+def shared_probe_fixture():
+    cache, checkpoint, tail, request = fixture()
+    branch = Node(
+        id=3, parent=checkpoint, creation_time=3, key=Key([14, 15]),
+        component_data=[data(), data(False, False, 0), data()],
+        write_through_pending_id=None, load_back_pending_id=None,
+        backuped=True,
+    )
+    nodes = {0: cache.tree_core.root_node, 1: checkpoint, 2: tail, 3: branch}
+    cache.tree_core.node_by_id = nodes.__getitem__
+    cache.session_refs.snapshot_latest_session_leaf_anchors.return_value = (
+        (0, ((2, 2), (3, 3))), (2, ((2, 2), (3, 3))),
+    )
+    request.origin_input_ids = [10, 11, 12, 13, 99]
+    return cache, checkpoint, tail, branch, request
+
+
+def test_shared_probe_checks_common_prefix_once_and_refreshes_next_call():
+    cache, checkpoint, tail, _, request = shared_probe_fixture()
+    checkpoint.key.is_prefix_at = Mock(wraps=checkpoint.key.is_prefix_at)
+    observation = cache.inspect_beliefkv_reentry(request)
+    assert checkpoint.key.is_prefix_at.call_count == 1
+    assert observation["checkpoint_tokens"] == 4
+    assert observation["device_checkpoint_tokens"] == 4
+    assert observation["component_leaves"] == ((0, ((2, 2),)), (2, ((2, 2),)))
+    checkpoint.component_data[0].value = None
+    tail.component_data[2].value = None
+    observation = cache.inspect_beliefkv_reentry(request)
+    assert checkpoint.key.is_prefix_at.call_count == 2
+    assert observation["device_checkpoint_tokens"] == 0
+    assert observation["missing_full_tokens"] == 2
+    assert observation["missing_mamba_slots"] == 1
+    checkpoint.component_data[0].host_value = None
+    assert cache.inspect_beliefkv_reentry(request) is None
+
+
+@pytest.mark.parametrize("blocked", ("pending", "namespace", "stale_ancestor"))
+def test_shared_probe_keeps_ancestor_validity_requirements(blocked):
+    cache, checkpoint, tail, _, request = shared_probe_fixture()
+    if blocked == "pending":
+        checkpoint.load_back_pending_id = "native"
+    elif blocked == "namespace":
+        request.cache_salt = "other"
+    else:
+        tail.parent = Node(**vars(checkpoint))
+    assert cache.inspect_beliefkv_reentry(request) is None
+
+
+def test_shared_probe_can_select_a_later_matching_branch():
+    cache, _, _, branch, request = shared_probe_fixture()
+    branch.component_data[0].value = None
+    branch.component_data[2].value = None
+    request.origin_input_ids = [10, 11, 14, 15, 99]
+    observation = cache.inspect_beliefkv_reentry(request)
+    assert observation["checkpoint_tokens"] == 4
+    assert observation["missing_full_tokens"] == 2
+    assert observation["missing_mamba_slots"] == 1
+    assert observation["component_leaves"] == ((0, ((3, 3),)), (2, ((3, 3),)))
+
+
+def test_shared_probe_counts_cached_depth_toward_ancestry_bound():
+    cache, _, _, request = fixture()
+    root = cache.tree_core.root_node
+    nodes, parent = {0: root}, root
+    for node_id in range(1, 66):
+        node = Node(
+            id=node_id, parent=parent, creation_time=node_id,
+            key=Key([node_id]),
+            component_data=[data(), data(False, False, 0), data()],
+            write_through_pending_id=None, load_back_pending_id=None,
+        )
+        nodes[node_id] = parent = node
+    cache.tree_core.node_by_id = nodes.__getitem__
+    cache.session_refs.snapshot_latest_session_leaf_anchors.return_value = (
+        (0, ((64, 64), (65, 65))), (2, ((64, 64), (65, 65))),
+    )
+    request.origin_input_ids = list(range(1, 67))
+    assert cache.inspect_beliefkv_reentry(request) is None
