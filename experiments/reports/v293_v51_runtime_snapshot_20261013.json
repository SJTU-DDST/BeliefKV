  "helper_utf8_source": "\"\"\"Bind V51's live principals and bounded runtime evidence before cutoff.\"\"\"\n\nfrom collections import Counter\nfrom datetime import datetime\nimport hashlib\nimport json\nfrom pathlib import Path\nimport sys\n\n\nMAIN = Path(\"/home/longhao/experiment/BeliefKV\")\nFOLLOWUP = Path(\"/home/longhao/experiment/.worktrees/beliefkv-v25-followup-20261011\")\nRUN = MAIN / \"experiments/raw/qwen35_native_predictive_replenished_108plus48_20261013_v51\"\nOUTPUT = FOLLOWUP / \"experiments/reports/v293_v51_runtime_snapshot_20261013.json\"\nDEPLOYMENT = FOLLOWUP / \"experiments/reports/v286_v51_deployment_validation_20261013.json\"\nsys.path.insert(0, str(MAIN))\nfrom scripts.summarize_semantic_h2d_ab import verify_frozen_execution_source\n\n\ndef sha(raw):\n    return hashlib.sha256(raw).hexdigest()\n\n\ndef identity(pid):\n    fields = Path(f\"/proc/{pid}/stat\").read_text().rsplit(\")\", 1)[1].split()\n    return {\n        \"pid\": pid, \"state\": fields[0], \"ppid\": int(fields[1]),\n        \"pgid\": int(fields[2]), \"sid\": int(fields[3]), \"start_ticks\": fields[19],\n    }\n\n\ndef tail(path):\n    with path.open(\"rb\") as stream:\n        stream.seek(0, 2)\n        end = stream.tell()\n        stream.seek(max(0, end - 4 * 1024 * 1024))\n        if stream.tell():\n            stream.readline()\n        start = stream.tell()\n        raw = stream.read(end - start)\n    raw = raw[:raw.rfind(b\"\\n\") + 1]\n    return [json.loads(line) for line in raw.splitlines()], {\n        \"path\": str(path), \"start_offset\": start,\n        \"complete_bytes_read\": len(raw), \"sha256\": sha(raw),\n    }\n\n\nif OUTPUT.exists():\n    raise ValueError(\"preserve existing runtime snapshot\")\nplan_bytes = (RUN / \"ab_plan.json\").read_bytes()\nplan = json.loads(plan_bytes)\nif plan[\"code_commit\"] != \"0990b73e639bdf7b23e05e24734c168e2d78d2d6\":\n    raise ValueError(\"V51 source differs\")\noriginal = json.loads(DEPLOYMENT.read_bytes())\npids = {\"coordinator\": 3783285, \"engine_parent\": 3783525, \"scheduler\": 3783899, \"client\": 3785578}\nidentities = {name: identity(pid) for name, pid in pids.items()}\ncommands = {\n    name: Path(f\"/proc/{pid}/cmdline\").read_bytes().replace(b\"\\0\", b\" \").decode()\n    for name, pid in pids.items()\n}\nfor name, expected in original[\"live_process_identities\"].items():\n    if identities[name][\"start_ticks\"] != expected[\"start_ticks\"]:\n        raise ValueError(f\"principal changed: {name}\")\nfor name in (\"coordinator\", \"engine_parent\", \"client\"):\n    row = identities[name]\n    if row[\"state\"] == \"Z\" or row[\"pgid\"] != row[\"pid\"] or row[\"sid\"] != row[\"pid\"]:\n        raise ValueError(f\"principal group changed: {name}\")\nif (\n    str(RUN) not in commands[\"coordinator\"] or \"launch_semantic_h2d_after_pair.py\" not in commands[\"coordinator\"]\n    or str(RUN) not in commands[\"client\"] or \"run_deepagents_swebench.py\" not in commands[\"client\"]\n    or \"--port 18456\" not in commands[\"engine_parent\"]\n    or identities[\"scheduler\"][\"ppid\"] != pids[\"engine_parent\"]\n):\n    raise ValueError(\"run/process ownership differs\")\nstates, state_input = tail(RUN / \"predictive_h2d/opportunities/admission_opportunities.jsonl\")\nstates = [row for row in states if row.get(\"event\") == \"admission_runtime_state\"]\nhosts, host_input = tail(RUN / \"predictive_h2d/server/host_pool_telemetry.jsonl\")\nhosts = [row for row in hosts if row.get(\"event\") == \"host_pool_usage\"]\nstate, host = states[-1], hosts[-1]\ncounts = host[\"full_host_eviction_scans\"]\nif counts[\"calls\"] != counts[\"already_satisfied\"] + counts[\"heap_builds\"]:\n    raise ValueError(\"Host counters do not reconcile\")\nrecent = [row for row in states if 0 <= state[\"ts_ms\"] - row[\"ts_ms\"] <= 30_000]\nresult = {\n    \"schema_version\": 1, \"observed_at_local\": datetime.now().astimezone().isoformat(),\n    \"run_root\": str(RUN), \"collection_code_commit\": plan[\"code_commit\"],\n    \"frozen_plan_sha256\": sha(plan_bytes),\n    \"execution_verification\": verify_frozen_execution_source(MAIN, plan[\"code_commit\"]),\n    \"previous_deployment_sha256\": sha(DEPLOYMENT.read_bytes()),\n    \"live_process_identities\": identities, \"live_process_commands\": commands,\n    \"runtime_state\": state, \"latest_host_state\": host,\n    \"recent_budget_sources\": dict(Counter(row[\"prefetch_residency_budget\"][\"source\"] for row in recent)),\n    \"runtime_source\": state_input, \"host_source\": host_input,\n    \"scope\": \"Bounded sequential complete tails; no full-run performance or causal gain claim.\",\n    \"helper_sha256\": sha(Path(__file__).read_bytes()), \"helper_utf8_source\": Path(__file__).read_text(),\n}\nOUTPUT.write_text(json.dumps(result, indent=2, allow_nan=False) + \"\\n\")\nprint(json.dumps({\n    \"observed_at_local\": result[\"observed_at_local\"],\n    \"recent_budget_sources\": result[\"recent_budget_sources\"],\n    \"host_counts\": counts,\n    \"complete_ready\": {key: value for key, value in state[\"counts\"].items() if \"complete_ready\" in key},\n}, indent=2))\n"
}
