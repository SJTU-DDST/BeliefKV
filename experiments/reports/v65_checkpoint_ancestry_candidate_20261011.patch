+def _leaf_ancestry(
+    nodes: Mapping[int, UnifiedNodeSummary | _PreparePrefixNode],
+    leaves: Mapping[int, int | float],
+) -> tuple[set[int], dict[int, int], dict[int, int], set[int]] | None:
+    """Index this snapshot's shared paths once, retaining lowest-leaf provenance."""
+    paths: set[int] = set()
+    provenance: dict[int, int] = {}
+    depth: dict[int, int] = {}
+    roots: set[int] = set()
+    for leaf in sorted(leaves):
+        current = leaf
+        chain: list[int] = []
+        seen: set[int] = set()
+        while current is not None and current not in paths:
+            if current not in nodes or current in seen:
+                return None
+            seen.add(current)
+            chain.append(current)
+            current = nodes[current].parent_id
+        if current is None:
+            roots.add(chain[-1])
+            start = 0
+        else:
+            start = depth[current] + 1
+        for distance, node_id in enumerate(reversed(chain), start):
+            paths.add(node_id)
+            provenance[node_id] = leaf
+            depth[node_id] = distance
+    return paths, provenance, depth, roots
+
