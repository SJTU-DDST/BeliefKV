+@pytest.mark.parametrize("blocked", ("none", "pending", "replaced", "missing", "excluded"))
+def test_pressure_publication_indexes_candidates_when_device_leaves_are_larger(blocked):
+    class Node(NS):
+        __hash__ = object.__hash__
+
+    class DeviceLeaves(set):
+        def __iter__(self):
+            raise AssertionError("unrelated device leaves must not be scanned")
+
+    runtime, _ = tool_runtime()
+    nodes = {
+        number: Node(
+            id=number, creation_time=number, backuped=True,
+            write_through_pending_id=None, load_back_pending_id=None,
+            component_data=[
+                NS(value=[1], host_value=[1], lock_ref=0, session_ref=1),
+                NS(value=None, host_value=None, lock_ref=0, session_ref=0),
+                NS(
+                    value=[1] if number == 64 else None,
+                    host_value=[1] if number == 64 else None,
+                    lock_ref=0, session_ref=1,
+                ),
+            ],
+        )
+        for number in range(1, 65)
+    }
+    leaves = DeviceLeaves({nodes[64], *(Node(id=n) for n in range(65, 4161))})
+    cache = NS(
+        tree_core=NS(
+            node_by_id=nodes.__getitem__, evictable_device_leaves=leaves,
+            lru_lists={2: NS(cache={64: nodes[64]})},
+        ),
+        ongoing_write_through={},
+    )
+    runtime._native_cache = cache
+    runtime._parent_pressure_candidates = {number: (None, number) for number in nodes}
+    if blocked == "pending":
+        nodes[64].load_back_pending_id = 9
+    elif blocked == "replaced":
+        nodes[64].creation_time = 65
+    elif blocked == "missing":
+        del nodes[64]
+    excluded = (64,) if blocked == "excluded" else ()
+    try:
+        runtime._publish_parent_pressure_candidates(exclude_node_ids=excluded)
+        assert runtime.counts["prepare_publication_candidate_index"] == 1
+        assert cache.beliefkv_join_pressure_candidates == tuple((n, n) for n in range(1, 9))
+        expected = ((64, 64),) if blocked == "none" else ()
+        assert cache.beliefkv_join_pressure_candidates_by_component == {0: expected, 2: expected}
+        assert tuple(runtime._parent_pressure_candidates) == tuple(range(1, 65))
+    finally:
+        runtime.close()
+
+
