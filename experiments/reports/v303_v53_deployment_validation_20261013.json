  "helper_sha256": "6802c106cd57b8cd80542e68b078d0e26fa28ceb1f8c9d5229fa60ab424dc1fb",
  "helper_utf8_source": "\"\"\"Verify frozen V53, unchanged workload and actual empty-restore execution.\"\"\"\n\nfrom collections import Counter\nfrom datetime import datetime\nimport hashlib\nimport json\nfrom pathlib import Path\nimport subprocess\nimport sys\nfrom urllib.request import urlopen\n\n\nMAIN = Path(\"/home/longhao/experiment/BeliefKV\")\nROOT = Path(\"/home/longhao/experiment/.worktrees/beliefkv-v25-followup-20261011\")\nCHECKOUT = Path(\"/home/longhao/experiment/.worktrees/beliefkv-v299-v53-empty-restore-20261013\")\nRUN = MAIN / \"experiments/raw/qwen35_native_predictive_replenished_108plus48_20261013_v53\"\nPREVIOUS = MAIN / \"experiments/raw/qwen35_native_predictive_replenished_108plus48_20261013_v52\"\nOUTPUT = ROOT / \"experiments/reports/v303_v53_deployment_validation_20261013.json\"\nsys.path.insert(0, str(MAIN))\nfrom beliefkv.experiments.source_provenance import git_source_state\nfrom scripts.summarize_semantic_h2d_ab import verify_frozen_execution_source\n\n\ndef sha(raw):\n    return hashlib.sha256(raw).hexdigest()\n\n\ndef load(path):\n    raw = path.read_bytes()\n    return json.loads(raw), sha(raw)\n\n\ndef require(condition, message):\n    if not condition:\n        raise ValueError(message)\n\n\ndef tail(path):\n    with path.open(\"rb\") as stream:\n        stream.seek(0, 2)\n        end = stream.tell()\n        stream.seek(max(0, end - 8 * 1024 * 1024))\n        if stream.tell():\n            stream.readline()\n        start = stream.tell()\n        raw = stream.read(end - start)\n    raw = raw[:raw.rfind(b\"\\n\") + 1]\n    return [json.loads(line) for line in raw.splitlines()], {\n        \"path\": str(path), \"start_offset\": start,\n        \"complete_bytes_read\": len(raw), \"sha256\": sha(raw),\n    }\n\n\ndef identity(pid):\n    fields = Path(f\"/proc/{pid}/stat\").read_text().rsplit(\")\", 1)[1].split()\n    return {\n        \"pid\": pid, \"state\": fields[0], \"ppid\": int(fields[1]),\n        \"pgid\": int(fields[2]), \"sid\": int(fields[3]), \"start_ticks\": fields[19],\n    }\n\n\nrequire(not OUTPUT.exists(), \"preserve prior deployment\")\nstarted = datetime.now().astimezone().isoformat()\nplan, plan_sha = load(RUN / \"ab_plan.json\")\nprevious, previous_sha = load(PREVIOUS / \"ab_plan.json\")\nlaunch, launch_sha = load(MAIN / \"experiments/reports/v53_launch_after_v52_20261013.json\")\nqualified, qualified_sha = load(ROOT / \"experiments/reports/v299_empty_restore_qualification_20261013.json\")\nold, old_sha = load(ROOT / \"experiments/reports/v295_v52_deployment_validation_20261013.json\")\nrevision = subprocess.check_output([\"git\", \"rev-parse\", \"HEAD\"], cwd=CHECKOUT, text=True).strip()\nrequire(revision == plan[\"code_commit\"] == launch[\"target_revision\"], \"frozen revision differs\")\nrequire(launch[\"status\"] == \"running_new_predictive\", \"collector is not running\")\nchanges = sorted(name for name in plan.keys() | previous.keys() if plan.get(name) != previous.get(name))\nrequire(changes == [\"code_commit\"], f\"unexpected workload differences: {changes}\")\nexecution = verify_frozen_execution_source(MAIN, revision)\nfrozen = verify_frozen_execution_source(CHECKOUT, revision)\nfor relative, expected in qualified[\"source_sha256\"].items():\n    require(\n        sha((MAIN / relative).read_bytes()) == sha((CHECKOUT / relative).read_bytes()) == expected,\n        f\"qualified source differs: {relative}\",\n    )\nengine = git_source_state(\n    MAIN / \"third_party/sglang-v0.5.20\",\n    canonical_patch=MAIN / \"patches/sglang-v0.5.20-beliefkv-staging.patch\",\n)[\"canonical_patch\"]\nrequire(engine[\"sha256\"] == plan[\"sglang_patch_sha256\"] == qualified[\"canonical_patch_sha256\"], \"patch differs\")\nrequire(engine[\"actual_tree\"] == engine[\"expected_tree\"] == old[\"engine\"][\"actual_tree\"], \"engine tree differs\")\nserver = RUN / \"predictive_h2d/server\"\ncapacity, capacity_sha = load(server / \"native_capacity_census.json\")\nrequire(capacity[\"capacity\"] == old[\"actual_capacity\"], \"physical capacities changed\")\nfreeze = (server / \"gc_freeze_initialization.txt\").read_bytes()\nrequire(b\"Garbage collection frozen.\" in freeze, \"GC freeze missing\")\naudit, audit_input = tail(server / \"runtime_audit.jsonl\")\nrows, state_input = tail(RUN / \"predictive_h2d/opportunities/admission_opportunities.jsonl\")\nhosts, host_input = tail(server / \"host_pool_telemetry.jsonl\")\nstates = [row for row in rows if row.get(\"event\") == \"admission_runtime_state\"]\nsamples = [row for row in audit if row.get(\"event\") == \"gpu_service_sample\"]\nprobes = [row for row in audit if row.get(\"event\") == \"gpu_restore_dependency_wait\"]\nhosts = [row for row in hosts if row.get(\"event\") == \"host_pool_usage\"]\nrequire(states and samples and hosts, \"actual runtime or GPU evidence absent\")\nstate = states[-1]\nflags = (\"final_stage_prefetch\", \"final_stage_priority\", \"prepare_host\", \"resident_first\", \"tool_prefetch\")\nrequire(all(state.get(flag) is True for flag in flags), \"predictive policy differs\")\nrequire(state[\"physical_disabled\"] is False and state[\"execution_handoff\"] is False, \"physical path differs\")\nrequire(state[\"counts\"].get(\"wait_prefetch_empty_restore_shortcut\", 0) > 0, \"empty hint has not executed\")\nrequire(state[\"counts\"].get(\"native_admitted\", 0) > 0, \"no actual admissions\")\nrequire(state[\"counts\"].get(\"semantic_worker_dropped\", 0) == 0, \"semantic evidence dropped\")\nrequire(state.get(\"semantic_worker_configured\") and state.get(\"tool_predictor_configured\"), \"predictor configuration absent\")\nrequire(not state.get(\"semantic_worker_error\") and not state.get(\"tool_predictor_disabled\"), \"predictor failed\")\nrequire(\n    all(type(row.get(\"thread_cpu_observed_layer_span_ms\")) in (int, float) for row in probes),\n    \"own-thread CPU span field missing\",\n)\nrecent = [row for row in states if 0 <= state[\"ts_ms\"] - row[\"ts_ms\"] <= 30_000]\ntelemetry, telemetry_sha = load(server / \"native_telemetry_status.json\")\nrequire(telemetry.get(\"writer_error\") is None, \"native telemetry writer failure\")\nrequire(telemetry[\"dropped_records\"] == telemetry[\"failed_records\"] == 0, \"native telemetry loss\")\nready, ready_sha = load(server / \"native_telemetry_ready.json\")\nscheduler = identity(ready[\"scheduler_pid\"])\nparent = identity(scheduler[\"ppid\"])\nrequire(b\"--port\\x0018458\" in Path(f\"/proc/{parent['pid']}/cmdline\").read_bytes(), \"engine port differs\")\nwith urlopen(\"http://127.0.0.1:18458/health\", timeout=5) as response:\n    health = response.status\nrequire(health == 200, \"server unhealthy\")\nfinished = datetime.now().astimezone()\nrequire(0 <= finished.timestamp() * 1000. - state[\"ts_ms\"] < 30_000, \"runtime evidence stale\")\nrow = {\n    \"started_at_local\": started, \"observed_at_local\": finished.isoformat(),\n    \"run_root\": str(RUN), \"code_commit\": revision,\n    \"sglang_patch_sha256\": plan[\"sglang_patch_sha256\"], \"engine\": engine,\n    \"launch_started_at_utc\": launch[\"started_at_utc\"], \"launch_state_sha256\": launch_sha,\n    \"frozen_plan_sha256\": plan_sha, \"previous_plan_sha256\": previous_sha,\n    \"observed_plan_differences\": changes,\n    \"unchanged_plan_field_count\": len(plan.keys() | previous.keys()) - len(changes),\n    \"actual_capacity\": capacity[\"capacity\"], \"capacity_receipt_sha256\": capacity_sha,\n    \"execution_verification\": execution, \"frozen_checkout_verification\": frozen,\n    \"validated_source_sha256\": qualified[\"source_sha256\"],\n    \"qualification_sha256\": qualified_sha, \"previous_deployment_sha256\": old_sha,\n    \"runtime_state\": state,\n    \"recent_budget_sources\": dict(Counter(row[\"prefetch_residency_budget\"][\"source\"] for row in recent)),\n    \"observed_gpu_service_samples_in_tail\": len(samples),\n    \"observed_own_thread_layer_span_samples_in_tail\": len(probes),\n    \"own_thread_layer_span_samples_available\": bool(probes),\n    \"sampled_span_semantics\": \"No probes is unknown, not zero CPU cost or proven acceleration.\",\n    \"health_http_status\": health,\n    \"live_process_identities\": {\"scheduler\": scheduler, \"engine_parent\": parent},\n    \"native_telemetry_status_sha256\": telemetry_sha, \"native_ready_sha256\": ready_sha,\n    \"gc_freeze_receipt_sha256\": sha(freeze),\n    \"observed_native_telemetry_status\": {\n        name: telemetry.get(name) for name in (\"writer_error\", \"dropped_records\", \"failed_records\")\n    },\n    \"audit_input\": audit_input, \"runtime_input\": state_input, \"host_input\": host_input,\n    \"scope\": \"Actual deployment, unchanged workload and path use; not busy-window throughput/JCT improvement.\",\n    \"helper_sha256\": sha(Path(__file__).read_bytes()), \"helper_utf8_source\": Path(__file__).read_text(),\n}\nOUTPUT.write_text(json.dumps(row, indent=2, allow_nan=False) + \"\\n\")\nprint(json.dumps({key: row[key] for key in (\n    \"observed_at_local\", \"unchanged_plan_field_count\", \"observed_gpu_service_samples_in_tail\",\n    \"observed_own_thread_layer_span_samples_in_tail\", \"recent_budget_sources\", \"health_http_status\",\n)}, indent=2))\n"
}
