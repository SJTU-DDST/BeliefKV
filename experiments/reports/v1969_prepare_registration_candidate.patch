@@ -0,0 +1,278 @@
+#!/usr/bin/env python3
+"""Compare fresh/repeated cold-page registration and complete PREPARE dispatch."""
+
+from __future__ import annotations
+
+import argparse
+from dataclasses import asdict, replace
+from datetime import datetime
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import sys
+import time
+from types import SimpleNamespace as NS
+from unittest.mock import patch
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT))
+
+from beliefkv.runtime.sglang_v0520_physical import capture_action_local_shadow
+from beliefkv.runtime.sglang_v0520_runtime import NativeAdmissionRuntime
+from scripts.benchmark_native_prepare_path import baseline_runtime, fixture
+from scripts.benchmark_prefetch_control_cpu import distribution
+import scripts.benchmark_prepare_selection_reuse_cpu as dispatch_benchmark
+
+
+def registration_fixture(cls, *, depth, layout, phase):
+    runtime, _, _, _, _ = fixture(
+        cls, workflows=1, depth=depth, backed=layout == "backed",
+        host_full=1_000_000, leases=0,
+    )
+    key = runtime.context_sessions["ctx-wf-0-root"]
+    cache = runtime._native_cache
+    if layout == "unbacked":
+        for node_id in range(depth):
+            node = cache.tree_core.node_by_id(node_id)
+            node.component_data[0].host_value = None
+            node.component_data[2].host_value = None
+    anchors = runtime.snapshot_session_anchors(
+        cache, context_id=key.context_id, context_epoch=key.context_epoch,
+    )
+    candidate = capture_action_local_shadow(cache, anchors, include_non_actionable=True)
+    runtime._parent_pressure_candidates.clear()
+    runtime._register_backed_pressure_nodes(key, candidate=candidate)
+    initial = dict(runtime._parent_pressure_candidates) if phase != "fresh" else {}
+    if phase == "replaced_node" and initial:
+        node_id = next(iter(initial))
+        initial[node_id] = (key, initial[node_id][1] - .5)
+    if phase == "equal_key":
+        key = replace(key)
+    if phase == "new_epoch":
+        key = replace(key, context_epoch=key.context_epoch + 1, request_id="next-request")
+    if phase == "missing_middle" and initial:
+        initial.pop(tuple(initial)[len(initial) // 2])
+
+    def reset():
+        runtime._parent_pressure_candidates = dict(initial)
+        runtime.counts.clear()
+
+    def run():
+        runtime._register_backed_pressure_nodes(
+            key, candidate=candidate, reclaim_tail_leaves=frozenset(),
+        )
+
+    def state():
+        return {
+            "candidates": [
+                (node_id, asdict(owner), created)
+                for node_id, (owner, created) in runtime._parent_pressure_candidates.items()
+            ],
+            "groups": sorted(
+                (json.dumps(asdict(owner), sort_keys=True), sorted(nodes))
+                for owner, nodes in runtime._parent_pressure_groups.items()
+            ),
+            "positions": runtime._parent_pressure_positions,
+            "next_position": runtime._parent_pressure_next_position,
+            "counts": dict(runtime.counts),
+        }
+
+    return runtime, reset, run, state
+
+
+def measure(baseline, *, depth, layout, phase, samples):
+    variants = {
+        name: registration_fixture(cls, depth=depth, layout=layout, phase=phase)
+        for name, cls in (("baseline", baseline), ("candidate", NativeAdmissionRuntime))
+    }
+    costs = {name: {"thread_cpu_us": [], "wall_us": []} for name in variants}
+    try:
+        for sample in range(samples + 10):
+            states = {}
+            order = list(variants)
+            if sample % 2:
+                order.reverse()
+            for name in order:
+                _, reset, run, state = variants[name]
+                reset()
+                cpu, wall = time.thread_time_ns(), time.perf_counter_ns()
+                run()
+                elapsed_wall = (time.perf_counter_ns() - wall) / 1000.
+                elapsed_cpu = (time.thread_time_ns() - cpu) / 1000.
+                if sample >= 10:
+                    costs[name]["thread_cpu_us"].append(elapsed_cpu)
+                    costs[name]["wall_us"].append(elapsed_wall)
+                states[name] = state()
+            if states["baseline"] != states["candidate"]:
+                raise AssertionError((depth, layout, phase, states))
+        return {
+            "depth": depth, "layout": layout, "phase": phase,
+            "registration_order_groups_and_generation_equal": True,
+            "costs": {
+                name: {clock: distribution(values) for clock, values in clocks.items()}
+                for name, clocks in costs.items()
+            },
+        }
+    finally:
+        for runtime, *_ in variants.values():
+            runtime.close()
+
+
+def indexed_fixture(cls, **kwargs):
+    """Retain native-style sparse leaf/LRU indices instead of a full-scan fallback."""
+    kwargs["workflows"] = 24
+    value = fixture(cls, **kwargs)
+    runtime, _, reads, _, _ = value
+    cache = runtime._native_cache
+    lookup = cache.tree_core.node_by_id
+
+    class UnifiedTreeNode(NS):
+        __hash__ = object.__hash__
+
+    depth = kwargs["depth"]
+    original = {node_id: lookup(node_id) for node_id in range(24 * depth)}
+    nodes = {node_id: UnifiedTreeNode(**vars(node)) for node_id, node in original.items()}
+    for node_id, node in nodes.items():
+        parent = original[node_id].parent
+        node.parent = nodes[parent.id] if parent is not None else None
+        full = node.component_data[0]
+        node.backuped = full.host_value is not None
+    leaves = [nodes[index * depth + depth - 1] for index in range(24)]
+
+    def node_by_id(node_id):
+        reads["node_lookup"] += 1
+        return nodes[node_id]
+
+    cache.tree_core.node_by_id = node_by_id
+    cache.tree_core.evictable_device_leaves = set(leaves)
+    cache.tree_core.lru_lists = {2: NS(cache={node.id: node for node in leaves})}
+    return value
+
+
+def measure_dispatch(baseline, *, depth, backed, control, decline, samples):
+    variants = {
+        name: dispatch_benchmark.setup(
+            cls, depth=depth, backed=backed, control=control, decline=decline,
+        )
+        for name, cls in (("baseline", baseline), ("candidate", NativeAdmissionRuntime))
+    }
+    costs = {name: {"thread_cpu_us": [], "wall_us": []} for name in variants}
+    try:
+        for sample in range(samples + 10):
+            states = {}
+            order = list(variants)
+            if sample % 2:
+                order.reverse()
+            for name in order:
+                runtime, queue, reads, actions = variants[name]
+                runtime.physical_ledger = type(runtime.physical_ledger)()
+                runtime._join_prepare_next_ms = 0.
+                runtime._join_prepare_cursor = 0
+                runtime._join_prepare_commands.clear()
+                runtime._prepare_probe_after_ms.clear()
+                runtime._native_max_running = 8
+                runtime.counts.clear()
+                actions.clear()
+                reads.clear()
+                cpu, wall = time.thread_time_ns(), time.perf_counter_ns()
+                runtime.dispatch_join_prepare(queue, running_batch=NS(reqs=[None] * 8))
+                elapsed_wall = (time.perf_counter_ns() - wall) / 1000.
+                elapsed_cpu = (time.thread_time_ns() - cpu) / 1000.
+                if sample >= 10:
+                    costs[name]["thread_cpu_us"].append(elapsed_cpu)
+                    costs[name]["wall_us"].append(elapsed_wall)
+                states[name] = {
+                    "actions": list(actions),
+                    "published": runtime._native_cache.beliefkv_join_pressure_candidates,
+                    "by_component": runtime._native_cache.beliefkv_join_pressure_candidates_by_component,
+                    "reads": dict(reads), "counts": dict(runtime.counts),
+                    "pending_bytes": runtime.physical_ledger.pending_action_bytes("PREPARE_HOST"),
+                    "pending_count": runtime.physical_ledger.pending_count,
+                }
+            if states["baseline"] != states["candidate"]:
+                raise AssertionError((depth, backed, control, decline, states))
+            if not backed and not decline and not states["candidate"]["actions"]:
+                raise AssertionError("actionable PREPARE did not submit")
+        return {
+            "depth": depth, "backed": backed, "control_delivered": control,
+            "native_decline": decline, "workflows": 24, "running": 8,
+            "actions_publication_reads_counters_and_pending_equal": True,
+            "costs": {
+                name: {clock: distribution(values) for clock, values in clocks.items()}
+                for name, clocks in costs.items()
+            },
+        }
+    finally:
+        for runtime, *_ in variants.values():
+            runtime.close()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--baseline", default="07eb988")
+    parser.add_argument("--samples", type=int, default=101)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    if args.samples < 1 or args.output.exists():
+        parser.error("positive samples and a fresh report are required")
+    paths = (
+        "beliefkv/runtime/sglang_v0520_runtime.py",
+        "beliefkv/runtime/sglang_v0520_physical.py",
+        "beliefkv/runtime/sglang_v0520_observer.py",
+        "scripts/benchmark_prepare_registration_cpu.py",
+        "scripts/benchmark_native_prepare_path.py",
+        "scripts/benchmark_prepare_selection_reuse_cpu.py",
+    )
+    sources = {path: hashlib.sha256((ROOT / path).read_bytes()).hexdigest() for path in paths}
+    baseline, baseline_sources = baseline_runtime(args.baseline)
+    with patch("time.monotonic", lambda: 1000.):
+        cases = [
+            measure(baseline, depth=depth, layout=layout, phase=phase, samples=args.samples)
+            for depth in (4, 16, 64, 256)
+            for layout in ("backed", "partial", "unbacked")
+            for phase in ("fresh", "repeated", "replaced_node", "equal_key", "new_epoch", "missing_middle")
+        ]
+        with patch.object(dispatch_benchmark, "fixture", indexed_fixture):
+            dispatch = [
+                measure_dispatch(
+                    baseline, depth=depth, backed=backed,
+                    control=control, decline=decline, samples=args.samples,
+                )
+                for depth in (16, 64, 256)
+                for backed, control, decline in (
+                    (False, False, False), (False, True, False),
+                    (False, False, True), (True, False, False),
+                )
+            ]
+    if any(hashlib.sha256((ROOT / path).read_bytes()).hexdigest() != sha
+           for path, sha in sources.items()):
+        raise RuntimeError("benchmark source changed")
+    report = {
+        "status": "complete_cpu_comparison_not_gpu_or_jct_gain",
+        "observed_at": datetime.now().astimezone().isoformat(),
+        "baseline_revision": args.baseline, "baseline_source_sha256": baseline_sources,
+        "candidate_source_sha256": sources, "cases": cases, "dispatch_cases": dispatch,
+        "limitations": [
+            "Registration uses validated immutable CPU closure snapshots; reset and equality checks are untimed.",
+            "Full JOIN PREPARE dispatch uses 24 synthetic workflows and native-style sparse leaf/LRU indices.",
+            "Controller, enqueue, writer and GPU capacity use CPU stand-ins; no real DMA, allocator or writer I/O.",
+            "The fixed clock is an ordinary lambda; reset, equality checking and counters are outside timing.",
+            "Synthetic case counts and CPU percentages do not establish online frequencies, throughput or JCT.",
+        ],
+    }
+    with args.output.open("x") as stream:
+        json.dump(report, stream, indent=2, allow_nan=False)
+        stream.write("\n")
+    print(json.dumps({
+        "registration_cases": len(cases), "dispatch_cases": len(dispatch),
+        "representative": [
+            {"depth": row["depth"], "layout": row["layout"], "phase": row["phase"],
+             **{name: value["thread_cpu_us"]["p50_us"] for name, value in row["costs"].items()}}
+            for row in cases if row["depth"] == 64 and row["phase"] in ("fresh", "repeated")
+        ],
+    }, indent=2))
+
+
+if __name__ == "__main__":
+    main()
