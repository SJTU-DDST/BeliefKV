+    def prepare_host_session_nodes(
+        self,
+        *,
+        session_id: str,
+        session_generation: int,
+        leaf_node_id: NodeId,
+        leaf_creation_time: int | float,
+        nodes: tuple[tuple[NodeId, int | float, str], ...],
+        beliefkv_before_enqueue: Callable[[CacheOperation], bool],
+    ) -> tuple[PrepareHostShadowResult, ...]:
+        """Queue a bounded FULL-only burst, then submit separate node receipts once."""
+        if (
+            type(nodes) is not tuple or not 1 <= len(nodes) <= 16
+            or any(type(item) is not tuple or len(item) != 3 for item in nodes)
+            or any(
+                type(node_id) is not int
+                or type(created) not in (int, float)
+                or type(command) is not str or not command
+                for node_id, created, command in nodes
+            )
+            or len({item[0] for item in nodes}) != len(nodes)
+            or len({item[2] for item in nodes}) != len(nodes)
+            or not callable(beliefkv_before_enqueue)
+        ):
+            return ()
+        if len(nodes) == 1:
+            node_id, created, command = nodes[0]
+            outcome = self.prepare_host_shadow(
+                session_id=session_id, session_generation=session_generation,
+                leaf_node_id=leaf_node_id, leaf_creation_time=leaf_creation_time,
+                node_id=node_id, node_creation_time=created,
+                beliefkv_command_id=command,
+                beliefkv_before_enqueue=beliefkv_before_enqueue,
+                beliefkv_include_mamba=False,
+            )
+            return (outcome,) if outcome.issued else ()
+        issued = []
+        pending_ids: set[NodeId] = set()
+        try:
+            for node_id, created, command in nodes:
+                outcome = self.prepare_host_shadow(
+                    session_id=session_id,
+                    session_generation=session_generation,
+                    leaf_node_id=leaf_node_id,
+                    leaf_creation_time=leaf_creation_time,
+                    node_id=node_id,
+                    node_creation_time=created,
+                    beliefkv_command_id=command,
+                    beliefkv_before_enqueue=beliefkv_before_enqueue,
+                    beliefkv_include_mamba=False,
+                    _beliefkv_pending_write_ids=frozenset(pending_ids),
+                    _beliefkv_defer_writing=True,
+                )
+                if not outcome.issued:
+                    break
+                issued.append(outcome)
+                pending_ids.add(node_id)
+        finally:
+            if issued:
+                self.cache_controller.start_writing()
+        return tuple(issued)
+
