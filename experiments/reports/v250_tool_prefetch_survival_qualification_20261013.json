rror((case, name, result))\n                    if sample >= 3:\n                        costs[name][\"wall_us\"].append(wall_total / 32000.)\n                        costs[name][\"thread_cpu_us\"].append(cpu_total / 32000.)\n            samples.append({\n                \"case\": case, \"expected_ready\": expected,\n                \"costs\": {\n                    name: {clock: {\"mean\": mean(values), \"p50\": median(values), \"samples\": values}\n                           for clock, values in clocks.items()}\n                    for name, clocks in costs.items()\n                },\n            })\nfinally:\n    runtime.close()\ncurrent_text = (ROOT / SOURCE).read_text()\npaths = (SOURCE, \"tests/test_tool_predictive_transfers.py\")\nreport = {\n    \"schema_version\": 1, \"observed_at_local\": datetime.now().astimezone().isoformat(),\n    \"parent_commit\": parent,\n    \"qualified_paths_sha256\": {\n        path: hashlib.sha256((ROOT / path).read_bytes()).hexdigest() for path in paths\n    },\n    \"completed_validation\": {\n        \"tool_session_id\": 50537, \"returncode\": 0, \"passed\": 470, \"duration_seconds\": 1.75,\n        \"pytest_args\": [\n            \"tests/test_tool_predictive_transfers.py\", \"tests/test_wait_prefetch_batch.py\",\n            \"tests/test_wait_prefetch_partial_extent.py\", \"tests/test_native_transfer_policy.py\",\n            \"tests/test_sglang_v0520_runtime.py\",\n        ],\n        \"evidence_source\": \"completed tool output in this thread\",\n    },\n    \"parent_reclaim_method_ast_unchanged\": (\n        ast.dump(method(source, \"_reclaim_wait_prefetch_capacity\"))\n        == ast.dump(method(current_text, \"_reclaim_wait_prefetch_capacity\"))\n    ),\n    \"cpu_checks\": samples,\n    \"semantics\": [\n        \"CPU hint fixtures only; no allocator, DMA, capacity or GPU throughput claim.\",\n        \"Model refresh alone cannot erase an observed same-tool survival overrun.\",\n        \"Old hint supplies statistical 