  "text": "} not set. \"\n            \"Expected JSON list or CSV of service definitions.\"\n        )\n\n    try:\n        # Try JSON first\n        services = json.loads(raw)\n        if not isinstance(services, list):\n            raise ValueError(\"Expected JSON list of service definitions.\")\n    except json.JSONDecodeError:\n        # Fall back to CSV\n        services = []\n        for part in raw.split(\",\"):\n            part = part.strip()\n            if not part:\n                continue\n            try:\n                name, host, port, version = part.split(\":\")\n                services.append(\n                    {\n                        \"name\": name,\n                        \"host\": host,\n                        \"port\": port,\n                        \"version\": version,\n                    }\n                )\n            except ValueError as exc:\n                raise ValueError(\n                    f\"Invalid shorthand format for service '{part}': {exc}\"\n                ) from exc\n\n    return [ServiceConfig(svc) for svc in services]\n\n\ndef main(argv: list[str] | None = None) -> int:\n    \"\"\"\n    Render the nginx.conf template and write to stdout or file.\n    \"\"\"\n    parser = argparse.ArgumentParser(\n        description=\"Render dynamic NGINX config from environment.\",\n        formatter_class=argparse.RawDescriptionHelpFormatter,\n        epilog=textwrap.dedent(\n            \"\"\"\n            Example usage:\n                $ CAMPUSCONNECT_SERVICES='[{\"name\":\"course\",\"host\":\"course\",\"port\":8080,\"version\":\"v1\"}]' \\\\\n                  ./infra/api_gateway/nginx.conf -o /etc/nginx/nginx.conf\n\n                $ CAMPUSCONNECT_SERVICES='course:course:8080:v1,social:social:8081:v1' \\\\\n                  ./infra/api_gateway/nginx.conf\n            \"\"\"\n        ),\n    )\n    parser.add_argument(\n        \"-o\",\n        \"--output\",\n        type=Path,\n        help=\"Write rendered config to file (default: stdout)\",\n    )\n    parser.add_argument(\n        \"--client-max-body-size\",\n        default=\"25m\",\n        help=\"Max upload size (default: 25m)\",\n    )\n    parser.add_argument(\n        \"--listen-port\",\n        type=int,\n        default=443,\n        help=\"Public listen port (default: 443)\",\n    )\n    parser.add_argument(\n        \"--enable-ssl\",\n        action=\"store_true\",\n        help=\"Enable SSL (default: off)\",\n    )\n    parser.add_argument(\n        \"--ssl-cert\",\n        default=\"/etc/nginx/certs/fullchain.pem\",\n",
