  "text": " imports.  The actual implementations\n#        are only resolved at runtime by the DI container.\n# --------------------------------------------------------------------------- #\n\n@runtime_checkable\nclass NFT(Protocol):\n    \"\"\"Domain NFT entity (from showtime_stash.domain.entities.nft).\"\"\"\n\n    id: str\n    owner: str\n    state: str\n    metadata_uri: str\n    created_at: datetime\n\n    def spotlight(self, duration: timedelta) -> None: ...\n\n    def stake(self, principal: int, duration: timedelta) -> None: ...\n\n    def redeem(self) -> None: ...\n\n    def archive(self) -> None: ...\n\n\n@runtime_checkable\nclass Wallet(Protocol):\n    \"\"\"Domain Wallet entity (from showtime_stash.domain.entities.wallet).\"\"\"\n\n    address: str\n    created_at: datetime\n\n\n@runtime_checkable\nclass GovernanceProposal(Protocol):\n    \"\"\"Domain GovernanceProposal entity (from showtime_stash.domain.entities.governance).\"\"\"\n\n    proposal_id: str\n    title: str\n    description: str\n    proposer: str\n    created_at: datetime\n    expires_at: datetime\n    quorum: int\n    passed: bool\n\n\n# --------------------------------------------------------------------------- #\n#                           Application Services                              #\n# --------------------------------------------------------------------------- #\n\nclass NFTService:\n    \"\"\"\n    Application service for NFT-related operations.\n    \"\"\"\n\n    def __init__(\n        self,\n        nft_factory: \"NFTFactory\",\n        nft_repository: \"NFTRepository\",\n        event_publisher: \"LiveEventPublisher\",\n    ) -> None:\n        self._factory = nft_factory\n        self._repo = nft_repository\n        self._publisher = event_publisher\n\n    def create_spotlight_nft(\n        self,\n        creator_wallet: str,\n        metadata_uri: str,\n        duration: timedelta,\n    ) -> NFT:\n        \"\"\"\n        Create a new NFT and immediately spotlight it.\n\n        Returns\n        -------\n        NFT\n            The newly created and spotlighted NFT.\n        \"\"\"\n        # 1. Create the NFT domain entity\n        nft = self._factory.from_dto(\n            {\n                \"id\": str(uuid.uuid4()),\n                \"name\": \"Spotlight NFT\",\n                \"description\": \"A spotlight NFT\",\n                \"owner\": creator_wallet,\n                \"minted_at\": datetime.now().isoformat(),\n                \"metadata_uri\": metadata_uri,\n                \"state\": \"MINTED\",\n            }\n        )\n\n        # 2. Apply the spotlight lifecycle transition",
