  "helper_utf8_source": "\"\"\"Preserve bounded V50 runtime and Host evidence before the development cutoff.\"\"\"\n\nfrom collections import Counter\nfrom datetime import datetime\nimport hashlib\nimport json\nfrom pathlib import Path\nimport sys\nimport xml.etree.ElementTree as ET\n\n\nMAIN = Path(\"/home/longhao/experiment/BeliefKV\")\nFOLLOWUP = Path(\"/home/longhao/experiment/.worktrees/beliefkv-v25-followup-20261011\")\nRUN = MAIN / \"experiments/raw/qwen35_native_predictive_replenished_108plus48_20261013_v50\"\nOUTPUT = FOLLOWUP / \"experiments/reports/v282_v50_runtime_snapshot_20261013.json\"\nsys.path.insert(0, str(MAIN))\nfrom scripts.summarize_semantic_h2d_ab import verify_frozen_execution_source\n\n\ndef digest(payload):\n    return hashlib.sha256(payload).hexdigest()\n\n\ndef tail(path, limit=4 * 1024 * 1024):\n    with path.open(\"rb\") as stream:\n        stream.seek(0, 2)\n        end = stream.tell()\n        stream.seek(max(0, end - limit))\n        if stream.tell():\n            stream.readline()\n        start = stream.tell()\n        payload = stream.read(end - start)\n    payload = payload[:payload.rfind(b\"\\n\") + 1]\n    return [json.loads(line) for line in payload.splitlines()], {\n        \"path\": str(path), \"start_offset\": start, \"complete_bytes_read\": len(payload),\n        \"sha256\": digest(payload),\n    }\n\n\nif OUTPUT.exists():\n    raise ValueError(\"preserve existing runtime snapshot\")\nplan_bytes = (RUN / \"ab_plan.json\").read_bytes()\nplan = json.loads(plan_bytes)\nverification = verify_frozen_execution_source(MAIN, plan[\"code_commit\"])\nstates, state_source = tail(RUN / \"predictive_h2d/opportunities/admission_opportunities.jsonl\")\nstates = [row for row in states if row.get(\"event\") == \"admission_runtime_state\"]\nhosts, host_source = tail(RUN / \"predictive_h2d/server/host_pool_telemetry.jsonl\")\nhosts = [row for row in hosts if row.get(\"event\") == \"host_pool_usage\"]\nstate, host = states[-1], hosts[-1]\nrecent = [row for row in states if 0 <= state[\"ts_ms\"] - row[\"ts_ms\"] <= 30_000]\ndocumented_host = next(row for row in hosts if row[\"ts_ms\"] == 1791878994524.7188)\ncounts = documented_host[\"full_host_eviction_scans\"]\nassert counts[\"calls\"] == counts[\"already_satisfied\"] + counts[\"heap_builds\"]\njunit_path = FOLLOWUP / \"experiments/reports/v280_prefill_layer_span_checks_20261013.xml\"\njunit = junit_path.read_bytes()\nsuites = ET.fromstring(junit)\nassert all(int(suite.get(key, \"0\")) == 0 for suite in suites for key in (\"errors\", \"failures\"))\nresult = {\n    \"schema_version\": 1, \"observed_at_local\": datetime.now().astimezone().isoformat(),\n    \"run_root\": str(RUN), \"collection_code_commit\": plan[\"code_commit\"],\n    \"frozen_plan_sha256\": digest(plan_bytes), \"execution_verification\": verification,\n    \"scope\": \"Bounded complete tails read sequentially; no atomic cross-file or full-run claim\",\n    \"runtime_state\": state, \"latest_host_state\": host,\n    \"documented_host_state\": documented_host,\n    \"recent_budget_sources\": dict(Counter(\n        row[\"prefetch_residency_budget\"][\"source\"] for row in recent\n    )),\n    \"runtime_source\": state_source, \"host_source\": host_source,\n    \"candidate_qualified_sources_sha256\": {\n        relative: digest((FOLLOWUP / relative).read_bytes()) for relative in (\n            \"beliefkv/runtime/restore_wait_probe.py\",\n            \"tests/test_restore_wait_probe.py\",\n            \"beliefkv/runtime/sglang_v0520_observer.py\",\n            \"beliefkv/runtime/sglang_v0520_runtime.py\",\n        )\n    },\n    \"candidate_junit\": str(junit_path), \"candidate_junit_sha256\": digest(junit),\n    \"candidate_test_suites\": [dict(suite.attrib) for suite in suites],\n    \"limitations\": [\n        \"Actual Host satisfied-capacity skips establish frequency, not saved CPU/JCT.\",\n        \"V50 has no new free-list reason or observed-layer span fields; keep them unknown.\",\n        \"The candidate is committed only in followup and must be cold-deployed.\",\n        \"No post-cutoff service is treated as a natural completion training label.\",\n    ],\n    \"helper_sha256\": digest(Path(__file__).read_bytes()),\n    \"helper_utf8_source\": Path(__file__).read_text(),\n}\nOUTPUT.write_text(json.dumps(result, indent=2, allow_nan=False) + \"\\n\")\nprint(json.dumps({\n    \"output\": str(OUTPUT), \"recent_budget_sources\": result[\"recent_budget_sources\"],\n    \"documented_host_scans\": counts, \"latest_host_scans\": host[\"full_host_eviction_scans\"],\n    \"candidate_tests\": sum(int(suite.get(\"tests\", \"0\")) for suite in suites),\n}))\n"
