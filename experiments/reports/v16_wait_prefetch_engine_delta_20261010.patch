+    cache, _, victim, _ = fixture()
+    cache.is_write_back = True
+    cache.ongoing_write_through = {}
+    cache.beliefkv_join_pressure_candidates = ((victim.id, victim.creation_time),)
+    cache.beliefkv_join_pressure_validator = Mock(return_value=True)
+    cache._component_available_size = Mock(return_value=0)
+    for item in victim.component_data:
+        item.session_ref = int(referenced)
+    cache._demote = Mock()
+    cache.tree_core.demote_backed_mamba_state = Mock()
+    assert cache.reclaim_beliefkv_handoff_capacity(
+        full_tokens=2, mamba_slots=1, exclude_node_ids=(victim.id,),
+    ) == {}
+    cache._demote.assert_not_called()
+    cache.tree_core.demote_backed_mamba_state.assert_not_called()
+    assert cache.beliefkv_handoff_last_victims == []
