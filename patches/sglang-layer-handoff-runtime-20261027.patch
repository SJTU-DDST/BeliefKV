diff --git a/python/sglang/srt/mem_cache/l2_transfer.py b/python/sglang/srt/mem_cache/l2_transfer.py
index 821c196..b19dbf3 100644
--- a/python/sglang/srt/mem_cache/l2_transfer.py
+++ b/python/sglang/srt/mem_cache/l2_transfer.py
@@ -46,6 +46,13 @@ class TransferCompletion(NamedTuple):
     timing_enabled: bool
 
 
+class LayerHandoffCompletion(NamedTuple):
+    donor: TransferCompletion
+    consumer: TransferCompletion
+    donor_layer_done: tuple[Any, ...]
+    consumer_layer_ready: tuple[Any, ...]
+
+
 class L2TransferEngine:
     """Runs resolved device↔host transfers without owning cache state."""
 
@@ -113,6 +120,97 @@ class L2TransferEngine:
             self._record_stream(transfers, self.host_to_device_stream)
         return TransferCompletion(ack_start, ack_finish, timing_enabled)
 
+    def submit_layer_handoff(
+        self,
+        donor: L2Transfer,
+        consumer: L2Transfer,
+        *,
+        layer_num: int,
+        donor_last_use_event,
+    ) -> LayerHandoffCompletion:
+        """Copy A out and B into the same reserved Device extent or its prefix.
+
+        The caller owns cache publication, logical admission and the reservation
+        for the entire operation. No slot becomes free here. A consumer may read
+        a layer only after its consumer_layer_ready event.
+        """
+        if (
+            type(layer_num) is not int
+            or layer_num <= 0
+            or donor_last_use_event is None
+            or donor.device_pool is not consumer.device_pool
+            or len(donor.device_indices) == 0
+            or len(consumer.device_indices) == 0
+            or len(consumer.device_indices) > len(donor.device_indices)
+            or len(donor.host_indices) != len(donor.device_indices)
+            or len(consumer.host_indices) != len(consumer.device_indices)
+            or donor.layer_mapper is not None
+            or consumer.layer_mapper is not None
+            or donor.is_draft
+            or consumer.is_draft
+        ):
+            raise ValueError("invalid exclusive layer handoff extent")
+        if donor.device_indices is not consumer.device_indices and not (
+            donor.device_indices.ndim == consumer.device_indices.ndim == 1
+            and donor.device_indices.is_contiguous()
+            and consumer.device_indices.is_contiguous()
+            and donor.device_indices.dtype == consumer.device_indices.dtype
+            and donor.device_indices.device == consumer.device_indices.device
+            and donor.device_indices.data_ptr() == consumer.device_indices.data_ptr()
+        ):
+            raise ValueError("consumer indices must be a view of the donor extent")
+        for transfer in (donor, consumer):
+            supported = getattr(transfer.host_pool, "supports_layer_handoff", None)
+            if (
+                not callable(supported)
+                or not supported(transfer.device_pool, self.io_backend)
+                or transfer.host_pool.layer_num != layer_num
+            ):
+                raise NotImplementedError("unsupported layer handoff pool")
+        if donor.host_pool is consumer.host_pool and donor.host_indices is consumer.host_indices:
+            raise ValueError("donor backup cannot overwrite the consumer Host source")
+        donor_done = tuple(device_module.Event() for _ in range(layer_num))
+        consumer_ready = tuple(device_module.Event() for _ in range(layer_num))
