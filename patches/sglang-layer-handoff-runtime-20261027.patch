diff --git a/python/sglang/srt/mem_cache/beliefkv_layer_handoff.py b/python/sglang/srt/mem_cache/beliefkv_layer_handoff.py
new file mode 100644
index 0000000..add5cf4
--- /dev/null
+++ b/python/sglang/srt/mem_cache/beliefkv_layer_handoff.py
@@ -0,0 +1,308 @@
+"""Exclusive FULL-only cache handoff; the caller supplies scheduling authority."""
+
+from dataclasses import dataclass
+import time
+
+import torch
+
+from sglang.srt.managers.cache_controller import HiCacheAck, device_module
+from sglang.srt.mem_cache.hicache_storage import PoolName, PoolTransfer
+from sglang.srt.mem_cache.l2_transfer import L2Transfer
+from sglang.srt.mem_cache.unified_cache.component_type import ComponentType
+
+
+@dataclass
+class LayerHandoff:
+    donor_id: int
+    consumer_id: int
+    donor_host_lock: object
+    reserved_tail: torch.Tensor
+    producer: int
+    completion: object = None
+    donor_finished: bool = False
+
+
+def supported(cache):
+    controller = cache.cache_controller
+    group = getattr(controller, "mem_pool_host", None)
+    anchor = getattr(group, "anchor_entry", None)
+    pool = getattr(anchor, "host_pool", None)
+    supports = getattr(pool, "supports_layer_handoff", None)
+    return bool(
+        cache.enable_session_radix_cache
+        and cache.is_write_back
+        and cache.host_memory_mode == "cache"
+        and cache.buffer_pipeline is None
+        and cache.linker is None
+        and cache.tree_components == (ComponentType.FULL,)
+        and not cache.enable_storage
+        and not getattr(cache, "sidecar_pool_specs", ())
+        and controller is not None
+        and controller.io_backend == "kernel"
+        and controller.load_fence_stream is not None
+        and callable(supports)
+        and supports(anchor.device_pool, controller.io_backend)
+        and controller.layer_num == pool.layer_num
+        and tuple(group.entry_map) == (PoolName.KV,)
+    )
+
+
+def _identity(cache, node_id, created, session_id, generation):
+    if (
+        cache.session_refs._session_generations.get(session_id) != generation
+        or session_id in cache.session_refs._closed_session_ids
+    ):
+        return None
+    try:
+        node = cache.tree_core.node_by_id(node_id)
+    except (KeyError, RuntimeError, ValueError):
+        return None
+    full = node.component_data[ComponentType.FULL]
+    if (
+        node is cache.tree_core.root_node
+        or node.creation_time != created
+        or full.session_ref != 1
+        or full.session_ids not in (None, {session_id})
+        or full.lock_ref
+        or full.host_lock_ref
+        or node.write_through_pending_id is not None
+        or node.load_back_pending_id is not None
+        or node.id in cache.ongoing_write_through
+        or node.id in cache.ongoing_load_back
+    ):
+        return None
+    return node
+
+
+def _paths(cache, donor, consumer, donor_session, donor_generation, consumer_session, consumer_generation):
+    root, tree = cache.tree_core.root_node, cache.tree_core
+    loads, node = [], consumer
+    for _ in range(64):
+        if node is root or node.component_data[ComponentType.FULL].value is not None:
+            break
+        if _identity(cache, node.id, node.creation_time, consumer_session, consumer_generation) is None:
+            return None
+        if node.component_data[ComponentType.FULL].host_value is None:
+            return None
+        loads.append(node)
+        node = node.parent
+    else:
+        return None
+    if not loads:
+        return None
+    needed = sum(len(item.component_data[ComponentType.FULL].host_value) for item in loads)
+    donors, size, node = [], 0, donor
+    for _ in range(64):
+        if node is root:
+            return None
+        if _identity(cache, node.id, node.creation_time, donor_session, donor_generation) is None:
+            return None
+        data = node.component_data[ComponentType.FULL]
+        if (
+            data.value is None or data.host_value is not None
+            or len(node.children) > 64
+            or any(
+                child.component_data[ComponentType.FULL].value is not None
+                and child not in donors
+                for child in node.children.values()
+            )
+        ):
+            return None
+        donors.append(node)
+        size += len(data.value)
+        if size >= needed:
+            return donors, list(reversed(loads)), size, needed
+        node = node.parent
+    return None
+
+
+def begin(
+    cache, *,
+    donor_node_id, donor_creation_time, donor_session_id, donor_session_generation,
+    consumer_node_id, consumer_creation_time, consumer_session_id,
+    consumer_session_generation, reserve_tokens, authorize,
+):
+    """Replace a private donor path with a complete Host-only missing path.
+
+    All logical eligibility is established by the caller before this operation.
+    Refusals allocate no Device slots, evict no peer and launch no transfer.
+    A launch exception is fatal: reservations must not be freed under live DMA.
+    """
+    reap(cache)
+    if (
+        not supported(cache)
+        or getattr(cache, "_beliefkv_layer_handoff", None) is not None
+        or donor_session_id == consumer_session_id
+        or type(reserve_tokens) is not int or reserve_tokens < 0
+        or not callable(authorize)
+    ):
+        return None
+    cc, tree = cache.cache_controller, cache.tree_core
+    if any((
+        cc.write_queue, cc.load_queue, cc.ack_write_queue, cc.ack_load_queue,
+        getattr(cc, "_beliefkv_load_continuation", None),
+    )):
+        return None
+    producer = (cc.layer_done_counter.producer_index + 1) % cc.layer_done_counter.num_counters
+    if not cc.layer_done_counter.events[producer].finish_event.query():
+        return None
+    donor = _identity(
+        cache, donor_node_id, donor_creation_time,
+        donor_session_id, donor_session_generation,
+    )
+    consumer = _identity(
+        cache, consumer_node_id, consumer_creation_time,
+        consumer_session_id, consumer_session_generation,
+    )
+    if donor is None or consumer is None or donor is consumer:
+        return None
+    component = cache.components[ComponentType.FULL]
+    if (
+        donor not in component._session_leaves.get(donor_session_id, ())
+        or consumer not in component._session_leaves.get(consumer_session_id, ())
+    ):
+        return None
+    if donor not in tree.evictable_device_leaves:
+        return None
+    paths = _paths(
+        cache, donor, consumer, donor_session_id, donor_session_generation,
+        consumer_session_id, consumer_session_generation,
+    )
+    if paths is None:
+        return None
+    donors, loads, donor_tokens, consumer_tokens = paths
+    if (
+        cc.mem_pool_device_allocator.available_size() < reserve_tokens
+        or cc.mem_pool_host.available_size() < donor_tokens
+    ):
+        return None
+    kv_xfer, extra = tree.build_load_back_spec(consumer.id)
+    if (
+        extra or kv_xfer.nodes_to_load != [item.id for item in loads]
+        or len(kv_xfer.host_indices) != consumer_tokens
+    ):
+        return None
+    host = cc.mem_pool_host.alloc(donor_tokens)
+    if host is None:
+        return None
+    if not authorize(donor_tokens, consumer_tokens):
+        cc.mem_pool_host.free(host)
+        return None
+    # The new Host allocation is disjoint from every live Host source by the
+    # native allocator contract. Its lease remains held through the final ACK.
+    extent = torch.cat([
+        item.component_data[ComponentType.FULL].value for item in reversed(donors)
+    ])
+    consumer_extent = extent[:consumer_tokens]
+    tail = extent[consumer_tokens:]
+    anchor = cc.mem_pool_host.anchor_entry
+    donor_indices, extent = cc.move_indices(host, extent)
+    consumer_indices, _ = cc.move_indices(kv_xfer.host_indices, consumer_extent)
+    # Index uploads and the last submitted writer must both precede D2H.
+    writer = device_module.Event()
+    writer.record(cc.load_fence_stream)
+    device_module.current_stream().wait_event(writer)
+    indices_ready = device_module.Event()
+    indices_ready.record()
+
+    offset = 0
+    for item in reversed(donors):
+        size = len(item.component_data[ComponentType.FULL].value)
+        tree.commit_backup(item.id, host[offset:offset + size], {})
+        offset += size
+    donor_host_lock = cache.inc_host_lock_ref(donor.id).to_dec_params()
+    cache._track_write_through_node(donor.id, None, [item.id for item in reversed(donors)])
+    detached_tokens = 0
+    for item in donors:
+        detached = tree.demote(item.id)
+        assert not detached.host_frees
+        # Demotion transfers ownership here, never to the ordinary free pool.
+        detached_tokens += sum(
+            len(part) for parts in detached.device_frees.values() for part in parts
+        )
+        detached.device_frees.clear()
+        detached.host_frees.clear()
+    assert detached_tokens == len(extent)
+    tree.component_protected_size_[ComponentType.FULL] += len(tail)
+    assert tree.beliefkv_handoff_reserved_full_tokens == 0
+    assert tree.beliefkv_handoff_donor_anchor is None
+    tree.beliefkv_handoff_reserved_full_tokens = len(tail)
+    tree.beliefkv_handoff_donor_anchor = donor.id
+    consumer_host_lock = cache.inc_host_lock_ref(consumer.id).to_dec_params()
+    consumer_lock = cache.inc_lock_ref(consumer.id).to_dec_params()
+    cache._apply_cache_actions(tree.commit_load_back(
+        consumer.id, consumer_extent, kv_xfer, {},
+    ))
+    from sglang.srt.mem_cache.unified_radix_cache import _OngoingLoadBack
+
+    cache.ongoing_load_back[consumer.id] = _OngoingLoadBack(
+        consumer.id, consumer_lock, consumer_host_lock,
+    )
+    transaction = LayerHandoff(
+        donor.id, consumer.id, donor_host_lock, tail, producer,
+    )
+    cache._beliefkv_layer_handoff = transaction
+    actual_producer = cc.layer_done_counter.update_producer()
+    assert actual_producer == producer
+    cc.layer_done_counter.events[producer].start_event.record()
+    start_ms, start_mono = time.time() * 1000., time.monotonic()
+    completion = cc.l2_transfer_engine.submit_layer_handoff(
+        L2Transfer(anchor.host_pool, anchor.device_pool, donor_indices, extent),
+        L2Transfer(anchor.host_pool, anchor.device_pool, consumer_indices, consumer_extent),
+        layer_num=cc.layer_num, donor_last_use_event=indices_ready,
+    )
+    transaction.completion = completion
+    event = cc.layer_done_counter.events[producer]
+    event.load_events = list(completion.consumer_layer_ready)
+    event.state_ready_event = None
+    cache._beliefkv_prefetch_consumer_index = producer
+    unit = anchor.host_pool.size_per_token
+    for queue, side, node_id, size in (
+        (cc.ack_write_queue, completion.donor, donor.id, len(extent)),
+        (cc.ack_load_queue, completion.consumer, consumer.id, len(consumer_extent)),
+    ):
+        queue.append(HiCacheAck(
+            start_event=side.start_event, finish_event=side.finish_event,
+            node_ids=[node_id], num_tokens=size, timing_enabled=side.timing_enabled,
+            num_tokens_by_pool={"kv": size}, num_bytes=size * unit,
+            submit_ts_ms=start_ms, submit_mono=start_mono,
+            unacked_bytes_at_submit=0, enqueue_to_submit_ms=0.,
+        ))
+    return {
+        "donor_node_id": donor.id, "consumer_node_id": consumer.id,
+        "donor_tokens": len(extent), "reused_tokens": len(consumer_extent),
+        "reserved_tail_tokens": len(tail), "consumer_index": producer,
+        "donor_nodes": len(donors), "consumer_nodes": len(loads),
+    }
+
+
+def blocks_load(cache, node_id):
+    transaction = getattr(cache, "_beliefkv_layer_handoff", None)
+    if transaction is None or transaction.donor_finished:
+        return False
+    node = cache.tree_core.node_by_id(node_id)
+    while node is not None and node is not cache.tree_core.root_node:
+        if node.write_through_pending_id == transaction.donor_id:
+            return True
+        node = node.parent
+    return False
+
+
+def reap(cache):
+    transaction = getattr(cache, "_beliefkv_layer_handoff", None)
+    if transaction is None:
+        return
+    if not transaction.donor_finished and transaction.donor_id not in cache.ongoing_write_through:
+        cache.dec_host_lock_ref(transaction.donor_id, transaction.donor_host_lock)
+        assert cache.tree_core.beliefkv_handoff_reserved_full_tokens == len(transaction.reserved_tail)
+        cache.tree_core.beliefkv_handoff_reserved_full_tokens = 0
+        cache.tree_core.beliefkv_handoff_donor_anchor = None
+        if len(transaction.reserved_tail):
+            cache.tree_core.component_protected_size_[ComponentType.FULL] -= len(transaction.reserved_tail)
+            cache.cache_controller.evict_device(transaction.reserved_tail)
+        transaction.donor_finished = True
+    if (
+        transaction.donor_finished
+        and transaction.consumer_id not in cache.ongoing_load_back
+    ):
+        cache._beliefkv_layer_handoff = None
