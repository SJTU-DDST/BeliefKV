+    def _can_defer_tool_start_acks(
+        self, available_size_targets: dict[ComponentType, tuple[ComponentType, int]]
+    ) -> bool:
+        """Leave submitted ToolStart writes for the regular HiCache poll."""
+        pending = self.ongoing_write_through
+        if not pending or self.cache_controller.write_queue:
+            return False
+        target = self._beliefkv_tool_start_full_alloc_target(available_size_targets)
+        if (
+            target is None
+            or self._component_available_size(ComponentType.FULL) < target
+        ):
+            return False
+
+        seen: set[NodeId] = set()
+        for ack in self.cache_controller.ack_write_queue:
+            receipts = getattr(ack, "child_receipts", ())
+            if not receipts or len(receipts) != len(ack.node_ids):
+                return False
+            for node_id, receipt in zip(ack.node_ids, receipts):
+                write = pending.get(node_id)
+                command = getattr(receipt, "command_id", None)
+                if (
+                    node_id in seen
+                    or write is None
+                    or write.node_id != node_id
+                    or write.lock_params is None
+                    or getattr(receipt, "node_id", None) != node_id
+                    or type(command) is not str
+                    or not command.startswith("beliefkv-tool-start-")
+                ):
+                    return False
+                try:
+                    node = self.tree_core.node_by_id(node_id)
+                except (KeyError, RuntimeError, ValueError):
+                    return False
+                full = node.component_data[ComponentType.FULL]
+                if (
+                    node.write_through_pending_id != node_id
+                    or full.value is None
+                    or full.lock_ref <= 0
+                ):
+                    return False
+                seen.add(node_id)
+        return len(seen) == len(pending)
