+    )
+    host = object.__new__(mha.MHATokenToKVPoolHost)
+    host.layout, host.can_use_jit, host.mtp_draft_device_pools = layout, True, ()
+    host.device_pool = device
+    host.layer_num = host.target_layer_num = 6
+    host.dtype, host.element_dim = torch.float32, 8
+    host.token_stride_size, host.layout_dim = 32, 192
+    host.k_data_ptrs, host.v_data_ptrs = torch.arange(6) + 300, torch.arange(6) + 400
+    host_indices, device_indices = torch.tensor([7, 9]), torch.tensor([1, 3])
+    with patch.object(mha, "jit_transfer_hicache_all_layer") as fused:
+        host.transfer_handoff_layers(
+            device, host_indices, device_indices, 1, 5, "kernel", load=load,
+        )
+    fused.assert_called_once()
+    args = fused.call_args.kwargs
+    assert torch.equal(args["k_ptr_dst"], (device if load else host).k_data_ptrs[1:5])
+    assert torch.equal(args["v_ptr_src"], (host if load else device).v_data_ptrs[1:5])
+    assert args["indices_dst"] is (device_indices if load else host_indices)
+    assert args["indices_src"] is (host_indices if load else device_indices)
+    assert args["kv_cache_src_stride_bytes"] == (192 if load and layout == "page_first" else 32)
+    assert args["kv_cache_dst_stride_bytes"] == (192 if not load and layout == "page_first" else 32)
+    assert args["element_size"] == 32
