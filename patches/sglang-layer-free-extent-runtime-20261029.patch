+    host.layer_num = host.target_layer_num = 3
+    host.element_dim = 2
+    host.pin_memory = False
+    host.kv_buffer = None
+    storage = torch.zeros((2, 3, 4, 1, 2) if layout == "layer_first" else (2, 4, 3, 1, 2))
+    host.k_data_refs = [storage[0, i] if layout == "layer_first" else storage[0, :, i] for i in range(3)]
+    host.v_data_refs = [storage[1, i] if layout == "layer_first" else storage[1, :, i] for i in range(3)]
+    indices = torch.tensor([1, 3])
