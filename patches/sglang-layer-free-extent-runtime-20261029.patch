+@pytest.mark.parametrize("value", (0, -1, 65, True, 1.5))
+@pytest.mark.parametrize("direction", ("donor_group_layers", "consumer_group_layers"))
+def test_invalid_group_is_refused_before_streams_or_copies(handoff, direction, value):
