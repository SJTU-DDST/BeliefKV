+    )
+    pool.k_buffer = [torch.arange(4.) + 10 * i for i in range(layers)]
+    original = [row.clone() for row in pool.k_buffer]
+    source = [row + 1000 for row in original]
+    host = [torch.zeros(2) for _ in range(layers)]
+    donor.host_pool.layer_num = consumer.host_pool.layer_num = layers
+
+    def copy(_pool, _host, indices, start, end, _backend, *, load):
+        calls.append(("range_h2d" if load else "range_d2h", start, end))
+        for layer in range(start, end):
+            if load:
+                assert torch.equal(host[layer], original[layer][:2])
+                pool.k_buffer[layer][indices] = source[layer][indices]
+            else:
+                host[layer].copy_(pool.k_buffer[layer][indices])
+
+    donor.host_pool.transfer_handoff_layers = consumer.host_pool.transfer_handoff_layers = copy
+    result = engine.submit_layer_handoff(
+        donor, consumer, layer_num=layers, donor_last_use_event=last_use,
