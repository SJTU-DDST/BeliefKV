diff --git a/test/srt/test_replayssm_decode_budget.py b/test/srt/test_replayssm_decode_budget.py
new file mode 100644
index 0000000000000000000000000000000000000000..62935fab04c18e13ff70debba9de1b1459527c29
--- /dev/null
+++ b/test/srt/test_replayssm_decode_budget.py
@@ -0,0 +1,143 @@
+from types import SimpleNamespace as NS
+
+import pytest
+import torch
+
+from sglang.srt.configs.mamba_utils import (
+    KimiLinearCacheParams,
+    KimiLinearStateShape,
+    Mamba2CacheParams,
+    Mamba2StateDType,
+    Mamba2StateShape,
+)
+from sglang.srt.mem_cache import kv_cache_configurator as configurator
+from sglang.srt.mem_cache.memory_pool import MambaPool
+
+
+def params(*, kda=False, temporal=torch.float32):
+    dtype = Mamba2StateDType(conv=torch.bfloat16, temporal=temporal)
+    if kda:
+        shape = KimiLinearStateShape.create(
+            tp_world_size=1, num_heads=4, head_dim=8,
+            num_k_heads=4, head_k_dim=8,
+        )
+        return KimiLinearCacheParams(shape=shape, dtype=dtype, layers=[0, 1])
+    shape = Mamba2StateShape(
+        conv=[(4, 3)], temporal=(4, 8, 8), intermediate_size=0,
+        conv_dim=0, ssm_state_size=0, num_heads=0, head_dim=0,
+        state_size=0, conv_kernel=0, num_k_heads_per_tp=4,
+    )
+    return Mamba2CacheParams(shape=shape, dtype=dtype, layers=[0, 1])
+
+
+def decode_ring_bytes(cache_params, length):
+    pool = MambaPool(
+        size=1, spec_state_size=1, cache_params=cache_params,
+        mamba_layer_ids=cache_params.layers, device="cpu",
+        enable_linear_replayssm=True, linear_replayssm_cache_len=length,
+    )
+    return sum(
+        tensor.numel() * tensor.element_size()
+        for tensor in (
+            pool.mamba_cache.replayssm_d, pool.mamba_cache.replayssm_k,
+            pool.mamba_cache.replayssm_g,
+        )
+    ) // 2
+
+
+def solve(
+    monkeypatch, cache_params, *, enabled, cap=None, kda=False,
+    disabled_radix=False, speculative=False,
+):
+    schedule = NS(
+        max_mamba_cache_size=cap, max_running_requests=48,
+        mamba_full_memory_ratio=1.,
+    )
+    mamba = NS(
+        enable_linear_replayssm=enabled, enable_linear_replayssm_spec=False,
+        linear_replayssm_cache_len=16,
+    )
+    monkeypatch.setattr(configurator, "get_exec", lambda: NS(mamba=mamba))
+    monkeypatch.setattr(configurator, "get_spec", lambda: NS(speculative_num_draft_tokens=3))
+    monkeypatch.setattr(configurator, "get_schedule", lambda: schedule)
+    monkeypatch.setattr(configurator, "get_memory", lambda: NS(disable_radix_cache=disabled_radix))
+
+    def override(source, **values):
+        for key, value in values.items():
+            setattr(schedule, key, value)
+
+    monkeypatch.setattr(configurator, "get_context", lambda: NS(override=override))
+    monkeypatch.setattr(configurator, "kimi_linear_config", lambda model: object() if kda else None)
+    runtime = NS(
+        mambaish_config=NS(mamba2_cache_params=cache_params),
+        ps=NS(pp_size=1, attn_dp_size=1),
+        spec_algorithm=NS(is_none=lambda: not speculative),
+        hybrid_gdn_config=None if kda else object(),
+        model_config=NS(num_hidden_layers=2),
+        _calculate_mamba_ratio=lambda: 2,
+    )
+    budget_gib = .001
+    remaining = configurator.KVCacheConfigurator._handle_max_mamba_cache(runtime, budget_gib)
+    return schedule.max_mamba_cache_size, remaining, budget_gib
+
+
+def test_standard_decode_ring_is_included_in_auto_sizing(monkeypatch):
+    cache_params = params()
+    count, remaining, budget = solve(monkeypatch, cache_params, enabled=True)
+    actual_bytes = (count + 1) * (
+        cache_params.mamba_cache_per_req + decode_ring_bytes(cache_params, 16)
+    )
+    assert actual_bytes <= budget * (1 << 30) / 2
+    assert remaining == pytest.approx(budget - actual_bytes / (1 << 30))
+
+
+@pytest.mark.parametrize("kda", [False, True])
+@pytest.mark.parametrize("temporal", [torch.float32, torch.bfloat16])
+@pytest.mark.parametrize("length", [1, 16])
+def test_decode_ring_layout_bytes_follow_ssm_dtype(kda, temporal, length):
+    cache_params = params(kda=kda, temporal=temporal)
+    assert cache_params.replayssm_decode_ring_bytes_per_req(length) == decode_ring_bytes(
+        cache_params, length,
+    )
+
+
+@pytest.mark.parametrize("enabled", [False, True])
+@pytest.mark.parametrize("kda", [False, True])
+def test_pool_budget_and_remainder_account_for_optional_decode_ring(monkeypatch, enabled, kda):
+    cache_params = params(kda=kda)
+    count, remaining, budget = solve(
+        monkeypatch, cache_params, enabled=enabled, kda=kda,
+    )
+    per_slot = cache_params.mamba_cache_per_req + (
+        decode_ring_bytes(cache_params, 16) if enabled else 0
+    )
+    expected = int((budget * (1 << 30) / 2 - per_slot) // per_slot)
+    assert count == expected
+    assert remaining == pytest.approx(budget - (count + 1) * per_slot / (1 << 30))
+
+
+@pytest.mark.parametrize("disabled_radix", [False, True])
+def test_explicit_or_radix_disabled_slot_counts_still_charge_decode_ring(monkeypatch, disabled_radix):
+    cache_params = params()
+    cap = None if disabled_radix else 3
+    count, remaining, budget = solve(
+        monkeypatch, cache_params, enabled=True, cap=cap,
+        disabled_radix=disabled_radix,
+    )
+    assert count == (48 if disabled_radix else 3)
+    actual = (count + 1) * (
+        cache_params.mamba_cache_per_req + decode_ring_bytes(cache_params, 16)
+    )
+    assert remaining == pytest.approx(budget - actual / (1 << 30))
+
+
+def test_decode_ring_and_legacy_verify_scratch_fit_joint_budget(monkeypatch):
+    cache_params = params()
+    count, remaining, budget = solve(
+        monkeypatch, cache_params, enabled=True, speculative=True,
+    )
+    state_bytes = cache_params.mamba_cache_per_req
+    main = (count + 1) * (state_bytes + decode_ring_bytes(cache_params, 16))
+    intermediate = (min(48, count // 2) + 1) * 3 * state_bytes
+    assert main + intermediate <= budget * (1 << 30) / 2
+    assert remaining == pytest.approx(budget - (main + intermediate) / (1 << 30))
