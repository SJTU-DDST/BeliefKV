     def _num_tokens_by_pool(self, op: CacheOperation) -> dict[str, int]:
         return {PoolName.KV.value: len(op.device_indices)}
 
+    def beliefkv_record_free_page_boundary(self) -> bool:
+        """Fence past writers before a forward can start using other allocated pages."""
+        if not self.beliefkv_free_page_fence_enabled or self.load_fence_stream is None:
+            return False
+        allocator = self.mem_pool_device_allocator
+        generation = allocator.beliefkv_free_generation
+        previous = self._beliefkv_free_page_boundary
+        if previous is not None and previous[:2] == (allocator, generation):
+            return False
+        event = device_module.Event()
+        event.record(stream=self.load_fence_stream)
+        self._beliefkv_free_page_boundary = (allocator, generation, event)
+        counts = self.beliefkv_h2d_fence_counts
+        counts["free_boundary_events"] = counts.get("free_boundary_events", 0) + 1
+        return True
+
+    def _beliefkv_wait_load_fence(self, op) -> None:
+        if self.load_fence_stream is None:
+            return
+        children = getattr(op, "_receipt_ops", (op,))
+        event = getattr(children[0], "_beliefkv_free_page_event", None)
+        if getattr(self, "beliefkv_free_page_fence_enabled", False) and event is not None and all(
+            not child.pool_transfers
+            and getattr(child, "_beliefkv_free_page_event", None) is event
+            for child in children
+        ):
+            self.l2_transfer_engine.host_to_device_stream.wait_event(event)
+            counts = self.beliefkv_h2d_fence_counts
+            counts["free_event_batches"] = counts.get("free_event_batches", 0) + 1
+            return
+        # Newly reclaimed pages may still be written by an in-flight forward.
+        self.l2_transfer_engine.host_to_device_stream.wait_stream(self.load_fence_stream)
+        if getattr(self, "beliefkv_free_page_fence_enabled", False):
+            counts = self.beliefkv_h2d_fence_counts
+            counts["forward_stream_batches"] = counts.get("forward_stream_batches", 0) + 1
+
+    def _beliefkv_bind_free_page_fence(self, op) -> None:
+        boundary = getattr(self, "_beliefkv_free_page_boundary", None)
+        if (
+            getattr(self, "beliefkv_free_page_fence_enabled", False)
+            and not op.pool_transfers
+            and boundary is not None
+            and boundary[0] is self.mem_pool_device_allocator
+            and boundary[1] == self.mem_pool_device_allocator.beliefkv_free_generation
+        ):
+            # Allocations only shrink this free set; any release invalidates its proof.
+            op._beliefkv_free_page_event = boundary[2]
+
     def load(
