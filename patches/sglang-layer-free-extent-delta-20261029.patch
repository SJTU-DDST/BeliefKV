+def test_larger_consumer_combines_donor_prefix_with_explicitly_owned_free_slots(handoff):
+    engine, donor, consumer, last_use, calls, pool, original, source, host = handoff
+    donor = donor._replace(
+        device_indices=consumer.device_indices[:2], host_indices=donor.host_indices[:2],
+    )
+
+    def backup(_pool, _host, indices, layer, _backend):
+        host[layer][:len(indices)].copy_(pool.k_buffer[layer][indices])
+        calls.append(("d2h", layer))
+
+    donor.host_pool.backup_from_device_per_layer = backup
+    result = engine.submit_layer_handoff(
+        donor, consumer, layer_num=3, donor_last_use_event=last_use,
+        additional_consumer_tokens=2,
+    )
+    for layer in range(3):
+        assert torch.equal(host[layer][:2], original[layer][:2])
+        assert torch.count_nonzero(host[layer][2:]) == 0
+        assert torch.equal(pool.k_buffer[layer], source[layer])
+    assert calls.index(("record", result.consumer_layer_ready[0], "h2d")) < calls.index(
+        ("record", result.donor_layer_done[-1], "d2h"),
+    )
+
