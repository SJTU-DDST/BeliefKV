+@pytest.mark.parametrize("donor_size,consumer_size", ((8, 4), (4, 8), (5, 3), (3, 5)))
+def test_independent_groups_restore_a_free_suffix_without_backing_it_up(
+    handoff, donor_size, consumer_size,
+):
+    engine, donor, consumer, last_use, calls, pool, *_ = handoff
+    layers = 17
+    donor = donor._replace(
+        device_indices=consumer.device_indices[:2], host_indices=donor.host_indices[:2],
+    )
+    pool.k_buffer = [torch.arange(4.) + 10 * i for i in range(layers)]
+    original = [row.clone() for row in pool.k_buffer]
+    source = [row + 1000 for row in original]
+    host = [torch.zeros(2) for _ in range(layers)]
+    donor.host_pool.layer_num = consumer.host_pool.layer_num = layers
+
+    def copy(_pool, _host, indices, start, end, _backend, *, load):
+        calls.append(("range_h2d" if load else "range_d2h", start, end))
+        for layer in range(start, end):
+            if load:
+                assert torch.equal(host[layer], original[layer][:2])
+                pool.k_buffer[layer][indices] = source[layer][indices]
+            else:
+                host[layer].copy_(pool.k_buffer[layer][indices])
+
+    donor.host_pool.transfer_handoff_layers = consumer.host_pool.transfer_handoff_layers = copy
+    result = engine.submit_layer_handoff(
+        donor, consumer, layer_num=layers, donor_last_use_event=last_use,
+        donor_group_layers=donor_size, consumer_group_layers=consumer_size,
+        additional_consumer_tokens=2,
+    )
+    assert all(torch.equal(a, b[:2]) for a, b in zip(host, original))
+    assert all(torch.equal(a, b) for a, b in zip(pool.k_buffer, source))
+    assert len(set(result.donor_layer_done)) == (layers + donor_size - 1) // donor_size
+    assert len(set(result.consumer_layer_ready)) == (layers + consumer_size - 1) // consumer_size
+    for start in range(0, layers, consumer_size):
+        end = min(start + consumer_size, layers)
+        wait_index = calls.index(("wait", result.donor_layer_done[end - 1], "h2d"))
+        assert wait_index < calls.index(("range_h2d", start, end))
+        for layer in range(start, end):
+            assert calls.index(("record", result.donor_layer_done[layer], "d2h")) < wait_index
+
+
