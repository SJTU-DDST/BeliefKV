diff --git a/test/srt/test_beliefkv_native_session_close.py b/test/srt/test_beliefkv_native_session_close.py
new file mode 100644
index 0000000..50af98a
--- /dev/null
+++ b/test/srt/test_beliefkv_native_session_close.py
@@ -0,0 +1,219 @@
+"""Explicit session-close GC through the real CPU cache and allocator."""
+
+from array import array
+from types import SimpleNamespace as NS
+from unittest.mock import Mock
+
+import pytest
+
+from sglang.srt.managers.schedule_batch import FINISH_LENGTH
+from sglang.srt.mem_cache.unified_cache.component_type import ComponentType
+from test_beliefkv_terminal_capacity import (
+    cache,
+    hybrid_cache,
+    insert_session,
+    match_length,
+)
+
+
+@pytest.fixture(autouse=True)
+def close_reclaim_mode(request, monkeypatch):
+    monkeypatch.setenv(
+        "SGLANG_NATIVE_SESSION_CLOSE_RECLAIM", getattr(request, "param", "1"),
+    )
+
+
+def poll(cache, *, writes=0, loads=0):
+    cache._drain_async_work = Mock()
+    cache._sync_hicache_ready_counts = Mock(return_value=(writes, loads, (), ()))
+    cache.writing_check = Mock()
+    cache.loading_check = Mock()
+    cache.check_hicache_events()
+
+
+@pytest.mark.parametrize("close_reclaim_mode", ("0",), indirect=True)
+def test_disabled_close_keeps_native_cache_and_does_not_queue_gc(cache):
+    insert_session(cache, [1, 2], "child")
+    before = cache.token_to_kv_pool_allocator.available_size()
+    cache.release_radix_session("child")
+    assert cache.token_to_kv_pool_allocator.available_size() == before
+    assert match_length(cache, [1, 2]) == 2
+    stats = cache.native_session_close_reclaim_stats()
+    assert stats["enabled"] is False
+    assert stats["pending_sessions"] == 0
+    assert stats["counts"]["close_calls"] == 0
+
+
+def test_explicit_close_reclaims_private_suffix_without_return_graph_or_dma(cache):
+    insert_session(cache, [1, 2, 8, 8], "parent")
+    insert_session(cache, [1, 2, 3, 4], "child")
+    before = cache.token_to_kv_pool_allocator.available_size()
+    cache.release_radix_session("child")
+    assert cache.token_to_kv_pool_allocator.available_size() == before + 2
+    assert match_length(cache, [1, 2, 8, 8]) == 4
+    assert match_length(cache, [1, 2, 3, 4]) == 2
+    assert cache.native_session_close_reclaim_stats()["counts"][
+        "freed_device_full_tokens"
+    ] == 2
+    cache._execute_and_commit_kv_backup.assert_not_called()
+
+
+def test_duplicate_and_unknown_close_do_not_reopen_or_double_free(cache):
+    insert_session(cache, [1, 2], "child")
+    cache.release_radix_session("child")
+    before = cache.token_to_kv_pool_allocator.available_size()
+    cache.release_radix_session("child")
+    cache.release_radix_session("unknown")
+    assert cache.token_to_kv_pool_allocator.available_size() == before
+    assert cache.session_refs.current_session_generation("child") is None
+    assert cache.session_refs.current_session_generation("unknown") is None
+    assert cache.native_session_close_reclaim_stats()["counts"][
+        "unknown_or_duplicate_closes"
+    ] == 2
+
+
+@pytest.mark.parametrize("blocked", ("device_lock", "host_lock", "d2h", "h2d"))
+def test_dependencies_delay_gc_until_safe_native_poll(cache, blocked):
+    leaf, _ = insert_session(cache, [3, 4], "child")
+    data = leaf.component_data[ComponentType.FULL]
+    if blocked == "device_lock":
+        receipt = cache.inc_lock_ref(leaf.id).to_dec_params()
+    elif blocked == "host_lock":
+        data.host_lock_ref = 1
+    elif blocked == "d2h":
+        leaf.write_through_pending_id = 7
+    else:
+        leaf.load_back_pending_id = 7
+    before = cache.token_to_kv_pool_allocator.available_size()
+    cache.release_radix_session("child")
+    stats = cache.native_session_close_reclaim_stats()
+    assert stats["pending_sessions"] == 1
+    batches = stats["counts"]["reclaim_batches"]
+    poll(cache)
+    assert cache.native_session_close_reclaim_stats()["counts"]["reclaim_batches"] == batches
+    if blocked == "device_lock":
+        cache.dec_lock_ref(leaf.id, receipt)
+    elif blocked == "host_lock":
+        data.host_lock_ref = 0
+    elif blocked == "d2h":
+        leaf.write_through_pending_id = None
+    else:
+        leaf.load_back_pending_id = None
+    assert cache.token_to_kv_pool_allocator.available_size() == before
+    poll(cache, writes=int(blocked in ("host_lock", "d2h")), loads=int(blocked == "h2d"))
+    assert cache.token_to_kv_pool_allocator.available_size() == before + 2
+    assert cache.native_session_close_reclaim_stats()["pending_sessions"] == 0
+    cache._execute_and_commit_kv_backup.assert_not_called()
+
+
+def test_another_sessions_exact_prefix_reference_survives(cache):
+    leaf, _ = insert_session(cache, [1, 2], "first")
+    insert_session(cache, [1, 2], "second")
+    before = cache.token_to_kv_pool_allocator.available_size()
+    cache.release_radix_session("first")
+    assert cache.token_to_kv_pool_allocator.available_size() == before
+    assert leaf.component_data[ComponentType.FULL].session_ref == 1
+    assert match_length(cache, [1, 2]) == 2
+    cache.release_radix_session("second")
+    assert cache.token_to_kv_pool_allocator.available_size() == before + 2
+
+
+def test_reopened_generation_invalidates_pending_old_retirement(cache):
+    leaf, old = insert_session(cache, [1, 2], "child")
+    receipt = cache.inc_lock_ref(leaf.id).to_dec_params()
+    cache.release_radix_session("child")
+    new = cache.open_radix_session("child")
+    assert new != old
+    insert_session(cache, [1, 2], "child")
+    before = cache.token_to_kv_pool_allocator.available_size()
+    cache.dec_lock_ref(leaf.id, receipt)
+    poll(cache)
+    assert cache.token_to_kv_pool_allocator.available_size() == before
+    assert match_length(cache, [1, 2]) == 2
+    stats = cache.native_session_close_reclaim_stats()
+    assert stats["pending_sessions"] == 0
+    assert stats["counts"]["stale_generations_skipped"] == 1
+    cache.release_radix_session("child")
+    assert cache.token_to_kv_pool_allocator.available_size() == before + 2
+
+
+@pytest.mark.parametrize("cache", (512,), indirect=True)
+def test_large_close_drains_in_bounded_rounds_and_keeps_live_parent(cache):
+    insert_session(cache, [1, 9000, 9000], "parent")
+    for index in range(140):
+        insert_session(cache, [1, 1000 + index], "child")
+    before = cache.token_to_kv_pool_allocator.available_size()
+    cache.release_radix_session("child")
+    assert cache.native_session_close_reclaim_stats()["pending_sessions"] == 1
+    for _ in range(20):
+        old = cache.native_session_close_reclaim_stats()["counts"]["attempted_nodes"]
+        poll(cache)
+        stats = cache.native_session_close_reclaim_stats()
+        assert stats["counts"]["attempted_nodes"] - old <= 4 * 64
+        if not stats["pending_sessions"]:
+            break
+    assert stats["pending_sessions"] == 0
+    assert stats["counts"]["freed_device_full_tokens"] == 140
+    assert cache.token_to_kv_pool_allocator.available_size() == before + 140
+    assert match_length(cache, [1, 9000, 9000]) == 3
+
+
+def test_request_finishing_after_close_is_queued_after_cache_cleanup(cache):
+    generation = cache.ensure_session_generation("child")
+    cache.release_radix_session("child")
+    indices = cache.token_to_kv_pool_allocator.alloc(3)
+    cache.req_to_token_pool.req_to_token[0, :3] = indices
+    request = NS(
+        rid="late", session=None, session_id="child", session_generation=generation,
+        origin_input_ids=array("q", [5, 6]), output_ids=array("q", [7]),
+        last_node=None, extra_key=None, cache_salt=None, kv_rotation_base=0,
+        swa_prefix_lock_released=False, finished_reason=FINISH_LENGTH(1),
+        kv=NS(req_pool_idx=0, cache_protected_len=0, swa_evicted_seqlen=0),
+    )
+    before = cache.token_to_kv_pool_allocator.available_size()
+    cache.cache_finished_req(request, kv_len_to_handle=3)
+    assert match_length(cache, [5, 6, 7]) == 3
+    assert cache.native_session_close_reclaim_stats()["pending_sessions"] == 1
+    assert cache.token_to_kv_pool_allocator.available_size() == before
+    poll(cache)
+    assert cache.token_to_kv_pool_allocator.available_size() == before + 3
+    assert cache.native_session_close_reclaim_stats()["counts"]["late_finished_requests"] == 1
+
+
+def test_closed_request_from_reopened_id_cannot_reclaim_new_generation(cache):
+    old = cache.ensure_session_generation("child")
+    cache.release_radix_session("child")
+    new = cache.open_radix_session("child")
+    leaf, _ = insert_session(cache, [5, 6], "child")
+    cache._observe_native_closed_request(NS(
+        session=None, session_id="child", session_generation=old, last_node=leaf.id,
+    ))
+    assert new != old
+    assert cache.native_session_close_reclaim_stats()["pending_sessions"] == 0
+    assert match_length(cache, [5, 6]) == 2
+
+
+def test_hybrid_close_frees_actual_full_and_mamba_capacity(hybrid_cache):
+    cache, full, request_pool = hybrid_cache
+    insert_session(cache, [1, 2, 8, 8], "parent")
+    insert_session(cache, [1, 2, 3, 4], "child")
+    before_full = full.available_size()
+    before_state = request_pool.mamba_allocator.available_size()
+    cache.release_radix_session("child")
+    assert full.available_size() == before_full + 2
+    assert request_pool.mamba_allocator.available_size() == before_state + 1
+    assert match_length(cache, [1, 2, 8, 8]) == 4
+    stats = cache.native_session_close_reclaim_stats()
+    assert stats["counts"]["freed_device_full_tokens"] == 2
+    assert stats["counts"]["freed_device_mamba_slots"] == 1
+
+
+def test_reset_discards_pending_provenance_before_tree_ids_are_reused(cache):
+    leaf, _ = insert_session(cache, [1, 2], "child")
+    cache.inc_lock_ref(leaf.id)
+    cache.release_radix_session("child")
+    assert cache.native_session_close_reclaim_stats()["pending_sessions"] == 1
+    cache.reset()
+    stats = cache.native_session_close_reclaim_stats()
+    assert stats["pending_sessions"] == 0
+    assert stats["counts"]["close_calls"] == 0
