+def _write_child_hidden_trace(
+    directory: Path,
+    rid: str,
+    samples: list,
+    finish_ns: int,
+    finish_reason: str,
+) -> None:
+    path = directory / f"{hashlib.sha256(rid.encode()).hexdigest()}.npz"
+    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
+    try:
+        with os.fdopen(fd, "wb") as output:
+            np.savez_compressed(
+                output,
+                rid=np.asarray(rid),
+                token_counts=np.asarray([row[0] for row in samples], dtype=np.int32),
+                arrival_ns=np.asarray([row[1] for row in samples], dtype=np.int64),
+                hidden=np.asarray([row[2] for row in samples], dtype=np.float16).reshape(
+                    -1, 2048
+                ),
+                finish_ns=np.asarray(finish_ns, dtype=np.int64),
+                finish_reason=np.asarray(finish_reason),
+            )
+    except BaseException:
+        path.unlink(missing_ok=True)
+        raise
+
