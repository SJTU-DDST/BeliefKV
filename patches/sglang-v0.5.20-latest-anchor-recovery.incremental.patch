@@ -0,0 +1,82 @@
+"""Deleted latest anchors can follow surviving native session coverage."""
+
+from types import SimpleNamespace as NS
+from unittest.mock import Mock
+
+import pytest
+
+from sglang.srt.mem_cache.unified_cache.component_type import ComponentType
+from sglang.srt.mem_cache.unified_cache.session_ref_tracker import UnifiedSessionRefTracker
+from test_beliefkv_session_anchors import FakeComponent
+
+
+def fixture(*, hybrid=False):
+    types = (ComponentType.FULL, ComponentType.MAMBA) if hybrid else (ComponentType.FULL,)
+    components = [FakeComponent(kind) for kind in types]
+    parent = NS(
+        id=1, creation_time=10, parent=None,
+        component_data={kind: NS(session_ids={"session"}) for kind in types},
+    )
+    # Session indexes contain tree nodes, which have identity hashing.
+    class Leaf:
+        pass
+
+    live = Leaf()
+    live.__dict__.update(parent.__dict__)
+    deleted = Leaf()
+    deleted.id, deleted.creation_time, deleted.parent = 2, 20, live
+    deleted.component_data = {kind: NS(session_ids=None) for kind in types}
+    arena = {1: live}
+    tracker = UnifiedSessionRefTracker(
+        components=components, tree_core=NS(node_by_id=arena.__getitem__),
+        enable_session_radix_cache=True,
+    )
+    generation = tracker.open_radix_session("session")
+    for component in components:
+        component._session_leaves["session"] = {live}
+        component._find_reusable_session_leaf = Mock(return_value=live)
+    tracker._latest_session_leaves["session"] = {int(kind): deleted for kind in types}
+    return tracker, components, arena, live, deleted, generation
+
+
+@pytest.mark.parametrize("hybrid", (False, True))
+def test_deleted_anchor_recedes_and_warm_snapshots_do_not_walk_again(hybrid):
+    tracker, components, _, live, deleted, generation = fixture(hybrid=hybrid)
+    expected = tuple((int(c.component_type), ((live.id, live.creation_time),)) for c in components)
+    assert tracker.snapshot_latest_session_leaf_anchors("session", generation) == expected
+    assert tracker.snapshot_latest_session_leaf_anchors("session", generation) == expected
+    for component in components:
+        component._find_reusable_session_leaf.assert_called_once_with(deleted.parent)
+        assert tracker._latest_session_leaves["session"][int(component.component_type)] is live
+
+
+@pytest.mark.parametrize("invalid", ("generation", "closed", "replacement", "missing_marker", "missing_index", "no_prefix"))
+def test_recovery_preserves_identity_and_session_guards(invalid):
+    tracker, components, arena, live, deleted, generation = fixture()
+    component = components[0]
+    if invalid == "generation":
+        generation += 1
+    elif invalid == "closed":
+        tracker.release_radix_session("session")
+    elif invalid == "replacement":
+        arena[deleted.id] = object()
+    elif invalid == "missing_marker":
+        live.component_data[ComponentType.FULL].session_ids.clear()
+    elif invalid == "missing_index":
+        component._session_leaves["session"].clear()
+    elif invalid == "no_prefix":
+        component._find_reusable_session_leaf.return_value = None
+    assert tracker.snapshot_latest_session_leaf_anchors("session", generation) is None
+    if invalid in ("generation", "closed", "replacement"):
+        component._find_reusable_session_leaf.assert_not_called()
+
+
+def test_partial_hybrid_validation_cannot_publish_an_unvalidated_snapshot():
+    tracker, _, arena, live, deleted, generation = fixture(hybrid=True)
+    wrong = object()
+    other = NS(id=3)
+    tracker._latest_session_leaves["session"][int(ComponentType.MAMBA)] = other
+    arena[3] = wrong
+    assert tracker.snapshot_latest_session_leaf_anchors("session", generation) is None
+    assert tracker._latest_session_leaves["session"][int(ComponentType.FULL)] is deleted
+    assert live is not deleted
