+def _require_mori():
+    if not envs.SGLANG_ENABLE_MORI.get():
+        raise HTTPException(status_code=404, detail="MORI is disabled.")
+
+
+@app.api_route("/mark_program_type", methods=["POST", "PUT"])
+@auth_level(AuthLevel.ADMIN_OPTIONAL)
+async def mark_program_type(program_id: str = Query(...), program_type: str = Query(...)):
+    _require_mori()
+    ret = await _global_state.tokenizer_manager.mark_program_type(
+        MarkProgramTypeReqInput(program_id=program_id, program_type=program_type)
+    )
+    return ORJSONResponse({"success": ret.success, "message": ret.message})
+
+
+@app.api_route("/release_program", methods=["POST", "PUT"])
+@auth_level(AuthLevel.ADMIN_OPTIONAL)
+async def release_program(program_id: str = Query(...)):
+    _require_mori()
+    ret = await _global_state.tokenizer_manager.release_program(
+        ReleaseProgramReqInput(program_id=program_id)
+    )
+    return ORJSONResponse({"success": ret.success, "message": ret.message})
+
+
+@app.api_route("/batch_program_ops", methods=["POST", "PUT"])
+@auth_level(AuthLevel.ADMIN_OPTIONAL)
+async def batch_program_ops(request: Request):
+    _require_mori()
+    body = await request.json()
+    marks = [(m["program_id"], m["program_type"]) for m in body.get("marks", []) or []]
+    releases = list(body.get("releases", []) or [])
+    if not marks and not releases:
+        return ORJSONResponse({"success": True, "message": "no-op"})
+    ret = await _global_state.tokenizer_manager.batch_program_ops(
+        BatchProgramOpsReqInput(marks=marks, releases=releases)
+    )
+    return ORJSONResponse({"success": ret.success, "message": ret.message})
+
+
