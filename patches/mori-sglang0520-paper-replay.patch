index 0000000..fb2ec52
--- /dev/null
+++ b/python/sglang/srt/mem_cache/mori.py
@@ -0,0 +1,97 @@
+"""MORI's program metadata and eviction keys (author release b4f6a1d)."""
+
+from __future__ import annotations
+
+from enum import IntEnum
+from typing import TYPE_CHECKING, Optional
+
+if TYPE_CHECKING:
+    from sglang.srt.mem_cache.evict_policy import EvictionStrategy
+    from sglang.srt.mem_cache.radix_cache import TreeNode
+
+
+class ProgramType(IntEnum):
+    INACTIVE = 0
+    ASYNC = 1
+    INTERACTIVE = 2
+    SHARED = 3
+
+
+SHARED_PROGRAM_ID = "__sglang_shared__"
+
+_GPU_EVICTION_ORDER = {
+    ProgramType.INACTIVE: 0,
+    ProgramType.ASYNC: 1,
+    ProgramType.INTERACTIVE: 2,
+    ProgramType.SHARED: 3,
+}
+
+_CPU_EVICTION_ORDER = {
+    ProgramType.INACTIVE: 0,
+    ProgramType.INTERACTIVE: 1,
+    ProgramType.ASYNC: 2,
+    ProgramType.SHARED: 3,
+}
+
+PROGRAM_TYPES = {
+    "interactive": ProgramType.INTERACTIVE,
+    "async": ProgramType.ASYNC,
+    "inactive": ProgramType.INACTIVE,
+}
+
+
+class MoriPolicy:
+    """Program placement state owned by the scheduler's HiRadixCache."""
+
+    def __init__(self, base_strategy: EvictionStrategy):
+        self._base = base_strategy
+        self.program_types: dict[str, ProgramType] = {}
+        self.pass_epoch = 0
+        self.load_sources: dict[int, list[TreeNode]] = {}
+        self.host_tokens_freed_on_h2d_ack = 0
+
+    def get_program_type(self, program_id: Optional[str]) -> ProgramType:
+        if program_id == SHARED_PROGRAM_ID:
+            return ProgramType.SHARED
+        return self.program_types.get(program_id, ProgramType.INACTIVE)
+
+    def mark_program_type(self, program_id: str, program_type: ProgramType) -> None:
+        self.program_types[program_id] = program_type
+
+    def release_program(self, program_id: str) -> None:
+        self.program_types.pop(program_id, None)
+
+    def stamp_program_metadata(
+        self, node: TreeNode, root: TreeNode, program_id: str
+    ) -> None:
+        self.program_types.setdefault(program_id, ProgramType.INTERACTIVE)
+        while node is not root:
+            owner = getattr(node, "program_id", None)
+            if owner is None:
+                node.program_id = program_id
+            elif owner != program_id and owner != SHARED_PROGRAM_ID:
+                node.program_id = (
+                    SHARED_PROGRAM_ID if owner in self.program_types else program_id
+                )
+            node = node.parent
+
+    def gpu_priority(self, node: TreeNode) -> tuple:
+        base = self._base.get_priority(node)
+        program_type = self.get_program_type(getattr(node, "program_id", None))
+        return (_GPU_EVICTION_ORDER[program_type],) + (
+            base if isinstance(base, tuple) else (base,)
+        )
+
+    def host_priority(self, node: TreeNode) -> tuple:
+        base = self._base.get_priority(node)
+        if not isinstance(base, tuple):
+            base = (base,)
+        program_type = self.get_program_type(getattr(node, "program_id", None))
+        type_key = _CPU_EVICTION_ORDER[program_type]
+        if not self.program_types:
+            return (0, type_key, 0) + base
+        if program_type == ProgramType.INTERACTIVE and node.evicted:
+            type_key = _CPU_EVICTION_ORDER[ProgramType.ASYNC] + 0.5
+        need = int(getattr(node, "load_need_epoch", -1) == self.pass_epoch)
+        written = int(getattr(node, "write_back_epoch", -1) == self.pass_epoch)
+        return (need, type_key, written) + base
