+++ b/python/sglang/srt/mem_cache/unified_cache/components/full.py
@@ -289,6 +289,97 @@ class FullComponent(TreeComponent):
         # The next native step must consider the last demoted node's parent.
         self._evict_device_last_node = self.tree_core.node_by_id(last_node_id)
 
+    def plan_write_back_frontier(
+        self, node_id: NodeId, full_tokens: int, max_nodes: int
+    ) -> tuple[NodeId, ...]:
+        """Merge native heap victims and newly exposed parents without mutation."""
+        if full_tokens <= 0 or max_nodes <= 1:
+            return ()
+        tree = self.tree_core
+        node = tree.node_by_id(node_id)
+        if (
+            node is not self._evict_device_last_node
+            or node not in tree.evictable_device_leaves
+        ):
+            return ()
+
+        # Traverse only the needed head of the existing binary heap. Copying
+        # the entire heap for every short restore would add another O(N) scan.
+        heap = self._evict_device_heap
+        frontier = [(*heap[0], 0)] if heap else []
+        planned, virtual_parents, nodes = set(), set(), []
+        tokens = 0
+        while node is not None and len(nodes) < max_nodes:
+            cd = node.component_data[self.component_type]
+            if (
+                node is tree.root_node or cd.value is None or not len(cd.value)
+                or node.backuped
+                or node.write_through_pending_id is not None
+                or node.load_back_pending_id is not None
+                or any(data.lock_ref or data.host_lock_ref for data in node.component_data)
+                or any(
+                    child.component_data[self.component_type].value is not None
+                    and child.id not in planned
+                    for child in node.children.values()
+                )
+            ):
+                break
+            planned.add(node.id)
+            nodes.append(node.id)
+            tokens += len(cd.value)
+            if tokens >= full_tokens or len(nodes) >= max_nodes:
+                break
+
+            parent = node.parent
+            if (
+                parent is not None and parent is not tree.root_node
+                and parent.id not in virtual_parents
+                and parent.component_data[self.component_type].value is not None
+                and not any(
+                    child.component_data[self.component_type].value is not None
+                    and child.id not in planned
+                    for child in parent.children.values()
+                )
+            ):
+                virtual_parents.add(parent.id)
+                heapq.heappush(
+                    frontier, (self.session_ref_eviction_strategy(parent), parent, -1)
+                )
+            node = None
+            while frontier:
+                _, candidate, index = heapq.heappop(frontier)
+                if index >= 0:
+                    for child_index in (2 * index + 1, 2 * index + 2):
+                        if child_index < len(heap):
+                            heapq.heappush(
+                                frontier, (*heap[child_index], child_index)
+                            )
+                if candidate.id not in planned and (
+                    candidate in tree.evictable_device_leaves
+                    or candidate.id in virtual_parents
+                ):
+                    node = candidate
+                    break
+        return tuple(nodes)
+
+    def finish_write_back_frontier(self, node_ids: tuple[NodeId, ...]) -> None:
+        """Expose parents from every completed branch to the native heap."""
+        tree = self.tree_core
+        last = tree.node_by_id(node_ids[-1])
+        parents = {}
+        for node_id in node_ids:
+            parent = tree.node_by_id(node_id).parent
+            if parent is not None and parent is not last.parent:
+                parents[parent.id] = parent
+        for parent in parents.values():
+            if parent in tree.evictable_device_leaves:
+                heapq.heappush(
+                    self._evict_device_heap,
+                    (self.session_ref_eviction_strategy(parent), parent),
+                )
+        # The regular next-node step inserts this final parent itself.
+        self._evict_device_last_node = last
+
     def drive_host_eviction(
         self,
         num_tokens: int,
