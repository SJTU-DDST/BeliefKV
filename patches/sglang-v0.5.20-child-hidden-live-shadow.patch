+def _send_child_hidden_live(sock, path, rid, tokens, sent_ns, hidden):
+    """Drop on a full or absent local socket; never stall model streaming."""
+    try:
+        identity = rid.encode("ascii")
+        if len(identity) > 64:
+            return False
+        vector = np.asarray(hidden, dtype="<f2")
+        if vector.shape != (2048,) or not np.isfinite(vector).all():
+            return False
+        payload = (
+            struct.pack(
+                "!4sB64sIQ", b"BKVH", 1, identity, tokens, sent_ns
+            )
+            + vector.tobytes()
+        )
+        return sock.sendto(payload, path) == len(payload)
+    except (OSError, ValueError, UnicodeError):
+        return False
+
