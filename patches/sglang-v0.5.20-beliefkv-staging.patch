+            session_id, session_generation, max_leaves=8,
+        )
+        if anchors is None:
+            return {**result, "reason": "unpublished_session"}
+        leaves = dict(anchors).get(BASE_COMPONENT_TYPE, ())
+        if not leaves:
+            return {**result, "reason": "unpublished_session"}
+        candidates, visited = [], set()
+        for node_id, created in leaves:
+            try:
+                node = self.tree_core.node_by_id(node_id)
+            except (KeyError, RuntimeError, ValueError):
+                return {**result, "reason": "changed_path"}
+            if node.creation_time != created:
+                return {**result, "reason": "changed_path"}
+            chain = set()
+            while node is not self.tree_core.root_node:
+                if node is None or node.id in chain:
+                    return {**result, "reason": "changed_path"}
+                if node.id in visited:
+                    break
+                chain.add(node.id)
+                visited.add(node.id)
+                try:
+                    live = self.tree_core.node_by_id(node.id) is node
+                except (KeyError, RuntimeError, ValueError):
+                    live = False
+                if not live:
+                    return {**result, "reason": "changed_path"}
+                result["scanned_nodes"] += 1
+                full = node.component_data[BASE_COMPONENT_TYPE]
+                if (
+                    full.value is not None and full.host_value is not None
+                    and len(full.value) != len(full.host_value)
+                ):
+                    return {**result, "reason": "host_extent_mismatch"}
+                if (
+                    node.write_through_pending_id is not None
+                    or node.load_back_pending_id is not None
+                    or node.id in self.ongoing_write_through
+                ):
+                    result["pending_nodes"] += 1
+                if full.value is not None and full.host_value is None:
+                    units = len(full.value)
+                    result["unbacked_full_tokens"] += units
+                    if units:
+                        candidates.append((node.id, node.creation_time, units))
+                node = node.parent
