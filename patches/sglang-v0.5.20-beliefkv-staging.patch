+"""Delegator FULL copies use native paths, locks and ACKs on a real CPU tree."""
+
+from types import SimpleNamespace as NS
+
+import pytest
+
+from sglang.srt.mem_cache.unified_cache.component_type import ComponentType as CT
+from test_beliefkv_cold_full_prepare import (
+    fixture, install_cpu_enqueue, install_production_cpu_controller,
+)
+from test_beliefkv_terminal_capacity import hybrid_cache, insert_session
+
+
+def live_fixture(hybrid_cache):
+    cache, allocator, request_pool, parent, leaf, _ = fixture(hybrid_cache)
+    leaf, generation = insert_session(cache, [1, 2, 3, 4, 5, 6], "delegator")
+    locks = install_cpu_enqueue(cache)
+    return cache, allocator, request_pool, parent, leaf, generation, locks
+
+
+def acknowledge(cache, node, locks):
+    cache.tree_core.finish_write_through([node.id], node.id)
+    del cache.ongoing_write_through[node.id]
+    cache.dec_lock_ref(node.id, locks[node.id])
+
+
+@pytest.mark.parametrize("shared", (False, True))
+def test_spawn_backups_keep_existing_prefix_host_and_live_device_state(hybrid_cache, shared):
