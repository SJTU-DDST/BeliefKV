+def test_cold_reclaim_scans_past_ineligible_nodes_within_transaction_bound(
+    hybrid_cache, blocked, scan_bound,
+):
+    cache, allocator, request_pool = hybrid_cache
+    sessions = {}
+    for index in range(9):
+        session_id = f"checkpoint-{index}"
+        node, _ = insert_session(cache, [100 + index, 1000 + index], session_id)
+        sessions[node.id] = session_id
+    ordered = list(cache.tree_core.evictable_device_leaves)
+    assert len(ordered) == 9
+    victim = ordered[-1]
+    for node in ordered:
+        ineligible = node is not victim
+        if not (ineligible and blocked == "referenced"):
+            cache.release_radix_session(sessions[node.id])
+        data = node.component_data[ComponentType.FULL]
+        if not (ineligible and blocked == "unbacked"):
+            data.host_value = data.value.clone()
+        state = node.component_data[ComponentType.MAMBA]
+        state.host_value = state.value.clone()
+        if ineligible and blocked == "pending":
+            node.load_back_pending_id = node.id
+        cache.tree_core._update_duplicate_tracking(node)
+    saved_values = [
+        (node, tuple((data.value, data.host_value) for data in node.component_data))
+        for node in ordered[:-1]
+    ]
+    full_available = allocator.available_size()
+    mamba_available = request_pool.mamba_allocator.available_size()
+    cache.is_write_back = True
+    cache.beliefkv_join_pressure_candidates = ()
+    cache.beliefkv_join_pressure_validator = lambda *_: False
+    # Exercise the legacy cursor independently of the indexed candidate path.
+    cache._beliefkv_handoff_full_scan = deque(ordered)
+
+    result = cache.reclaim_beliefkv_handoff_capacity(
+        full_tokens=full_available + 2,
+        mamba_slots=0,
+        max_nodes=scan_bound,
+    )
+
+    freed = 2 if scan_bound == 9 else 0
+    assert result.get(int(ComponentType.FULL), 0) == freed
+    assert allocator.available_size() == full_available + freed
+    assert request_pool.mamba_allocator.available_size() == mamba_available + (
+        1 if scan_bound == 9 else 0
+    )
+    assert (victim.component_data[ComponentType.FULL].value is None) == (scan_bound == 9)
+    for node, values in saved_values:
+        for data, (device_value, host_value) in zip(node.component_data, values):
+            assert data.value is device_value and data.host_value is host_value
+    cache._execute_and_commit_kv_backup.assert_not_called()
