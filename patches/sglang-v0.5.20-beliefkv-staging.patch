+    )
+    assert first is not None
+    prefix = cache.tree_core.node_by_id(first[0])
+    cache.tree_core._unevict_node_on_insert(prefix, allocator.alloc(2))
+    values = prefix.component_data[ComponentType.FULL].value
+    lock = cache.tree_core.inc_lock_ref(prefix.id).to_dec_params()
+    refs = prefix.component_data[ComponentType.FULL].lock_ref
+    before = allocator.available_size()
+    mamba_before = request_pool.mamba_allocator.available_size()
+    try:
+        second = cache.split_beliefkv_prefetch_full_prefix(
+            session_id="waiting-parent", session_generation=generation,
+            leaf_node_id=leaf.id, leaf_creation_time=float(leaf.creation_time),
+            node_id=leaf.id, node_creation_time=float(leaf.creation_time), prefix_tokens=2,
+        )
+        assert second is not None
+        middle = cache.tree_core.node_by_id(second[0])
+        assert leaf.parent is middle and middle.parent is prefix
+        assert prefix.component_data[ComponentType.FULL].value is values
+        assert prefix.component_data[ComponentType.FULL].lock_ref == refs
+        assert allocator.available_size() == before
+        assert request_pool.mamba_allocator.available_size() == mamba_before
+        assert torch.equal(torch.cat((
+            prefix.component_data[ComponentType.FULL].host_value,
+            middle.component_data[ComponentType.FULL].host_value,
+            leaf.component_data[ComponentType.FULL].host_value,
+        )), host_indices)
+        assert match_length(cache, tokens) == 0
+        cache.tree_core._unevict_node_on_insert(middle, allocator.alloc(2))
+        assert match_length(cache, tokens) == 0
+        cache.tree_core._unevict_node_on_insert(leaf, allocator.alloc(4))
+        assert match_length(cache, tokens) == 8
+        assert leaf.component_data[ComponentType.MAMBA].value is state
+        cache._execute_and_commit_kv_backup.assert_not_called()
+    finally:
+        cache.tree_core.dec_lock_ref(prefix.id, lock)
