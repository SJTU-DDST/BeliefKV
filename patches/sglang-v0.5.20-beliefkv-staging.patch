+        self.assertEqual(events, [])
+        cache.buffer_pipeline.finish_backup_ack.assert_called_once_with(5)
+        cache.buffer_pipeline.try_finish_load_back.assert_called_once_with(6)
+        cache.tree_core.finish_write_through.assert_not_called()
+        cache.tree_core.finish_load_back.assert_not_called()
+
+    def test_mixed_load_ack_does_not_attribute_pool_totals_to_subset(self):
+        cache = cache_fixture()
+        events = []
+        cache.on_hicache_transfer_commit = events.append
+        cache.buffer_pipeline = SimpleNamespace(
+            try_finish_load_back=Mock(side_effect=[True, False])
+        )
+        cache.ongoing_load_back = {8: (8, "device_lock", "host_lock")}
