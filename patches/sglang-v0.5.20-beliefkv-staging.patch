@@ -0,0 +1,148 @@
+"""Discover waiting FULL owners without treating session references as GPU locks."""
+
+from types import SimpleNamespace as NS
+from unittest.mock import Mock
+
+import pytest
+import torch
+
+from sglang.srt.mem_cache.unified_cache.component_type import ComponentType as CT
+from test_beliefkv_cold_full_prepare import install_cpu_enqueue
+from test_beliefkv_terminal_capacity import hybrid_cache, insert_session
+
+
+def fixture(hybrid_cache, *, backed=True):
+    cache, allocator, pool = hybrid_cache
+    leaf, first = insert_session(cache, [1, 2, 3, 4], "waiting-a")
+    other, second = insert_session(cache, [1, 2, 3, 4], "waiting-b")
+    assert leaf is other
+    full = leaf.component_data[CT.FULL]
+    assert full.session_ref == 2
+    assert full.session_ids == {"waiting-a", "waiting-b"}
+    if backed:
+        full.host_value = full.value.clone()
+        cache.tree_core._update_duplicate_tracking(leaf)
+    cache.is_write_back = True
+    cache.host_memory_mode = "cache"
+    cache.beliefkv_join_pressure_candidates = ()
+    cache.beliefkv_join_pressure_validator = lambda *_: False
+    owners = {("waiting-a", first), ("waiting-b", second)}
+    cache.beliefkv_cold_full_owner_validator = Mock(
+        side_effect=lambda observed: set(observed) == owners,
+    )
+    cache.cache_controller = NS(
+        write_queue=[], load_queue=[], ack_write_queue=[], ack_load_queue=[],
+        start_writing=Mock(),
+        mem_pool_host=NS(size_per_token=16 * 1024**2, available_size=lambda: 128),
+    )
+    return cache, allocator, pool, leaf
+
+
+def test_shared_waiting_full_reclaims_without_moving_state_or_releasing_owners(hybrid_cache):
+    cache, allocator, pool, leaf = fixture(hybrid_cache)
+    full, state = leaf.component_data[CT.FULL], leaf.component_data[CT.MAMBA]
+    host, device_state = full.host_value, state.value
+    state_available = pool.mamba_allocator.available_size()
+    available = allocator.available_size()
+
+    result = cache.reclaim_beliefkv_handoff_capacity(
+        full_tokens=available + 4, mamba_slots=0, collect_diagnostics=True,
+    )
+
+    assert result == {int(CT.FULL): 4}
+    assert allocator.available_size() == available + 4
+    assert full.value is None and full.host_value is host
+    assert full.session_ref == 2 and full.session_ids == {"waiting-a", "waiting-b"}
+    assert state.value is device_state and state.host_value is None
+    assert pool.mamba_allocator.available_size() == state_available
+    assert cache.beliefkv_handoff_last_capacity["causal_full_selected"] == 1
+    assert cache.beliefkv_handoff_last_victims[0]["scope"] == "causal_waiting_full"
+    assert cache.beliefkv_cold_full_owner_validator.call_count == 2
+    cache._execute_and_commit_kv_backup.assert_not_called()
+
+
+@pytest.mark.parametrize("blocked", (
+    "owner", "device_lock", "host_lock", "d2h", "h2d", "excluded",
+    "missing_generation", "reference_mismatch",
+))
+def test_new_path_rejects_unknown_active_locked_or_changed_owners(hybrid_cache, blocked):
+    cache, allocator, _, leaf = fixture(hybrid_cache)
+    if blocked == "owner":
+        cache.beliefkv_cold_full_owner_validator.return_value = False
+        cache.beliefkv_cold_full_owner_validator.side_effect = None
+    elif blocked == "device_lock":
+        cache.inc_lock_ref(leaf.id)
+    elif blocked == "host_lock":
+        leaf.component_data[CT.FULL].host_lock_ref = 1
+    elif blocked == "d2h":
+        leaf.write_through_pending_id = leaf.id
+    elif blocked == "h2d":
+        leaf.load_back_pending_id = leaf.id
+    elif blocked == "missing_generation":
+        del cache.session_refs._session_generations["waiting-b"]
+    elif blocked == "reference_mismatch":
+        leaf.component_data[CT.FULL].session_ref = 3
+    before = allocator.available_size()
+    device = leaf.component_data[CT.FULL].value
+    assert cache.reclaim_beliefkv_handoff_capacity(
+        full_tokens=before + 4, mamba_slots=0,
+        exclude_node_ids=(leaf.id,) if blocked == "excluded" else (),
+    ) == {}
+    assert allocator.available_size() == before
+    assert leaf.component_data[CT.FULL].value is device
+    cache._execute_and_commit_kv_backup.assert_not_called()
+
+
+def test_owner_becoming_runnable_after_selection_cannot_lose_full(hybrid_cache):
+    cache, allocator, _, leaf = fixture(hybrid_cache)
