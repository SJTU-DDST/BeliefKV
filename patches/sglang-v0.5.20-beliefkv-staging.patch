+                batch,
+                SimpleNamespace(
+                    forward_mode=SimpleNamespace(is_extend=lambda: False)
+                ),
+            )
+        self.assertFalse(scheduler._beliefkv_retraction_drain_pending)
+
+    def test_tp_disagreement_fails_before_drain(self):
+        scheduler, batch, calls = idle_scheduler(overlap=True)
+        scheduler.ps.tp_size = 2
+        scheduler.tp_group = SimpleNamespace(device="cpu", device_group=object())
+        scheduler.result_queue.append("inflight")
+        scheduler.beliefkv_runtime = SimpleNamespace(
+            scheduler_step=lambda: calls.append("ack"),
+            running_batch_retraction_barrier_required=lambda _: True,
+        )
+
+        class Flag:
+            def __init__(self, value):
+                self.value = value
+
+            def item(self):
+                return self.value
+
+        class Flags:
+            def __init__(self, values):
+                self.values = [Flag(value) for value in values]
+
+            def __getitem__(self, key):
+                return self.values[key]
+
+        reduce_op = SimpleNamespace(MIN="min", MAX="max")
+        torch = SimpleNamespace(
+            int32=object(),
+            tensor=lambda values, **_: Flags(values),
+            distributed=SimpleNamespace(
+                ReduceOp=reduce_op,
+                all_reduce=lambda flags, op, group: setattr(
+                    flags[0], "value", 0 if op == reduce_op.MIN else 1
+                ),
+            ),
+        )
+        with patch.dict(Hook._beliefkv_tp_agree.__globals__, {"torch": torch}):
+            with self.assertRaisesRegex(RuntimeError, "TP ranks disagree"):
+                scheduler.get_next_batch_to_run(
+                    batch,
+                    SimpleNamespace(
+                        forward_mode=SimpleNamespace(is_extend=lambda: False)
+                    ),
+                )
+        self.assertEqual(calls, ["abort", "cache", "ack"])
+
+
+if __name__ == "__main__":
