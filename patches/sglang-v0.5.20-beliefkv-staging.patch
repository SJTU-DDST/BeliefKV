+@pytest.mark.parametrize("cache", (512,), indirect=True)
+@pytest.mark.parametrize("branch_count", (65, 128))
+@pytest.mark.parametrize("close_first", (False, True))
+@pytest.mark.parametrize("shared_parent", (False, True))
+def test_many_terminal_branches_reclaim_every_private_suffix_in_bounded_batches(
+    cache, branch_count, close_first, shared_parent,
+):
+    if shared_parent:
+        insert_session(cache, [1, 2], "parent")
+    for index in range(branch_count):
+        _, generation = insert_session(cache, [1, 100 + index], "child")
+    available = cache.token_to_kv_pool_allocator.available_size()
+    assert cache.session_refs.snapshot_session_leaf_anchors(
+        "child", generation, max_leaves=64,
+    ) is None
+    anchors = cache.session_refs.snapshot_session_leaf_anchors(
+        "child", generation, max_leaves=None,
+    )
+    assert len(anchors[0][1]) == branch_count
+    if close_first:
+        cache.release_radix_session("child")
+    released, discarded = 0, set()
+    retry = None
+    for _ in range(branch_count + 1):
+        result = cache.retire_beliefkv_child_session(
+            session_id="child", session_generation=generation,
+            retry_anchors=retry, max_nodes=4,
+        )
+        assert result["reason"] is None
+        assert len(result["discarded_nodes"]) <= 4
+        assert discarded.isdisjoint(result["discarded_nodes"])
+        released += result["freed_device_units"].get(0, 0)
+        discarded.update(result["discarded_nodes"])
+        retry = result["retry_anchors"]
+        if not retry:
+            break
+    assert not retry
+    assert released == branch_count + (0 if shared_parent else 1)
+    assert cache.token_to_kv_pool_allocator.available_size() == available + released
+    assert cache.token_to_kv_pool_allocator.available_size() == 512 - (
+        2 if shared_parent else 0
+    )
+    assert match_length(cache, [1, 2]) == (2 if shared_parent else 0)
+    cache._execute_and_commit_kv_backup.assert_not_called()
