+"""CPU equivalence checks for complete-segment matching in reentry inspection."""
+
+import ast
+from array import array
+import ctypes
+from pathlib import Path
+import random
+
+import pytest
+
+
+SOURCE = (
+    Path(__file__).resolve().parents[2]
+    / "python/sglang/srt/mem_cache/radix_cache.py"
+)
+
+
+def radix_key_class():
+    tree = ast.parse(SOURCE.read_text())
+    cls = next(
+        item for item in tree.body
+        if isinstance(item, ast.ClassDef) and item.name == "RadixKey"
+    )
+    module = ast.Module(body=[
+        ast.ImportFrom(
+            module="__future__", names=[ast.alias(name="annotations")], level=0,
+        ),
+        cls,
+    ], type_ignores=[])
+    namespace = {"array": array, "ctypes": ctypes}
+    exec(compile(ast.fix_missing_locations(module), str(SOURCE), "exec"), namespace)
+    return namespace["RadixKey"]
+
+
+RadixKey = radix_key_class()
+
+
+def key(tokens, *, container, **kwargs):
+    return RadixKey(container(tokens), **kwargs)
+
+
+@pytest.mark.parametrize("container", (list, lambda tokens: array("q", tokens)))
+@pytest.mark.parametrize("bigram", (False, True))
+@pytest.mark.parametrize("page_size", (1, 2, 4, 16))
+def test_complete_segment_agrees_with_lcp_for_limits_offsets_and_divergence(
+    container, bigram, page_size,
+):
+    rng = random.Random(73)
+    for _ in range(240):
+        raw = [rng.randrange(20) for _ in range(rng.randrange(36))]
+        offset = rng.randrange(8)
+        right = [99] * offset + raw + [98, 97]
+        if right and rng.randrange(2):
+            right[rng.randrange(len(right))] = 96
+        left_limit = rng.choice((None, 0, 1, len(raw) // 2, len(raw) + 2))
+        right_limit = rng.choice((None, len(right) // 2, len(right) + 2))
+        left = key(raw, container=container, is_bigram=bigram, limit=left_limit)
+        other = key(right, container=container, is_bigram=bigram, limit=right_limit)
+        offset = min(offset, len(other))
+        assert left.is_prefix_at(other, offset, page_size) == (
+            left.match_at(other, offset, page_size) >= len(left)
+        )
+
+
+def test_bigram_segment_requires_its_shared_boundary_token():
+    left = RadixKey([10, 11, 12], is_bigram=True)
+    assert left.is_prefix_at(RadixKey([99, 10, 11, 12, 98], is_bigram=True), 1)
+    assert not left.is_prefix_at(RadixKey([99, 10, 11, 90, 98], is_bigram=True), 1)
+    assert not left.is_prefix_at(RadixKey([99, 10, 11], is_bigram=True), 1)
+    assert not left.is_prefix_at(
+        RadixKey([99, 10, 11, 12, 98], is_bigram=True, limit=3), 1,
+    )
+
+
+def test_empty_logical_bigram_does_not_require_a_raw_boundary_match():
+    left = RadixKey([10], is_bigram=True)
+    other = RadixKey([90], is_bigram=True)
+    assert left.match_at(other, 0) == 0
+    assert left.is_prefix_at(other, 0)
+
+
+def test_page_alignment_applies_to_the_whole_segment():
+    left, other = RadixKey([10, 11, 12]), RadixKey([10, 11, 12, 13])
+    assert left.is_prefix_at(other, 0, 1)
+    assert not left.is_prefix_at(other, 0, 2)
+    assert RadixKey([10, 11]).is_prefix_at(other, 0, 2)
+
+
+@pytest.mark.parametrize("changed", ("namespace", "salt", "bigram", "type"))
+def test_compatibility_errors_are_preserved(changed):
+    left = RadixKey([10, 11], extra_key="agent", cache_salt="salt")
+    other = RadixKey([10, 11, 12], extra_key="agent", cache_salt="salt")
+    if changed == "namespace":
+        other.extra_key = "other"
+    elif changed == "salt":
+        other.cache_salt = "other"
+    elif changed == "bigram":
+        other.is_bigram = True
+    else:
+        other.token_ids = array("q", other.token_ids)
+    exception = AssertionError if changed == "type" else ValueError
+    with pytest.raises(exception):
+        left.match_at(other, 0)
+    with pytest.raises(exception):
+        left.is_prefix_at(other, 0)
+
+
+@pytest.mark.parametrize("offset", (-1, 4))
+def test_invalid_offsets_are_preserved(offset):
+    left, other = RadixKey([10]), RadixKey([10, 11, 12])
+    with pytest.raises(IndexError):
+        left.match_at(other, offset)
+    with pytest.raises(IndexError):
+        left.is_prefix_at(other, offset)
+
+
+def test_nonpositive_pages_keep_the_existing_lcp_behavior():
+    left, other = RadixKey([10, 11]), RadixKey([10, 90])
+    for page_size in (-2, -1):
+        assert left.is_prefix_at(other, 0, page_size) == (
+            left.match_at(other, 0, page_size) >= len(left)
+        )
+    with pytest.raises(ZeroDivisionError):
+        left.is_prefix_at(other, 0, 0)
+
+
+@pytest.mark.parametrize(
+    "container",
+    (list, lambda tokens: array("q", tokens), lambda tokens: array("l", tokens)),
+)
+@pytest.mark.parametrize("bigram", (False, True))
+@pytest.mark.parametrize("mismatch", (None, 0, 2047, 4095, 8191))
+def test_long_segments_keep_exact_prefix_and_limit_semantics(container, bigram, mismatch):
+    raw = list(range(8192))
+    right = [9000] * 17 + raw + [9001]
+    if mismatch is not None:
+        right[17 + mismatch] = 9002
+    for left_limit, right_limit in (
+        (None, None), (4096, None), (4096, 17 + 4096), (None, 17 + 8191),
+    ):
+        left = key(raw, container=container, is_bigram=bigram, limit=left_limit)
+        other = key(right, container=container, is_bigram=bigram, limit=right_limit)
+        for page_size in (1, 16):
+            assert left.is_prefix_at(other, 17, page_size) == (
+                left.match_at(other, 17, page_size) >= len(left)
+            )
+
+
+def test_different_array_formats_keep_numeric_equality():
+    left = RadixKey(array("q", range(4096)))
+    other = RadixKey(array("I", [0, *range(4096)]))
+    assert left.is_prefix_at(other, 1)
+    other.token_ids[-1] = 9000
+    assert not left.is_prefix_at(other, 1)
+
+
+def test_long_comparison_reads_current_buffer_after_growth():
+    left = RadixKey(array("q", range(4096)))
+    other = RadixKey(array("q", [-1, *range(4096)]), limit=4097)
+    assert left.is_prefix_at(other, 1)
+    other.token_ids.extend(range(65536))
+    assert left.is_prefix_at(other, 1)
+    other.token_ids[2049] = -2
+    assert not left.is_prefix_at(other, 1)
+
+
+@pytest.mark.parametrize("container", (list, lambda tokens: array("q", tokens)))
+@pytest.mark.parametrize("bigram", (False, True))
+def test_length_tracks_mutable_storage_and_current_limit(container, bigram):
+    tokens = container([10, 11, 12])
+    current = RadixKey(tokens, is_bigram=bigram, limit=5)
+    for replacement in ([10, 11, 12], list(range(16)), [10], []):
+        tokens[:] = container(replacement)
+        raw = replacement[:5]
+        expected = list(zip(raw, raw[1:])) if bigram else raw
+        assert len(current) == len(expected)
+        assert list(current) == expected
+    current.limit = None
+    tokens.extend(container(range(8)))
+    raw = list(tokens)
+    expected = list(zip(raw, raw[1:])) if bigram else raw
+    assert len(current) == len(expected)
+
+
+@pytest.mark.parametrize("container", (list, lambda tokens: array("q", tokens)))
+@pytest.mark.parametrize("bigram", (False, True))
+@pytest.mark.parametrize("raw_length", (0, 1, 2, 8))
+def test_complete_segment_keeps_empty_and_short_right_boundary_semantics(
+    container, bigram, raw_length,
+):
+    left = key([10, 11], container=container, is_bigram=bigram)
+    for right_limit in (None, 0, 1, raw_length + 2):
+        other = key(
+            [10, 11, 12, 13, 14, 15, 16, 17][:raw_length],
+            container=container, is_bigram=bigram, limit=right_limit,
+        )
+        for offset in range(len(other) + 1):
+            for page_size in (1, 2, 16):
+                assert left.is_prefix_at(other, offset, page_size) == (
+                    left.match_at(other, offset, page_size) >= len(left)
+                )
+
+
+@pytest.mark.parametrize("bad_side", ("left", "right"))
+def test_negative_logical_length_preserves_builtin_length_error(bad_side):
+    left, other = RadixKey([10, 11]), RadixKey([10, 11, 12])
+    (left if bad_side == "left" else other).limit = -1
+    with pytest.raises(ValueError, match="__len__"):
+        left.is_prefix_at(other, 0)
