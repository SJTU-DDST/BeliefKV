+def backed_waiting_chain(hybrid_cache, depth=3):
+    cache, allocator, request_pool = hybrid_cache
+    tokens = list(range(1, depth * 2 + 1))
+    for end in range(2, len(tokens) + 1, 2):
+        leaf, _ = insert_session(cache, tokens[:end], "waiting-parent")
+    chain, node = [], leaf
+    while node is not cache.tree_core.root_node:
+        full = node.component_data[ComponentType.FULL]
+        full.host_value = full.value.clone()
+        chain.append(node)
+        node = node.parent
+    assert len(chain) == depth
+    cache.is_write_back = True
+    cache.host_memory_mode = "cache"
+    cache.cache_controller = NS()
+    cache.beliefkv_join_pressure_candidates_by_component = {
+        int(ComponentType.FULL): ((leaf.id, leaf.creation_time),),
+    }
+    cache.beliefkv_join_pressure_validator = lambda *_: True
+    return cache, allocator, request_pool, chain
+
