+                        name=name,
+                        device_indices=cd.value,
+                        host_indices=None,
+                        indices_from_pool=None,
+                        nodes_to_load=[node_id],
+                    )
+                ]
+        return device, extra
+
+    def commit_backup(node_id, indices, xfers):
+        if len(indices):
+            nodes[node_id].component_data[ComponentType.FULL].host_value = indices
+        for ct, transfers in xfers.items():
+            nodes[node_id].component_data[ct].host_value = transfers[0].host_indices
+
+    def mark_pending(ids, ack_id):
+        for nid in ids:
+            nodes[nid].write_through_pending_id = ack_id
+        return ids
+
+    cache.tree_core = SimpleNamespace(
+        root_node=root,
+        is_write_back=False,
+        node_by_id=Mock(side_effect=nodes.__getitem__),
+        build_backup_spec=Mock(side_effect=backup_spec),
