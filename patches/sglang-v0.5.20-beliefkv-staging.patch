+    def _beliefkv_eos_token_ids(self) -> List[int]:
+        tokenizer = self.tokenizer_manager.tokenizer
+        tokens = ("<|im_end|>", "<|endoftext|>")
+        token_ids = [tokenizer.convert_tokens_to_ids(token) for token in tokens]
+        if any(
+            not isinstance(token_id, int)
+            or tokenizer.convert_ids_to_tokens(token_id) != token
+            for token, token_id in zip(tokens, token_ids)
+        ):
+            raise ValueError("BeliefKV EOS logprobs require both Qwen EOS tokens")
+        return token_ids
+
+    @staticmethod
+    def _attach_beliefkv_eos_logprobs(
+        choice_logprobs: Dict[str, Any],
+        meta_info: Dict[str, Any],
+        start: int,
+        end: int,
+    ) -> None:
+        samples = choice_logprobs["content"]
+        targeted = meta_info.get("output_token_ids_logprobs")
+        if not isinstance(targeted, list):
+            raise ValueError("BeliefKV EOS logprobs missing from sampled output")
+        if len(targeted) == end:
+            targeted = targeted[start:end]
+        if len(targeted) != len(samples):
+            raise ValueError("BeliefKV EOS logprobs are not aligned with output tokens")
+        for sample, candidates in zip(samples, targeted):
+            if not isinstance(candidates, list):
+                continue
+            for value, _, text in candidates:
+                if text not in ("<|im_end|>", "<|endoftext|>"):
+                    continue
+                sample["top_logprobs"].append({
+                    "token": text,
+                    "bytes": list(text.encode("utf-8")),
+                    "logprob": value,
+                })
