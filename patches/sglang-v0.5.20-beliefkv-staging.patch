+"""The optional probe must preserve native load wait semantics."""
+
+import ast
+from pathlib import Path
+from types import SimpleNamespace
+
+
+SOURCE = Path(__file__).resolve().parents[2] / "python/sglang/srt/managers/cache_controller.py"
+
+
+def counter_class():
+    tree = ast.parse(SOURCE.read_text())
+    node = next(item for item in tree.body
+                if isinstance(item, ast.ClassDef) and item.name == "LayerDoneCounter")
+    module = ast.fix_missing_locations(ast.Module(body=[node], type_ignores=[]))
+    namespace = {
+        "LayerLoadingEvent": lambda _: SimpleNamespace(finish_event=SimpleNamespace(query=lambda: True)),
+    }
+    exec(compile(module, str(SOURCE), "exec"), namespace)
+    return namespace["LayerDoneCounter"]
+
+
+def test_optional_probe_preserves_waits_and_reset():
+    counter = counter_class()(2)
+    calls = []
+    counter.events[0].wait = lambda layer: calls.append(("native", layer))
+    counter.wait_until(0)
+    assert calls == []
+    counter.set_consumer(0)
+    counter.wait_until(1)
+    assert calls == [("native", 1)]
+
+    def measured(event, layer, consumer):
+        calls.append(("probe", layer, consumer))
+        event.wait(layer)
+
+    counter.beliefkv_wait_probe = SimpleNamespace(wait=measured)
+    counter.wait_until(0)
+    assert calls[-2:] == [("probe", 0, 0), ("native", 0)]
+    counter.reset()
+    assert counter.beliefkv_wait_probe is None
+    assert counter.consumer_index == -1
+
+
+def test_state_copy_waits_only_its_recorded_dependency_and_legacy_keeps_layer_wait():
+    counter = counter_class()(40)
+    waits = []
+    counter.wait_until_state.__func__.__globals__["device_module"] = SimpleNamespace(
+        current_stream=lambda: SimpleNamespace(wait_event=lambda event: waits.append(event)),
+    )
+    counter.set_consumer(0)
+    counter.events[0].wait = lambda layer: waits.append(layer)
+    counter.wait_until_state(38)
+    assert waits == [38]
+    state = object()
+    counter.events[0].state_ready_event = state
+    counter.wait_until_state(38)
+    assert waits == [38, state]
+    captured = []
+    counter.beliefkv_wait_probe = SimpleNamespace(
+        wait_state=lambda event, layer, consumer: captured.append((event, layer, consumer)),
+    )
+    counter.wait_until_state(38)
+    assert captured == [(state, 38, 0)]
+    assert waits == [38, state]
+
+
+def test_state_layer_probe_preserves_threshold_and_later_model_layer_wait():
+    counter = counter_class()(40)
+    calls = []
+    event = counter.events[0]
+    event.wait = lambda layer: calls.append(("native", layer))
+
+    def measured_state(loading_event, layer, consumer):
+        assert loading_event is event
+        calls.append(("state", layer, consumer))
+        loading_event.wait(layer)
+
+    def measured_layer(loading_event, layer, consumer):
+        assert loading_event is event
+        calls.append(("layer", layer, consumer))
+        loading_event.wait(layer)
+
+    counter.beliefkv_wait_probe = SimpleNamespace(
+        wait_state_layer=measured_state, wait=measured_layer,
+    )
+    counter.wait_until_state(38)
+    assert calls == []
+    counter.set_consumer(0)
+    counter.wait_until_state(38)
+    counter.wait_until(38)
+    assert calls == [
+        ("state", 38, 0), ("native", 38),
+        ("layer", 38, 0), ("native", 38),
+    ]
+
+
+def test_state_layer_probe_remains_compatible_with_legacy_layer_only_probe():
+    counter = counter_class()(40)
+    calls = []
+    counter.events[0].wait = lambda layer: calls.append(("native", layer))
+
+    def measured(event, layer, consumer):
+        calls.append(("layer", layer, consumer))
+        event.wait(layer)
+
+    counter.set_consumer(0)
+    counter.beliefkv_wait_probe = SimpleNamespace(wait=measured)
+    counter.wait_until_state(38)
+    assert calls == [("layer", 38, 0), ("native", 38)]
