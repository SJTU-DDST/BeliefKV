+"""CPU checks of selective state transfer and native session reference release."""
+
+import ast
+from pathlib import Path
+from types import SimpleNamespace as NS
+from unittest.mock import Mock
+
+import torch
+
+from test_beliefkv_shadow_dispatch import ComponentType, Node
+
+
+SOURCE = Path(__file__).resolve().parents[2] / "python/sglang/srt/mem_cache"
+
+
+def methods(path, class_name, names, **namespace):
+    tree = ast.parse(path.read_text())
+    cls = next(node for node in tree.body if isinstance(node, ast.ClassDef)
+               and node.name == class_name)
+    functions = [node for node in cls.body if isinstance(node, ast.FunctionDef)
+                 and node.name in names]
+    module = ast.Module(body=[
+        ast.ImportFrom(module="__future__", names=[ast.alias(name="annotations")], level=0),
+        ast.ClassDef(name="Loaded", bases=[], keywords=[], body=functions, decorator_list=[]),
+    ], type_ignores=[])
+    ast.fix_missing_locations(module)
+    exec(compile(module, str(path), "exec"), namespace)
+    return namespace["Loaded"]
+
+
+def tree_fixture():
+    from test_beliefkv_shadow_dispatch import PoolName
+    phase = NS(BACKUP_HOST="backup_host", LOAD_BACK="load_back")
+    tree_class = methods(
+        SOURCE / "unified_cache/unified_tree_core.py", "UnifiedTreeCore",
+        {"_build_backup_spec", "build_load_back_spec"},
+        ComponentType=ComponentType, BASE_COMPONENT_TYPE=ComponentType.FULL,
+        CacheTransferPhase=phase, PoolName=PoolName, torch=torch,
+    )
+    full_xfer = NS(host_indices=torch.arange(4), nodes_to_load=[11])
+    mamba_xfer = NS(host_indices=torch.arange(1), nodes_to_load=[11])
+    full = NS(component_type=ComponentType.FULL,
+              build_hicache_transfers=Mock(return_value=[full_xfer]))
+    mamba = NS(component_type=ComponentType.MAMBA,
+               build_hicache_transfers=Mock(return_value=[mamba_xfer]))
+    node = NS(id=11, backuped=False, load_back_pending_id=None, component_data={
+        ComponentType.FULL: NS(value=torch.arange(4)),
+        ComponentType.MAMBA: NS(value=torch.arange(1), host_value=None),
+    })
+    tree = tree_class()
+    tree.components = [full, mamba]
+    tree.components_by_type = {ComponentType.FULL: full, ComponentType.MAMBA: mamba}
+    tree.node_by_id = lambda _: node
+    return tree, node, mamba
+
+
+def test_full_only_backup_never_builds_or_commits_historical_state():
+    tree, node, mamba = tree_fixture()
+    full, extra = tree._build_backup_spec(node, include_mamba=False)
+    assert len(full) == 4 and extra == {}
+    mamba.build_hicache_transfers.assert_not_called()
+    assert node.component_data[ComponentType.MAMBA].host_value is None
+
+
+def test_full_only_restore_filters_state_before_controller_allocations():
+    tree, _, mamba = tree_fixture()
+    full, extra = tree.build_load_back_spec(11, include_mamba=False)
+    assert len(full.host_indices) == 4 and extra == {}
+    mamba.build_hicache_transfers.assert_not_called()
+
+
+def test_native_backup_default_keeps_required_state_transfer():
+    tree, node, mamba = tree_fixture()
+    _, extra = tree._build_backup_spec(node)
+    assert set(extra) == {ComponentType.MAMBA}
+    mamba.build_hicache_transfers.assert_called_once()
+
+
+def test_native_demand_default_keeps_required_state_transfer():
+    tree, _, mamba = tree_fixture()
+    _, extra = tree.build_load_back_spec(11)
+    assert set(extra) == {ComponentType.MAMBA}
+    mamba.build_hicache_transfers.assert_called_once()
+
+
+def session_fixture():
+    base = methods(
+        SOURCE / "unified_cache/components/base.py", "TreeComponent",
+        {"_unmark_session_leaf"},
+    )
+    state = methods(
+        SOURCE / "unified_cache/components/mamba.py", "MambaComponent",
+        {"_dec_session_coverage", "retain_latest_session_leaf"},
+    )
+    class Component(state, base):
+        component_type = ComponentType.MAMBA
+    component = Component()
+    component._refresh_session_partition = Mock()
+    old = Node(component_data={
+        ComponentType.MAMBA: NS(session_ids={"s", "shared"}, session_ref=2,
+                               lock_ref=1, host_lock_ref=1,
+                               value=torch.tensor([10]), host_value=torch.tensor([20])),
+    })
+    latest = Node(component_data={
+        ComponentType.MAMBA: NS(session_ids={"s"}, session_ref=1),
+    })
+    component._session_leaves = {"s": {old, latest}, "shared": {old}}
+    return component, old, latest
+
+
+def test_latest_state_releases_only_this_context_not_shared_or_locked_slots():
+    component, old, latest = session_fixture()
+    component.retain_latest_session_leaf("s", latest)
+    assert component._session_leaves == {"s": {latest}, "shared": {old}}
+    data = old.component_data[ComponentType.MAMBA]
+    assert data.session_ref == 1 and data.session_ids == {"shared"}
+    assert data.lock_ref == data.host_lock_ref == 1
+    assert data.value.tolist() == [10] and data.host_value.tolist() == [20]
+
+
+def test_unregistered_new_state_does_not_release_existing_checkpoint():
+    component, old, latest = session_fixture()
+    component.retain_latest_session_leaf("s", Node())
+    assert component._session_leaves["s"] == {old, latest}
