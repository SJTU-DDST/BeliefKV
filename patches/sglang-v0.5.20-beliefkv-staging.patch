index 0000000..5e054d0
--- /dev/null
+++ b/test/srt/test_beliefkv_transfer_receipts.py
@@ -0,0 +1,382 @@
+"""CPU-only coverage for per-operation HiCache transfer receipts."""
+
+import ast
+import unittest
+from pathlib import Path
+from types import SimpleNamespace
+from typing import NamedTuple
+from unittest.mock import Mock, patch
+
+import torch
+
+from sglang.srt.mem_cache.hicache_storage import PoolName, PoolTransfer
+
+
+ROOT = Path(__file__).resolve().parents[2] / "python/sglang/srt"
+
+
+def controller_classes():
+    base_source = ROOT / "managers/cache_controller.py"
+    hybrid_source = ROOT / "mem_cache/hybrid_cache/hybrid_cache_controller.py"
+
+    def selected(source, class_name, methods):
+        tree = ast.parse(source.read_text(encoding="utf-8"))
+        cls = next(
+            node
+            for node in tree.body
+            if isinstance(node, ast.ClassDef) and node.name == class_name
+        )
+        cls.body = [
+            node
+            for node in cls.body
+            if isinstance(node, ast.FunctionDef) and node.name in methods
+        ]
+        return cls
+
+    base_tree = ast.parse(base_source.read_text(encoding="utf-8"))
+    definitions = [
+        next(
+            node
+            for node in base_tree.body
+            if isinstance(node, ast.ClassDef) and node.name == name
+        )
+        for name in ("CacheChildReceipt", "HiCacheAck")
+    ]
+    definitions.insert(
+        0,
+        selected(
+            base_source,
+            "CacheOperation",
+            {"__init__", "_merge_pool_transfers", "merge_ops"},
+        ),
+    )
+    definitions.append(
+        selected(
+            base_source,
+            "HiCacheController",
+            {
+                "write",
+                "start_writing",
+                "_child_receipts",
+                "_transfer_num_bytes",
+                "_num_tokens_by_pool",
+                "load",
+                "start_loading",
+            },
+        )
+    )
+    hybrid = selected(
+        hybrid_source,
+        "HybridCacheController",
+        {"write", "load", "_num_tokens_by_pool", "_transfer_num_bytes"},
+    )
+    hybrid.bases = [ast.Name(id="HiCacheController", ctx=ast.Load())]
+    definitions.append(hybrid)
+    module = ast.Module(
+        body=[
+            ast.ImportFrom(
+                module="__future__",
+                names=[ast.alias(name="annotations")],
+                level=0,
+            ),
+            *definitions,
+        ],
+        type_ignores=[],
+    )
+    ast.fix_missing_locations(module)
+    namespace = {
+        "torch": torch,
+        "PoolName": PoolName,
+        "PoolTransfer": PoolTransfer,
+        "NamedTuple": NamedTuple,
+    }
+    exec(compile(module, str(base_source), "exec"), namespace)
+    namespace["CacheOperation"].counter = 0
+    return (
+        namespace["CacheOperation"],
+        namespace["CacheChildReceipt"],
+        namespace["HiCacheAck"],
+        namespace["HiCacheController"],
+        namespace["HybridCacheController"],
+    )
+
+
+(
+    CacheOperation,
+    CacheChildReceipt,
+    HiCacheAck,
+    HiCacheController,
+    HybridCacheController,
+) = controller_classes()
+
+
+def indices(count):
+    return torch.arange(count, dtype=torch.int64)
+
+
+def controller(cls=HiCacheController):
+    instance = cls.__new__(cls)
+    instance.write_queue = []
+    instance.load_queue = []
+    instance.ack_write_queue = []
+    instance.ack_load_queue = []
+    instance.mem_pool_host = SimpleNamespace(
+        size_per_token=10,
+        alloc=Mock(side_effect=lambda n: indices(n)),
+        free=Mock(),
+    )
+    instance.mem_pool_device_allocator = SimpleNamespace(
+        alloc=Mock(side_effect=lambda n: indices(n)),
+        free=Mock(),
+    )
+    instance._move_write_operation = lambda op: (
+        op.host_indices,
+        op.device_indices,
+        op.pool_transfers,
+    )
+    instance._move_op_indices = instance._move_write_operation
+    instance._l2_transfers = lambda *args: list(args)
+    instance._l2_load_transfers = instance._l2_transfers
+    completion = SimpleNamespace(
+        start_event=object(), finish_event=object(), timing_enabled=False
+    )
+    instance.l2_transfer_engine = SimpleNamespace(
+        submit_device_to_host=Mock(return_value=completion),
+        submit_host_to_device=Mock(return_value=completion),
+    )
+    producer = SimpleNamespace(
+        start_event=SimpleNamespace(record=Mock()), complete=Mock()
+    )
+    instance.layer_done_counter = SimpleNamespace(
+        update_producer=Mock(return_value=0), events=[producer]
+    )
+    instance.load_fence_stream = None
+    instance.layer_num = 1
+    return instance
+
+
+def hybrid_controller():
+    instance = controller(HybridCacheController)
+    anchor = SimpleNamespace(
+        name=PoolName.KV, host_pool=SimpleNamespace(size_per_token=10)
+    )
+    entries = {
+        PoolName.MAMBA: SimpleNamespace(host_pool=SimpleNamespace(size_per_token=5)),
+        PoolName.SWA: SimpleNamespace(host_pool=SimpleNamespace(size_per_token=7)),
+    }
+
+    def resolve_host(transfers, *, primary_device_indices, primary_host_indices):
+        for transfer in transfers or []:
+            if transfer.indices_from_pool is None:
+                transfer.host_indices = indices(len(transfer.device_indices))
+            else:
+                source = next(
+                    (t for t in transfers if t.name == transfer.indices_from_pool),
+                    None,
+                )
+                transfer.host_indices = (
+                    primary_host_indices if source is None else source.host_indices
+                )
+                transfer.device_indices = (
+                    primary_device_indices if source is None else source.device_indices
+                )
+        return transfers
+
+    instance.mem_pool_host.anchor_entry = anchor
+    instance.mem_pool_host.entry_map = entries
+    instance.mem_pool_host.resolve_host_transfers = Mock(side_effect=resolve_host)
+    instance.mem_pool_device_allocator.full_attn_allocator = (
+        instance.mem_pool_device_allocator
+    )
+    instance.device = "cpu"
+    instance._resolve_device_transfers = Mock(
+        side_effect=lambda transfers, **_: transfers
+    )
+    return instance
+
+
+def assert_reconciled(test, ack):
+    totals = {}
+    for receipt in ack.child_receipts:
+        for pool, count in receipt.num_tokens_by_pool:
+            totals[pool] = totals.get(pool, 0) + count
+    test.assertEqual(totals, ack.num_tokens_by_pool)
+    test.assertEqual(sum(r.num_bytes for r in ack.child_receipts), ack.num_bytes)
+
+
+class TransferReceiptTest(unittest.TestCase):
+    def test_two_commands_merge_and_immutable_receipts(self):
+        ctrl = controller()
+        with patch.object(ctrl, "start_writing"):
+            ctrl.write(indices(2), node_id=11, beliefkv_command_id="first")
+            ctrl.write(indices(3), node_id=12, beliefkv_command_id="second")
+        merged = CacheOperation.merge_ops(ctrl.write_queue)
+        self.assertEqual(merged.node_ids, [11, 12])
+        self.assertEqual(merged._receipt_ops, tuple(ctrl.write_queue))
+        self.assertEqual(
+            CacheOperation.merge_ops([merged, ctrl.write_queue[0]])._receipt_ops,
+            tuple(ctrl.write_queue) + (ctrl.write_queue[0],),
+        )
+        HiCacheController.start_writing(ctrl)
+        ack = ctrl.ack_write_queue.pop()
+        self.assertEqual(
+            ack.child_receipts,
+            (
+                CacheChildReceipt("first", 11, (("kv", 2),), 20),
+                CacheChildReceipt("second", 12, (("kv", 3),), 30),
+            ),
+        )
+        with self.assertRaises(AttributeError):
+            ack.child_receipts[0].num_bytes = 0
+        self.assertEqual(ack.node_ids, [11, 12])
+        self.assertEqual(ack.num_tokens, 5)
+        assert_reconciled(self, ack)
+        ctrl.l2_transfer_engine.submit_device_to_host.assert_called_once()
+
+    def test_mixed_tagged_and_native_hybrid_write_with_sidecar_bytes(self):
+        ctrl = hybrid_controller()
+        with patch.object(ctrl, "start_writing"):
+            ctrl.write(
+                indices(2),
+                node_id=3,
+                extra_pools=[
+                    PoolTransfer(name=PoolName.MAMBA, device_indices=indices(1)),
+                    PoolTransfer(name=PoolName.SWA, indices_from_pool=PoolName.MAMBA),
+                ],
+                beliefkv_command_id="tagged",
+            )
+            ctrl.write(indices(1), node_id=4)
+
+        HiCacheController.start_writing(ctrl)
+        ack = ctrl.ack_write_queue.pop()
+        self.assertEqual(
+            ack.child_receipts,
+            (
+                CacheChildReceipt(
+                    "tagged", 3, (("kv", 2), ("mamba", 1)), 32
+                ),
+                CacheChildReceipt(None, 4, (("kv", 1),), 10),
+            ),
+        )
+        assert_reconciled(self, ack)
+
+    def test_mamba_only_load_delays_receipt_until_submit(self):
+        ctrl = hybrid_controller()
+        ctrl.load(
+            indices(0),
+            node_id=21,
+            extra_pools=[
+                PoolTransfer(
+                    name=PoolName.MAMBA,
+                    host_indices=indices(2),
+                    device_indices=indices(2),
+                )
+            ],
+            beliefkv_command_id="mamba-only",
+        )
+        ctrl.load(indices(3), node_id=22)
+        self.assertEqual(ctrl.ack_load_queue, [])
+        ctrl.l2_transfer_engine.submit_host_to_device.assert_not_called()
+        ctrl.mem_pool_device_allocator.alloc.assert_called_once_with(3)
+
+        self.assertEqual(HiCacheController.start_loading(ctrl), 0)
+        ack = ctrl.ack_load_queue.pop()
+        self.assertEqual(
+            ack.child_receipts,
+            (
+                CacheChildReceipt(
+                    "mamba-only", 21, (("kv", 0), ("mamba", 2)), 10
+                ),
+                CacheChildReceipt(None, 22, (("kv", 3),), 30),
+            ),
+        )
+        assert_reconciled(self, ack)
+        self.assertEqual(HiCacheController.start_loading(ctrl), -1)
+
+    def test_failed_allocations_or_resolution_do_not_emit_receipts(self):
+        ctrl = controller()
+        ctrl.mem_pool_host.alloc.return_value = None
+        ctrl.mem_pool_host.alloc.side_effect = None
+        self.assertIsNone(ctrl.write(indices(1), beliefkv_command_id="no-host"))
+        ctrl.mem_pool_device_allocator.alloc.return_value = None
+        ctrl.mem_pool_device_allocator.alloc.side_effect = None
+        self.assertIsNone(ctrl.load(indices(1), beliefkv_command_id="no-device"))
+        self.assertEqual((ctrl.write_queue, ctrl.load_queue), ([], []))
+
+        hybrid = hybrid_controller()
+        hybrid.mem_pool_host.resolve_host_transfers.return_value = None
+        hybrid.mem_pool_host.resolve_host_transfers.side_effect = None
+        self.assertIsNone(
+            hybrid.write(
+                indices(1),
+                extra_pools=[PoolTransfer(name=PoolName.MAMBA)],
+                beliefkv_command_id="unresolved-write",
+            )
+        )
+        hybrid.mem_pool_host.free.assert_called_once()
+        hybrid._resolve_device_transfers.return_value = None
+        hybrid._resolve_device_transfers.side_effect = None
+        self.assertIsNone(
+            hybrid.load(
+                indices(1),
+                extra_pools=[PoolTransfer(name=PoolName.MAMBA)],
+                beliefkv_command_id="unresolved-load",
+            )
+        )
+        hybrid.mem_pool_device_allocator.free.assert_called_once()
+        self.assertEqual((hybrid.write_queue, hybrid.load_queue), ([], []))
+        self.assertEqual((hybrid.ack_write_queue, hybrid.ack_load_queue), ([], []))
+
+    def test_native_batches_emit_no_child_receipts(self):
+        ctrl = controller()
+        with patch.object(ctrl, "start_writing"):
+            ctrl.write(indices(1), node_id=1)
+            ctrl.write(indices(2), node_id=2)
+        HiCacheController.start_writing(ctrl)
+        self.assertEqual(ctrl.ack_write_queue[0].child_receipts, ())
+        ctrl.load(indices(1), node_id=3)
+        ctrl.load(indices(2), node_id=4)
+        self.assertEqual(ctrl.ack_load_queue, [])
+        HiCacheController.start_loading(ctrl)
+        self.assertEqual(ctrl.ack_load_queue[0].child_receipts, ())
+
+    def test_nested_native_merge_then_tagged_operation_keeps_all_children(self):
+        ctrl = controller()
