+        if type(unit) is not int or unit <= 0:
+            return result
+        if controller.mem_pool_host.available_size() <= ceil_align(
+            (64 * 1024**2 + unit - 1) // unit, self.tree_core.page_size,
+        ):
+            return {**result, "reason": "host_capacity"}
