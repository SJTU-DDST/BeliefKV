+    )
+    assert allocator.available_size() == before
+    assert cache.reclaim_beliefkv_handoff_capacity(full_tokens=target, mamba_slots=0) == {}
+    cache.tree_core.finish_write_through([leaf.id], leaf.id)
+    del cache.ongoing_write_through[leaf.id]
+    cache.dec_lock_ref(leaf.id, locks[leaf.id])
+    if returns_early:
