+    def prepare_beliefkv_spawn_full(
+        self, *, session_id: str, session_generation: int,
+        max_batch_bytes: int = 4 * 1024**3,
+    ) -> dict:
+        """Back published FULL on a delegator's path, without pressure or eviction."""
+        result = {
+            "issued": (), "complete": False, "reason": "unsupported_cache",
+            "scanned_nodes": 0, "unbacked_full_tokens": 0, "pending_nodes": 0,
+            "max_batch_bytes": max_batch_bytes, "max_merged_nodes": 64,
+        }
+        if (
+            not self.enable_session_radix_cache or not self.is_write_back
