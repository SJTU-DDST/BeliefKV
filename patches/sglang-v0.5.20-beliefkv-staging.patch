+
+def component(*, value=None, host_value=None, session_ids=None):
+    return SimpleNamespace(
+        value=value, host_value=host_value, session_ids=session_ids or set()
+    )
+
+
+class Node(SimpleNamespace):
+    __hash__ = object.__hash__
+    __eq__ = object.__eq__
+
+
+def node(node_id, parent, *, host=None, device=None):
+    return Node(
+        id=node_id,
+        parent=parent,
+        creation_time=node_id + 100,
+        write_through_pending_id=None,
+        load_back_pending_id=None,
+        component_data={
+            ComponentType.FULL: component(value=device, host_value=host),
+            ComponentType.MAMBA: component(),
+            ComponentType.SWA: component(),
+        },
+    )
+
+
+class HostGroup:
+    def __init__(self, *, kv=8, mamba=8, swa=8):
+        self.free_sizes = {PoolName.KV: kv, PoolName.MAMBA: mamba, PoolName.SWA: swa}
+        self.entry_map = {
+            pool: SimpleNamespace(host_pool=SimpleNamespace(size_per_token=bytes_per_slot))
+            for pool, bytes_per_slot in (
+                (PoolName.KV, 8),
+                (PoolName.MAMBA, 16),
+                (PoolName.SWA, 4),
+                (PoolName.SIDECAR, 3),
+            )
+        }
+        self.anchor_entry = SimpleNamespace(
+            name=PoolName.KV, host_pool=self.entry_map[PoolName.KV].host_pool
+        )
+        self.allocations = []
+        self.releases = []
+
+    def available_size(self, pool=None):
+        return self.free_sizes[pool or PoolName.KV]
+
+    def alloc(self, size, *, pool=None):
+        pool = pool or PoolName.KV
+        if self.free_sizes[pool] < size:
+            return None
+        self.free_sizes[pool] -= size
+        indices = torch.arange(size)
+        self.allocations.append((pool, size))
+        return indices
+
+    def free(self, indices, *, pool=None):
+        pool = pool or PoolName.KV
+        self.free_sizes[pool] += len(indices)
+        self.releases.append((pool, len(indices)))
+
+
+def fixture():
+    cache = ShadowCache()
+    root = node(0, None)
+    parent = node(1, root, host=torch.arange(2), device=torch.arange(2))
+    leaf = node(2, parent, device=torch.arange(2))
+    leaf.component_data[ComponentType.FULL].session_ids.add("s")
+    nodes = {n.id: n for n in (root, parent, leaf)}
+    group = HostGroup()
+    ops = []
+
+    def write(
+        device_indices, *, node_id, extra_pools, beliefkv_command_id,
+        beliefkv_before_enqueue=None, beliefkv_defer_writing=False,
+    ):
+        indices = group.alloc(len(device_indices))
+        if indices is not None:
+            for transfer in extra_pools or ():
+                if transfer.indices_from_pool is not None:
+                    source = next(
+                        (
+                            candidate
+                            for candidate in extra_pools
+                            if candidate.name == transfer.indices_from_pool
+                            and candidate.indices_from_pool is None
+                        ),
+                        None,
+                    )
+                    transfer.host_indices = (
+                        indices
+                        if transfer.indices_from_pool == PoolName.KV
+                        else source.host_indices
+                    )
+            if beliefkv_before_enqueue is not None:
+                op = SimpleNamespace(
+                    beliefkv_command_id=beliefkv_command_id,
+                    node_ids=[node_id],
+                    device_indices=device_indices,
+                    host_indices=indices,
+                    pool_transfers=extra_pools,
+                )
+                if beliefkv_before_enqueue(op) is not True:
+                    group.free(indices)
+                    return None
+            ops.append((node_id, beliefkv_command_id, extra_pools))
+            if not beliefkv_defer_writing:
+                cache.cache_controller.start_writing()
+        return indices
+
+    def backup_spec(node_id, *, include_mamba=True):
+        target = nodes[node_id]
+        full = target.component_data[ComponentType.FULL]
+        device = full.value if full.host_value is None else full.value[:0]
+        extra = {}
+        for ct, name in (
+            (ComponentType.MAMBA, PoolName.MAMBA),
+            (ComponentType.SWA, PoolName.SWA),
+        ):
+            if ct == ComponentType.MAMBA and not include_mamba:
+                continue
+            cd = target.component_data[ct]
+            if cd.value is not None and cd.host_value is None:
+                extra[ct] = [
