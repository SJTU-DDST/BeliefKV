+class ComponentType(IntEnum):
+    FULL = 0
+    SWA = 1
+    MAMBA = 2
+
+
+class Key:
+    def __init__(self, ids, *, extra_key=None, cache_salt=None, limit=None):
+        self.ids = list(ids)[:limit] if limit is not None else list(ids)
+        self.namespace = extra_key, cache_salt
+
+    def __len__(self):
+        return len(self.ids)
+
+    def match_at(self, other, offset, *, page_size):
+        if self.namespace != other.namespace:
+            raise ValueError("namespace changed")
+        count = 0
+        for left, right in zip(self.ids, other.ids[offset:]):
+            if left != right:
+                break
+            count += 1
+        return count // page_size * page_size
+
+    def is_prefix_at(self, other, offset, *, page_size):
+        return self.match_at(other, offset, page_size=page_size) >= len(self)
+
+
+def cache_class():
+    tree = ast.parse(SOURCE.read_text())
+    cache = next(item for item in tree.body if isinstance(item, ast.ClassDef) and item.name == "UnifiedRadixCache")
+    methods = [item for item in cache.body if isinstance(item, ast.FunctionDef) and item.name in {
+        "inspect_beliefkv_reentry", "reclaim_beliefkv_handoff_capacity",
+        "_evict_backed_join_parent",
+        "_evict_device_leaf", "_preserve_mamba_reentry_node",
+        "_prepare_beliefkv_full_demote",
+        "_demote", "_accumulate_tracker",
+    }]
+    module = ast.Module(body=[
+        ast.ImportFrom(module="__future__", names=[ast.alias(name="annotations")], level=0),
+        ast.ClassDef(name="Cache", bases=[], keywords=[], body=methods, decorator_list=[]),
+    ], type_ignores=[])
+    ast.fix_missing_locations(module)
+    namespace = {
+        "RadixKey": Key, "ComponentType": ComponentType, "BASE_COMPONENT_TYPE": 0,
+        "BackupKV": lambda node_ids: NS(node_ids=node_ids),
+    }
+    exec(compile(module, str(SOURCE), "exec"), namespace)
+    return namespace["Cache"]
+
+
+Cache = cache_class()
