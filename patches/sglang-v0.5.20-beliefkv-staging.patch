+def _prompt_tool_definitions(request: ChatCompletionRequest) -> Optional[List[Dict]]:
+    if not request.tools:
+        return None
+    if isinstance(request.tool_choice, str):
+        return [item.model_dump() for item in request.tools]
+    # The first BeliefKV root turn must constrain output to task without changing
+    # the tool definitions embedded in the reusable session prefix.
+    keep_all = (
+        request.beliefkv_metadata is not None
+        and request.tool_choice.function.name == "task"
+    )
+    return [
+        item.model_dump()
+        for item in request.tools
+        if keep_all or item.function.name == request.tool_choice.function.name
+    ] or None
+
+
+def _tool_constraint_spec(request: ChatCompletionRequest, tools: List[Tool]):
+    if (
+        request.beliefkv_metadata is not None
+        and request.parallel_tool_calls
+        and isinstance(request.tool_choice, ToolChoice)
+        and request.tool_choice.function.name == "task"
+    ):
+        # This XGrammar version's named-tool tag permits only one call. Required
+        # over the named subset permits repetition without changing the prompt.
+        return [tool for tool in tools if tool.function.name == "task"], "required"
+    return tools, request.tool_choice
+
+
+def _bounded_task_constraint(request: ChatCompletionRequest, constraint):
+    if request.beliefkv_task_fanout is None:
+        return constraint
+    lower, upper = request.beliefkv_task_fanout
+    if (
+        request.beliefkv_metadata is None
+        or not request.parallel_tool_calls
+        or not isinstance(request.tool_choice, ToolChoice)
+        or request.tool_choice.function.name != "task"
+        or not 1 <= lower <= upper <= 4
+        or constraint is None
+        or constraint[0] != "structural_tag"
+        or constraint[1].format.type != "tags_with_separator"
+        or len(constraint[1].format.tags) != 1
+    ):
+        raise ValueError("BeliefKV task fanout requires a parallel native task tag")
+    from xgrammar.structural_tag import RepeatFormat
+
+    kind, tag = constraint
+    bounded = tag.model_copy(update={
+        "format": RepeatFormat(content=tag.format.tags[0], min=lower, max=upper),
+    })
+    logger.info("BeliefKV task generation fanout=%s..%s", lower, upper)
+    return kind, bounded
+
