+"""Exercise batch fences with the actual CPU radix tree and FULL component."""
+
+from array import array
+from types import SimpleNamespace as NS
+
+import torch
+
+from sglang.srt.mem_cache.base_prefix_cache import MatchPrefixParams
+from sglang.srt.mem_cache.cache_init_params import CacheInitParams
+from sglang.srt.mem_cache.hicache_storage import PoolName, PoolTransfer
+from sglang.srt.mem_cache.radix_cache import RadixKey
+from sglang.srt.mem_cache.unified_cache.components import ComponentType
+from sglang.srt.mem_cache.unified_cache.components.full import FullComponent
+from sglang.srt.mem_cache.unified_cache.unified_tree_core import UnifiedTreeCore
+from sglang.srt.mem_cache.unified_radix_cache import UnifiedRadixCache
+
+
+def fixture(*, write_back=True):
+    params = CacheInitParams(
+        disable=False, req_to_token_pool=None,
+        token_to_kv_pool_allocator=None, page_size=1,
+    )
+    cache = UnifiedRadixCache.__new__(UnifiedRadixCache)
+    cache.enable_session_radix_cache = False
+    cache.linker = cache.buffer_pipeline = None
+    cache.tree_components = (ComponentType.FULL,)
+    component = FullComponent(cache, params)
+    tree = cache.tree_core = UnifiedTreeCore(
+        params, {ComponentType.FULL: component},
+    )
+    tree.is_write_back = write_back
+    cache.ongoing_load_back = {}
+    cache._beliefkv_prefetch_consumer_index = 2
+    cache.cache_controller = NS(
+        write_policy="write_back" if write_back else "write_through",
+        start_loading=lambda: -1,
+        layer_done_counter=NS(events={2: NS(finish_event=NS(query=lambda: False))}),
+    )
+    return cache
+
+
+def load_path(cache, tokens, *, complete=False):
+    tree = cache.tree_core
+    host = torch.arange(len(tokens), dtype=torch.int64)
+    node_id = tree.insert_host(
+        tree.root_node.id, RadixKey(array("q", tokens)),
+        host, [str(token) for token in tokens],
+    ).inserted_host_node
+    transfer = PoolTransfer(
+        name=PoolName.KV, host_indices=host, nodes_to_load=[node_id],
+    )
+    tree.commit_load_back(node_id, host + 100, transfer, {})
+    if complete:
+        tree.finish_load_back(node_id)
+    else:
+        cache.ongoing_load_back[node_id] = object()
+    return node_id
+
+
+def split_prefix(cache, tokens):
+    return cache.tree_core.match_prefix(
+        MatchPrefixParams(key=RadixKey(array("q", tokens))),
+    ).last_device_node
+
+
+def test_resident_native_prefix_runs_while_a_different_path_is_loading():
+    cache = fixture()
+    resident = load_path(cache, [1, 2, 3, 4], complete=True)
+    pending = load_path(cache, [9, 8, 7, 6])
+    node = cache.tree_core.node_by_id(resident)
+    original = node.component_data[ComponentType.FULL].value.clone()
+    assert cache.ready_to_load_host_cache() == 2
+    assert cache.beliefkv_prefill_load_consumer([NS(last_node=resident)], 2) == -1
+    assert pending in cache.ongoing_load_back
+    assert torch.equal(node.component_data[ComponentType.FULL].value, original)
+
+
+def test_native_split_inherits_pending_dependency_until_the_anchor_ack():
+    cache = fixture()
+    anchor = load_path(cache, [1, 2, 3, 4])
+    prefix = split_prefix(cache, [1, 2])
+    assert prefix != anchor
+    assert prefix not in cache.ongoing_load_back
+    assert cache.tree_core.node_by_id(prefix).load_back_pending_id == anchor
+    request = NS(last_node=prefix)
+    assert cache.beliefkv_prefill_load_consumer([request], 2) == 2
+    cache.tree_core.finish_load_back(anchor)
+    del cache.ongoing_load_back[anchor]
+    assert cache.beliefkv_prefill_load_consumer([request], 2) == -1
+
+
+def test_write_through_split_without_pending_markers_retains_the_native_wait():
+    cache = fixture(write_back=False)
+    anchor = load_path(cache, [1, 2, 3, 4])
+    prefix = split_prefix(cache, [1, 2])
+    assert prefix != anchor and prefix not in cache.ongoing_load_back
+    assert cache.tree_core.node_by_id(prefix).load_back_pending_id is None
+    assert cache.beliefkv_prefill_load_consumer([NS(last_node=prefix)], 2) == 2
