+            not callable(splitter) or not self.enable_session_radix_cache
+            or self.host_memory_mode != "cache" or self.buffer_pipeline is not None
+            or type(session_id) is not str or not session_id
+            or type(session_generation) is not int
+            or type(leaf_node_id) is not int or type(node_id) is not int
+            or type(leaf_creation_time) not in (int, float)
+            or type(node_creation_time) not in (int, float)
+            or self.session_refs._session_generations.get(session_id) != session_generation
+            or session_id in self.session_refs._closed_session_ids
+        ):
+            return None
+        try:
+            leaf = self.tree_core.node_by_id(leaf_node_id)
+            node = self.tree_core.node_by_id(node_id)
+        except (KeyError, RuntimeError, ValueError):
+            return None
+        if (
+            leaf.creation_time != leaf_creation_time
+            or node.creation_time != node_creation_time
+            or leaf not in self.components[BASE_COMPONENT_TYPE]._session_leaves.get(
+                session_id, (),
+            )
+            or session_id not in (leaf.component_data[BASE_COMPONENT_TYPE].session_ids or ())
+        ):
+            return None
+        current, found, visited = leaf, False, set()
+        while current is not self.tree_core.root_node:
+            if current is None or current.id in visited:
+                return None
+            visited.add(current.id)
+            try:
+                live_node = self.tree_core.node_by_id(current.id)
+            except (KeyError, RuntimeError, ValueError):
