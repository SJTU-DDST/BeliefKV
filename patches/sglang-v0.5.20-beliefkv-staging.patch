+            scheduler._beliefkv_registered_request_ids, {"id", "id-child"}
+        )
+
+    def test_exact_eviction_of_untagged_prefix_does_not_cancel_tagged(self):
+        runtime = Mock()
+        scheduler = scheduler_fixture(runtime)
+        scheduler._beliefkv_registered_request_ids.add("id-child")
+        scheduler._beliefkv_on_abort(
+            SimpleNamespace(rid="id", abort_all=False), exact=True
+        )
+        runtime.on_abort_request.assert_not_called()
+        self.assertEqual(scheduler._beliefkv_registered_request_ids, {"id-child"})
+
+    def test_batch_completion_keeps_batch_identity_and_forgets_finished(self):
+        runtime = Mock()
+        runtime.register_visible_request.return_value = True
+        scheduler = scheduler_fixture(runtime)
+        active = request("active", {"turn_id": "active"})
+        done = request("done", {"turn_id": "done"})
+        plain = request("plain")
+        scheduler._add_request_to_queue(active)
+        scheduler._add_request_to_queue(done)
+        # A request that finishes after enqueue remains tracked until completion.
+        done.finished = lambda: True
+        batch = SimpleNamespace(reqs=[active, done, plain])
+        scheduler._beliefkv_on_batch_completed(batch)
+        runtime.on_batch_completed.assert_called_once_with(batch)
+        self.assertIs(runtime.on_batch_completed.call_args.args[0], batch)
+        self.assertEqual(scheduler._beliefkv_registered_request_ids, {"active"})
+        scheduler._beliefkv_on_batch_completed(SimpleNamespace(reqs=[done, plain]))
+        self.assertEqual(runtime.on_batch_completed.call_count, 2)
+        active.finished = lambda: True
+        scheduler._beliefkv_on_batch_completed(SimpleNamespace(reqs=[active]))
+        self.assertEqual(scheduler._beliefkv_registered_request_ids, set())
+
+    def test_scheduler_entry_points_are_wired(self):
+        methods = {
+            node.name: node
+            for node in SCHEDULER_AST.body
+            if isinstance(node, ast.FunctionDef)
+        }
+        abort = methods["abort_request"]
+        self.assertEqual(
+            ast.unparse(abort.body[0]), "self._beliefkv_on_abort(recv_req)"
+        )
+        result = methods["process_batch_result"]
+        statements = [ast.unparse(node) for node in result.body]
+        self.assertLess(
+            statements.index("self._beliefkv_on_batch_completed(batch)"),
+            statements.index("self._record_step_counters(batch, result)"),
+        )
+        enqueue = methods["_add_request_to_queue"]
+        calls = [
+            node.func.attr
+            for node in ast.walk(enqueue)
+            if isinstance(node, ast.Call)
+            and isinstance(node.func, ast.Attribute)
+            and isinstance(node.func.value, ast.Name)
+            and node.func.value.id == "self"
+        ]
+        self.assertIn("_beliefkv_on_enqueue", calls)
+
+
+if __name__ == "__main__":
+    unittest.main()
