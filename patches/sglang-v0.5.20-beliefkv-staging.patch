+"""Selective background backup never treats execution locks as coldness."""
+
+from unittest.mock import Mock
+
+import pytest
+
+from sglang.srt.mem_cache.unified_cache.component_type import ComponentType as CT
+from test_beliefkv_cold_full_prepare import fixture, install_cpu_enqueue
+from test_beliefkv_terminal_capacity import hybrid_cache, insert_session
+
+
+@pytest.mark.parametrize("waiting", (False, True))
+@pytest.mark.parametrize("locked", (False, True))
+def test_only_direct_waiting_owners_or_unowned_cold_nodes_are_selected(hybrid_cache, waiting, locked):
+    cache, _, _, _, leaf, _ = fixture(hybrid_cache)
+    install_cpu_enqueue(cache)
+    insert_session(cache, [1, 2, 3, 4, 5, 6], "owner")
+    cache.enable_beliefkv_incremental_prepare()
+    cache.beliefkv_idle_prepare_policy = "cold"
+    cache.beliefkv_backup_full_owner_validator = Mock(return_value=waiting)
+    if locked:
+        cache.inc_lock_ref(leaf.id)
+    result = cache.prepare_beliefkv_idle_full()
+    assert bool(result) is (waiting and not locked)
+    assert leaf.component_data[CT.FULL].value is not None
+    assert leaf.component_data[CT.MAMBA].host_value is None
+    assert cache.beliefkv_backup_full_owner_validator.call_count == int(not locked)
+
+
+def test_unknown_shared_coverage_is_skipped_without_a_subtree_walk(hybrid_cache):
+    cache, _, _, _, leaf, _ = fixture(hybrid_cache)
+    cache.enable_beliefkv_incremental_prepare()
+    cache.beliefkv_idle_prepare_policy = "cold"
+    leaf.component_data[CT.FULL].session_ref = 2
+    leaf.component_data[CT.FULL].session_ids = {"partial"}
+    cache._beliefkv_full_covering_sessions = Mock(side_effect=AssertionError("no subtree scan"))
+    assert cache.prepare_beliefkv_idle_full() == ()
+    assert leaf.id in cache._beliefkv_unbacked_full
+
+
+def test_newly_blocked_owner_is_rechecked_without_rebuilding_the_dirty_index(hybrid_cache):
+    cache, _, _, _, leaf, _ = fixture(hybrid_cache)
+    install_cpu_enqueue(cache)
+    insert_session(cache, [1, 2, 3, 4, 5, 6], "owner")
+    cache.enable_beliefkv_incremental_prepare()
+    cache.beliefkv_idle_prepare_policy = "cold"
+    cache.beliefkv_backup_full_owner_validator = Mock(return_value=False)
+    assert cache.prepare_beliefkv_idle_full() == ()
+    cache.beliefkv_backup_full_owner_validator.return_value = True
+    assert cache.prepare_beliefkv_idle_full() == ((leaf.id, leaf.creation_time, 2),)
