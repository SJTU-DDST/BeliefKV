+
+    def test_abort_matches_prefix_once_and_abort_all_clears_rest(self):
+        runtime = Mock()
+        runtime.register_visible_request.return_value = True
+        scheduler = scheduler_fixture(runtime)
+        for rid in ("child-1", "child-2", "other"):
+            scheduler._add_request_to_queue(request(rid, {"turn_id": rid}))
+        abort = SimpleNamespace(rid="child-", abort_all=False)
+        scheduler._beliefkv_on_abort(abort)
+        scheduler._beliefkv_on_abort(abort)
+        runtime.on_abort_request.assert_called_once_with(abort)
+        self.assertEqual(scheduler._beliefkv_registered_request_ids, {"other"})
+
+        all_abort = SimpleNamespace(rid="", abort_all=True)
+        scheduler._beliefkv_on_abort(all_abort)
+        scheduler._beliefkv_on_abort(all_abort)
+        self.assertEqual(runtime.on_abort_request.call_count, 2)
+        self.assertIs(runtime.on_abort_request.call_args.args[0], all_abort)
+        self.assertEqual(scheduler._beliefkv_registered_request_ids, set())
+
+    def test_priority_eviction_clears_tracked_request(self):
+        runtime = Mock()
+        runtime.register_visible_request.return_value = True
+        scheduler = scheduler_fixture(runtime)
+        candidate = request("evicted", {"turn_id": "old"})
+        candidate.priority = 5
+        candidate.time_stats.wait_queue_entry_time = 1
+        candidate.time_stats.trace_ctx = SimpleNamespace(abort=Mock())
+        scheduler._add_request_to_queue(candidate)
+
+        scheduler._abort_on_queued_limit = Lifecycle._abort_on_queued_limit.__get__(
+            scheduler
+        )
