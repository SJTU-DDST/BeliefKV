+"""Compare complete Mamba prefill metadata with the pinned upstream methods."""
+
+import ast
+import copy
+from dataclasses import fields
+from pathlib import Path
+import random
+import subprocess
+from types import SimpleNamespace as NS
+from unittest.mock import patch
+
+import pytest
+import torch
+
+from sglang.srt.layers.attention import hybrid_linear_attn_backend as hybrid
+from sglang.srt.model_executor.forward_batch_info import ForwardBatch, ForwardMode
+
+
+SOURCE = "python/sglang/srt/layers/attention/hybrid_linear_attn_backend.py"
+ENGINE = Path(__file__).resolve().parents[2]
+
+
+def reference_methods():
+    source = subprocess.check_output(
+        ["git", "show", f"94602c9:{SOURCE}"], cwd=ENGINE, text=True
+    )
+    cls = next(
+        node
+        for node in ast.parse(source).body
+        if isinstance(node, ast.ClassDef) and node.name == "MambaAttnBackendBase"
+    )
+    names = {
+        "_forward_metadata",
+        "_init_track_conv_indices",
+        "_init_track_ssm_indices",
+    }
+    namespace = dict(vars(hybrid))
+    methods = [node for node in cls.body if getattr(node, "name", None) in names]
+    exec(
+        compile(
+            ast.fix_missing_locations(
+                ast.Module(
+                    body=[
+                        ast.ImportFrom(
+                            module="__future__",
+                            names=[ast.alias(name="annotations")],
+                            level=0,
+                        ),
+                        *methods,
+                    ],
+                    type_ignores=[],
+                )
+            ),
+            f"94602c9:{SOURCE}",
+            "exec",
+        ),
+        namespace,
+    )
+    return {name: namespace[name] for name in names}
+
+
+REFERENCE = reference_methods()
+
+
+def backend(kind, *, reference, size, chunk):
+    parent = (
+        hybrid.Mamba2AttnBackend if kind == "mamba2" else hybrid.MambaAttnBackendBase
+    )
+    cls = type("ReferenceBackend" if reference else "CandidateBackend", (parent,), {})
+    if reference:
+        for name, function in REFERENCE.items():
+            setattr(cls, name, function)
+    result = cls.__new__(cls)
+    result.device = "cpu"
+    result._mamba_chunk_size = chunk
+    result.conv_states_shape = (16, 4)
+    mapping = torch.randperm(256, generator=torch.Generator().manual_seed(83))
+    cache_slots = torch.arange(10, 10 + size, dtype=torch.int32)
+    result.req_to_token_pool = NS(
+        get_mamba_indices=lambda rows: cache_slots[rows],
+        translate_mamba_indices=lambda slots: mapping[slots.long()].to(slots.dtype),
+    )
+    return result
+
+
+def batch(*, extend, prefix, mask, tracked, cached=True):
+    size = len(extend)
+    result = ForwardBatch(
+        forward_mode=ForwardMode.EXTEND,
+        batch_size=size,
+        input_ids=torch.arange(sum(extend), dtype=torch.int64),
+        req_pool_indices=torch.arange(size),
+        seq_lens=torch.tensor([a + b for a, b in zip(extend, prefix)]),
+        out_cache_loc=torch.arange(sum(extend)),
+        seq_lens_sum=sum(extend) + sum(prefix),
+    )
+    result.extend_seq_lens = torch.tensor(extend, dtype=torch.int32)
+    result.extend_seq_lens_cpu = list(extend)
+    result.extend_prefix_lens = torch.tensor(prefix, dtype=torch.int32)
+    result.extend_prefix_lens_cpu = list(prefix)
+    starts = [0]
+    for length in extend[:-1]:
+        starts.append(starts[-1] + length)
+    result.extend_start_loc = torch.tensor(starts, dtype=torch.int32)
+    result.mamba_track_mask = torch.tensor(mask, dtype=torch.bool)
+    result.mamba_track_indices = torch.arange(80, 80 + size, dtype=torch.int64)
+    seqlens = [a + b for a, b in zip(prefix, tracked)]
+    result.mamba_track_seqlens = torch.tensor(seqlens, dtype=torch.int64)
+    result.mamba_extend_track_cpu = (
+        (tuple(mask), tuple(seqlens)) if cached else None
+    )
+    return result
+
+
+def equal_metadata(left, right):
+    for field in fields(left):
+        a, b = getattr(left, field.name), getattr(right, field.name)
+        if isinstance(a, torch.Tensor):
+            assert isinstance(b, torch.Tensor), field.name
+            assert a.dtype == b.dtype, field.name
+            assert a.shape == b.shape, field.name
+            assert torch.equal(a, b), field.name
+        else:
+            assert a == b, field.name
+
+
+def cases(chunk):
+    yield dict(extend=[1], prefix=[32768], mask=[True], tracked=[1])
+    yield dict(extend=[chunk], prefix=[0], mask=[True], tracked=[chunk])
+    yield dict(
+        extend=[chunk + 1], prefix=[17], mask=[True], tracked=[chunk + 1]
+    )
+    yield dict(extend=[9, 71], prefix=[0, 4096], mask=[False, False], tracked=[0, 0])
+    generator = random.Random(449)
+    for size in (1, 2, 4, 16, 48):
+        for _ in range(8):
+            extend = [generator.randrange(1, 513) for _ in range(size)]
+            prefix = [generator.randrange(0, 32769) for _ in range(size)]
+            mask = [generator.choice((False, True)) for _ in range(size)]
+            tracked = [generator.randrange(1, length + 1) for length in extend]
+            yield dict(extend=extend, prefix=prefix, mask=mask, tracked=tracked)
+
+
+@pytest.mark.parametrize("kind", ("gdn", "mamba2"))
+@pytest.mark.parametrize("chunk", (8, 64))
