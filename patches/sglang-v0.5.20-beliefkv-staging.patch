+    def _beliefkv_full_covering_sessions(
+        self, node: UnifiedTreeNode, *, max_nodes: int = 64,
+    ) -> Optional[set[str]]:
+        """Resolve inherited FULL coverage in a bounded, current subtree."""
+        full = node.component_data[BASE_COMPONENT_TYPE]
+        owners = full.session_ids
+        if owners and len(owners) == full.session_ref:
+            return owners
+        pending = [node]
+        visited = set()
+        resolved: set[str] = set()
+        matched_refs = 0
+        inspected = 1
+        leaves = self.components[BASE_COMPONENT_TYPE]._session_leaves
+        while pending:
+            current = pending.pop()
+            data = current.component_data[BASE_COMPONENT_TYPE]
+            try:
+                live = self.tree_core.node_by_id(current.id)
+            except (KeyError, RuntimeError, ValueError):
+                return None
+            if (
+                current.id in visited
+                or live is not current
+                or type(data.session_ref) is not int or data.session_ref <= 0
+                or current is not node and data.value is not None
+                or current.write_through_pending_id is not None
+                or current.load_back_pending_id is not None
+                or any(cd.lock_ref or cd.host_lock_ref for cd in current.component_data)
+            ):
+                return None
+            visited.add(current.id)
+            direct = data.session_ids
+            if direct is not None and (type(direct) is not set or not direct):
+                return None
+            coverage = len(direct) if direct is not None else 0
+            for owner in direct or ():
+                if (
+                    type(owner) is not str or not owner
+                    or current not in leaves.get(owner, ())
+                ):
+                    return None
+                resolved.add(owner)
+            matched_refs += coverage
+            for child in current.children.values():
+                inspected += 1
+                if inspected > max_nodes:
+                    return None
+                child_full = child.component_data[BASE_COMPONENT_TYPE]
+                try:
+                    live_child = self.tree_core.node_by_id(child.id)
+                except (KeyError, RuntimeError, ValueError):
+                    return None
+                if (
+                    child.parent is not current
+                    or live_child is not child
+                    or type(child_full.session_ref) is not int
+                    or child_full.session_ref < 0
+                    or child_full.session_ref == 0 and child_full.session_ids
+                ):
+                    return None
+                coverage += child_full.session_ref
+                if child_full.session_ref:
+                    pending.append(child)
+            if coverage != data.session_ref or matched_refs > full.session_ref:
+                return None
+        return resolved if resolved and matched_refs == full.session_ref else None
