+            node_id=node_id,
+            skipped_lock_components=tuple(
+                comp.component_type for comp in self.tree_core.components
+                if comp.component_type not in requested
+            ),
+        )
+        for comp in self.tree_core.components:
+            if comp.component_type in requested:
+                receipt = comp.acquire_component_lock(node=node, result=receipt, lock_host=True)
