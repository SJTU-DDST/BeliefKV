+def test_actual_full_leaf_eviction_saves_live_state_and_waits_for_native_ack():
+    cache, leaf = eviction_fixture()
+    full_host = leaf.component_data[0].host_value
+    order = []
+
+    def enqueue(action, *, write_back, no_host_reclaim):
+        assert action.node_ids == [leaf.id]
