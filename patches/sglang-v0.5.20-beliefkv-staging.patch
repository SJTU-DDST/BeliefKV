@@ -0,0 +1,278 @@
+"""CPU-only contract tests for optional scheduler request lifecycle hooks."""
+
+import ast
+import os
+import unittest
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+
+SCHEDULER = (
+    Path(__file__).resolve().parents[2] / "python/sglang/srt/managers/scheduler.py"
+)
+
+
+def load_lifecycle():
+    tree = ast.parse(SCHEDULER.read_text(encoding="utf-8"))
+    scheduler = next(
+        node
+        for node in tree.body
+        if isinstance(node, ast.ClassDef) and node.name == "Scheduler"
+    )
+    names = {
+        "init_beliefkv_runtime",
+        "_beliefkv_on_enqueue",
+        "_add_request_to_queue",
+        "_abort_on_queued_limit",
+        "_beliefkv_on_abort",
+        "_beliefkv_on_batch_completed",
+    }
+    methods = [
+        node
+        for node in scheduler.body
+        if isinstance(node, ast.FunctionDef) and node.name in names
+    ]
+    module = ast.Module(
+        body=[
+            ast.ImportFrom(
+                module="__future__",
+                names=[ast.alias(name="annotations")],
+                level=0,
+            ),
+            ast.ClassDef(
+                name="Lifecycle",
+                bases=[],
+                keywords=[],
+                body=methods,
+                decorator_list=[],
+            ),
+        ],
+        type_ignores=[],
+    )
+    ast.fix_missing_locations(module)
+    namespace = {
+        "os": os,
+        "DisaggregationMode": SimpleNamespace(NULL="null", PREFILL="prefill", DECODE="decode"),
+        "AbortReq": lambda *, rid: SimpleNamespace(rid=rid, abort_all=False),
+        "HTTPStatus": SimpleNamespace(SERVICE_UNAVAILABLE=503, BAD_REQUEST=400),
+        "_make_abort_req": lambda req, **kwargs: (req, kwargs),
+    }
+    exec(compile(module, str(SCHEDULER), "exec"), namespace)
+    return namespace["Lifecycle"], scheduler
+
+
+Lifecycle, SCHEDULER_AST = load_lifecycle()
+
+
+def scheduler_fixture(runtime):
+    scheduler = Lifecycle()
+    scheduler.server_args = SimpleNamespace(enable_beliefkv=False)
+    scheduler.init_beliefkv_runtime()
+    scheduler.beliefkv_runtime = runtime
+    scheduler.disaggregation_mode = "null"
+    scheduler.waiting_queue = []
+    scheduler._set_or_validate_priority = Mock(return_value=True)
+    scheduler._abort_on_queued_limit = Mock(return_value=False)
+    scheduler._prefetch_kvcache = Mock()
+    scheduler._release_aborted_request = Mock()
+    scheduler.ipc_channels = SimpleNamespace(
+        send_to_tokenizer=SimpleNamespace(send_output=Mock())
+    )
+    scheduler.processed_tokens_counter = 0
+    return scheduler
+
+
+def request(rid, metadata=None, *, finished=False):
+    req = SimpleNamespace(
+        rid=rid,
+        beliefkv_metadata=metadata,
+        time_stats=SimpleNamespace(set_wait_queue_entry_time=Mock()),
+        storage_prefetch_retry_attempts=0,
+        storage_prefetch_last_match_len=None,
+        staged_prefetch_plan=None,
+    )
+    req.finished = lambda: finished
+    return req
+
+
+class TestBeliefKVLifecycle(unittest.TestCase):
+    def test_enqueue_preserves_metadata_identity_and_registers_once(self):
+        runtime = Mock()
+        runtime.register_visible_request.return_value = True
+        scheduler = scheduler_fixture(runtime)
+        metadata = {"turn_id": "first"}
+        req = request("tagged", metadata)
+
+        scheduler._add_request_to_queue(req)
+        self.assertIs(scheduler.waiting_queue[0], req)
+        self.assertIs(req.beliefkv_metadata, metadata)
+        self.assertIs(runtime.register_visible_request.call_args.args[0], req)
+
+        scheduler._add_request_to_queue(req, is_retracted=True)
+        runtime.register_visible_request.assert_called_once_with(req)
+        runtime.on_requests_requeued.assert_called_once_with(
+            [req], is_retracted=True
+        )
+        self.assertIs(runtime.on_requests_requeued.call_args.args[0][0], req)
+
+    def test_rejection_and_queue_limit_do_not_enqueue(self):
+        runtime = Mock()
+        runtime.register_visible_request.return_value = False
+        scheduler = scheduler_fixture(runtime)
+        req = request("rejected", {"turn_id": "rejected"})
+        scheduler._add_request_to_queue(req)
+        self.assertEqual(scheduler.waiting_queue, [])
+        scheduler._prefetch_kvcache.assert_not_called()
+        self.assertEqual(scheduler._beliefkv_registered_request_ids, set())
+        scheduler._release_aborted_request.assert_called_once_with(req)
+        abort = scheduler.ipc_channels.send_to_tokenizer.send_output.call_args.args[0]
+        self.assertEqual(abort[1]["finished_reason"]["status_code"], 400)
+
+        scheduler._abort_on_queued_limit.return_value = True
+        scheduler._add_request_to_queue(request("full", {"turn_id": "full"}))
+        runtime.register_visible_request.assert_called_once_with(req)
+
+    def test_untagged_and_disabled_do_not_call_runtime(self):
+        runtime = Mock()
+        scheduler = scheduler_fixture(runtime)
+        plain = request("plain")
+        scheduler._add_request_to_queue(plain)
+        scheduler._beliefkv_on_abort(SimpleNamespace(rid="plain", abort_all=False))
+        plain_batch = SimpleNamespace(reqs=[plain])
+        scheduler._beliefkv_on_batch_completed(plain_batch)
+        runtime.on_batch_completed.assert_called_once_with(plain_batch)
+        runtime.register_visible_request.assert_not_called()
+        runtime.on_abort_request.assert_not_called()
+
+        scheduler.beliefkv_runtime = None
+        tagged = request("tagged", {"turn_id": "tagged"})
+        scheduler._add_request_to_queue(tagged)
+        scheduler._beliefkv_on_abort(SimpleNamespace(rid="", abort_all=True))
+        scheduler._beliefkv_on_batch_completed(SimpleNamespace(reqs=[tagged]))
+        self.assertEqual(scheduler.waiting_queue, [plain, tagged])
+        runtime.on_batch_completed.assert_called_once_with(plain_batch)
+
+    def test_abort_matches_prefix_once_and_abort_all_clears_rest(self):
+        runtime = Mock()
+        runtime.register_visible_request.return_value = True
+        scheduler = scheduler_fixture(runtime)
+        for rid in ("child-1", "child-2", "other"):
+            scheduler._add_request_to_queue(request(rid, {"turn_id": rid}))
+        abort = SimpleNamespace(rid="child-", abort_all=False)
+        scheduler._beliefkv_on_abort(abort)
+        scheduler._beliefkv_on_abort(abort)
+        runtime.on_abort_request.assert_called_once_with(abort)
+        self.assertEqual(scheduler._beliefkv_registered_request_ids, {"other"})
+
+        all_abort = SimpleNamespace(rid="", abort_all=True)
+        scheduler._beliefkv_on_abort(all_abort)
+        scheduler._beliefkv_on_abort(all_abort)
+        self.assertEqual(runtime.on_abort_request.call_count, 2)
+        self.assertIs(runtime.on_abort_request.call_args.args[0], all_abort)
+        self.assertEqual(scheduler._beliefkv_registered_request_ids, set())
+
+    def test_priority_eviction_clears_tracked_request(self):
+        runtime = Mock()
+        runtime.register_visible_request.return_value = True
+        scheduler = scheduler_fixture(runtime)
+        candidate = request("evicted", {"turn_id": "old"})
+        candidate.priority = 5
+        candidate.time_stats.wait_queue_entry_time = 1
+        candidate.time_stats.trace_ctx = SimpleNamespace(abort=Mock())
+        scheduler._add_request_to_queue(candidate)
+
+        scheduler._abort_on_queued_limit = Lifecycle._abort_on_queued_limit.__get__(
+            scheduler
+        )
+        scheduler.max_queued_requests = 1
+        scheduler.enable_priority_scheduling = True
+        scheduler.schedule_low_priority_values_first = True
+        scheduler._release_aborted_request = Mock()
+        scheduler.beam_coordinator = SimpleNamespace(retire_group=Mock())
+        sender = SimpleNamespace(send_output=Mock())
+        scheduler.ipc_channels = SimpleNamespace(send_to_tokenizer=sender)
+        incoming = request("incoming", {"turn_id": "new"})
+        incoming.priority = 1
+        incoming.time_stats.wait_queue_entry_time = 2
+
+        scheduler._add_request_to_queue(incoming)
+        self.assertEqual(scheduler.waiting_queue, [incoming])
+        self.assertEqual(scheduler._beliefkv_registered_request_ids, {"incoming"})
+        runtime.on_abort_request.assert_called_once()
+        self.assertEqual(runtime.on_abort_request.call_args.args[0].rid, "evicted")
+
+    def test_exact_eviction_rejects_overlapping_abort_prefix(self):
+        runtime = Mock()
+        scheduler = scheduler_fixture(runtime)
+        scheduler._beliefkv_registered_request_ids.update(("id", "id-child"))
+        abort = SimpleNamespace(rid="id", abort_all=False)
+        with self.assertRaisesRegex(RuntimeError, "ambiguous request prefix"):
+            scheduler._beliefkv_on_abort(abort, exact=True)
+        runtime.on_abort_request.assert_not_called()
+        self.assertEqual(
+            scheduler._beliefkv_registered_request_ids, {"id", "id-child"}
+        )
+
+    def test_exact_eviction_of_untagged_prefix_does_not_cancel_tagged(self):
+        runtime = Mock()
+        scheduler = scheduler_fixture(runtime)
+        scheduler._beliefkv_registered_request_ids.add("id-child")
+        scheduler._beliefkv_on_abort(
+            SimpleNamespace(rid="id", abort_all=False), exact=True
+        )
+        runtime.on_abort_request.assert_not_called()
+        self.assertEqual(scheduler._beliefkv_registered_request_ids, {"id-child"})
+
+    def test_batch_completion_keeps_batch_identity_and_forgets_finished(self):
+        runtime = Mock()
+        runtime.register_visible_request.return_value = True
+        scheduler = scheduler_fixture(runtime)
+        active = request("active", {"turn_id": "active"})
+        done = request("done", {"turn_id": "done"})
+        plain = request("plain")
+        scheduler._add_request_to_queue(active)
+        scheduler._add_request_to_queue(done)
+        # A request that finishes after enqueue remains tracked until completion.
+        done.finished = lambda: True
+        batch = SimpleNamespace(reqs=[active, done, plain])
+        scheduler._beliefkv_on_batch_completed(batch)
+        runtime.on_batch_completed.assert_called_once_with(batch)
+        self.assertIs(runtime.on_batch_completed.call_args.args[0], batch)
+        self.assertEqual(scheduler._beliefkv_registered_request_ids, {"active"})
+        scheduler._beliefkv_on_batch_completed(SimpleNamespace(reqs=[done, plain]))
+        self.assertEqual(runtime.on_batch_completed.call_count, 2)
+        active.finished = lambda: True
+        scheduler._beliefkv_on_batch_completed(SimpleNamespace(reqs=[active]))
+        self.assertEqual(scheduler._beliefkv_registered_request_ids, set())
+
+    def test_scheduler_entry_points_are_wired(self):
+        methods = {
+            node.name: node
+            for node in SCHEDULER_AST.body
+            if isinstance(node, ast.FunctionDef)
+        }
+        abort = methods["abort_request"]
+        self.assertEqual(
+            ast.unparse(abort.body[1]), "self._beliefkv_on_abort(recv_req)"
+        )
+        result = methods["process_batch_result"]
+        statements = [ast.unparse(node) for node in result.body]
+        self.assertLess(
+            statements.index("self._beliefkv_on_batch_completed(batch)"),
+            statements.index("self._record_step_counters(batch, result)"),
+        )
+        enqueue = methods["_add_request_to_queue"]
+        calls = [
+            node.func.attr
+            for node in ast.walk(enqueue)
+            if isinstance(node, ast.Call)
+            and isinstance(node.func, ast.Attribute)
+            and isinstance(node.func.value, ast.Name)
+            and node.func.value.id == "self"
+        ]
+        self.assertIn("_beliefkv_on_enqueue", calls)
+
+
+if __name__ == "__main__":
+    unittest.main()
