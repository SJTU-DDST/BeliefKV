+@pytest.fixture
+def cache(request):
+    size = getattr(request, "param", 64)
+    pool = MHATokenToKVPool(
+        size=size, page_size=1, dtype=torch.float16, head_num=2, head_dim=8,
+        layer_num=1, device="cpu", enable_memory_saver=False,
+    )
+    allocator = TokenToKVPoolAllocator(
+        size=size, dtype=torch.float16, device="cpu", kvcache=pool, need_sort=False,
+    )
+    result = UnifiedRadixCache(CacheInitParams(
+        disable=False,
+        req_to_token_pool=ReqToTokenPool(
+            size=8, max_context_len=128, device="cpu", enable_memory_saver=False,
+        ),
+        token_to_kv_pool_allocator=allocator, page_size=1, eviction_policy="lru",
+        enable_session_radix_cache=True, tree_components=(ComponentType.FULL,),
+    ))
+    result._execute_and_commit_kv_backup = Mock(side_effect=AssertionError("unexpected D2H"))
+    return result
+
+
+def insert_session(cache, tokens, session_id):
+    values = cache.token_to_kv_pool_allocator.alloc(len(tokens))
+    params = InsertParams(
+        key=RadixKey(array("q", tokens)), value=values.to(torch.int64),
+    )
+    if cache.supports_mamba():
+        params.mamba_value = cache.req_to_token_pool.mamba_allocator.alloc(1)
+    node = cache.insert(params).last_device_node
+    generation = cache.ensure_session_generation(session_id)
+    cache.session_refs.register_session_ref(NS(
+        session_id=session_id, session_generation=generation, session=None,
+        last_node=node, origin_input_ids=array("q", tokens), output_ids=array("q"),
+        extra_key=None,
+    ))
+    return cache.tree_core.node_by_id(node), generation
+
+
+def match_length(cache, tokens):
+    return len(cache.match_prefix(MatchPrefixParams(
+        key=RadixKey(array("q", tokens)),
+    )).device_indices)
+
+
+@pytest.mark.parametrize("close_first", (False, True))
+def test_child_private_pages_are_freed_while_parent_prefix_stays(cache, close_first):
+    insert_session(cache, [1, 2, 9, 9], "parent")
+    leaf, generation = insert_session(cache, [1, 2, 3, 4], "child")
+    available = cache.token_to_kv_pool_allocator.available_size()
+    if close_first:
+        cache.release_radix_session("child")
+    result = cache.retire_beliefkv_child_session(
+        session_id="child", session_generation=generation,
+    )
+    assert result["freed_device_units"] == {0: 2}
+    assert cache.token_to_kv_pool_allocator.available_size() == available + 2
+    assert match_length(cache, [1, 2, 9, 9]) == 4
+    assert match_length(cache, [1, 2, 3, 4]) == 2
+    assert (leaf.id, leaf.creation_time) in result["discarded_nodes"]
+    cache._execute_and_commit_kv_backup.assert_not_called()
+    assert not cache.retire_beliefkv_child_session(
+        session_id="child", session_generation=generation,
+    )["freed_device_units"]
+
+
+@pytest.mark.parametrize("blocked", ("device_lock", "host_lock", "d2h", "h2d"))
+def test_reclaim_retries_after_native_dependency_settles(cache, blocked):
+    leaf, generation = insert_session(cache, [5, 6], "child")
+    data = leaf.component_data[ComponentType.FULL]
+    if blocked == "device_lock":
+        lock = cache.inc_lock_ref(leaf.id).to_dec_params()
+    elif blocked == "host_lock":
+        data.host_lock_ref = 1
+    elif blocked == "d2h":
+        leaf.write_through_pending_id = 7
+    else:
+        leaf.load_back_pending_id = 7
+    result = cache.retire_beliefkv_child_session(
+        session_id="child", session_generation=generation,
+    )
+    assert not result["freed_device_units"]
+    assert result["retry_anchors"]
+    if blocked == "device_lock":
+        cache.dec_lock_ref(leaf.id, lock)
+    elif blocked == "host_lock":
+        data.host_lock_ref = 0
+    elif blocked == "d2h":
+        leaf.write_through_pending_id = None
+    else:
+        leaf.load_back_pending_id = None
+    retried = cache.retire_beliefkv_child_session(
+        session_id="child", session_generation=generation,
+        retry_anchors=result["retry_anchors"],
+    )
+    assert retried["freed_device_units"] == {0: 2}
+    assert cache.token_to_kv_pool_allocator.available_size() == 64
+
