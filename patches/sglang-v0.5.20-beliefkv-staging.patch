+"""BeliefKV scheduler safe-point contract, without model/GPU dependencies."""
+
+import ast
+import sys
+import types
+import unittest
+from collections import namedtuple
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import patch
+
+
+SCHEDULER = (
+    Path(__file__).resolve().parents[2]
+    / "python/sglang/srt/managers/scheduler.py"
+)
+PLAN = namedtuple("NextBatchPlan", "batch_to_run running_batch")
+
+
+def load_hook():
+    tree = ast.parse(SCHEDULER.read_text(encoding="utf-8"))
+    scheduler = next(
+        node
+        for node in tree.body
+        if isinstance(node, ast.ClassDef) and node.name == "Scheduler"
+    )
+    methods = {
+        "init_beliefkv_runtime",
+        "_beliefkv_tp_agree",
+        "_beliefkv_before_batch_selection",
+        "get_next_batch_to_run",
+    }
+    extracted = [
+        node
+        for node in scheduler.body
+        if isinstance(node, ast.FunctionDef) and node.name in methods
+    ]
+    for node in extracted:
+        node.decorator_list = []
+    module = ast.Module(
+        body=[
+            ast.ImportFrom(
+                module="__future__",
+                names=[ast.alias(name="annotations")],
+                level=0,
+            ),
+            ast.ClassDef(
+                name="SchedulerHook",
+                bases=[],
+                keywords=[],
+                body=extracted,
+                decorator_list=[],
+            ),
+        ],
+        type_ignores=[],
+    )
+    ast.fix_missing_locations(module)
+    namespace = {
+        "NextBatchPlan": PLAN,
+        "TokenizedGenerateReqInput": SimpleNamespace(
+            __struct_fields__=("beliefkv_metadata",)
+        ),
+    }
+    exec(compile(module, str(SCHEDULER), "exec"), namespace)
+    return namespace["SchedulerHook"]
+
+
+Hook = load_hook()
+
+
+def idle_scheduler(runtime=None, *, overlap=False):
+    scheduler = Hook()
+    calls = []
+    scheduler.beliefkv_runtime = runtime
+    scheduler._beliefkv_retraction_drain_pending = False
+    scheduler.ps = SimpleNamespace(tp_size=1, pp_size=1)
+    scheduler.enable_overlap = overlap
+    scheduler.result_queue = []
+    scheduler.chunked_req = None
+    scheduler.process_pending_chunked_abort = lambda: calls.append("abort")
+    scheduler._process_hicache_events = lambda: calls.append("cache")
+    scheduler.enable_fpm = False
+    scheduler.dllm_config = None
+    scheduler.enable_hisparse = False
+    scheduler.require_mlp_sync = False
+    scheduler._should_defer_prefill = lambda: True
+    scheduler.dp_attn_adapter = SimpleNamespace(
+        maybe_prepare_mlp_sync_batch=lambda batch, **kw: batch,
+        maybe_convert_decode_to_extend=lambda batch: batch,
+    )
+    scheduler._arm_prefill_decode_interval = lambda batch: None
+    scheduler.ngram_embedding_manager = SimpleNamespace(
+        prepare_for_forward=lambda batch, **kw: batch
+    )
+    batch = SimpleNamespace(
+        is_empty=lambda: True, is_prefill_only=False, batch_is_full=False
+    )
+    return scheduler, batch, calls
+
+
+class TestBeliefKVHook(unittest.TestCase):
+    def test_normal_and_radix_native_request_metadata_is_forwarded(self):
+        tree = ast.parse(SCHEDULER.read_text(encoding="utf-8"))
+        scheduler = next(
+            node
+            for node in tree.body
+            if isinstance(node, ast.ClassDef) and node.name == "Scheduler"
+        )
+        handler = next(
+            node
+            for node in scheduler.body
+            if isinstance(node, ast.FunctionDef)
+            and node.name == "handle_generate_request"
+        )
+        normal_or_radix_branch = next(
+            node
+            for node in ast.walk(handler)
+            if isinstance(node, ast.If)
+            and isinstance(node.test, ast.BoolOp)
+            and any(
+                isinstance(value, ast.Name) and value.id == "radix_native_session"
+                for value in node.test.values
+            )
+        )
+        constructor = next(
+            node
+            for statement in normal_or_radix_branch.body
+            for node in ast.walk(statement)
+            if isinstance(node, ast.Call)
+            and isinstance(node.func, ast.Name)
+            and node.func.id == "Req"
+        )
+        metadata = next(
+            keyword.value
+            for keyword in constructor.keywords
+            if keyword.arg == "beliefkv_metadata"
+        )
+        self.assertIsInstance(metadata, ast.Attribute)
+        self.assertIsInstance(metadata.value, ast.Name)
+        self.assertEqual(
+            (metadata.value.id, metadata.attr), ("recv_req", "beliefkv_metadata")
+        )
+
+    def test_disabled_does_not_touch_runtime_or_change_idle_plan(self):
+        scheduler, batch, calls = idle_scheduler()
+        scheduler.server_args = SimpleNamespace(enable_beliefkv=False)
+        scheduler.init_beliefkv_runtime()
+        plan = scheduler.get_next_batch_to_run(batch, None)
+        self.assertIsNone(plan.batch_to_run)
+        self.assertIs(plan.running_batch, batch)
+        self.assertEqual(calls, ["abort", "cache"])
+
+    def test_enabled_fails_closed_before_importing_old_runtime(self):
+        scheduler, batch, _ = idle_scheduler()
+        scheduler.server_args = SimpleNamespace(enable_beliefkv=True)
+        scheduler.tree_cache = object()
+        scheduler.running_batch = batch
+        cache_module = types.ModuleType("sglang.srt.mem_cache.hiradix_cache")
+        cache_module.HiRadixCache = type("HiRadixCache", (), {})
+        with patch.dict(sys.modules, {cache_module.__name__: cache_module}):
+            with self.assertRaisesRegex(RuntimeError, "activation unsupported") as error:
+                scheduler.init_beliefkv_runtime()
+        self.assertIn("transfer completion ACK adapter", str(error.exception))
+        self.assertIn("selective running retraction", str(error.exception))
+        self.assertIsNone(scheduler.beliefkv_runtime)
+
+    def test_ack_step_precedes_native_cache_events_on_idle(self):
+        scheduler, batch, calls = idle_scheduler()
+        scheduler.beliefkv_runtime = SimpleNamespace(
+            scheduler_step=lambda: calls.append("ack"),
+            plan_running_batch_retraction=lambda _: None,
+            on_batch_selected=lambda selected: calls.append(("selected", selected)),
+        )
+        plan = scheduler.get_next_batch_to_run(batch, None)
+        self.assertIsNone(plan.batch_to_run)
+        self.assertEqual(calls, ["ack", "abort", "cache", ("selected", None)])
+
+    def test_overlap_drain_returns_plan_then_notifies_after_result_is_drained(self):
+        scheduler, batch, calls = idle_scheduler(overlap=True)
+        runtime = SimpleNamespace(
+            scheduler_step=lambda: calls.append("ack"),
+            running_batch_retraction_barrier_required=lambda _: True,
+            on_running_batch_retraction_barrier_drained=lambda _: calls.append("drained"),
+            plan_running_batch_retraction=lambda _: None,
+            on_batch_selected=lambda _: calls.append("selected"),
+        )
+        scheduler.beliefkv_runtime = runtime
+        scheduler.result_queue.append("inflight")
+        last_batch = SimpleNamespace(
+            forward_mode=SimpleNamespace(is_extend=lambda: False)
+        )
+        plan = scheduler.get_next_batch_to_run(batch, last_batch)
+        self.assertIsNone(plan.batch_to_run)
+        self.assertIs(plan.running_batch, batch)
+        self.assertNotIn("drained", calls)
+        self.assertNotIn("selected", calls)
+        scheduler.result_queue.clear()
+        scheduler.get_next_batch_to_run(batch, None)
+        self.assertLess(calls.index("drained"), calls.index("selected"))
+
+    def test_retraction_plan_is_rejected_before_native_scheduling(self):
+        scheduler, batch, calls = idle_scheduler()
+        scheduler.beliefkv_runtime = SimpleNamespace(
+            scheduler_step=lambda: calls.append("ack"),
+            plan_running_batch_retraction=lambda _: object(),
+        )
+        with self.assertRaisesRegex(RuntimeError, "selective release and ACK"):
+            scheduler.get_next_batch_to_run(batch, None)
+        self.assertEqual(calls, ["ack", "abort", "cache"])
+
+    def test_inconsistent_overlap_queue_rejected_before_drain(self):
+        scheduler, batch, calls = idle_scheduler(overlap=True)
+        scheduler.beliefkv_runtime = SimpleNamespace(
+            scheduler_step=lambda: calls.append("ack")
