+"""Reclaim referenced FULL ancestors using complete, current leaf coverage."""
+
+from types import SimpleNamespace as NS
+from unittest.mock import Mock
+
+import pytest
+
+from sglang.srt.mem_cache.unified_cache.component_type import ComponentType as CT
+from test_beliefkv_cold_full_prepare import install_cpu_enqueue
+from test_beliefkv_terminal_capacity import hybrid_cache, insert_session
+
+
+def fixture(hybrid_cache, *, second=None, prefix_backed=True):
+    cache, allocator, pool = hybrid_cache
+    prefix, generation = insert_session(cache, [1, 2], "waiting-a")
+    leaf, _ = insert_session(cache, [1, 2, 3, 4], "waiting-a")
+    owners = {("waiting-a", generation)}
+    sibling = None
+    if second is not None:
+        owner = "waiting-a" if second == "same_session_sibling" else "waiting-b"
+        tokens = [1, 2, 3, 4] if second == "shared_leaf" else [1, 2, 5, 6]
+        other, second_generation = insert_session(cache, tokens, owner)
+        owners.add((owner, second_generation))
+        sibling = other if other is not leaf else None
+    for node in (prefix, leaf, *((sibling,) if sibling is not None else ())):
+        full = node.component_data[CT.FULL]
+        if node is not prefix or prefix_backed:
+            full.host_value = full.value.clone()
+            cache.tree_core._update_duplicate_tracking(node)
+    cache.is_write_back = True
+    cache.host_memory_mode = "cache"
+    cache.beliefkv_join_pressure_candidates = ()
+    cache.beliefkv_join_pressure_validator = lambda *_: False
+    cache.beliefkv_cold_full_owner_validator = Mock(
+        side_effect=lambda observed: set(observed) <= owners,
+    )
+    cache.cache_controller = NS(
+        write_queue=[], load_queue=[], ack_write_queue=[], ack_load_queue=[],
+        start_writing=Mock(),
+        mem_pool_host=NS(size_per_token=16 * 1024**2, available_size=lambda: 128),
+    )
+    if sibling is not None:
+        result = cache.tree_core.demote_backed_full_preserving_mamba(sibling.id)
+        cache._free_values(result.device_frees, result.host_frees)
+    return cache, allocator, pool, prefix, leaf, sibling, owners
+
+
+@pytest.mark.parametrize("second", (None, "shared_leaf", "sibling", "same_session_sibling"))
+def test_inherited_prefix_continues_reclaim_without_d2h_or_mamba_changes(hybrid_cache, second):
+    cache, allocator, pool, prefix, leaf, _, owners = fixture(hybrid_cache, second=second)
+    full_before = allocator.available_size()
+    state_before = pool.mamba_allocator.available_size()
+    states = {
+        node.id: node.component_data[CT.MAMBA].value for node in (prefix, leaf)
+    }
+    refs = {node.id: node.component_data[CT.FULL].session_ref for node in (prefix, leaf)}
+    assert prefix.component_data[CT.FULL].session_ids is None
+    assert cache.reclaim_beliefkv_handoff_capacity(
+        full_tokens=full_before + 4, mamba_slots=0, collect_diagnostics=True,
+    ) == {int(CT.FULL): 4}
+    assert allocator.available_size() == full_before + 4
+    assert pool.mamba_allocator.available_size() == state_before
+    for node in (prefix, leaf):
+        assert node.component_data[CT.FULL].value is None
+        assert node.component_data[CT.FULL].host_value is not None
+        assert node.component_data[CT.FULL].session_ref == refs[node.id]
+        assert node.component_data[CT.MAMBA].value is states[node.id]
+        assert node.component_data[CT.MAMBA].host_value is None
+    victim = cache.beliefkv_handoff_last_victims[-1]
+    assert victim["node_id"] == prefix.id
+    assert victim["full_owner_proof"] == "inherited_coverage"
+    assert set(victim["full_session_owners"]) == owners
+    cache._execute_and_commit_kv_backup.assert_not_called()
+
+
+def test_runnable_host_only_sibling_blocks_shared_prefix_reclaim(hybrid_cache):
+    cache, allocator, _, prefix, _, _, owners = fixture(hybrid_cache, second="sibling")
+    waiting = {item for item in owners if item[0] == "waiting-a"}
+    cache.beliefkv_cold_full_owner_validator.side_effect = lambda observed: set(observed) <= waiting
+    available = allocator.available_size()
+    assert cache.reclaim_beliefkv_handoff_capacity(
+        full_tokens=available + 4, mamba_slots=0,
+    ) == {int(CT.FULL): 2}
+    assert prefix.component_data[CT.FULL].value is not None
+    assert allocator.available_size() == available + 2
+
+
+@pytest.mark.parametrize("blocked", (
+    "coverage_count", "missing_generation", "closed_session", "missing_leaf_index",
+    "descendant_host_lock", "descendant_pending_load", "descendant_pending_write",
+))
+def test_unknown_or_unsettled_inherited_coverage_is_rejected(hybrid_cache, blocked):
+    cache, allocator, _, prefix, leaf, _, _ = fixture(hybrid_cache)
+    available = allocator.available_size()
+    assert cache.reclaim_beliefkv_handoff_capacity(
+        full_tokens=available + 2, mamba_slots=0,
+    ) == {int(CT.FULL): 2}
+    if blocked == "coverage_count":
+        prefix.component_data[CT.FULL].session_ref += 1
+    elif blocked == "missing_generation":
+        del cache.session_refs._session_generations["waiting-a"]
+    elif blocked == "closed_session":
+        cache.session_refs._closed_session_ids["waiting-a"] = None
+    elif blocked == "missing_leaf_index":
+        cache.components[CT.FULL]._session_leaves["waiting-a"].discard(leaf)
+    elif blocked == "descendant_host_lock":
+        leaf.component_data[CT.FULL].host_lock_ref = 1
+    elif blocked == "descendant_pending_load":
+        leaf.load_back_pending_id = leaf.id
+    else:
+        leaf.write_through_pending_id = leaf.id
+    assert not cache._beliefkv_causal_full_donor(prefix, require_host_copy=True)
+    assert cache.reclaim_beliefkv_handoff_capacity(
+        full_tokens=available + 4, mamba_slots=0,
+    ) == {}
+    assert prefix.component_data[CT.FULL].value is not None
+    assert allocator.available_size() == available + 2
+
+
+@pytest.mark.parametrize("changed", ("missing", "replaced"))
+def test_replaced_descendant_identity_cannot_prove_inherited_owners(hybrid_cache, changed, monkeypatch):
+    cache, allocator, _, prefix, leaf, _, _ = fixture(hybrid_cache)
+    available = allocator.available_size()
+    cache.reclaim_beliefkv_handoff_capacity(full_tokens=available + 2, mamba_slots=0)
+    original = cache.tree_core.node_by_id
+
+    def lookup(index):
+        if index == leaf.id:
+            if changed == "missing":
+                raise KeyError(index)
+            return NS()
+        return original(index)
+
+    monkeypatch.setattr(cache.tree_core, "node_by_id", lookup)
+    assert cache._beliefkv_full_covering_sessions(prefix) is None
+
+
+def test_owner_becoming_runnable_before_inherited_transaction_keeps_prefix(hybrid_cache):
+    cache, allocator, _, prefix, _, _, _ = fixture(hybrid_cache)
+    available = allocator.available_size()
+    cache.reclaim_beliefkv_handoff_capacity(full_tokens=available + 2, mamba_slots=0)
+    cache.beliefkv_cold_full_owner_validator.side_effect = (True, False)
+    assert cache.reclaim_beliefkv_handoff_capacity(
+        full_tokens=available + 4, mamba_slots=0,
+    ) == {}
+    assert prefix.component_data[CT.FULL].value is not None
+
+
+def test_inherited_owner_walk_is_bounded_and_stops_at_required_capacity(hybrid_cache):
+    cache, allocator, _, prefix, _, _, owners = fixture(hybrid_cache, second="sibling")
+    available = allocator.available_size()
+    assert cache.reclaim_beliefkv_handoff_capacity(
+        full_tokens=available + 2, mamba_slots=0,
+    ) == {int(CT.FULL): 2}
+    assert prefix.component_data[CT.FULL].value is not None
+    assert cache._beliefkv_full_covering_sessions(prefix, max_nodes=2) is None
+    assert cache._beliefkv_full_covering_sessions(prefix, max_nodes=3) == {
+        owner for owner, _ in owners
+    }
+    cache._beliefkv_full_covering_sessions = Mock(side_effect=AssertionError("capacity already fits"))
+    assert cache.reclaim_beliefkv_handoff_capacity(
+        full_tokens=allocator.available_size(), mamba_slots=0,
+    ) == {}
+
+
+def test_complete_direct_leaf_ownership_does_not_scan_descendant_coverage(hybrid_cache, monkeypatch):
+    cache, _, _, _, leaf, _, _ = fixture(hybrid_cache, second="shared_leaf")
+    lookup = Mock(side_effect=AssertionError("direct owners already cover every FULL reference"))
+    monkeypatch.setattr(cache.tree_core, "node_by_id", lookup)
