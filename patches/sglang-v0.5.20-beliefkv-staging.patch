+            or not set(self.tree_components) <= {
+                BASE_COMPONENT_TYPE, ComponentType.MAMBA,
+            }
+        ):
+            return {}
+        try:
+            node = self.tree_core.node_by_id(node_id)
+        except (KeyError, RuntimeError, ValueError):
+            return {}
+        if (
+            node is self.tree_core.root_node or node.creation_time != creation_time
+            or node_id in self.ongoing_write_through
+            or node.write_through_pending_id is not None
+            or node.load_back_pending_id is not None
+            or any(cd.lock_ref > 0 for cd in node.component_data)
