+
+    def test_no_callback_before_native_finish_and_observer_error_is_isolated(self):
+        cache = cache_fixture()
+        events = []
+        cache.on_hicache_transfer_commit = events.append
+        cache.ongoing_write_through = {1: (1, "lock", [1])}
+        cache.tree_core.finish_write_through.side_effect = RuntimeError("commit failed")
+        cache.cache_controller.ack_write_queue = [ack([1], {"kv": 2})]
