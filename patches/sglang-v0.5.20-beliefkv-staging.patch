+                if node_id in exclude_node_ids:
+                    stats["excluded_nodes"] += 1
+                elif node_id in self.ongoing_write_through or node.write_through_pending_id is not None:
+                    stats["pending_d2h_nodes"] += 1
+                elif node.load_back_pending_id is not None:
+                    stats["pending_h2d_nodes"] += 1
+                elif any(cd.host_lock_ref for cd in node.component_data):
+                    stats["host_locked_nodes"] += 1
+                elif selective and not self._beliefkv_idle_full_is_cold(node):
+                    stats["hot_or_unknown_owner_nodes"] += 1
+                else:
+                    candidates.append((node_id, node.creation_time, len(full.value)))
+                    stats["eligible_nodes"] += 1
+                    stats["eligible_full_tokens"] += len(full.value)
+                    if len(candidates) >= 32:
+                        break
+            stats["uninspected_nodes_last"] = len(dirty)
+            stats["scan_limited_rounds"] += scanned == 32 and bool(dirty)
+            issued = self._prepare_beliefkv_cold_full_nodes(
+                tuple(candidates), exclude_node_ids=exclude_node_ids,
+                idle=True, read_only_backup=True,
+            ) if candidates else ()
+            for node in inspected:
+                self._remember_beliefkv_unbacked_full(node)
+            stats["dirty_nodes_after_last"] = len(dirty)
+            stats["rounds_without_eligible_nodes"] += not candidates
+            stats["issued_rounds"] += bool(issued)
+            stats["empty_rounds"] += not issued
