+        issued = self._prepare_beliefkv_cold_full_nodes(
+            tuple(reversed(candidates)), read_only_backup=True,
+            max_batch_bytes=max_batch_bytes, max_batch_nodes=64,
+            reserve_host_bytes=64 * 1024**2,
+        )
+        return {
+            **result, "issued": issued,
+            "reason": "issued" if issued else "copy_blocked",
+        }
