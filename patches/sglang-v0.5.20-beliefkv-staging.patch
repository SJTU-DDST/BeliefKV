+"""Real CPU cache/tree and operation merge with simulated DMA completion."""
+
+from array import array
+from pathlib import Path
+from types import SimpleNamespace as NS
+
+import pytest
+import torch
+
+from test_beliefkv_full_host_eviction import cache
+
+from sglang.srt.managers.cache_controller import CacheOperation
+from sglang.srt.mem_cache.base_prefix_cache import EvictParams, InsertParams
+from sglang.srt.mem_cache.radix_cache import RadixKey
+from sglang.srt.mem_cache.unified_cache.component_type import ComponentType
+from sglang.srt.mem_cache import unified_radix_cache
+
+
+@pytest.mark.parametrize("batch_nodes,submits", [(1, 3), (32, 1)])
+def test_real_cache_backup_release_and_merged_index_mapping(cache, batch_nodes, submits):
+    expected_root = Path(__file__).resolve().parents[2] / "python"
+    assert Path(unified_radix_cache.__file__).resolve().is_relative_to(expected_root)
+    cache.write_back_batch_nodes = batch_nodes
+    allocator = cache.token_to_kv_pool_allocator
+    leaf = None
+    for tokens in ([1, 2], [1, 2, 3, 4], [1, 2, 3, 4, 5, 6]):
+        values = allocator.alloc(len(tokens))
+        inserted = cache.insert(InsertParams(
+            key=RadixKey(array("q", tokens)), value=values,
+        ))
+        allocator.free(values[:inserted.prefix_len])
+        leaf = cache.tree_core.node_by_id(inserted.last_device_node)
+    chain = []
+    node = leaf
+    while node is not cache.tree_core.root_node:
+        chain.append(node)
+        node = node.parent
+    assert len(chain) == 3
+    originals = {
+        node.id: node.component_data[ComponentType.FULL].value.clone() for node in chain
+    }
+    slot_contents = torch.arange(64) * 17 + 5
+    host_contents = torch.full((64,), -1, dtype=torch.int64)
+    next_host = [0]
+    submitted = []
+    controller = NS(write_queue=[], ack_write_queue=[], write_policy="write_back")
+    controller.mem_pool_host = NS(available_size=lambda: 64 - next_host[0])
+    cache.cache_controller = controller
+
+    def write(device_indices, *, node_id, beliefkv_defer_writing=False, **kwargs):
+        assert kwargs.get("extra_pools") is None
+        for pending in cache.ongoing_write_through:
+            pending_node = cache.tree_core.node_by_id(pending)
+            assert pending_node.write_through_pending_id is not None
+            assert not cache.tree_core._can_reclaim_full_host_duplicate(pending_node)
+        start = next_host[0]
+        next_host[0] += len(device_indices)
+        host_indices = torch.arange(start, next_host[0], dtype=torch.int64)
+        controller.write_queue.append(CacheOperation(
+            host_indices, device_indices.clone(), node_id,
+        ))
+        if not beliefkv_defer_writing:
+            start_writing()
+        return host_indices
+
+    def start_writing():
+        operation = CacheOperation.merge_ops(controller.write_queue)
+        controller.write_queue.clear()
+        submitted.append(tuple(operation.node_ids))
+
+        def synchronize():
+            for identity in operation.node_ids:
+                current = cache.tree_core.node_by_id(identity)
+                assert current.component_data[ComponentType.FULL].value is not None
+                assert current.write_through_pending_id is not None
+            host_contents[operation.host_indices] = slot_contents[operation.device_indices]
+
+        controller.ack_write_queue.append(NS(
+            node_ids=operation.node_ids, finish_event=NS(synchronize=synchronize),
+        ))
+
+    controller.write = write
+    controller.start_writing = start_writing
+    free_before = allocator.available_size()
+    result = cache.evict(EvictParams(num_tokens=6))
+    assert result.num_tokens_evicted == 6
+    assert allocator.available_size() == free_before + 6
+    assert len(submitted) == submits
+    assert [identity for group in submitted for identity in group] == [
+        node.id for node in chain
+    ]
+    for node in chain:
+        cd = node.component_data[ComponentType.FULL]
+        assert cd.value is None and cd.host_value is not None
+        assert node.write_through_pending_id is None
+        assert torch.equal(host_contents[cd.host_value], slot_contents[originals[node.id]])
+    assert not cache.ongoing_write_through and not controller.ack_write_queue
+    assert not controller.write_queue
