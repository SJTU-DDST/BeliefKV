+        assert leaf.component_data[0].host_value is full_host
+        order.append("demote_full")
+        tracker[0], tracker[2] = 2, 1
+
+    cache._execute_and_commit_kv_backup.side_effect = enqueue
+    cache.writing_check.side_effect = ack
+    cache._demote = Mock(side_effect=demote)
+    if handoff:
+        assert cache.reclaim_beliefkv_handoff_capacity(full_tokens=2, mamba_slots=0) == {}
+        assert order == ["save_state"]
+        assert leaf.component_data[0].value is not None
+        assert leaf.component_data[2].value is not None
+        cache.writing_check.assert_not_called()
+        cache._demote.assert_not_called()
+        ack(write_back=True)
+        assert cache.reclaim_beliefkv_handoff_capacity(full_tokens=2, mamba_slots=0) == {0: 2, 2: 1}
+    else:
+        tracker = {}
+        cache._evict_backed_join_parent(0, tracker)
+        assert tracker == {0: 2, 2: 1}
+    assert order == ["save_state", "ack_state", "demote_full"]
+    cache.beliefkv_join_pressure_parked.assert_called_once_with(leaf.id, {0: 2, 2: 1})
+
+
+@pytest.mark.parametrize("change", ("declined", "pending", "full_host_lost", "shared", "locked"))
+def test_full_reclaim_revalidates_after_state_backup_and_preserves_live_state(change):
+    cache, leaf = eviction_fixture()
+    cache.beliefkv_join_pressure_candidates_by_component = {0: ((leaf.id, leaf.creation_time),)}
+    cache.beliefkv_join_pressure_validator = Mock(return_value=True)
+    cache._component_available_size = Mock(return_value=0)
+    cache._demote = Mock()
+    cache.tree_core.demote_backed_mamba_state = Mock()
+
+    def preserve(
+        node, *, no_host_reclaim, wait_for_completion=True,
+        preserve_unreferenced=False,
+    ):
+        assert node is leaf and not no_host_reclaim and not wait_for_completion
+        assert not preserve_unreferenced
+        if change == "declined":
+            return
+        leaf.component_data[2].host_value = [9]
+        if change == "pending":
+            leaf.write_through_pending_id = "d2h"
+        elif change == "full_host_lost":
+            leaf.component_data[0].host_value = None
+        elif change == "shared":
+            leaf.component_data[2].session_ref = 2
+        elif change == "locked":
+            leaf.component_data[2].lock_ref = 1
+
+    cache._preserve_mamba_reentry_node = Mock(side_effect=preserve)
+    assert cache.reclaim_beliefkv_handoff_capacity(full_tokens=2, mamba_slots=0) == {}
+    cache._preserve_mamba_reentry_node.assert_called_once()
+    cache._demote.assert_not_called()
+    assert leaf.component_data[2].value is not None
+
+
+def test_unreferenced_mamba_does_not_require_a_host_copy_for_full_reclaim():
+    cache, leaf = eviction_fixture()
+    for component in leaf.component_data:
+        component.session_ref = 0
+    cache.beliefkv_join_pressure_candidates = ()
+    cache.beliefkv_join_pressure_validator = Mock(return_value=False)
+    cache._component_available_size = Mock(return_value=0)
+    cache._preserve_mamba_reentry_node = Mock()
+
+    def demote(node_id, tracker):
+        assert node_id == leaf.id
+        tracker[0] = 2
+
+    cache._demote = Mock(side_effect=demote)
+    assert cache.reclaim_beliefkv_handoff_capacity(full_tokens=2, mamba_slots=0) == {0: 2}
+    cache._preserve_mamba_reentry_node.assert_not_called()
