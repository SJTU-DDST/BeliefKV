+        # A path cap can discard unowned state before pool-pressure backup.
+        if (
+            not callable(demote) or ComponentType.MAMBA not in components
+            or not set(components) <= {BASE_COMPONENT_TYPE, ComponentType.MAMBA}
+            or state.value is None or state.host_value is not None
+            or not (
+                state.session_ref > 0
+                or state.session_ref == 0
+                and getattr(self, "_beliefkv_incremental_full_enabled", False)
+                and getattr(
+                    self.components[ComponentType.MAMBA], "mamba_max_states_per_path", 0,
+                ) < 0
+                and (
+                    full_session_ref == 0
+                    or getattr(
+                        node.component_data[BASE_COMPONENT_TYPE], "session_ids", False,
+                    ) is None
