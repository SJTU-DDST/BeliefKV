+"""BeliefKV request identity transport in the v0.5.20 ingress path."""
+
+import unittest
+from array import array
+from types import SimpleNamespace
+from unittest.mock import patch
+
+from sglang.test.test_utils import maybe_stub_sgl_kernel
+
+maybe_stub_sgl_kernel()
+
+import msgspec
+
+from sglang.srt.entrypoints.openai.protocol import (
+    ChatCompletionRequest,
+    MessageProcessingResult,
+)
+from sglang.srt.entrypoints.openai.serving_chat import OpenAIServingChat
+from sglang.srt.managers.io_struct import (
+    GenerateReqInput,
+    SessionParams,
+    TokenizedGenerateReqInput,
+)
+from sglang.srt.managers.schedule_batch import Req
+from sglang.srt.managers.tokenizer_manager import TokenizerManager
+from sglang.srt.sampling.sampling_params import SamplingParams
+from sglang.srt.session.session_controller import Session
+from sglang.srt.utils.msgpack_utils import enc_hook, ext_hook
+
+
+class BeliefKVMetadataTest(unittest.TestCase):
+    def test_openai_request_preserves_metadata_and_session_id(self):
+        metadata = {"conversation_id": "conversation", "turn_id": "turn-1"}
+        request = ChatCompletionRequest.model_validate(
+            {
+                "model": "test",
+                "messages": [{"role": "user", "content": "hello"}],
+                "n": 2,
+                "session_id": "session-1",
+                "beliefkv_metadata": metadata,
+            }
+        )
+        self.assertEqual(request.model_dump()["beliefkv_metadata"], metadata)
+
+        serving = object.__new__(OpenAIServingChat)
+        serving.is_gpt_oss = False
+        serving.reasoning_parser = None
+        serving.template_manager = SimpleNamespace(reasoning_config=None)
+        serving.tokenizer_manager = SimpleNamespace(
+            model_config=SimpleNamespace(is_multimodal=False)
+        )
+        serving.default_sampling_params = {}
+        serving.chat_encoding_spec = None
+        serving.allowed_custom_labels = None
+        processed = MessageProcessingResult(
+            prompt="hello",
+            prompt_ids=[1, 2],
+            image_data=None,
+            audio_data=None,
+            video_data=None,
+            modalities=[],
+            stop=[],
+        )
+        with (
+            patch.object(serving, "_process_messages", return_value=processed),
+            patch.object(serving, "_resolve_lora_path", return_value=None),
+            patch.object(serving, "_should_return_input_ids", return_value=False),
+        ):
+            adapted, _ = serving._convert_to_internal_request(request)
+        self.assertIs(adapted.beliefkv_metadata, request.beliefkv_metadata)
+        self.assertEqual(adapted.session_id, "session-1")
+        adapted.normalize_batch_and_arguments()
+        self.assertEqual(
+            [adapted[i].beliefkv_metadata for i in range(2)], [metadata, metadata]
+        )
+        self.assertEqual([adapted[i].session_id for i in range(2)], ["session-1"] * 2)
+
+    def test_batch_metadata_follows_each_prompt_across_parallel_samples(self):
+        metadata = [{"turn_id": "first"}, {"turn_id": "second"}]
+        req = GenerateReqInput(
+            text=["first", "second"],
+            sampling_params={"n": 2},
+            session_id="same-session",
+            beliefkv_metadata=metadata,
+        )
+        req.normalize_batch_and_arguments()
+        self.assertEqual(
+            [req[i].beliefkv_metadata for i in range(4)], metadata + metadata
+        )
+        self.assertEqual(
+            [req[i].session_id for i in range(4)], ["same-session"] * 4
+        )
+
+    def test_defaults_and_invalid_batch_length(self):
+        single = GenerateReqInput(text="hello")
+        single.normalize_batch_and_arguments()
+        self.assertIsNone(single.beliefkv_metadata)
+        batch = GenerateReqInput(text=["a", "b"], sampling_params={"n": 2})
+        batch.normalize_batch_and_arguments()
+        self.assertEqual(batch.beliefkv_metadata, [None] * 4)
+        with self.assertRaisesRegex(ValueError, "beliefkv_metadata length"):
+            GenerateReqInput(
+                text=["a", "b"], beliefkv_metadata=[{"turn_id": "only-one"}]
+            ).normalize_batch_and_arguments()
+
+    def test_tokenizer_ipc_preserves_metadata(self):
+        metadata = {"conversation_id": "c", "turn_id": "t"}
+        obj = GenerateReqInput(
+            input_ids=[1, 2],
+            rid="rid-1",
+            beliefkv_metadata=metadata,
+            session_params={"id": "session-1"},
+        )
+        obj.normalize_batch_and_arguments()
+        manager = object.__new__(TokenizerManager)
+        manager.preferred_sampling_params = None
+        manager.sampling_params_class = SamplingParams
+        manager.tokenizer = None
+        manager.model_config = SimpleNamespace(vocab_size=128)
+        manager.rid_to_state = {
+            obj.rid: SimpleNamespace(
+                time_stats=SimpleNamespace(set_tokenize_finish_time=lambda: None)
+            )
+        }
+        with patch(
+            "sglang.srt.managers.tokenizer_manager.get_disagg",
+            return_value=SimpleNamespace(disaggregation_transfer_backend=None),
+        ):
+            tokenized = manager._create_tokenized_object(obj, None, obj.input_ids)
+        self.assertEqual(tokenized.beliefkv_metadata, metadata)
+        self.assertEqual(tokenized.session_params.id, "session-1")
+        # The minimal tokenizer stub has no serializable API time-statistics object.
+        tokenized.time_stats = None
+        self.assertEqual(
+            msgspec.msgpack.decode(
+                msgspec.msgpack.encode(tokenized, enc_hook=enc_hook),
+                type=TokenizedGenerateReqInput,
+                ext_hook=ext_hook,
+            ).beliefkv_metadata,
+            metadata,
+        )
+
+    def test_session_uses_current_turn_metadata(self):
+        session = Session(capacity_of_str_len=0, session_id="session-1", streaming=True)
+
+        def turn(rid, metadata):
+            recv = SimpleNamespace(
+                rid=rid,
+                input_ids=array("q", [1, 2]),
+                mm_inputs=None,
+                session_params=SessionParams(id="session-1"),
+                sampling_params=SamplingParams(max_new_tokens=1),
+                beliefkv_metadata=metadata,
+                lora_id=None,
+                custom_logit_processor=None,
+                stream=False,
+                return_logprob=False,
+                top_logprobs_num=0,
+                token_ids_logprob=None,
+                return_sampling_mask=False,
+                require_reasoning=False,
+                return_hidden_states=False,
+                return_routed_experts=False,
+                routed_experts_start_len=0,
+                bootstrap_host=None,
+                bootstrap_port=None,
+                bootstrap_room=None,
+                routed_dp_rank=None,
+                disagg_prefill_dp_rank=None,
+                priority=None,
+                routing_key=None,
+                extra_key=None,
+                cache_salt=None,
+                http_worker_ipc=None,
+                time_stats=None,
+            )
+            return session.create_req(recv, tokenizer=None, vocab_size=128)
+
+        first = turn("r1", {"turn_id": "first"})
+        self.assertIs(first.session, session)
+        session.finish_req(first)
+        second = turn("r2", {"turn_id": "second"})
+        self.assertIs(second.session, session)
+        self.assertEqual(first.beliefkv_metadata, {"turn_id": "first"})
+        self.assertEqual(second.beliefkv_metadata, {"turn_id": "second"})
+        self.assertIsNone(
+            Req("plain", None, array("q", [1]), SamplingParams()).beliefkv_metadata
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
