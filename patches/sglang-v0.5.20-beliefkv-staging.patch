+    def _beliefkv_causal_full_owner_refs(
+        self, node: UnifiedTreeNode, *, require_host_copy: bool,
+    ) -> Optional[tuple[tuple[str, int], ...]]:
+        """Validate all session owners without releasing state or active references."""
+        validator = getattr(self, "beliefkv_cold_full_owner_validator", None)
+        full = node.component_data[BASE_COMPONENT_TYPE]
+        if (
+            not callable(validator)
+            or not set(self.tree_components) <= {BASE_COMPONENT_TYPE, ComponentType.MAMBA}
+            or node not in self.tree_core.evictable_device_leaves
+            or full.value is None
+            or (require_host_copy and full.host_value is None)
+            or full.session_ref <= 0
+            or node.id in self.ongoing_write_through
+            or node.write_through_pending_id is not None
+            or node.load_back_pending_id is not None
+            or any(cd.lock_ref or cd.host_lock_ref for cd in node.component_data)
+        ):
+            return None
+        owners = self._beliefkv_full_covering_sessions(node)
+        if owners is None:
