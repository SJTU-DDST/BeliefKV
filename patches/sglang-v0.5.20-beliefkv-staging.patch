+@pytest.mark.parametrize("shared", (False, True))
+def test_partial_host_extent_preserves_session_checkpoint_and_later_reuse(hybrid_cache, shared):
+    cache, allocator, request_pool, leaf, generation, tokens = host_only_session_extent(
+        hybrid_cache,
+    )
+    if shared:
+        cache.session_refs.register_session_ref(NS(
+            session_id="other", session_generation=cache.ensure_session_generation("other"),
+            session=None, last_node=leaf.id, origin_input_ids=array("q", tokens),
+            output_ids=array("q"), extra_key=None,
+        ))
+    full = leaf.component_data[ComponentType.FULL]
+    host_indices = full.host_value.clone()
+    state = leaf.component_data[ComponentType.MAMBA].value
+    before = allocator.available_size()
+    mamba_before = request_pool.mamba_allocator.available_size()
+    ref_count = full.session_ref
+    cache.tree_core.page_size = cache.page_size = 2
+
+    split = cache.split_beliefkv_prefetch_full_prefix(
+        session_id="waiting-parent", session_generation=generation,
+        leaf_node_id=leaf.id, leaf_creation_time=float(leaf.creation_time),
+        node_id=leaf.id, node_creation_time=float(leaf.creation_time), prefix_tokens=2,
+    )
+
+    assert split is not None
+    prefix = cache.tree_core.node_by_id(split[0])
+    assert leaf.parent is prefix
+    assert len(prefix.key) == 2 and len(leaf.key) == 6
+    assert torch.equal(torch.cat((
+        prefix.component_data[ComponentType.FULL].host_value, full.host_value,
+    )), host_indices)
+    assert prefix.component_data[ComponentType.FULL].session_ref == full.session_ref == ref_count
+    assert prefix.component_data[ComponentType.MAMBA].value is None
+    assert leaf.component_data[ComponentType.MAMBA].value is state
+    assert allocator.available_size() == before
+    assert request_pool.mamba_allocator.available_size() == mamba_before
+    assert dict(cache.session_refs.snapshot_session_leaf_anchors(
+        "waiting-parent", generation,
+    ))[int(ComponentType.FULL)] == ((leaf.id, leaf.creation_time),)
+
+    # Restore each actual native fragment. The partial FULL copy is not yet
+    # a reusable Mamba checkpoint; the completed suffix makes all eight reusable.
+    cache.tree_core._unevict_node_on_insert(prefix, allocator.alloc(2))
+    observation = cache.inspect_beliefkv_reentry(NS(
+        origin_input_ids=array("q", [*tokens, 99]),
+        session_id="waiting-parent", session_generation=generation, extra_key=None,
+    ))
+    assert observation["missing_full_tokens"] == 6
+    assert observation["missing_mamba_slots"] == 0
+    assert match_length(cache, tokens) == 0
+    cache.tree_core._unevict_node_on_insert(leaf, allocator.alloc(6))
+    assert match_length(cache, tokens) == 8
+    assert leaf.component_data[ComponentType.MAMBA].value is state
+    cache.release_radix_session("waiting-parent")
+    if shared:
+        assert prefix.component_data[ComponentType.FULL].session_ref == full.session_ref == 1
+        cache.release_radix_session("other")
+    assert prefix.component_data[ComponentType.FULL].session_ref == full.session_ref == 0
+    cache._execute_and_commit_kv_backup.assert_not_called()
