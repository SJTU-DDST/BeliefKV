@@ -0,0 +1,143 @@
+"""CPU-only tests for the optional per-node Host eviction observer."""
+
+import ast
+from enum import Enum
+from pathlib import Path
+from types import SimpleNamespace
+import unittest
+from unittest.mock import Mock
+
+
+SOURCE = (
+    Path(__file__).resolve().parents[2]
+    / "python/sglang/srt/mem_cache/unified_cache/unified_tree_core.py"
+)
+
+
+class EvictLayer(Enum):
+    DEVICE = "device"
+    HOST = "host"
+
+
+class _Lru:
+    def in_list(self, _node):
+        return False
+
+    def remove_node(self, _node):
+        raise AssertionError("node is not in the LRU")
+
+
+def _load_evict_method():
+    tree = ast.parse(SOURCE.read_text(encoding="utf-8"))
+    core = next(
+        node
+        for node in tree.body
+        if isinstance(node, ast.ClassDef) and node.name == "UnifiedTreeCore"
+    )
+    method = next(
+        node
+        for node in core.body
+        if isinstance(node, ast.FunctionDef)
+        and node.name == "_evict_component_and_detach_lru"
+    )
+    module = ast.Module(
+        body=[
+            ast.ImportFrom(
+                module="__future__",
+                names=[ast.alias(name="annotations")],
+                level=0,
+            ),
+            method,
+        ],
+        type_ignores=[],
+    )
+    ast.fix_missing_locations(module)
+    namespace = {
+        "EvictLayer": EvictLayer,
+        "BASE_COMPONENT_TYPE": 0,
+    }
+    exec(compile(module, str(SOURCE), "exec"), namespace)
+    return namespace["_evict_component_and_detach_lru"]
+
+
+_evict_component_and_detach_lru = _load_evict_method()
+
+
+class _Core:
+    _evict_component_and_detach_lru = _evict_component_and_detach_lru
+
+    def __init__(self, observer):
+        self._beliefkv_host_eviction_observer = observer
+        self._is_tracking_unbacked_tokens = False
+        self.lru_lists = {0: _Lru(), 2: _Lru()}
+        self.host_lru_lists = {0: _Lru(), 2: _Lru()}
+
+
+def _component(component_type, *, device_freed=0, host_freed=0):
+    return SimpleNamespace(
+        component_type=component_type,
+        evict_component=Mock(return_value=(device_freed, host_freed)),
+    )
+
+
+def _node(component_type):
+    return SimpleNamespace(
+        id=7,
+        component_data={component_type: SimpleNamespace(host_value=object())},
+    )
+
+
+class BeliefKVHostEvictionObserverTest(unittest.TestCase):
+    def test_only_host_frees_with_positive_units_are_observed(self):
+        observer = Mock()
+        core = _Core(observer)
+        node = _node(2)
+
+        freed = core._evict_component_and_detach_lru(
+            node,
+            _component(2, host_freed=5),
+            {},
+            {},
+            target={EvictLayer.HOST},
+        )
+
+        self.assertEqual(freed, (0, 5))
+        observer.assert_called_once_with(node, 2, 5)
+
+        observer.reset_mock()
+        core._evict_component_and_detach_lru(
+            node,
+            _component(2, host_freed=5),
+            {},
+            {},
+            target={EvictLayer.DEVICE},
+        )
+        observer.assert_not_called()
+
+        core._evict_component_and_detach_lru(
+            node,
+            _component(2, host_freed=0),
+            {},
+            {},
+            target={EvictLayer.HOST},
+        )
+        observer.assert_not_called()
+
+    def test_observer_exception_does_not_change_native_eviction_result(self):
+        observer = Mock(side_effect=RuntimeError("telemetry failed"))
+        core = _Core(observer)
+
+        result = core._evict_component_and_detach_lru(
+            _node(0),
+            _component(0, device_freed=3, host_freed=2),
+            {},
+            {},
+            target={EvictLayer.HOST},
+        )
+
+        self.assertEqual(result, (3, 2))
+        observer.assert_called_once()
+
+
+if __name__ == "__main__":
+    unittest.main()
