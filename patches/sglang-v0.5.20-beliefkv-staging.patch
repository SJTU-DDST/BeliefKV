+    cache.writing_check.side_effect = ack
+    cache.tree_core.evict_device_leaf.side_effect = evict
+    assert cache._evict_device_leaf(leaf.id, {}) is None
+    assert order == ["enqueue_state", "ack_state", "evict_leaf"]
