+def test_partial_restore_can_split_its_tail_while_resident_prefix_is_protected(hybrid_cache):
+    cache, allocator, request_pool, leaf, generation, tokens = host_only_session_extent(
+        hybrid_cache,
+    )
+    host_indices = leaf.component_data[ComponentType.FULL].host_value.clone()
