+    def _prepare_beliefkv_cold_full_nodes(
+        self, candidates: tuple, *, exclude_node_ids: tuple[NodeId, ...] = (),
+        require_device_leaf: bool = False, idle: bool = False,
+        read_only_backup: bool = False, require_cold_owners: bool = False,
+        max_batch_bytes: int | None = None, max_batch_nodes: int | None = None,
+        reserve_host_bytes: int = 0,
+    ) -> tuple[tuple[NodeId, int | float, int], ...]:
+        controller = getattr(self, "cache_controller", None)
+        stats = getattr(self, "beliefkv_idle_full_prepare_stats", None) if idle else None
+        if (
+            not self.is_write_back or self.host_memory_mode != "cache"
+            or self.buffer_pipeline is not None or controller is None
+            or controller.write_queue
+        ):
+            return ()
+        prior = getattr(self, "_beliefkv_cold_full_prepare_pending", ())
+        if any(node_id in self.ongoing_write_through for node_id, _, _ in prior):
+            if stats is not None:
+                stats["blocked_prior_background_batch"] += 1
+            return ()
+        self._beliefkv_cold_full_prepare_pending = ()
+        self._beliefkv_cold_full_prepare_scan_ref = None
+        host_pool = controller.mem_pool_host
+        unit = host_pool.size_per_token
+        page = self.tree_core.page_size
+        if type(unit) is not int or unit <= 0:
+            return ()
+        # Amortize background launch costs. Only a capacity-blocked urgent
+        # restore uses small chunks; the directions need not have equal rates.
+        max_bytes = (
+            max_batch_bytes if max_batch_bytes is not None
+            else BELIEFKV_IDLE_FULL_PREPARE_MAX_BYTES if idle else 64 * 1024 * 1024
+        )
+        node_limit = max_batch_nodes if max_batch_nodes is not None else 32 if idle else 1
+        chunk_tokens = max(page, (max_bytes // unit // page) * page)
+        host_free = host_pool.available_size()
+        if stats is not None:
+            stats["host_free_tokens_last"] = host_free
+            stats["host_reserved_tokens"] = chunk_tokens
+            stats["max_batch_bytes"] = max_bytes
+            stats["full_bytes_per_token"] = unit
+            stats["max_scanned_nodes"] = 32
+            stats["max_merged_nodes"] = 32
+        if idle:
+            host_free -= chunk_tokens
+        elif reserve_host_bytes:
+            host_free -= ceil_align((reserve_host_bytes + unit - 1) // unit, page)
+        limit = min(chunk_tokens, max(0, host_free) // page * page)
+        initial_limit = limit
+        if stats is not None:
+            stats["host_budget_tokens_last"] = limit
+            stats["host_budget_limited_rounds"] += limit < chunk_tokens
+        if limit <= 0:
+            if stats is not None:
+                stats["blocked_host_capacity_rounds"] += 1
+            return ()
+        excluded = set(exclude_node_ids)
+        queued = []
+        try:
+            for node_id, created, _ in candidates:
+                try:
+                    node = self.tree_core.node_by_id(node_id)
+                except (KeyError, RuntimeError, ValueError):
+                    continue
+                full = node.component_data[BASE_COMPONENT_TYPE]
+                if (
+                    node_id in excluded or node.creation_time != created
+                    or (require_device_leaf
+                        and node not in self.tree_core.evictable_device_leaves)
+                    or full.value is None or full.host_value is not None
+                    or not len(full.value)
+                    or node_id in self.ongoing_write_through
+                    or node.write_through_pending_id is not None
+                    or node.load_back_pending_id is not None
+                    or any(cd.host_lock_ref for cd in node.component_data)
+                    or (require_cold_owners and (
+                        any(cd.lock_ref for cd in node.component_data)
+                        or any(cd.session_ref for cd in node.component_data)
+                        and not self._beliefkv_causal_full_donor(node, require_host_copy=False)
+                    ))
+                    or (not read_only_backup and any(
+                        cd.session_ref or cd.lock_ref for cd in node.component_data
+                    ))
+                ):
+                    continue
+                units = len(full.value)
+                if units > limit:
+                    split = self.tree_core.split_idle_device_full_suffix(
+                        node_id, created, limit, read_only_backup=read_only_backup,
+                    )
+                    if split is None:
+                        continue
+                    self._apply_cache_actions(split[1])
+                    units = len(node.component_data[BASE_COMPONENT_TYPE].value)
+                self._execute_and_commit_kv_backup(
+                    BackupKV([node_id]), no_host_reclaim=True,
+                    beliefkv_include_mamba=False, beliefkv_defer_writing=True,
+                )
+                if node_id not in self.ongoing_write_through:
+                    if stats is not None:
+                        stats["enqueue_failed_nodes"] += 1
+                    continue
+                queued.append((node_id, created, units))
+                limit -= units
+                if limit <= 0 or len(queued) >= node_limit:
+                    break
+        finally:
+            if queued:
+                self._beliefkv_cold_full_prepare_pending = tuple(queued)
+                controller.start_writing()
+                if stats is not None:
+                    stats["issued_tokens"] += initial_limit - limit
+                    stats["issued_nodes"] += len(queued)
+                    stats["byte_budget_reached_rounds"] += (
+                        initial_limit == chunk_tokens and limit <= 0
+                    )
+                    stats["host_budget_reached_rounds"] += (
+                        initial_limit < chunk_tokens and limit <= 0
+                    )
+                    stats["extent_limit_reached_rounds"] += len(queued) >= 32
+        return tuple(queued)
