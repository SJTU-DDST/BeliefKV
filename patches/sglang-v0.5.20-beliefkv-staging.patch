+class TestPrepareHostShadow(unittest.TestCase):
+    def test_same_anchor_full_prefetch_then_native_state_waits_without_overwriting(self):
+        cache, _, parent, leaf, _, _, _ = native_load_fixture()
+        full_spec = SimpleNamespace(
+            host_indices=torch.arange(2), nodes_to_load=[leaf.id],
+        )
+        state_spec = SimpleNamespace(host_indices=torch.arange(0), nodes_to_load=[])
+        cache.tree_core.build_load_back_spec = Mock(side_effect=(
+            (full_spec, {}),
+            (state_spec, {ComponentType.MAMBA: [SimpleNamespace(
+                name=PoolName.MAMBA, host_indices=torch.arange(1),
+                nodes_to_load=[leaf.id],
+            )]}),
+        ))
+        cache.linker = None
+        cache.tree_core.is_full_device_evicted = Mock(return_value=False)
+        cache.tree_core.empty_match_result = SimpleNamespace(
+            device_indices=torch.arange(0),
+        )
+        cache.tree_core.collect_full_device_indices = Mock(return_value=torch.arange(0))
+        cache.tree_core.finish_load_back = Mock(
+            side_effect=lambda node_id: setattr(leaf, "load_back_pending_id", None),
+        )
+        request = SimpleNamespace(
+            rid="native-parent", last_node=parent.id,
+            swa_host_hit_length=0, mamba_host_hit_length=1,
+        )
+        params = SimpleNamespace(
+            best_match_node=leaf.id, mem_quota=None, req=request, host_hit_length=0,
+        )
+        self.assertTrue(cache.load_back(
+            leaf.id, beliefkv_command_id="full-prefetch",
+            beliefkv_no_device_reclaim=True, beliefkv_include_mamba=False,
+        ))
+        first = cache.ongoing_load_back[leaf.id]
+        self.assertIsNone(cache.init_load_back(params))
+        self.assertIs(cache.ongoing_load_back[leaf.id], first)
+        self.assertEqual(cache.cache_controller.load.call_count, 1)
+        self.assertEqual(cache.inc_host_lock_ref.call_count, 1)
+        for comp in cache._components_tuple:
+            self.assertEqual(comp.prepare_load_back.call_count, 1)
+
+        cache.cache_controller.ack_load_queue = [SimpleNamespace(
+            node_ids=[leaf.id], finish_event=Mock(),
+        )]
+        cache.loading_check(finish_count=1)
+        self.assertEqual(cache.ongoing_load_back, {})
+
+        cache.init_load_back(params)
+        self.assertEqual(cache.cache_controller.load.call_count, 2)
+        cache.cache_controller.ack_load_queue = [SimpleNamespace(
+            node_ids=[leaf.id], finish_event=Mock(),
+        )]
+        cache.loading_check(finish_count=1)
+        self.assertEqual(cache.ongoing_load_back, {})
+        self.assertEqual(cache.dec_host_lock_ref.call_count, 2)
+        self.assertEqual(cache.tree_core.finish_load_back.call_count, 2)
+
