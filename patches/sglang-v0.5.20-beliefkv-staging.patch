+    full = leaf.component_data[ComponentType.FULL]
+    full.host_value = full.value.clone()
+    cache.is_write_back = True
+    cache.host_memory_mode = "cache"
+    result = cache.tree_core.demote_backed_full_preserving_mamba(leaf.id)
+    cache._free_values(result.device_frees, result.host_frees)
+    return cache, allocator, request_pool, leaf, generation, tokens
