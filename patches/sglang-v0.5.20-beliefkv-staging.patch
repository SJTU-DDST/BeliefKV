+    retained = chain[-1].component_data[ComponentType.FULL].value
+    result = cache.reclaim_beliefkv_handoff_capacity(
+        full_tokens=available + 6, mamba_slots=0, max_nodes=2,
+    )
+    assert result[int(ComponentType.FULL)] == 4
+    assert allocator.available_size() == available + 4
+    assert chain[-1].component_data[ComponentType.FULL].value is retained
+    cache._execute_and_commit_kv_backup.assert_not_called()
+
+
+def test_capacity_diagnosis_records_a_real_tool_candidate_and_the_unfilled_deficit(
+    hybrid_cache,
+):
+    cache, allocator, _, chain = backed_waiting_chain(hybrid_cache)
+    available = allocator.available_size()
+    result = cache.reclaim_beliefkv_handoff_capacity(
+        full_tokens=available + 6, mamba_slots=0, max_nodes=1,
+        collect_diagnostics=True,
+    )
+    diagnosis = cache.beliefkv_handoff_last_capacity
+    assert result[int(ComponentType.FULL)] == 2
+    assert diagnosis["free_full_tokens_before"] == available
+    assert diagnosis["free_full_tokens_after"] == available + 2
+    assert not diagnosis["full_target_satisfied"]
+    assert diagnosis["transaction_truncated"]
+    check, = diagnosis["waiting_candidate_checks"]
+    assert check["node_id"] == chain[0].id
+    assert check["full_session_ref"] == 1 and check["full_host_tokens"] == 2
+    assert check["causal_wait_valid"] and not check["inflight"]
+    cache._execute_and_commit_kv_backup.assert_not_called()
+
+
+@pytest.mark.parametrize(
+    "blocked", ("device_lock", "shared", "d2h", "h2d", "excluded", "stale"),
+)
+def test_full_only_exchange_keeps_active_shared_or_inflight_state(hybrid_cache, blocked):
+    cache, allocator, request_pool = hybrid_cache
+    victim, _ = insert_session(cache, [1, 2], "waiting-parent")
+    full = victim.component_data[ComponentType.FULL]
+    state = victim.component_data[ComponentType.MAMBA]
+    full.host_value = full.value.clone()
+    full_value, state_value = full.value, state.value
+    full_available = allocator.available_size()
+    mamba_available = request_pool.mamba_allocator.available_size()
+    cache.is_write_back = True
+    cache.host_memory_mode = "cache"
+    cache.cache_controller = NS()
+    cache.beliefkv_join_pressure_candidates_by_component = {
+        int(ComponentType.FULL): ((
+            victim.id, victim.creation_time - 1 if blocked == "stale" else victim.creation_time,
+        ),),
+    }
+    cache.beliefkv_join_pressure_validator = lambda *_: True
+    if blocked == "device_lock":
+        cache.inc_lock_ref(victim.id)
+    elif blocked == "shared":
+        insert_session(cache, [1, 2], "other-live-session")
+    elif blocked == "d2h":
+        victim.write_through_pending_id = victim.id
+    elif blocked == "h2d":
+        victim.load_back_pending_id = victim.id
+    full_available = allocator.available_size()
+    mamba_available = request_pool.mamba_allocator.available_size()
+    assert cache.reclaim_beliefkv_handoff_capacity(
+        full_tokens=full_available + 2, mamba_slots=0,
+        exclude_node_ids=(victim.id,) if blocked == "excluded" else (),
+    ) == {}
+    assert full.value is full_value and state.value is state_value
+    assert allocator.available_size() == full_available
+    assert request_pool.mamba_allocator.available_size() == mamba_available
+    cache._execute_and_commit_kv_backup.assert_not_called()
+
+
+def test_opportunistic_full_reclaim_keeps_real_pages_until_asynchronous_state_ack(
+    hybrid_cache,
+):
+    cache, allocator, request_pool = hybrid_cache
+    victim, _ = insert_session(cache, [1, 2], "waiting-parent")
+    full = victim.component_data[ComponentType.FULL]
+    state = victim.component_data[ComponentType.MAMBA]
+    full.host_value = full.value.clone()
+    host_full = full.host_value
+    full_available = allocator.available_size()
+    mamba_available = request_pool.mamba_allocator.available_size()
+    required_mamba = mamba_available + 1
+    cache.is_write_back = True
+    cache.host_memory_mode = "cache"
+    cache.cache_controller = NS()
+    cache.beliefkv_join_pressure_candidates_by_component = {
+        int(ComponentType.FULL): ((victim.id, victim.creation_time),),
+    }
+    cache.beliefkv_join_pressure_validator = lambda *_: True
+    cache.writing_check = Mock(side_effect=AssertionError("unexpected synchronous drain"))
+
+    def enqueue(action, *, write_back, no_host_reclaim):
+        assert action.node_ids == [victim.id] and not write_back and not no_host_reclaim
+        state.host_value = state.value.clone()
+        lock = cache.inc_lock_ref(victim.id).to_dec_params()
+        cache._track_write_through_node(victim.id, lock, [victim.id])
+
+    cache._execute_and_commit_kv_backup.side_effect = enqueue
+    for _ in range(2):
+        assert cache.reclaim_beliefkv_handoff_capacity(
+            full_tokens=full_available + 2, mamba_slots=required_mamba,
+        ) == {}
+        assert allocator.available_size() == full_available
+        assert request_pool.mamba_allocator.available_size() == mamba_available
+        assert full.value is not None and state.value is not None
+        assert victim.write_through_pending_id == victim.id
+        assert full.lock_ref > 0 and state.lock_ref > 0
+        assert victim not in cache.tree_core.evictable_device_leaves
+    cache._execute_and_commit_kv_backup.assert_called_once()
+    cache.writing_check.assert_not_called()
+    host_state = state.host_value
+    cache._finish_write_through_ack(victim.id)
+    assert full.lock_ref == 0 and state.lock_ref == 0
+
+    assert cache.reclaim_beliefkv_handoff_capacity(
+        full_tokens=full_available + 2, mamba_slots=required_mamba,
+    ) == {int(ComponentType.FULL): 2, int(ComponentType.MAMBA): 1}
+    assert allocator.available_size() == full_available + 2
+    assert request_pool.mamba_allocator.available_size() == mamba_available + 1
+    assert full.host_value is host_full and state.host_value is host_state
+    cache.writing_check.assert_not_called()
+
+
+@pytest.mark.parametrize("close_first", (False, True))
+def test_terminal_hybrid_suffix_returns_full_pages_and_mamba_slots(hybrid_cache, close_first):
+    cache, allocator, request_pool = hybrid_cache
+    insert_session(cache, [1, 2, 9, 9], "parent")
+    leaf, generation = insert_session(cache, [1, 2, 3, 4], "child")
+    parent_match = cache.match_prefix(MatchPrefixParams(key=RadixKey(array("q", [1, 2, 9, 9]))))
+    full_available = allocator.available_size()
+    mamba_available = request_pool.mamba_allocator.available_size()
+    if close_first:
+        cache.release_radix_session("child")
+    result = cache.retire_beliefkv_child_session(
+        session_id="child", session_generation=generation,
+    )
+    assert result["freed_device_units"] == {0: 2, 2: 1}
+    assert allocator.available_size() == full_available + 2
+    assert request_pool.mamba_allocator.available_size() == mamba_available + 1
+    assert match_length(cache, [1, 2, 9, 9]) == 4
+    assert cache.tree_core.node_by_id(parent_match.last_device_node).component_data[
+        ComponentType.MAMBA
+    ].value is not None
+    assert (leaf.id, leaf.creation_time) in result["discarded_nodes"]
+    cache._execute_and_commit_kv_backup.assert_not_called()
