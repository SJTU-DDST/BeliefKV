+def load_cache_methods():
+    cache = next(
+        node
+        for node in TREE.body
+        if isinstance(node, ast.ClassDef) and node.name == "UnifiedRadixCache"
+    )
+    names = {
+        "supports_beliefkv_resident_parent_prepare",
+        "prepare_host_shadow",
+        "prepare_host_session_nodes",
+        "prefetch_gpu_session_node",
+        "prefetch_gpu_session_nodes",
+        "_start_beliefkv_prefetch_loads",
+        "beliefkv_prefetch_can_admit",
+        "supports_beliefkv_overlap_prefetch",
+        "supports_beliefkv_restore_tiers",
+        "advance_beliefkv_prefetch",
+        "_beliefkv_ack_stream_elapsed_ms",
+        "ready_to_load_host_cache",
+        "init_load_back",
+        "load_back",
+        "loading_check",
+        "_load_back_transfers",
+        "_execute_and_commit_kv_backup",
+        "_execute_kv_backup",
+        "_backup_publish_node_ids",
+        "_track_write_through_node",
+        "_finish_write_through_ack",
+        "writing_check",
+        "_emit_hicache_transfer_commit",
+        "_log_write_ack_metrics",
+    }
+    methods = [
+        node
+        for node in cache.body
+        if isinstance(node, ast.FunctionDef) and node.name in names
+    ]
+    for method in methods:
+        if method.name == "init_load_back":
+            method.decorator_list = []
+    results = [
+        node
+        for node in TREE.body
+        if isinstance(node, ast.ClassDef)
+        and node.name in {
+            "PrepareHostShadowResult",
+            "PrefetchGpuNodeResult",
+            "_OngoingLoadBack",
+            "HiCacheChildCommit",
+            "HiCacheTransferCommit",
+        }
+    ]
+    module = ast.Module(
+        body=[
+            ast.ImportFrom(
+                module="__future__", names=[ast.alias(name="annotations")], level=0
+            ),
+            *results,
+            ast.ClassDef(
+                name="ShadowCache", bases=[], keywords=[], body=methods, decorator_list=[]
+            ),
+        ],
+        type_ignores=[],
+    )
+    ast.fix_missing_locations(module)
+    namespace = {
+        "NamedTuple": NamedTuple,
+        "Optional": Optional,
+        "BASE_COMPONENT_TYPE": ComponentType.FULL,
+        "PoolName": PoolName,
+        "ComponentType": ComponentType,
+        "BackupKV": BackupKV,
+        "_OngoingWriteThrough": _OngoingWriteThrough,
+        "CacheTransferPhase": SimpleNamespace(LOAD_BACK="load_back"),
+        "logger": logging.getLogger(__name__),
+        "time": time,
+    }
+    exec(compile(module, str(SOURCE), "exec"), namespace)
+    return namespace["ShadowCache"], namespace["PrepareHostShadowResult"]
+
+
+ShadowCache, PrepareHostShadowResult = load_cache_methods()
