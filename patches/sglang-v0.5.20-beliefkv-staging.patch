+            if (
+                node.creation_time != created or not validate(node_id, created)
+                or cd.value is None or cd.host_value is None or cd.lock_ref != 0
+                or cd.session_ref != 1
+                or node_id in self.ongoing_write_through
+                or node.write_through_pending_id is not None
+                or node.load_back_pending_id is not None
