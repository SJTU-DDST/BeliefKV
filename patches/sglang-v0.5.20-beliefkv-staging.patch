+            or type(session_generation) is not int
+            or type(leaf_node_id) is not int
+            or type(node_id) is not int
+            or type(leaf_creation_time) not in (int, float)
+            or type(node_creation_time) not in (int, float)
+            or type(beliefkv_command_id) is not str
+            or not beliefkv_command_id
