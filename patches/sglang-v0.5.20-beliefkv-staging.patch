+    def prepare_beliefkv_cold_full_capacity(
+        self, *, full_tokens: int, exclude_node_ids: tuple[NodeId, ...] = (),
+    ) -> tuple[tuple[NodeId, int | float, int], ...]:
+        """Back cold FULL leaves asynchronously; reclaim still requires an ACK."""
+        if (
+            type(full_tokens) is not int or full_tokens <= 0
+            or self._component_available_size(BASE_COMPONENT_TYPE) >= full_tokens
+        ):
+            return ()
+        issued = self._prepare_beliefkv_cold_full_nodes(
+            getattr(self, "beliefkv_handoff_cold_full_candidates", ())[:8],
+            exclude_node_ids=exclude_node_ids, require_device_leaf=True,
+            read_only_backup=True, require_cold_owners=True,
+        )
+        if issued:
+            scan = getattr(self, "_beliefkv_handoff_full_scan", None)
+            self._beliefkv_cold_full_prepare_scan_ref = (
+                weakref_ref(scan) if scan is not None else None
+            )
+        return issued
+
+    def enable_beliefkv_incremental_prepare(self) -> bool:
+        """Track cache commits once; do not rediscover growing contexts per decode."""
+        if (
+            not self.is_write_back or self.host_memory_mode != "cache"
+            or self.buffer_pipeline is not None
+            or not set(self.tree_components) <= {
+                BASE_COMPONENT_TYPE, ComponentType.MAMBA,
+            }
+            or not hasattr(self.tree_core, "beliefkv_full_resident_observer")
+        ):
+            return False
+        self._beliefkv_incremental_full_enabled = True
+        self._beliefkv_unbacked_full = OrderedDict()
+        self.tree_core.beliefkv_full_resident_observer = self._remember_beliefkv_unbacked_full
+        # Activation runs before workload service, not on the scheduler hot path.
+        for node in self.tree_core._node_arena.values():
+            self._remember_beliefkv_unbacked_full(node)
+        return True
+
+    def _remember_beliefkv_unbacked_full(self, node) -> None:
+        pending = self._beliefkv_unbacked_full
+        if self.tree_core._node_arena.get(node.id) is not node:
+            pending.pop(node.id, None)
+            return
+        full = node.component_data[BASE_COMPONENT_TYPE]
+        if node is not self.tree_core.root_node and full.value is not None and full.host_value is None:
+            pending[node.id] = node
+        else:
+            pending.pop(node.id, None)
+
+    def prepare_beliefkv_idle_full(
+        self, *, exclude_node_ids: tuple[NodeId, ...] = (),
+    ) -> tuple[tuple[NodeId, int | float, int], ...]:
+        """Use idle transfer queues for one bounded, non-evicting FULL backup."""
+        stats = getattr(self, "beliefkv_idle_full_prepare_stats", None)
+        if stats is None:
+            stats = self.beliefkv_idle_full_prepare_stats = Counter()
+        stats["checks"] += 1
+        stats["max_batch_bytes"] = BELIEFKV_IDLE_FULL_PREPARE_MAX_BYTES
+        selective = getattr(self, "beliefkv_idle_prepare_policy", "all") == "cold"
+        dirty = getattr(self, "_beliefkv_unbacked_full", None)
+        if dirty is not None:
+            stats["dirty_nodes_last"] = len(dirty)
+            stats["dirty_nodes_high_water"] = max(stats["dirty_nodes_high_water"], len(dirty))
+        controller = self.cache_controller
+        if (
+            controller is None or not self.is_write_back or self.host_memory_mode != "cache"
+            or self.buffer_pipeline is not None
+        ):
+            stats["blocked_unsupported"] += 1
+            return ()
+        queues = (
+            ("write_queue", "blocked_write_queue"),
+            ("load_queue", "blocked_h2d_queue"),
+            ("ack_write_queue", "blocked_d2h_ack"),
+            ("ack_load_queue", "blocked_h2d_ack"),
+        )
+        blocked = False
+        for name, reason in queues:
+            if getattr(controller, name):
+                stats[reason] += 1
+                blocked = True
+        if blocked:
+            stats["blocked_native_queues"] += 1
+            return ()
+        if dirty:
+            prior = getattr(self, "_beliefkv_cold_full_prepare_pending", ())
+            if not any(node_id in self.ongoing_write_through for node_id, _, _ in prior):
+                pool = controller.mem_pool_host
+                unit, page = pool.size_per_token, self.tree_core.page_size
+                if type(unit) is int and unit > 0:
+                    reserved = max(page, BELIEFKV_IDLE_FULL_PREPARE_MAX_BYTES // unit // page * page)
+                    free = pool.available_size()
+                    if type(free) is int and free - reserved < page:
+                        self._beliefkv_cold_full_prepare_pending = ()
+                        self._beliefkv_cold_full_prepare_scan_ref = None
+                        stats["host_free_tokens_last"] = free
+                        stats["host_reserved_tokens"] = reserved
+                        stats["full_bytes_per_token"] = unit
+                        stats["max_scanned_nodes"] = 32
+                        stats["max_merged_nodes"] = 32
+                        stats["host_budget_tokens_last"] = 0
+                        stats["uninspected_nodes_last"] = len(dirty)
+                        stats["dirty_nodes_after_last"] = len(dirty)
+                        stats["host_budget_limited_rounds"] += 1
+                        stats["blocked_host_capacity_rounds"] += 1
+                        stats["host_budget_pre_scan_skips"] += 1
+                        stats["empty_rounds"] += 1
+                        return ()
+        if dirty is not None:
+            candidates = []
+            inspected = []
+            scanned = 0
+            for _ in range(min(32, len(dirty))):
+                node_id, node = dirty.popitem(last=False)
+                scanned += 1
+                stats["scanned_nodes"] += 1
+                full = node.component_data[BASE_COMPONENT_TYPE]
+                try:
+                    live = self.tree_core.node_by_id(node_id) is node
+                except (KeyError, RuntimeError, ValueError):
+                    live = False
+                if not live or full.value is None or full.host_value is not None:
+                    stats["stale_nodes"] += 1
+                    continue
