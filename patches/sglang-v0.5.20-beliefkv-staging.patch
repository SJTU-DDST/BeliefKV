+"""Discover native recovery victims only while allocator capacity is missing."""
+
+from collections import Counter
+from unittest.mock import Mock
+
+import pytest
+
+from sglang.srt.mem_cache.unified_cache.component_type import ComponentType as CT
+from test_beliefkv_terminal_capacity import hybrid_cache, insert_session
+
+
+def fixture(hybrid_cache, *, referenced=True, count=8, backed_states=False):
+    cache, allocator, pool = hybrid_cache
+    nodes = []
+    for index in range(count):
+        node, _ = insert_session(cache, [100 + index, 1000 + index], "waiting")
+        nodes.append(node)
+    if not referenced:
+        cache.release_radix_session("waiting")
+    for node in nodes:
+        full = node.component_data[CT.FULL]
+        full.host_value = full.value.clone()
+        if backed_states:
+            state = node.component_data[CT.MAMBA]
+            state.host_value = state.value.clone()
+        cache.tree_core._update_duplicate_tracking(node)
+
+    class OrderedLeaves(set):
+        iterations = 0
+
+        def __iter__(self):
+            self.iterations += 1
+            return (node for node in nodes if set.__contains__(self, node))
+
+    cache.tree_core.evictable_device_leaves = OrderedLeaves(
+        cache.tree_core.evictable_device_leaves,
+    )
+    cache.is_write_back = True
+    cache.beliefkv_join_pressure_candidates = ()
+    cache.beliefkv_join_pressure_validator = lambda *_: False
+    cache.beliefkv_cold_full_owner_validator = Mock(return_value=True)
+    return cache, allocator, pool, nodes
+
+
+@pytest.mark.parametrize("hybrid_cache", (32,), indirect=True)
+@pytest.mark.parametrize("referenced", (False, True))
+def test_first_sufficient_victim_stops_discovery_without_skipping_commit_validation(
+    hybrid_cache, referenced,
+):
+    cache, allocator, pool, nodes = fixture(hybrid_cache, referenced=referenced)
+    available = allocator.available_size()
+    state_available = pool.mamba_allocator.available_size()
+    assert cache.reclaim_beliefkv_handoff_capacity(
+        full_tokens=available + 2, mamba_slots=0, collect_diagnostics=True,
+    )[int(CT.FULL)] == 2
+    diagnosis = cache.beliefkv_handoff_last_capacity
+    assert diagnosis["native_full_scanned"] == 1
+    assert diagnosis["native_full_selected"] == 1
+    assert diagnosis["transaction_attempts"] == 1
+    assert diagnosis["native_full_scan_remaining"] == 7
+    assert diagnosis["full_target_satisfied"]
+    assert nodes[0].component_data[CT.FULL].value is None
+    assert all(node.component_data[CT.FULL].value is not None for node in nodes[1:])
+    assert cache.beliefkv_cold_full_owner_validator.call_count == (2 if referenced else 0)
+    if referenced:
+        assert pool.mamba_allocator.available_size() == state_available
+        assert all(node.component_data[CT.MAMBA].value is not None for node in nodes)
+    cache._execute_and_commit_kv_backup.assert_not_called()
+
+
+@pytest.mark.parametrize("hybrid_cache", (32,), indirect=True)
+@pytest.mark.parametrize("changed", ("owner", "lock", "pending", "host_lost", "creation"))
+def test_rejected_first_transaction_continues_with_the_next_native_victim(
+    hybrid_cache, changed,
+):
+    cache, allocator, _, nodes = fixture(hybrid_cache)
+    first = nodes[0]
+    check = cache._beliefkv_causal_full_owner_refs
+    calls = Counter()
+
+    def revalidate(node, **kwargs):
+        calls[node.id] += 1
+        if node is first and calls[node.id] == 2:
+            if changed == "owner":
+                return None
+            if changed == "lock":
+                node.component_data[CT.FULL].lock_ref = 1
+            elif changed == "pending":
+                node.load_back_pending_id = node.id
+            elif changed == "host_lost":
+                node.component_data[CT.FULL].host_value = None
+            else:
+                node.creation_time += 1
+        return check(node, **kwargs)
+
+    cache._beliefkv_causal_full_owner_refs = revalidate
+    available = allocator.available_size()
+    assert cache.reclaim_beliefkv_handoff_capacity(
+        full_tokens=available + 2, mamba_slots=0, collect_diagnostics=True,
+    ) == {int(CT.FULL): 2}
+    assert first.component_data[CT.FULL].value is not None
+    assert nodes[1].component_data[CT.FULL].value is None
+    assert allocator.available_size() == available + 2
+    assert calls[first.id] == calls[nodes[1].id] == 2
+    diagnosis = cache.beliefkv_handoff_last_capacity
+    assert diagnosis["native_full_selected"] == 2
+    assert diagnosis["transaction_attempts"] == 2
+    cache._execute_and_commit_kv_backup.assert_not_called()
+
+
+@pytest.mark.parametrize("hybrid_cache", (32,), indirect=True)
+def test_mamba_iteration_survives_each_previous_victim_leaving_its_lru(hybrid_cache):
+    cache, allocator, pool, _ = fixture(
+        hybrid_cache, referenced=False, backed_states=True,
+    )
+    available, states = allocator.available_size(), pool.mamba_allocator.available_size()
+    assert cache.reclaim_beliefkv_handoff_capacity(
+        full_tokens=available, mamba_slots=states + 3, collect_diagnostics=True,
+    ) == {int(CT.MAMBA): 3}
+    assert allocator.available_size() == available
+    assert pool.mamba_allocator.available_size() == states + 3
+    assert cache.beliefkv_handoff_last_capacity["transaction_attempts"] == 3
+    assert cache.beliefkv_handoff_last_capacity["native_full_scanned"] == 0
+    assert cache.beliefkv_handoff_last_capacity["mamba_target_satisfied"]
+    cache._execute_and_commit_kv_backup.assert_not_called()
+
+
+@pytest.mark.parametrize("hybrid_cache", (32,), indirect=True)
+def test_fitting_capacity_does_not_start_a_native_scan(hybrid_cache):
+    cache, allocator, _, _ = fixture(hybrid_cache)
+    leaves = cache.tree_core.evictable_device_leaves
+    cache._beliefkv_causal_full_donor = Mock(side_effect=AssertionError("no capacity shortfall"))
+    assert cache.reclaim_beliefkv_handoff_capacity(
+        full_tokens=allocator.available_size(), mamba_slots=0, collect_diagnostics=True,
+    ) == {}
+    assert leaves.iterations == 0
+    assert not cache.beliefkv_handoff_last_capacity["native_fallback_considered"]
+
+
+@pytest.mark.parametrize("hybrid_cache", (32,), indirect=True)
+@pytest.mark.parametrize("max_nodes", (1, 2))
+def test_scan_and_transaction_budgets_are_preserved_across_capacity_retries(
+    hybrid_cache, max_nodes,
+):
+    cache, allocator, _, _ = fixture(hybrid_cache)
+    target = allocator.available_size() + 4
+    assert cache.reclaim_beliefkv_handoff_capacity(
+        full_tokens=target, mamba_slots=0, max_nodes=max_nodes,
+        collect_diagnostics=True,
+    ) == {int(CT.FULL): 2 * max_nodes}
+    diagnosis = cache.beliefkv_handoff_last_capacity
+    assert diagnosis["native_full_scanned"] == max_nodes
+    assert diagnosis["transaction_attempts"] == max_nodes
+    assert diagnosis["transaction_truncated"] is (max_nodes == 1)
+    if max_nodes == 1:
+        assert cache.reclaim_beliefkv_handoff_capacity(
+            full_tokens=target, mamba_slots=0, max_nodes=max_nodes,
+            collect_diagnostics=True,
+        ) == {int(CT.FULL): 2}
+    assert allocator.available_size() == target
+    assert cache.beliefkv_handoff_last_capacity["full_target_satisfied"]
+
+
+@pytest.mark.parametrize("hybrid_cache", (32,), indirect=True)
+def test_eight_candidate_limit_still_bounds_native_discovery(hybrid_cache):
+    cache, allocator, _, _ = fixture(hybrid_cache, count=10)
+    available = allocator.available_size()
+    assert cache.reclaim_beliefkv_handoff_capacity(
+        full_tokens=available + 20, mamba_slots=0, collect_diagnostics=True,
+    ) == {int(CT.FULL): 16}
+    diagnosis = cache.beliefkv_handoff_last_capacity
+    assert diagnosis["native_full_selected"] == 8
+    assert diagnosis["transaction_attempts"] == 8
+    assert diagnosis["native_full_scan_truncated"]
+    assert not diagnosis["full_target_satisfied"]
