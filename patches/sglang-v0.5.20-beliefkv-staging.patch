+        return_value=SimpleNamespace(delta=0, to_dec_params=lambda: "device")
+    )
+    cache._components_tuple = tuple(
+        SimpleNamespace(
+            component_type=ct, prepare_load_back=Mock(return_value=object()),
+            finalize_load_back=Mock(),
+        )
+        for ct in (ComponentType.FULL, ComponentType.MAMBA)
+    )
+    cache.cache_controller.load_queue = []
+    cache.cache_controller.start_loading = Mock(return_value=1)
+
+    def load(host_indices, *, node_id, extra_pools, beliefkv_command_id,
+             beliefkv_before_enqueue, beliefkv_no_device_reclaim):
+        operation = SimpleNamespace(
+            beliefkv_command_id=beliefkv_command_id, node_id=node_id,
+            host_indices=host_indices, extra_pools=extra_pools,
+        )
+        if beliefkv_before_enqueue is not None and not beliefkv_before_enqueue(operation):
+            return None
+        cache.cache_controller.load_queue.append(operation)
+        return torch.arange(len(host_indices))
+
+    def commit(node_id, device_indices, kv_xfer, comp_xfers):
+        target = nodes[node_id]
+        if len(device_indices):
+            target.component_data[ComponentType.FULL].value = device_indices
+        for ct, transfers in comp_xfers.items():
+            target.component_data[ct].value = torch.arange(
+                sum(len(transfer.host_indices) for transfer in transfers)
+            )
+        target.load_back_pending_id = node_id
+        return []
+
+    cache.cache_controller.load = Mock(side_effect=load)
+    cache.tree_core.commit_load_back = Mock(side_effect=commit)
+    cache._apply_cache_actions = Mock()
+    cache.evict_for_alloc = Mock(side_effect=AssertionError("device eviction is forbidden"))
+    return result
