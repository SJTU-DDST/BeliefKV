+            node_id, created = pending.pop()
+            if (node_id, created) in visited:
+                continue
+            attempts += 1
+            try:
+                node = self.tree_core.node_by_id(node_id)
+            except (KeyError, RuntimeError, ValueError):
+                continue
+            if node is self.tree_core.root_node or node.creation_time != created:
+                continue
+            if any(cd.session_ref for cd in node.component_data):
+                continue
+            if node.children:
+                continue
