+"""CPU-only tests for UnifiedRadixCache's optional post-commit observer."""
+
+import ast
+import logging
+import unittest
+from pathlib import Path
+from types import SimpleNamespace
+from typing import NamedTuple
+from unittest.mock import Mock
+
+
+SOURCE = (
+    Path(__file__).resolve().parents[2]
+    / "python/sglang/srt/mem_cache/unified_radix_cache.py"
+)
+TREE = ast.parse(SOURCE.read_text(encoding="utf-8"))
+
+
+def load_ack_methods():
+    cache = next(
+        node
+        for node in TREE.body
+        if isinstance(node, ast.ClassDef) and node.name == "UnifiedRadixCache"
+    )
+    methods = [
+        node
+        for node in cache.body
+        if isinstance(node, ast.FunctionDef)
+        and node.name
+        in {
+            "writing_check",
+            "loading_check",
+            "_finish_write_through_ack",
+            "_emit_hicache_transfer_commit",
+            "_log_write_ack_metrics",
+        }
+    ]
+    events = [
+        node
+        for node in TREE.body
+        if isinstance(node, ast.ClassDef)
+        and node.name in {"HiCacheChildCommit", "HiCacheTransferCommit"}
+    ]
+    module = ast.Module(
+        body=[
+            ast.ImportFrom(
+                module="__future__",
+                names=[ast.alias(name="annotations")],
+                level=0,
+            ),
+            *events,
+            ast.ClassDef(
+                name="AckCache", bases=[], keywords=[], body=methods, decorator_list=[]
+            ),
+        ],
+        type_ignores=[],
+    )
+    ast.fix_missing_locations(module)
+    namespace = {"NamedTuple": NamedTuple, "logger": logging.getLogger(__name__)}
+    exec(compile(module, str(SOURCE), "exec"), namespace)
+    return namespace["AckCache"], namespace["HiCacheTransferCommit"], cache
+
+
+AckCache, HiCacheTransferCommit, CACHE_AST = load_ack_methods()
+
+
+def ack(node_ids, counts=None, log=None, child_receipts=(), num_bytes=0):
+    event = Mock()
+    event.synchronize.side_effect = lambda: log.append("sync") if log is not None else None
+    return SimpleNamespace(
+        node_ids=node_ids,
+        finish_event=event,
+        num_tokens_by_pool=counts,
+        num_bytes=num_bytes,
+        child_receipts=child_receipts,
+        timing_enabled=False,
+    )
+
+
+def cache_fixture():
+    cache = AckCache()
+    cache.on_hicache_transfer_commit = None
+    cache.metrics_collector = None
+    cache.buffer_pipeline = None
+    cache.enable_storage = False
+    cache.ongoing_write_through = {}
+    cache.ongoing_load_back = {}
+    cache.cache_controller = SimpleNamespace(ack_write_queue=[], ack_load_queue=[])
+    cache.tree_core = SimpleNamespace(
+        finish_write_through=Mock(), finish_load_back=Mock()
+    )
+    cache.dec_lock_ref = Mock()
+    cache.dec_host_lock_ref = Mock()
+    cache.write_backup_storage = Mock()
+    return cache
+
+
+class TestUnifiedAck(unittest.TestCase):
+    def test_native_action_paths_forward_optional_command_identity(self):
+        for name in (
+            "_execute_and_commit_kv_backup",
+            "_execute_kv_backup",
+            "load_back",
+            "_load_back_transfers",
+        ):
+            method = next(
+                node
+                for node in CACHE_AST.body
+                if isinstance(node, ast.FunctionDef) and node.name == name
+            )
+            self.assertIn(
+                "beliefkv_command_id",
+                {arg.arg for arg in method.args.kwonlyargs},
+            )
+            self.assertTrue(
+                any(
+                    isinstance(node, ast.keyword)
+                    and node.arg == "beliefkv_command_id"
+                    for node in ast.walk(method)
+                )
+            )
+
+    def test_merged_ack_attributes_only_valid_tagged_child_after_split_commit(self):
+        cache = cache_fixture()
+        events = []
+        cache.on_hicache_transfer_commit = events.append
+        cache.ongoing_write_through = {
+            1: (1, "lock1", [1, 11]),
+            2: (2, "lock2", [2]),
+        }
+        receipts = (
+            SimpleNamespace(
+                command_id="prepare-1",
+                node_id=1,
+                num_tokens_by_pool=(("kv", 8), ("mamba", 2)),
+                num_bytes=100,
+            ),
+            SimpleNamespace(
+                command_id=None,
+                node_id=2,
+                num_tokens_by_pool=(("kv", 4),),
+                num_bytes=40,
+            ),
+        )
+        cache.cache_controller.ack_write_queue = [
+            ack(
+                [1, 2],
+                {"kv": 12, "mamba": 2},
+                child_receipts=receipts,
+                num_bytes=140,
+            )
+        ]
+
+        cache.writing_check(finish_count=1)
+
+        self.assertEqual(len(events), 1)
+        self.assertEqual(events[0].node_ids, (1, 11, 2))
+        self.assertEqual(len(events[0].child_commits), 1)
+        child = events[0].child_commits[0]
+        self.assertEqual(child.command_id, "prepare-1")
+        self.assertEqual(child.anchor_node_id, 1)
+        self.assertEqual(child.published_node_ids, (1, 11))
+        self.assertEqual(child.num_tokens_by_pool, (("kv", 8), ("mamba", 2)))
+        self.assertEqual(child.num_bytes, 100)
+
+    def test_mismatched_merged_receipt_never_certifies_command(self):
+        cache = cache_fixture()
+        events = []
+        cache.on_hicache_transfer_commit = events.append
+        cache.ongoing_load_back = {7: (7, "lock", "host-lock")}
+        cache.cache_controller.ack_load_queue = [
+            ack(
+                [7],
+                {"kv": 0, "mamba": 2},
+                child_receipts=(
+                    SimpleNamespace(
+                        command_id="prefetch-7",
+                        node_id=7,
+                        num_tokens_by_pool=(("kv", 0), ("mamba", 2)),
+                        num_bytes=1,
+                    ),
+                ),
+                num_bytes=8,
+            )
+        ]
+
+        cache.loading_check(finish_count=1)
+
+        self.assertEqual(events[0].child_commits, ())
+        self.assertEqual(events[0].status, "completed")
+
+    def test_constructor_defaults_observer_to_none(self):
+        init = next(
+            node
+            for node in CACHE_AST.body
+            if isinstance(node, ast.FunctionDef) and node.name == "__init__"
+        )
+        assignments = [
+            node
+            for node in ast.walk(init)
+            if isinstance(node, ast.AnnAssign)
+            and isinstance(node.target, ast.Attribute)
+            and node.target.attr == "on_hicache_transfer_commit"
+        ]
+        self.assertEqual(len(assignments), 1)
+        self.assertIsInstance(assignments[0].value, ast.Constant)
+        self.assertIsNone(assignments[0].value.value)
+
+    def test_merged_write_ack_follows_split_tree_and_lock_commit(self):
+        cache = cache_fixture()
+        log = []
+        cache.on_hicache_transfer_commit = lambda event: log.append(("callback", event))
+        cache.tree_core.finish_write_through.side_effect = (
+            lambda ids, ack_id: log.append(("tree", tuple(ids), ack_id))
+        )
+        cache.dec_lock_ref.side_effect = lambda *args: log.append(("unlock", args[0]))
+        cache.ongoing_write_through = {
+            1: (1, "lock1", [1, 11]),
+            2: (2, "lock2", [2]),
+        }
+        cache.cache_controller.ack_write_queue = [
+            ack([1, 2], {"mamba": 4, "kv": 12}, log)
+        ]
+
+        cache.writing_check(finish_count=1)
+
+        self.assertEqual(
+            log,
+            [
+                "sync",
+                ("tree", (1, 11), 1),
+                ("unlock", 1),
+                ("tree", (2,), 2),
+                ("unlock", 2),
+                (
+                    "callback",
+                    HiCacheTransferCommit(
+                        "d2h", (1, 11, 2), (("kv", 12), ("mamba", 4)), "completed"
+                    ),
+                ),
+            ],
+        )
+        self.assertEqual(cache.cache_controller.ack_write_queue, [])
+        self.assertEqual(cache.ongoing_write_through, {})
+
+    def test_write_back_waits_and_skips_untracked_ack_ids(self):
+        cache = cache_fixture()
+        events = []
+        cache.on_hicache_transfer_commit = events.append
+        cache.ongoing_write_through = {3: (3, None, [3])}
+        cache.cache_controller.ack_write_queue = [
+            ack([99, 3], {"kv": 5, "mamba": 1})
+        ]
+
+        cache.writing_check(write_back=True)
+
+        self.assertEqual(
+            events,
+            [HiCacheTransferCommit("d2h", (3,), (), "completed")],
+        )
+        cache.dec_lock_ref.assert_not_called()
+        cache.tree_core.finish_write_through.assert_called_once_with([3], 3)
+
+    def test_load_ack_follows_both_unlocks_and_tree_finish(self):
+        cache = cache_fixture()
+        log = []
+        cache.dec_lock_ref.side_effect = lambda *args: log.append("device_unlock")
+        cache.dec_host_lock_ref.side_effect = lambda *args: log.append("host_unlock")
+        cache.tree_core.finish_load_back.side_effect = lambda *args: log.append("tree")
+        cache.on_hicache_transfer_commit = lambda event: log.append(event)
+        cache.ongoing_load_back = {7: (7, "device_lock", "host_lock")}
+        cache.cache_controller.ack_load_queue = [
+            ack([7], {"kv": 0, "mamba": 2}, log)
+        ]
+
+        cache.loading_check(finish_count=1)
