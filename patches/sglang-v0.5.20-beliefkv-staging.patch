+def install_production_cpu_controller(cache):
+    import torch
+
+    cache.tree_core.set_hicache_enabled()
+    cache.tree_core.is_write_back = True
+    cache._execute_and_commit_kv_backup = (
+        type(cache)._execute_and_commit_kv_backup.__get__(cache)
+    )
+    cache.metrics_collector = None
+    controller = cache.cache_controller
+    operations, commits = [], []
+    cache.on_hicache_transfer_commit = commits.append
+
+    def write(device_indices, **kwargs):
+        assert kwargs["extra_pools"] is None
+        assert kwargs["beliefkv_defer_writing"] is True
+        start = 20 + sum(len(op.device_indices) for op in operations)
+        host_indices = torch.arange(start, start + len(device_indices), dtype=torch.int64)
+        operations.append(NS(
+            node_id=kwargs["node_id"], host_indices=host_indices,
+            device_indices=device_indices.clone(),
+        ))
+        controller.write_queue.append(operations[-1])
+        return host_indices
+
+    def start():
+        units = sum(len(op.device_indices) for op in controller.write_queue)
+        controller.ack_write_queue.append(NS(
+            node_ids=[op.node_id for op in controller.write_queue],
+            finish_event=NS(synchronize=Mock()), timing_enabled=False,
+            num_tokens_by_pool={"kv": units},
+            num_bytes=units * controller.mem_pool_host.size_per_token,
+            submit_ts_ms=None, submit_mono=None, unacked_bytes_at_submit=0,
+        ))
+        controller.write_queue.clear()
+
+    controller.write = write
+    controller.start_writing = Mock(side_effect=start)
+    return operations, commits
+
