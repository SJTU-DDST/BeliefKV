+    assert cache.reclaim_beliefkv_handoff_capacity(full_tokens=target, mamba_slots=0) == {}
+    cache.tree_core.finish_write_through([prefix.id], prefix.id)
+    del cache.ongoing_write_through[prefix.id]
+    cache.dec_lock_ref(prefix.id, locks[prefix.id])
+    assert cache.reclaim_beliefkv_handoff_capacity(
+        full_tokens=target, mamba_slots=0,
+    ) == {int(CT.FULL): 2}
+    assert allocator.available_size() == target
+    assert prefix.component_data[CT.MAMBA].host_value is None
