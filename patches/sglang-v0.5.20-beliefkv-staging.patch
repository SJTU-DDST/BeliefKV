+    def _beliefkv_idle_full_is_cold(self, node) -> bool:
+        """Cheap backup eligibility; this is not permission to evict a page."""
+        if any(cd.lock_ref for cd in node.component_data):
+            return False
+        full = node.component_data[BASE_COMPONENT_TYPE]
+        if full.session_ref == 0:
+            return not full.session_ids
+        owners = full.session_ids
+        validate = getattr(self, "beliefkv_backup_full_owner_validator", None)
+        if (
+            not callable(validate) or type(owners) is not set
+            or not owners or len(owners) != full.session_ref
+        ):
+            # Inherited/shared coverage needs a subtree proof for eviction.
+            # Background selection never pays for that proof.
+            return False
+        tracker = self.session_refs
+        generations = tracker._session_generations
+        if any(owner not in generations or owner in tracker._closed_session_ids for owner in owners):
+            return False
+        return validate(tuple((owner, generations[owner]) for owner in owners)) is True
