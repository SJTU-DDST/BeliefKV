+class TestPrefetchGpuNode(unittest.TestCase):
+    def test_ancestor_burst_submits_once_without_waiting_for_each_ack(self):
+        cache, _, parent, leaf, _, _, args = fixture()
+        controller = cache.cache_controller
+        controller.load_queue = []
+        controller.start_loading = Mock(return_value=1)
+        for target in (parent, leaf):
+            target.component_data[ComponentType.FULL].host_value = torch.arange(2)
+            target.component_data[ComponentType.FULL].value = None
+        leaf.component_data[ComponentType.MAMBA].host_value = torch.arange(1)
+
+        def spec(node_id, *, include_mamba):
+            return (
+                SimpleNamespace(host_indices=torch.arange(2), nodes_to_load=[node_id]),
+                {ComponentType.MAMBA: [SimpleNamespace(nodes_to_load=[node_id])]}
+                if include_mamba else {},
+            )
+
+        def load(node_id, **kwargs):
+            target = parent if node_id == parent.id else leaf
+            target.component_data[ComponentType.FULL].value = torch.arange(2)
+            target.load_back_pending_id = node_id
+            cache.ongoing_load_back[node_id] = object()
+            controller.load_queue.append(SimpleNamespace(
+                beliefkv_command_id=kwargs["beliefkv_command_id"],
+            ))
+            return True
+
+        cache.tree_core.build_load_back_spec = Mock(side_effect=spec)
+        cache.load_back = Mock(side_effect=load)
+        result = cache.prefetch_gpu_session_nodes(
+            session_id=args["session_id"], session_generation=args["session_generation"],
+            leaf_node_id=args["leaf_node_id"], leaf_creation_time=args["leaf_creation_time"],
+            nodes=((parent.id, parent.creation_time, False, "a"),
+                   (leaf.id, leaf.creation_time, True, "b")),
+            beliefkv_before_enqueue=lambda op: True,
+        )
+        self.assertEqual([item.node_id for item in result], [parent.id, leaf.id])
+        self.assertTrue(all(item.load_started for item in result))
+        controller.start_loading.assert_called_once()
+        self.assertEqual(cache.load_back.call_count, 2)
+        self.assertFalse(cache.load_back.call_args_list[0].kwargs["beliefkv_include_mamba"])
+        self.assertTrue(cache.load_back.call_args_list[1].kwargs["beliefkv_include_mamba"])
+
