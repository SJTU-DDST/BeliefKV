+    def _try_write_back_chain(
+        self, node_id: NodeId, tracker: dict[ComponentType, int], full_tokens: int
+    ) -> bool:
+        max_nodes = getattr(self, "write_back_batch_nodes", 1)
+        if max_nodes <= 1:
+            return False
+        counts = self.write_back_batch_counts
+        counts["attempts"] = counts.get("attempts", 0) + 1
+        if (
+            self.buffer_pipeline is not None
+            or set(self.tree_components) - {ComponentType.FULL, ComponentType.MAMBA}
+            or self.cache_controller.write_queue
+        ):
+            counts["unsupported_or_queued"] = counts.get("unsupported_or_queued", 0) + 1
+            return False
+        component = getattr(self.tree_core, "components_by_type", {}).get(
+            BASE_COMPONENT_TYPE
+        )
+        planner = getattr(component, "plan_write_back_chain", None)
+        if not callable(planner):
+            counts["no_planner"] = counts.get("no_planner", 0) + 1
+            return False
+        plan = planner(node_id, full_tokens, max_nodes)
+        if len(plan) < 2:
+            counts["no_chain"] = counts.get("no_chain", 0) + 1
+            return False
+        counts["planned_nodes"] = counts.get("planned_nodes", 0) + len(plan)
+
+        queued = []
+        before = tracker[BASE_COMPONENT_TYPE]
+        try:
+            for candidate in plan:
+                self._execute_and_commit_kv_backup(
+                    BackupKV([candidate]),
+                    write_back=True,
+                    no_host_reclaim=False,
+                    beliefkv_defer_writing=True,
+                )
+                if candidate not in self.ongoing_write_through:
+                    counts["enqueue_failed"] = counts.get("enqueue_failed", 0) + 1
+                    break
+                queued.append(candidate)
+        finally:
+            if queued:
+                self.cache_controller.start_writing()
+                self.writing_check(write_back=True)
+                for candidate in queued:
+                    self._demote(candidate, tracker)
+                component.finish_write_back_chain(queued[-1])
+                counts["batches"] += 1
+                counts["nodes"] += len(queued)
+                counts["full_tokens"] += tracker[BASE_COMPONENT_TYPE] - before
+                counts["partial_batches"] += int(len(queued) < len(plan))
+        return bool(queued)
