+class BeliefKVMetadataTest(unittest.TestCase):
+    def test_openai_request_preserves_metadata_and_session_id(self):
+        metadata = {"conversation_id": "conversation", "turn_id": "turn-1"}
+        request = ChatCompletionRequest.model_validate(
+            {
+                "model": "test",
+                "messages": [{"role": "user", "content": "hello"}],
