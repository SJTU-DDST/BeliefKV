+        scheduler.enable_priority_scheduling = True
+        scheduler.schedule_low_priority_values_first = True
+        scheduler._release_aborted_request = Mock()
+        scheduler.beam_coordinator = SimpleNamespace(retire_group=Mock())
+        sender = SimpleNamespace(send_output=Mock())
+        scheduler.ipc_channels = SimpleNamespace(send_to_tokenizer=sender)
+        incoming = request("incoming", {"turn_id": "new"})
+        incoming.priority = 1
+        incoming.time_stats.wait_queue_entry_time = 2
+
+        scheduler._add_request_to_queue(incoming)
+        self.assertEqual(scheduler.waiting_queue, [incoming])
+        self.assertEqual(scheduler._beliefkv_registered_request_ids, {"incoming"})
+        runtime.on_abort_request.assert_called_once()
+        self.assertEqual(runtime.on_abort_request.call_args.args[0].rid, "evicted")
+
+    def test_exact_eviction_rejects_overlapping_abort_prefix(self):
+        runtime = Mock()
+        scheduler = scheduler_fixture(runtime)
+        scheduler._beliefkv_registered_request_ids.update(("id", "id-child"))
+        abort = SimpleNamespace(rid="id", abort_all=False)
+        with self.assertRaisesRegex(RuntimeError, "ambiguous request prefix"):
+            scheduler._beliefkv_on_abort(abort, exact=True)
