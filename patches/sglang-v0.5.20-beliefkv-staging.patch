+        self.assertEqual(
+            log,
+            [
+                "sync",
+                "device_unlock",
+                "host_unlock",
+                "tree",
+                HiCacheTransferCommit(
+                    "h2d", (7,), (("kv", 0), ("mamba", 2)), "completed"
+                ),
+            ],
+        )
+
+    def test_buffer_only_acks_emit_nothing(self):
+        cache = cache_fixture()
+        events = []
+        cache.on_hicache_transfer_commit = events.append
+        cache.buffer_pipeline = SimpleNamespace(
+            finish_backup_ack=Mock(), try_finish_load_back=Mock(return_value=True)
+        )
+        cache.cache_controller.ack_write_queue = [ack([5], {"kv": 4})]
+        cache.cache_controller.ack_load_queue = [ack([6], {"kv": 4})]
+
+        cache.writing_check(finish_count=1)
+        cache.loading_check(finish_count=1)
