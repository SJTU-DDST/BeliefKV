+    elif blocked in ("unaligned", "whole_extent", "zero"):
+        kwargs["prefix_tokens"] = {"unaligned": 3, "whole_extent": 8, "zero": 0}[blocked]
+    else:
+        cache.tree_core._unevict_node_on_insert(leaf, allocator.alloc(8))
+    before = allocator.available_size()
+    assert cache.split_beliefkv_prefetch_full_prefix(**kwargs) is None
