+"""CPU-only tests for UnifiedRadixCache's optional post-commit observer."""
+
+import ast
+import logging
+import time
+import unittest
+from pathlib import Path
+from types import SimpleNamespace
+from typing import NamedTuple
+from unittest.mock import Mock
+
+
+SOURCE = (
+    Path(__file__).resolve().parents[2]
+    / "python/sglang/srt/mem_cache/unified_radix_cache.py"
+)
+TREE = ast.parse(SOURCE.read_text(encoding="utf-8"))
+
+
+def load_ack_methods():
+    cache = next(
+        node
+        for node in TREE.body
+        if isinstance(node, ast.ClassDef) and node.name == "UnifiedRadixCache"
+    )
+    methods = [
+        node
+        for node in cache.body
+        if isinstance(node, ast.FunctionDef)
+        and node.name
+        in {
+            "writing_check",
+            "loading_check",
+            "_finish_write_through_ack",
+            "_emit_hicache_transfer_commit",
+            "_log_write_ack_metrics",
+        }
+    ]
+    events = [
+        node
+        for node in TREE.body
+        if isinstance(node, ast.ClassDef)
+        and node.name in {"HiCacheChildCommit", "HiCacheTransferCommit"}
+    ]
+    module = ast.Module(
+        body=[
+            ast.ImportFrom(
+                module="__future__",
+                names=[ast.alias(name="annotations")],
+                level=0,
+            ),
+            *events,
+            ast.ClassDef(
+                name="AckCache", bases=[], keywords=[], body=methods, decorator_list=[]
+            ),
+        ],
+        type_ignores=[],
+    )
+    ast.fix_missing_locations(module)
+    namespace = {
+        "NamedTuple": NamedTuple,
+        "logger": logging.getLogger(__name__),
+        "time": time,
+    }
+    exec(compile(module, str(SOURCE), "exec"), namespace)
+    return namespace["AckCache"], namespace["HiCacheTransferCommit"], cache
+
+
+AckCache, HiCacheTransferCommit, CACHE_AST = load_ack_methods()
+
+
+def ack(node_ids, counts=None, log=None, child_receipts=(), num_bytes=0,
+        submit_ts_ms=None, submit_mono=None, timing_enabled=False):
+    event = Mock()
+    event.synchronize.side_effect = lambda: log.append("sync") if log is not None else None
+    return SimpleNamespace(
+        node_ids=node_ids,
+        start_event=Mock(),
+        finish_event=event,
+        num_tokens_by_pool=counts,
+        num_bytes=num_bytes,
+        child_receipts=child_receipts,
+        timing_enabled=timing_enabled,
+        submit_ts_ms=submit_ts_ms,
+        submit_mono=submit_mono,
+        unacked_bytes_at_submit=512 if submit_ts_ms is not None else None,
+    )
+
+
+def cache_fixture():
+    cache = AckCache()
+    cache.on_hicache_transfer_commit = None
+    cache.metrics_collector = None
+    cache.buffer_pipeline = None
+    cache.enable_storage = False
+    cache.ongoing_write_through = {}
+    cache.ongoing_load_back = {}
+    cache.cache_controller = SimpleNamespace(ack_write_queue=[], ack_load_queue=[])
+    cache.tree_core = SimpleNamespace(
+        finish_write_through=Mock(), finish_load_back=Mock()
+    )
+    cache.dec_lock_ref = Mock()
+    cache.dec_host_lock_ref = Mock()
+    cache.write_backup_storage = Mock()
+    return cache
+
+
+class TestUnifiedAck(unittest.TestCase):
+    def test_ack_carries_measured_transfer_stream_and_submit_to_ack(self):
+        cache = cache_fixture()
+        events = []
+        cache.on_hicache_transfer_commit = events.append
+        cache.ongoing_write_through = {1: (1, "lock", [1])}
+        transfer = ack(
+            [1], {"kv": 8}, num_bytes=4096,
+            submit_ts_ms=1000.0, submit_mono=0.0, timing_enabled=True,
+        )
+        transfer.start_event.elapsed_time.return_value = 1.5
+        cache.cache_controller.ack_write_queue = [transfer]
+        cache._finish_write_through_ack = Mock(return_value=[1])
+
+        cache.writing_check(finish_count=1)
+
+        self.assertEqual(len(events), 1)
+        self.assertEqual(events[0].actual_bytes, 4096)
+        self.assertEqual(events[0].submit_ts_ms, 1000.0)
+        self.assertEqual(events[0].transfer_stream_elapsed_ms, 1.5)
+        self.assertEqual(events[0].unacked_bytes_at_submit, 512)
+        self.assertGreater(events[0].submit_to_ack_ms, 0)
+
+    def test_native_action_paths_forward_optional_command_identity(self):
+        for name in (
+            "_execute_and_commit_kv_backup",
+            "_execute_kv_backup",
+            "load_back",
+            "_load_back_transfers",
+        ):
+            method = next(
+                node
+                for node in CACHE_AST.body
+                if isinstance(node, ast.FunctionDef) and node.name == name
+            )
+            self.assertIn(
+                "beliefkv_command_id",
+                {arg.arg for arg in method.args.kwonlyargs},
+            )
+            self.assertTrue(
+                any(
+                    isinstance(node, ast.keyword)
+                    and node.arg == "beliefkv_command_id"
+                    for node in ast.walk(method)
+                )
+            )
+
