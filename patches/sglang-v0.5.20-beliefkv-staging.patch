+"""The optional probe must preserve native load wait semantics."""
+
+import ast
+from pathlib import Path
+from types import SimpleNamespace
+
+
+SOURCE = Path(__file__).resolve().parents[2] / "python/sglang/srt/managers/cache_controller.py"
+
+
+def counter_class():
+    tree = ast.parse(SOURCE.read_text())
+    node = next(item for item in tree.body
+                if isinstance(item, ast.ClassDef) and item.name == "LayerDoneCounter")
+    module = ast.fix_missing_locations(ast.Module(body=[node], type_ignores=[]))
+    namespace = {
+        "LayerLoadingEvent": lambda _: SimpleNamespace(finish_event=SimpleNamespace(query=lambda: True)),
+    }
+    exec(compile(module, str(SOURCE), "exec"), namespace)
+    return namespace["LayerDoneCounter"]
+
+
+def test_optional_probe_preserves_waits_and_reset():
+    counter = counter_class()(2)
+    calls = []
+    counter.events[0].wait = lambda layer: calls.append(("native", layer))
+    counter.wait_until(0)
+    assert calls == []
+    counter.set_consumer(0)
+    counter.wait_until(1)
+    assert calls == [("native", 1)]
+
+    def measured(event, layer, consumer):
+        calls.append(("probe", layer, consumer))
+        event.wait(layer)
+
+    counter.beliefkv_wait_probe = SimpleNamespace(wait=measured)
+    counter.wait_until(0)
+    assert calls[-2:] == [("probe", 0, 0), ("native", 0)]
+    counter.reset()
+    assert counter.beliefkv_wait_probe is None
+    assert counter.consumer_index == -1
