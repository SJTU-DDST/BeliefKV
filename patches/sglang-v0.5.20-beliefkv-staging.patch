@@ -0,0 +1,115 @@
+from collections import Counter, OrderedDict
+import pickle
+from types import SimpleNamespace
+
+from sglang.test.test_utils import maybe_stub_sgl_kernel
+
+maybe_stub_sgl_kernel()
+
+from sglang.srt.entrypoints.openai.protocol import ChatCompletionRequest, MessageProcessingResult
+from sglang.srt.entrypoints.openai.serving_chat import OpenAIServingChat
+from sglang.srt.observability.req_time_stats import APIServerReqTimeStats, SchedulerReqTimeStats
+
+
+class CountingTokenizer:
+    bos_token_id = None
+    chat_template = "test"
+
+    def __init__(self):
+        self.calls = Counter()
+
+    def apply_chat_template(self, messages, **kwargs):
+        self.calls["render"] += 1
+        return "task history"
+
+    def encode(self, text, **kwargs):
+        self.calls["encode"] += 1
+        return list(text.encode())
+
+    def decode(self, ids):
+        self.calls["decode"] += 1
+        return bytes(ids).decode()
+
+
+def serving_fixture(model_type="qwen3_5_moe"):
+    serving = object.__new__(OpenAIServingChat)
+    tokenizer = CountingTokenizer()
+    serving.chat_encoding_spec = None
+    serving._chat_template_cache = OrderedDict()
+    serving._tokenizer_auto_adds_specials = False
+    serving.tokenizer_manager = SimpleNamespace(
+        tokenizer=tokenizer, model_config=SimpleNamespace(
+            is_multimodal=True, hf_config=SimpleNamespace(model_type=model_type),
+        ),
+    )
+    serving.template_manager = SimpleNamespace(
+        jinja_template_content_format="openai", jinja_template_may_reorder_tool_results=False,
+        reasoning_config=None,
+    )
+    return serving, tokenizer
+
+
+def test_qwen_text_reuses_encoded_prompt_and_retains_cache():
+    serving, tokenizer = serving_fixture()
+    request = ChatCompletionRequest(
+        model="test", messages=[{"role": "user", "content": "inspect foo.py"}],
+    )
+    for _ in range(2):
+        processed = serving._apply_jinja_template(request, None, True)
+        assert serving._engine_prompt(processed, True) == (
+            "input_ids", list(b"task history"),
+        )
+    assert tokenizer.calls == {"render": 1, "encode": 1}
+
+
+def test_qwen_continued_text_report_does_not_decode_prompt():
+    serving, tokenizer = serving_fixture()
+    request = ChatCompletionRequest(
+        model="test", continue_final_message=True, messages=[
+            {"role": "user", "content": "inspect foo.py"},
+            {"role": "assistant", "content": "Conclusion: "},
+        ],
+    )
+    processed = serving._apply_jinja_template(request, None, True)
+    assert serving._engine_prompt(processed, True) == (
+        "input_ids", list(b"task historyConclusion: "),
+    )
+    assert tokenizer.calls["decode"] == 0
+
+
+def test_media_and_other_multimodal_models_keep_text_routing():
+    serving, _ = serving_fixture()
+    for pool in ("image_data", "video_data", "audio_data", "modalities"):
+        media = dict(image_data=None, video_data=None, audio_data=None, modalities=[])
+        media[pool] = ["media"]
+        processed = MessageProcessingResult(
+            prompt="media prompt", prompt_ids=[1], stop=None, **media,
+        )
+        assert serving._engine_prompt(processed, True) == ("text", "media prompt")
+    other, tokenizer = serving_fixture("other_vlm")
+    request = ChatCompletionRequest(
+        model="test", messages=[{"role": "user", "content": "inspect foo.py"}],
+    )
+    processed = other._apply_jinja_template(request, None, True)
+    assert other._engine_prompt(processed, True) == ("text", "task history")
+    assert tokenizer.calls == {"render": 1, "encode": 1, "decode": 1}
+
+
+def test_ingress_epoch_timestamps_survive_native_pickle_and_request_stats_copy():
+    stats = APIServerReqTimeStats(beliefkv_ingress_timing_ms={
+        "chat_conversion_started_ts_ms": 1000.0,
+        "chat_conversion_finished_ts_ms": 1001.0,
+    })
+    stats.set_tokenize_finish_time()
+    stats.set_api_server_dispatch_time()
+    restored = pickle.loads(pickle.dumps(stats))
+    scheduler = SchedulerReqTimeStats.new_from_obj(restored)
+    assert scheduler.beliefkv_ingress_timing_ms == stats.beliefkv_ingress_timing_ms
+    assert scheduler.beliefkv_ingress_timing_ms is not stats.beliefkv_ingress_timing_ms
+    assert set(scheduler.beliefkv_ingress_timing_ms) == {
+        "chat_conversion_started_ts_ms", "chat_conversion_finished_ts_ms",
+        "api_tokenized_ts_ms", "api_dispatch_started_ts_ms",
+    }
+    ordinary = APIServerReqTimeStats()
+    ordinary.set_tokenize_finish_time()
+    assert "beliefkv_ingress_timing_ms" not in ordinary.__getstate__()
diff --git a/test/srt/test_beliefkv_transfer_receipts.py b/test/srt/test_beliefkv_transfer_receipts.py
new file mode 100644
index 0000000..04f9ddd
--- /dev/null
+++ b/test/srt/test_beliefkv_transfer_receipts.py
@@ -0,0 +1,678 @@
+"""CPU-only coverage for per-operation HiCache transfer receipts."""
+
+import ast
+import time
+import unittest
+from pathlib import Path
+from types import SimpleNamespace
+from typing import NamedTuple
+from unittest.mock import Mock, patch
+
+import torch
+
+from sglang.srt.mem_cache.hicache_storage import PoolName, PoolTransfer
+
+
+ROOT = Path(__file__).resolve().parents[2] / "python/sglang/srt"
+
+
+def controller_classes():
+    base_source = ROOT / "managers/cache_controller.py"
+    hybrid_source = ROOT / "mem_cache/hybrid_cache/hybrid_cache_controller.py"
+
+    def selected(source, class_name, methods):
+        tree = ast.parse(source.read_text(encoding="utf-8"))
+        cls = next(
+            node
+            for node in tree.body
+            if isinstance(node, ast.ClassDef) and node.name == class_name
+        )
+        cls.body = [
+            node
+            for node in cls.body
+            if isinstance(node, ast.FunctionDef) and node.name in methods
+        ]
+        return cls
+
+    base_tree = ast.parse(base_source.read_text(encoding="utf-8"))
+    definitions = [
+        next(
+            node
+            for node in base_tree.body
+            if isinstance(node, ast.ClassDef) and node.name == name
+        )
+        for name in ("CacheChildReceipt", "HiCacheAck")
+    ]
+    definitions.insert(
+        0,
+        selected(
+            base_source,
+            "CacheOperation",
+            {"__init__", "_merge_pool_transfers", "merge_ops"},
+        ),
+    )
+    definitions.append(
+        selected(
+            base_source,
+            "HiCacheController",
+            {
+                "write",
+                "start_writing",
+                "_child_receipts",
+                "_transfer_num_bytes",
+                "_num_tokens_by_pool",
+                "load",
+                "start_loading",
+            },
+        )
+    )
+    hybrid = selected(
+        hybrid_source,
+        "HybridCacheController",
+        {
+            "write", "load", "_num_tokens_by_pool", "_transfer_num_bytes",
+            "_resolve_device_transfers",
+        },
+    )
+    hybrid.bases = [ast.Name(id="HiCacheController", ctx=ast.Load())]
+    definitions.append(hybrid)
+    module = ast.Module(
+        body=[
+            ast.ImportFrom(
+                module="__future__",
+                names=[ast.alias(name="annotations")],
+                level=0,
+            ),
+            *definitions,
+        ],
+        type_ignores=[],
+    )
+    ast.fix_missing_locations(module)
+    namespace = {
+        "torch": torch,
+        "PoolName": PoolName,
+        "PoolTransfer": PoolTransfer,
+        "NamedTuple": NamedTuple,
+        "logger": Mock(),
+        "time": time,
+    }
+    exec(compile(module, str(base_source), "exec"), namespace)
+    namespace["CacheOperation"].counter = 0
+    return (
+        namespace["CacheOperation"],
+        namespace["CacheChildReceipt"],
+        namespace["HiCacheAck"],
+        namespace["HiCacheController"],
+        namespace["HybridCacheController"],
+    )
+
+
+(
+    CacheOperation,
+    CacheChildReceipt,
+    HiCacheAck,
+    HiCacheController,
+    HybridCacheController,
+) = controller_classes()
+
+
+def indices(count):
+    return torch.arange(count, dtype=torch.int64)
+
+
+def controller(cls=HiCacheController):
+    instance = cls.__new__(cls)
+    instance.write_queue = []
+    instance.load_queue = []
+    instance.ack_write_queue = []
+    instance.ack_load_queue = []
+    instance.mem_pool_host = SimpleNamespace(
+        size_per_token=10,
+        alloc=Mock(side_effect=lambda n: indices(n)),
+        free=Mock(),
+    )
+    instance.mem_pool_device_allocator = SimpleNamespace(
+        alloc=Mock(side_effect=lambda n: indices(n)),
+        free=Mock(),
+    )
+    instance._move_write_operation = lambda op: (
+        op.host_indices,
+        op.device_indices,
+        op.pool_transfers,
+    )
+    instance._move_op_indices = instance._move_write_operation
+    instance._l2_transfers = lambda *args: list(args)
+    instance._l2_load_transfers = instance._l2_transfers
+    completion = SimpleNamespace(
+        start_event=object(), finish_event=object(), timing_enabled=False
+    )
+    instance.l2_transfer_engine = SimpleNamespace(
+        submit_device_to_host=Mock(return_value=completion),
+        submit_host_to_device=Mock(return_value=completion),
+    )
+    producer = SimpleNamespace(
+        start_event=SimpleNamespace(record=Mock()), complete=Mock()
+    )
+    instance.layer_done_counter = SimpleNamespace(
+        update_producer=Mock(return_value=0), events=[producer]
+    )
+    instance.load_fence_stream = None
+    instance.layer_num = 1
+    return instance
+
+
+def hybrid_controller():
+    instance = controller(HybridCacheController)
+    anchor = SimpleNamespace(
+        name=PoolName.KV, host_pool=SimpleNamespace(size_per_token=10)
+    )
+    entries = {
+        PoolName.MAMBA: SimpleNamespace(host_pool=SimpleNamespace(size_per_token=5)),
+        PoolName.SWA: SimpleNamespace(host_pool=SimpleNamespace(size_per_token=7)),
+    }
+
+    def resolve_host(transfers, *, primary_device_indices, primary_host_indices):
+        for transfer in transfers or []:
+            if transfer.indices_from_pool is None:
+                transfer.host_indices = indices(len(transfer.device_indices))
+            else:
+                source = next(
+                    (t for t in transfers if t.name == transfer.indices_from_pool),
+                    None,
+                )
+                transfer.host_indices = (
+                    primary_host_indices if source is None else source.host_indices
+                )
+                transfer.device_indices = (
+                    primary_device_indices if source is None else source.device_indices
+                )
+        return transfers
+
+    instance.mem_pool_host.anchor_entry = anchor
+    instance.mem_pool_host.entry_map = entries
+    instance.mem_pool_host.resolve_host_transfers = Mock(side_effect=resolve_host)
+    instance.mem_pool_device_allocator.full_attn_allocator = (
+        instance.mem_pool_device_allocator
+    )
+    instance.device = "cpu"
+    instance._resolve_device_transfers = Mock(
+        side_effect=lambda transfers, **_: transfers
+    )
+    return instance
+
+
+def reservation_controller():
+    instance = hybrid_controller()
+
+    def alloc(count, *, pool=None):
+        offset = 100 if pool is PoolName.MAMBA else 0
+        return indices(count) + offset
+
+    def resolve(transfers, *, primary_device_indices, primary_host_indices):
+        for transfer in transfers or []:
+            if (
+                transfer.indices_from_pool is None
+                and transfer.host_indices is None
+                and transfer.device_indices is not None
+            ):
+                transfer.host_indices = instance.mem_pool_host.alloc(
+                    len(transfer.device_indices), pool=transfer.name
+                )
+        for transfer in transfers or []:
+            if transfer.indices_from_pool is None:
+                continue
+            source = next(
+                (
+                    candidate
+                    for candidate in transfers
+                    if candidate.name == transfer.indices_from_pool
+                    and candidate.indices_from_pool is None
+                ),
+                None,
+            )
+            transfer.host_indices = (
+                primary_host_indices if source is None else source.host_indices
+            )
+            transfer.device_indices = (
+                primary_device_indices if source is None else source.device_indices
+            )
+        return transfers
+
+    instance.mem_pool_host.alloc.side_effect = alloc
+    instance.mem_pool_host.resolve_host_transfers.side_effect = resolve
+    return instance
+
+
+def assert_reconciled(test, ack):
+    totals = {}
+    for receipt in ack.child_receipts:
+        for pool, count in receipt.num_tokens_by_pool:
+            totals[pool] = totals.get(pool, 0) + count
+    test.assertEqual(totals, ack.num_tokens_by_pool)
+    test.assertEqual(sum(r.num_bytes for r in ack.child_receipts), ack.num_bytes)
+
+
+class TransferReceiptTest(unittest.TestCase):
+    def test_h2d_before_enqueue_veto_frees_only_new_device_slots(self):
+        ctrl = hybrid_controller()
+        aux = PoolTransfer(name=PoolName.MAMBA, host_indices=indices(1))
+        derived = PoolTransfer(name=PoolName.SWA, indices_from_pool=PoolName.MAMBA)
+        saved = PoolTransfer(
+            name=PoolName.MAMBA, host_indices=indices(1),
+            device_indices=indices(1) + 44,
+        )
+        freed_mamba = Mock()
+        ctrl.mem_pool_host.entry_map[PoolName.MAMBA].device_free_fn = freed_mamba
+
+        def resolve(transfers, **kwargs):
+            self.assertIs(kwargs.get("allow_reclaim"), False)
+            aux.device_indices = indices(1) + 33
+            derived.device_indices = aux.device_indices
+            derived.host_indices = aux.host_indices
+            return transfers
+
+        ctrl._resolve_device_transfers.side_effect = resolve
+        with patch.object(ctrl, "start_loading") as start:
+            result = ctrl.load(
+                indices(2), node_id=7,
+                extra_pools=[aux, saved, derived],
+                beliefkv_command_id="h2d-7",
+                beliefkv_before_enqueue=lambda op: False,
+                beliefkv_no_device_reclaim=True,
+            )
+        self.assertIsNone(result)
+        self.assertEqual(ctrl.load_queue, [])
+        start.assert_not_called()
+        ctrl.mem_pool_device_allocator.free.assert_called_once()
+        freed_mamba.assert_called_once()
+        self.assertIsNone(aux.device_indices)
+        self.assertEqual(saved.device_indices.tolist(), [44])
+        self.assertIsNotNone(derived.device_indices)
+
+    def test_h2d_before_enqueue_accepts_full_and_mamba_only_ops(self):
+        ctrl = hybrid_controller()
+        seen = []
+        with patch.object(ctrl, "start_loading") as start:
+            assert ctrl.load(
+                indices(2), node_id=8, beliefkv_command_id="h2d-8",
+                beliefkv_before_enqueue=lambda op: (
+                    seen.append(op) or True
+                ), beliefkv_no_device_reclaim=True,
+            ) is not None
+            assert ctrl.load(
+                indices(0), node_id=9,
+                extra_pools=[PoolTransfer(
+                    name=PoolName.MAMBA, host_indices=indices(1)
+                )],
+                beliefkv_command_id="h2d-9",
+                beliefkv_before_enqueue=lambda op: (
+                    seen.append(op) or True
+                ), beliefkv_no_device_reclaim=True,
+            ) is not None
