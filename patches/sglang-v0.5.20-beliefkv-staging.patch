+"""CPU write-back PREPARE with resident ancestors and independent Mamba state."""
+
+from array import array
+from types import SimpleNamespace as NS
+from unittest.mock import Mock
+
+import pytest
+import torch
+
+from sglang.srt.mem_cache.base_prefix_cache import MatchPrefixParams
+from sglang.srt.mem_cache.radix_cache import RadixKey
+from sglang.srt.mem_cache.unified_cache.component_type import ComponentType as CT
+from test_beliefkv_shadow_dispatch import ComponentType, PoolName, fixture
+from test_beliefkv_terminal_capacity import hybrid_cache, insert_session
+
+
+@pytest.mark.parametrize("policy", ("write_back", "write_through", "write_through_selective"))
+def test_only_writeback_accepts_resident_ancestor_without_host(policy):
+    cache, _, parent, leaf, group, operations, args = fixture()
+    cache.cache_controller.write_policy = policy
+    cache.tree_core.is_write_back = policy == "write_back"
+    parent.component_data[ComponentType.FULL].host_value = None
+    assert cache.supports_beliefkv_resident_parent_prepare() == (policy == "write_back")
+    result = cache.prepare_host_shadow(**args, beliefkv_include_mamba=False)
+    assert result.issued == (policy == "write_back")
+    assert len(operations) == int(result.issued)
+    assert parent.component_data[ComponentType.FULL].host_value is None
+    if result.issued:
+        assert group.allocations == [(PoolName.KV, 2)]
+        assert leaf.component_data[ComponentType.FULL].value is not None
+        assert leaf.write_through_pending_id is not None
+
+
+@pytest.mark.parametrize("blocked", (
+    "ancestor_missing", "write", "load", "generation", "target", "host_capacity", "veto",
+))
+def test_resident_parent_does_not_relax_enqueue_dependencies_or_rollback(blocked):
+    cache, _, parent, leaf, group, operations, args = fixture()
+    cache.cache_controller.write_policy = "write_back"
+    cache.tree_core.is_write_back = True
+    parent.component_data[ComponentType.FULL].host_value = None
+    if blocked == "ancestor_missing":
+        parent.component_data[ComponentType.FULL].value = None
+    elif blocked == "write":
+        parent.write_through_pending_id = 11
+    elif blocked == "load":
+        parent.load_back_pending_id = 11
+    elif blocked == "generation":
+        args["session_generation"] += 1
+    elif blocked == "target":
+        args["node_creation_time"] += 1
+    elif blocked == "host_capacity":
+        group.free_sizes[PoolName.KV] = 1
+    before = group.free_sizes.copy()
+    result = cache.prepare_host_shadow(
+        **args, beliefkv_include_mamba=False,
+        beliefkv_before_enqueue=(lambda _: False) if blocked == "veto" else None,
+    )
+    assert not result.issued
+    assert not operations and not cache.ongoing_write_through
+    assert group.free_sizes == before
+    assert leaf.component_data[ComponentType.FULL].host_value is None
+    cache.evict_host.assert_not_called()
+
+
+@pytest.mark.parametrize("hybrid_cache", (32,), indirect=True)
+@pytest.mark.parametrize("shared", (False, True))
+def test_real_hybrid_tree_recovers_leaf_then_parent_and_keeps_latest_mamba(
+    hybrid_cache, shared,
+):
+    cache, allocator, request_pool = hybrid_cache
+    parent, _ = insert_session(cache, [1, 2], "s")
+    leaf, _ = insert_session(cache, [1, 2, 3, 4], "s")
+    if shared:
+        insert_session(cache, [1, 2], "other")
+    tree = cache.tree_core
+    tree.set_hicache_enabled()
+    tree.is_write_back = True
+    cache.is_write_back = True
+    cache.host_memory_mode = "cache"
+    cache.cache_controller = NS(write_policy="write_back")
+    leaf_state = leaf.component_data[CT.MAMBA].value
+    state_available = request_pool.mamba_allocator.available_size()
+    tree.commit_backup(leaf.id, torch.tensor([50, 51], dtype=torch.int64), {})
+    tree.mark_write_through_pending([leaf.id], leaf.id)
+    cache.beliefkv_join_pressure_candidates_by_component = {
+        int(CT.FULL): ((leaf.id, leaf.creation_time),),
+    }
+    cache.beliefkv_join_pressure_validator = lambda *_: True
+    cache.beliefkv_join_pressure_parked = Mock()
+    available = allocator.available_size()
+
+    assert cache.reclaim_beliefkv_handoff_capacity(
+        full_tokens=available + 2, mamba_slots=0,
+    ) == {}
+    assert allocator.available_size() == available
+    tree.finish_write_through([leaf.id], leaf.id)
+    assert cache.reclaim_beliefkv_handoff_capacity(
+        full_tokens=available + 2, mamba_slots=0,
+    ) == {int(CT.FULL): 2}
+    assert allocator.available_size() == available + 2
+    assert leaf.component_data[CT.MAMBA].value is leaf_state
+    assert leaf.component_data[CT.MAMBA].host_value is None
+    assert request_pool.mamba_allocator.available_size() == state_available
+    assert parent.component_data[CT.FULL].host_value is None
+    assert parent.component_data[CT.FULL].value is not None
+    full, extra = tree.build_load_back_spec(leaf.id)
+    assert full.nodes_to_load == [leaf.id]
+    assert full.host_indices.tolist() == [50, 51]
+    assert not extra
+
+    tree.commit_backup(parent.id, torch.tensor([48, 49], dtype=torch.int64), {})
+    cache.beliefkv_join_pressure_candidates_by_component = {
+        int(CT.FULL): ((parent.id, parent.creation_time),),
+    }
+    freed = cache.reclaim_beliefkv_handoff_capacity(
+        full_tokens=available + 4, mamba_slots=0,
+    )
+    assert freed == ({} if shared else {int(CT.FULL): 2, int(CT.MAMBA): 1})
+    full, extra = tree.build_load_back_spec(leaf.id)
+    assert full.nodes_to_load == ([leaf.id] if shared else [parent.id, leaf.id])
+    assert full.host_indices.tolist() == ([50, 51] if shared else [48, 49, 50, 51])
+    assert not extra
+    assert cache.match_prefix(MatchPrefixParams(
+        key=RadixKey(array("q", [1, 2, 3, 4])),
+    )).best_match_node == leaf.id
+    assert leaf.component_data[CT.MAMBA].value is leaf_state
+    assert request_pool.mamba_allocator.available_size() == state_available + int(not shared)
+    cache._execute_and_commit_kv_backup.assert_not_called()
