+"""CPU checks for read-only reentry and cold-only capacity exchange."""
+
+import ast
+from collections import deque
+from enum import IntEnum
+from pathlib import Path
+from types import SimpleNamespace as NS
+from unittest.mock import Mock
+
+import pytest
+
+
+SOURCE = Path(__file__).resolve().parents[2] / "python/sglang/srt/mem_cache/unified_radix_cache.py"
+
+
+class ComponentType(IntEnum):
+    FULL = 0
+    SWA = 1
+    MAMBA = 2
+
+
+class Key:
+    def __init__(self, ids, *, extra_key=None, cache_salt=None, limit=None):
+        self.ids = list(ids)[:limit] if limit is not None else list(ids)
+        self.namespace = extra_key, cache_salt
+
+    def __len__(self):
+        return len(self.ids)
+
+    def match_at(self, other, offset, *, page_size):
+        if self.namespace != other.namespace:
+            raise ValueError("namespace changed")
+        count = 0
+        for left, right in zip(self.ids, other.ids[offset:]):
+            if left != right:
+                break
+            count += 1
+        return count // page_size * page_size
+
+    def is_prefix_at(self, other, offset, *, page_size):
+        return self.match_at(other, offset, page_size=page_size) >= len(self)
+
+
+def cache_class():
+    tree = ast.parse(SOURCE.read_text())
+    cache = next(item for item in tree.body if isinstance(item, ast.ClassDef) and item.name == "UnifiedRadixCache")
+    methods = [item for item in cache.body if isinstance(item, ast.FunctionDef) and item.name in {
+        "inspect_beliefkv_reentry", "reclaim_beliefkv_handoff_capacity",
+        "_evict_backed_join_parent",
+        "_evict_device_leaf", "_preserve_mamba_reentry_node",
+        "_prepare_beliefkv_full_demote", "_can_beliefkv_full_demote",
+        "_reclaim_beliefkv_full_preserving_mamba",
+        "_beliefkv_causal_full_donor", "_beliefkv_causal_full_owner_refs",
+        "_beliefkv_full_covering_sessions",
+        "_demote", "_accumulate_tracker",
+    }]
+    module = ast.Module(body=[
+        ast.ImportFrom(module="__future__", names=[ast.alias(name="annotations")], level=0),
+        ast.ClassDef(name="Cache", bases=[], keywords=[], body=methods, decorator_list=[]),
+    ], type_ignores=[])
+    ast.fix_missing_locations(module)
+    namespace = {
+        "RadixKey": Key, "ComponentType": ComponentType, "BASE_COMPONENT_TYPE": 0,
+        "deque": deque,
+        "BackupKV": lambda node_ids: NS(node_ids=node_ids),
+    }
+    exec(compile(module, str(SOURCE), "exec"), namespace)
+    return namespace["Cache"]
+
+
+Cache = cache_class()
+
+
+class Node(NS):
+    __hash__ = object.__hash__
+
+
+class Indices(list):
+    @property
+    def shape(self):
+        return (len(self),)
+
+
+def data(device=True, host=True, refs=1):
+    return NS(value=Indices([1, 2]) if device else None,
+              host_value=Indices([1, 2]) if host else None,
+              lock_ref=0, session_ref=refs)
+
+
+def fixture():
+    root = Node(id=0, parent=None, creation_time=0)
+    checkpoint = Node(id=1, parent=root, creation_time=1, key=Key([10, 11]),
+                      component_data=[data(), data(False, False, 0), data()],
+                      write_through_pending_id=None, load_back_pending_id=None,
+                      backuped=True)
+    tail = Node(id=2, parent=checkpoint, creation_time=2, key=Key([12, 13]),
+                component_data=[data(), data(False, False, 0), data()],
+                write_through_pending_id=None, load_back_pending_id=None,
+                backuped=True)
+    nodes = {0: root, 1: checkpoint, 2: tail}
+    cache = Cache()
+    cache.tree_components = (ComponentType.FULL, ComponentType.MAMBA)
+    cache.page_size = 1
+    cache.tree_core = NS(root_node=root, is_eagle=False, node_by_id=nodes.__getitem__,
+                         evictable_device_leaves={tail})
+    cache.session_refs = NS(
+        session_id_for_req=lambda req: req.session_id,
+        snapshot_latest_session_leaf_anchors=Mock(return_value=(
+            (0, ((2, 2),)), (2, ((1, 1),)),
+        )),
+    )
+    request = NS(origin_input_ids=[10, 11, 99], session_id="s", session_generation=1)
+    return cache, checkpoint, tail, request
+
+
+def test_probe_matches_only_actual_next_input_and_does_not_touch_tree():
+    cache, checkpoint, _, request = fixture()
+    observation = cache.inspect_beliefkv_reentry(request)
+    assert observation["checkpoint_tokens"] == 2
+    assert observation["device_checkpoint_tokens"] == 2
+    assert observation["missing_full_tokens"] == 0
+    assert observation["component_leaves"] == ((0, ((2, 2),)), (2, ((1, 1),)))
+    assert checkpoint.component_data[0].lock_ref == 0
+    request.origin_input_ids = [10, 90, 99]
+    assert cache.inspect_beliefkv_reentry(request) is None
+
+
+def test_probe_requires_mamba_and_all_full_ancestors_on_some_tier():
+    cache, checkpoint, _, request = fixture()
+    checkpoint.component_data[0].value = None
+    checkpoint.component_data[2].value = None
+    observation = cache.inspect_beliefkv_reentry(request)
+    assert observation["missing_full_tokens"] == 2
+    assert observation["missing_mamba_slots"] == 1
+    checkpoint.component_data[0].host_value = None
+    assert cache.inspect_beliefkv_reentry(request) is None
+
+
+@pytest.mark.parametrize("writing_node", ("checkpoint", "tail"))
+def test_probe_keeps_resident_checkpoint_readable_during_outbound_backup(writing_node):
+    cache, checkpoint, tail, request = fixture()
+    request.origin_input_ids = [10, 11, 12, 13, 99]
+    node = checkpoint if writing_node == "checkpoint" else tail
+    node.write_through_pending_id = "d2h"
+    node.component_data[0].lock_ref = 1
+    node.component_data[2].lock_ref = 1
+    observation = cache.inspect_beliefkv_reentry(request)
+    assert observation["checkpoint_tokens"] == 4
+    assert observation["device_checkpoint_tokens"] == 4
+    assert observation["missing_full_tokens"] == 0
+    assert observation["missing_mamba_slots"] == 0
+    assert node.write_through_pending_id == "d2h"
+    assert node.component_data[0].lock_ref == 1
+    assert node.component_data[2].lock_ref == 1
+
+
+@pytest.mark.parametrize("component", (ComponentType.FULL, ComponentType.MAMBA))
+def test_probe_does_not_credit_host_only_component_before_outbound_ack(component):
+    cache, checkpoint, _, request = fixture()
+    checkpoint.component_data[component].value = None
+    checkpoint.write_through_pending_id = "d2h"
+    assert cache.inspect_beliefkv_reentry(request) is None
+    checkpoint.write_through_pending_id = None
+    assert cache.inspect_beliefkv_reentry(request)["checkpoint_tokens"] == 2
+
+
+def test_probe_preserves_resident_fallback_while_a_deeper_restore_is_unsettled():
+    cache, checkpoint, tail, request = fixture()
+    request.origin_input_ids = [10, 11, 12, 13, 99]
+    checkpoint.write_through_pending_id = "d2h"
+    tail.component_data[0].value = None
+    tail.component_data[2].value = None
+    observation = cache.inspect_beliefkv_reentry(request)
+    assert observation["checkpoint_tokens"] == 2
+    assert observation["device_checkpoint_tokens"] == 2
+    checkpoint.write_through_pending_id = None
+    assert cache.inspect_beliefkv_reentry(request)["checkpoint_tokens"] == 4
+
+
+def test_probe_rejects_pending_dma_namespace_and_stale_session():
+    cache, checkpoint, _, request = fixture()
+    checkpoint.load_back_pending_id = "native"
+    assert cache.inspect_beliefkv_reentry(request) is None
+    checkpoint.load_back_pending_id = None
+    request.cache_salt = "other"
+    assert cache.inspect_beliefkv_reentry(request) is None
+    del request.cache_salt
+    cache.session_refs.snapshot_latest_session_leaf_anchors.return_value = None
+    assert cache.inspect_beliefkv_reentry(request) is None
+
+
+def shared_probe_fixture():
+    cache, checkpoint, tail, request = fixture()
+    branch = Node(
+        id=3, parent=checkpoint, creation_time=3, key=Key([14, 15]),
+        component_data=[data(), data(False, False, 0), data()],
+        write_through_pending_id=None, load_back_pending_id=None,
+        backuped=True,
+    )
+    nodes = {0: cache.tree_core.root_node, 1: checkpoint, 2: tail, 3: branch}
+    cache.tree_core.node_by_id = nodes.__getitem__
+    cache.session_refs.snapshot_latest_session_leaf_anchors.return_value = (
+        (0, ((2, 2), (3, 3))), (2, ((2, 2), (3, 3))),
+    )
+    request.origin_input_ids = [10, 11, 12, 13, 99]
+    return cache, checkpoint, tail, branch, request
+
+
+def test_shared_probe_checks_common_prefix_once_and_refreshes_next_call():
+    cache, checkpoint, tail, _, request = shared_probe_fixture()
+    checkpoint.key.is_prefix_at = Mock(wraps=checkpoint.key.is_prefix_at)
+    observation = cache.inspect_beliefkv_reentry(request)
+    assert checkpoint.key.is_prefix_at.call_count == 1
+    assert observation["checkpoint_tokens"] == 4
+    assert observation["device_checkpoint_tokens"] == 4
+    assert observation["component_leaves"] == ((0, ((2, 2),)), (2, ((2, 2),)))
+    checkpoint.component_data[0].value = None
+    tail.component_data[2].value = None
+    observation = cache.inspect_beliefkv_reentry(request)
+    assert checkpoint.key.is_prefix_at.call_count == 2
+    assert observation["device_checkpoint_tokens"] == 0
+    assert observation["missing_full_tokens"] == 2
+    assert observation["missing_mamba_slots"] == 1
+    checkpoint.component_data[0].host_value = None
+    assert cache.inspect_beliefkv_reentry(request) is None
+
+
+@pytest.mark.parametrize("mismatch", ("tokens", "namespace", "short_input"))
+def test_shared_probe_reuses_failed_prefix_only_within_one_read(mismatch):
+    cache, checkpoint, _, _, request = shared_probe_fixture()
+    checkpoint.key.is_prefix_at = Mock(wraps=checkpoint.key.is_prefix_at)
+    if mismatch == "tokens":
+        request.origin_input_ids[1] = -1
+    elif mismatch == "namespace":
+        request.cache_salt = "other"
+    else:
+        request.origin_input_ids = [10]
+    assert cache.inspect_beliefkv_reentry(request) is None
+    assert checkpoint.key.is_prefix_at.call_count == 1
+    request.origin_input_ids = [10, 11, 12, 13, 99]
+    request.cache_salt = None
+    observation = cache.inspect_beliefkv_reentry(request)
+    assert observation["checkpoint_tokens"] == 4
+    assert checkpoint.key.is_prefix_at.call_count == 2
+
+
+@pytest.mark.parametrize("blocked", ("pending", "namespace", "stale_ancestor"))
