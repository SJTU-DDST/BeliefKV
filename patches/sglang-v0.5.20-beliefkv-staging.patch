+"""Cold FULL capacity preparation using real CPU trees and explicit ACK boundaries."""
+
+from types import SimpleNamespace as NS
+from unittest.mock import Mock
+
+import pytest
+
+from sglang.srt.mem_cache.unified_cache.component_type import ComponentType
+from test_beliefkv_terminal_capacity import hybrid_cache, insert_session
+
+
+def fixture(hybrid_cache):
+    cache, allocator, request_pool = hybrid_cache
+    parent, _ = insert_session(cache, [1, 2, 3, 4], "cold")
+    leaf, _ = insert_session(cache, [1, 2, 3, 4, 5, 6], "cold")
+    cache.release_radix_session("cold")
+    for component in (ComponentType.FULL, ComponentType.MAMBA):
+        data = parent.component_data[component]
+        data.host_value = data.value.clone()
+    cache.tree_core._update_duplicate_tracking(parent)
+    cache.is_write_back = True
+    cache.host_memory_mode = "cache"
+    cache.ongoing_write_through = {}
+    cache.cache_controller = NS(
+        write_queue=[], load_queue=[], ack_write_queue=[], ack_load_queue=[],
+        start_writing=Mock(),
+        mem_pool_host=NS(
+            size_per_token=16 * 1024 * 1024, available_size=lambda: 128,
+        ),
+    )
+    cache.beliefkv_join_pressure_validator = lambda *_: False
+    target = allocator.available_size() + 6
+    assert cache.reclaim_beliefkv_handoff_capacity(
+        full_tokens=target, mamba_slots=0, collect_cold_full_candidates=True,
+    ) == {}
+    assert cache.beliefkv_handoff_cold_full_candidates == (
+        (leaf.id, leaf.creation_time, 2),
+    )
+    return cache, allocator, request_pool, parent, leaf, target
+
+
+def install_cpu_enqueue(cache):
+    locks = {}
+
+    def enqueue(action, **kwargs):
+        assert kwargs == {
+            "no_host_reclaim": True, "beliefkv_include_mamba": False,
+            "beliefkv_defer_writing": True,
+        }
+        node_id, = action.node_ids
+        node = cache.tree_core.node_by_id(node_id)
+        full = node.component_data[ComponentType.FULL]
+        full.host_value = full.value.clone()
+        locks[node_id] = cache.inc_lock_ref(node_id).to_dec_params()
+        cache.tree_core.mark_write_through_pending([node_id], node_id)
+        cache.ongoing_write_through[node_id] = True
+        return len(full.value)
+
+    cache._execute_and_commit_kv_backup = Mock(side_effect=enqueue)
+    return locks
+
+
+def test_cold_full_backup_unlocks_backed_ancestors_only_after_ack(hybrid_cache):
+    cache, allocator, request_pool, parent, leaf, target = fixture(hybrid_cache)
+    locks = install_cpu_enqueue(cache)
+    available = allocator.available_size()
+    state = leaf.component_data[ComponentType.MAMBA]
+    state_device = state.value
+    state_available = request_pool.mamba_allocator.available_size()
+
+    assert cache.prepare_beliefkv_cold_full_capacity(full_tokens=target) == (
+        (leaf.id, leaf.creation_time, 2),
+    )
+    assert allocator.available_size() == available
+    assert state.value is state_device and state.host_value is None
+    assert request_pool.mamba_allocator.available_size() == state_available
+    cache.cache_controller.start_writing.assert_called_once_with()
+    assert cache.prepare_beliefkv_cold_full_capacity(full_tokens=target) == ()
+    assert cache.reclaim_beliefkv_handoff_capacity(full_tokens=target, mamba_slots=0) == {}
+    assert allocator.available_size() == available
+
+    cache.tree_core.finish_write_through([leaf.id], leaf.id)
+    del cache.ongoing_write_through[leaf.id]
+    cache.dec_lock_ref(leaf.id, locks[leaf.id])
+    freed = cache.reclaim_beliefkv_handoff_capacity(full_tokens=target, mamba_slots=0)
+    assert freed[int(ComponentType.FULL)] == 6
+    assert allocator.available_size() == target
+    assert leaf.component_data[ComponentType.FULL].host_value is not None
+    assert parent.component_data[ComponentType.FULL].host_value is not None
+    assert leaf.component_data[ComponentType.FULL].value is None
+    assert parent.component_data[ComponentType.FULL].value is None
+    cache._execute_and_commit_kv_backup.assert_called_once()
+
+
+@pytest.mark.parametrize("change", (
+    "session", "device_lock", "host_lock", "d2h", "h2d", "identity", "backed", "excluded",
+    "not_leaf", "mamba_session",
+))
+def test_cold_candidate_is_revalidated_before_native_enqueue(hybrid_cache, change):
+    cache, allocator, _, _, leaf, target = fixture(hybrid_cache)
+    if change == "session":
+        insert_session(cache, [1, 2, 3, 4, 5, 6], "new-owner")
+    elif change == "device_lock":
+        cache.inc_lock_ref(leaf.id)
+    elif change == "host_lock":
+        leaf.component_data[ComponentType.FULL].host_lock_ref = 1
+    elif change == "d2h":
+        leaf.write_through_pending_id = leaf.id
+    elif change == "h2d":
+        leaf.load_back_pending_id = leaf.id
+    elif change == "identity":
+        cache.beliefkv_handoff_cold_full_candidates = (
+            (leaf.id, leaf.creation_time + 1, 2),
+        )
+    elif change == "backed":
+        leaf.component_data[ComponentType.FULL].host_value = (
+            leaf.component_data[ComponentType.FULL].value.clone()
+        )
+    elif change == "not_leaf":
+        insert_session(cache, [1, 2, 3, 4, 5, 6, 7, 8], "new-child")
+    elif change == "mamba_session":
+        leaf.component_data[ComponentType.MAMBA].session_ref = 1
+    available = allocator.available_size()
+    assert cache.prepare_beliefkv_cold_full_capacity(
+        full_tokens=target, exclude_node_ids=(leaf.id,) if change == "excluded" else (),
+    ) == ()
+    assert allocator.available_size() == available
+    cache._execute_and_commit_kv_backup.assert_not_called()
+    cache.cache_controller.start_writing.assert_not_called()
+
+
+@pytest.mark.parametrize("change", ("queued", "buffer", "write_through", "enough_capacity"))
+def test_cold_prepare_is_skipped_without_supported_unqueued_pressure(hybrid_cache, change):
+    cache, allocator, _, _, _, target = fixture(hybrid_cache)
+    if change == "queued":
+        cache.cache_controller.write_queue.append(object())
+    elif change == "buffer":
+        cache.buffer_pipeline = object()
+    elif change == "write_through":
+        cache.is_write_back = False
+    else:
+        target = allocator.available_size()
+    assert cache.prepare_beliefkv_cold_full_capacity(full_tokens=target) == ()
+    cache._execute_and_commit_kv_backup.assert_not_called()
+    cache.cache_controller.start_writing.assert_not_called()
+
+
+def test_failed_host_allocation_cannot_claim_backup_or_free_capacity(hybrid_cache):
+    cache, allocator, _, _, _, target = fixture(hybrid_cache)
+    cache._execute_and_commit_kv_backup = Mock(return_value=0)
+    available = allocator.available_size()
+    assert cache.prepare_beliefkv_cold_full_capacity(full_tokens=target) == ()
+    assert allocator.available_size() == available
+    cache.cache_controller.start_writing.assert_not_called()
+
+
+def test_native_reclaim_without_critical_opt_in_never_collects_or_starts_copies(hybrid_cache):
+    cache, allocator, _, _, _, target = fixture(hybrid_cache)
+    assert cache.reclaim_beliefkv_handoff_capacity(full_tokens=target, mamba_slots=0) == {}
+    assert cache.beliefkv_handoff_cold_full_candidates == ()
+    assert cache.prepare_beliefkv_cold_full_capacity(full_tokens=target) == ()
+    cache._execute_and_commit_kv_backup.assert_not_called()
+
+
+def test_one_large_first_extent_is_not_permanently_rejected_by_the_shortfall(hybrid_cache):
+    cache, allocator, _, _, leaf, _ = fixture(hybrid_cache)
+    install_cpu_enqueue(cache)
+    available = allocator.available_size()
+    assert cache.prepare_beliefkv_cold_full_capacity(full_tokens=available + 1) == (
+        (leaf.id, leaf.creation_time, 2),
+    )
+    assert allocator.available_size() == available
+
+
+@pytest.mark.parametrize("queue", (
+    "write_queue", "load_queue", "ack_write_queue", "ack_load_queue",
+))
+def test_idle_backup_never_queues_behind_existing_transfer_work(hybrid_cache, queue):
+    cache, _, _, _, _, _ = fixture(hybrid_cache)
+    getattr(cache.cache_controller, queue).append(object())
+    assert cache.prepare_beliefkv_idle_full() == ()
+    cache._execute_and_commit_kv_backup.assert_not_called()
+    stats = cache.beliefkv_idle_full_prepare_stats
+    assert stats["checks"] == stats["blocked_native_queues"] == 1
+    assert stats["scanned_nodes"] == 0
+    assert stats[{
+        "write_queue": "blocked_write_queue", "load_queue": "blocked_h2d_queue",
+        "ack_write_queue": "blocked_d2h_ack", "ack_load_queue": "blocked_h2d_ack",
+    }[queue]] == 1
+
+
+def test_idle_backup_requires_no_hbm_pressure_and_keeps_device_capacity(hybrid_cache):
+    cache, allocator, _, _, leaf, _ = fixture(hybrid_cache)
+    install_cpu_enqueue(cache)
+    available = allocator.available_size()
+    assert cache.prepare_beliefkv_idle_full() == (
+        (leaf.id, leaf.creation_time, 2),
+    )
+    assert allocator.available_size() == available
+    assert cache.prepare_beliefkv_idle_full() == ()
+    cache._execute_and_commit_kv_backup.assert_called_once()
+    assert leaf.component_data[ComponentType.MAMBA].host_value is None
+
+
+def test_idle_backup_leaves_host_space_for_one_urgent_chunk(hybrid_cache):
+    cache, _, _, _, _, _ = fixture(hybrid_cache)
+    cache.cache_controller.mem_pool_host.available_size = lambda: 4
+    assert cache.prepare_beliefkv_idle_full() == ()
+    cache._execute_and_commit_kv_backup.assert_not_called()
+
+
+@pytest.mark.parametrize("blocked", ("session", "device_lock", "host_lock", "excluded"))
+def test_idle_backup_preserves_ownership_locks_and_exclusions(hybrid_cache, blocked):
+    cache, _, _, _, leaf, _ = fixture(hybrid_cache)
+    if blocked == "session":
+        insert_session(cache, [1, 2, 3, 4, 5, 6], "new")
+    elif blocked == "device_lock":
+        cache.inc_lock_ref(leaf.id)
+    elif blocked == "host_lock":
+        leaf.component_data[ComponentType.FULL].host_lock_ref = 1
+    assert cache.prepare_beliefkv_idle_full(
+        exclude_node_ids=(leaf.id,) if blocked == "excluded" else (),
+    ) == ()
+    cache._execute_and_commit_kv_backup.assert_not_called()
