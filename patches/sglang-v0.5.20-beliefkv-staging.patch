+def test_unbacked_inherited_prefix_still_requires_settled_backup_ack(hybrid_cache):
+    cache, allocator, _, prefix, _, _, _ = fixture(hybrid_cache, prefix_backed=False)
+    locks = install_cpu_enqueue(cache)
