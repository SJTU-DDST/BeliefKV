+"""Session-scoped radix anchors are bounded hints, not transfer authority."""
+
+from types import SimpleNamespace
+
+from sglang.srt.mem_cache.unified_cache.component_type import ComponentType
+from sglang.srt.mem_cache.unified_cache.session_ref_tracker import (
+    UnifiedSessionRefTracker,
+)
+
+
+class FakeComponent:
+    def __init__(self, component_type):
+        self.component_type = component_type
+        self._session_leaves = {}
+
+    def reset_session_state(self):
+        self._session_leaves.clear()
+
+    def release_session(self, session_id):
+        return len(self._session_leaves.pop(session_id, ()))
+
+
+def test_session_anchor_snapshot_revalidates_generation_and_node_identity():
+    full = FakeComponent(ComponentType.FULL)
+    mamba = FakeComponent(ComponentType.MAMBA)
+    class Leaf:
+        pass
+
+    node = Leaf()
+    node.id = 11
+    node.creation_time = 42
+    node.component_data = {
+            ComponentType.FULL: SimpleNamespace(session_ids={"session"}),
+            ComponentType.MAMBA: SimpleNamespace(session_ids={"session"}),
+        }
+    full._session_leaves["session"] = {node}
+    mamba._session_leaves["session"] = {node}
+    nodes = {11: node}
+    tree = SimpleNamespace(node_by_id=nodes.__getitem__)
+    tracker = UnifiedSessionRefTracker(
+        components=(full, mamba),
+        tree_core=tree,
+        enable_session_radix_cache=True,
+    )
+    # The tracker initializes its component indexes at construction.
+    full._session_leaves["session"] = {node}
+    mamba._session_leaves["session"] = {node}
+    generation = tracker.open_radix_session("session")
+    assert tracker.snapshot_session_leaf_anchors("session", generation) == (
+        (int(ComponentType.FULL), ((11, 42),)),
+        (int(ComponentType.MAMBA), ((11, 42),)),
+    )
+    assert tracker.snapshot_session_leaf_anchors("session", generation + 1) is None
+    assert tracker.snapshot_session_leaf_anchors(
+        "session", generation, max_leaves=1
+    ) is None
+    nodes[11] = object()
+    assert tracker.snapshot_session_leaf_anchors("session", generation) is None
+    nodes[11] = node
+    node.component_data[ComponentType.FULL].session_ids.clear()
+    assert tracker.snapshot_session_leaf_anchors("session", generation) is None
+    node.component_data[ComponentType.FULL].session_ids.add("session")
+    tracker.release_radix_session("session")
+    assert tracker.snapshot_session_leaf_anchors("session", generation) is None
