+"""CPU transfer-order and lifecycle proofs for dependency-based restore tiers."""
+
+from types import SimpleNamespace as NS
+from unittest.mock import Mock, patch
+
+import pytest
+import contextlib
+
+from test_beliefkv_transfer_receipts import (
+    CacheOperation, HiCacheController, controller, indices,
+)
+from test_beliefkv_unified_ack import AckCache
+from test_beliefkv_shadow_dispatch import fixture as shadow_fixture
+
+
+def fixture():
+    cache = controller()
+    cache.layer_num = 8
+    cache._l2_load_transfers = lambda *_: [NS(layer_mapper=lambda layer: layer if layer in (3, 7) else None)]
+    calls = []
+
+    def submit(transfers, **kwargs):
+        start = NS(elapsed_time=Mock(return_value=2.))
+        finish = NS(query=Mock(return_value=False))
+        calls.append((transfers, kwargs, start, finish))
+        if kwargs.get("on_layer_done"):
+            for layer in range(kwargs.get("layer_start", 0), kwargs["layer_num"]):
+                kwargs["on_layer_done"](layer)
+        return NS(start_event=start, finish_event=finish, timing_enabled=True)
+
+    cache.l2_transfer_engine.submit_host_to_device = submit
+    cache.load_queue.append(CacheOperation(indices(10), indices(10), 1, beliefkv_command_id="p1"))
+    return cache, calls
+
+
+def test_pipeline_copies_only_first_actual_full_layer_and_retains_full_receipt():
+    cache, calls = fixture()
+    assert cache.start_loading(beliefkv_prefetch_tier="pipeline") == 0
+    assert [item[1]["layer_num"] for item in calls] == [0, 4]
+    assert cache.layer_done_counter.events[0].complete.call_args_list[-1].args == (3,)
+    assert cache.ack_load_queue == []
+    assert cache._beliefkv_load_continuation is not None
+    assert cache.resume_beliefkv_loading()
+    assert calls[-1][1]["layer_start"] == 4
+    assert calls[-1][1]["layer_num"] == 8
+    assert len(cache.ack_load_queue) == 1
+    ack = cache.ack_load_queue[0]
+    assert ack.node_ids == [1] and ack.num_tokens == 10 and ack.num_bytes == 100
+    assert ack.child_receipts[0].command_id == "p1"
+    assert ack.finish_event is calls[-1][3]
+    assert ack.state_ready_event is calls[0][3]
+    assert len(ack.transfer_segments) == 3
+    assert not cache.resume_beliefkv_loading()
+
+
+def test_native_start_resumes_tail_before_advancing_the_layer_ring():
+    cache, calls = fixture()
+    cache.start_loading(beliefkv_prefetch_tier="pipeline")
+    cache.load_queue.append(CacheOperation(indices(1), indices(1), 2))
+    cache.start_loading()
+    assert calls[2][1]["layer_start"] == 4
+    assert calls[3][1]["layer_num"] == 8
+    assert cache.layer_done_counter.update_producer.call_count == 2
+    assert [ack.node_ids for ack in cache.ack_load_queue] == [[1], [2]]
+    assert cache.layer_done_counter.events[0].state_ready_event is None
+
+
+def test_eager_has_no_deferred_tail_and_native_has_no_extra_stages():
+    for tier, count in (("eager", 2), ("complete", 1)):
+        cache, calls = fixture()
+        cache.start_loading(beliefkv_prefetch_tier=tier)
+        assert len(calls) == count
+        assert len(cache.ack_load_queue) == 1
+        assert not cache.resume_beliefkv_loading()
+
+
+def test_unclaimed_prefetch_finishes_after_200ms_without_publishing_early_ack():
+    cache, calls = fixture()
+    with patch("time.monotonic", return_value=10.):
+        cache.start_loading(beliefkv_prefetch_tier="pipeline")
+    with patch("time.monotonic", return_value=10.199):
+        assert not cache.resume_beliefkv_loading(expired_only=True)
+    assert cache.ack_load_queue == []
+    with patch("time.monotonic", return_value=10.2):
+        assert cache.resume_beliefkv_loading(expired_only=True)
+    assert len(calls) == 3 and len(cache.ack_load_queue) == 1
+
+
+@pytest.mark.parametrize("tier", ("pipeline", "eager"))
+def test_native_work_merged_into_burst_always_uses_original_pipeline(tier):
+    cache, calls = fixture()
+    cache.load_queue.append(CacheOperation(indices(1), indices(1), 2))
+    cache.start_loading(beliefkv_prefetch_tier=tier)
+    assert len(calls) == 1
+    assert cache.ack_load_queue[0].node_ids == [1, 2]
+    assert not cache.resume_beliefkv_loading()
+
+
+def test_failed_tail_submission_retains_ownership_and_never_publishes_ack():
+    cache, _ = fixture()
+    cache.start_loading(beliefkv_prefetch_tier="pipeline")
+    cache.l2_transfer_engine.submit_host_to_device = Mock(side_effect=RuntimeError("launch"))
+    with pytest.raises(RuntimeError, match="launch"):
+        cache.resume_beliefkv_loading()
+    assert cache.ack_load_queue == [] and cache._beliefkv_load_continuation is not None
+
+
+def test_state_transfer_finishes_before_full_and_is_not_a_full_ack():
+    cache, calls = fixture()
+    state = NS(layer_mapper=lambda layer: layer)
+    cache._beliefkv_split_prefetch_transfers = lambda full: ([state], full)
+    cache.start_loading(beliefkv_prefetch_tier="pipeline")
+    assert calls[0][0] == [state] and calls[0][1]["layer_num"] == 8
+    assert calls[1][1]["start_event"] is calls[0][3]
+    assert cache.layer_done_counter.events[0].state_ready_event is calls[0][3]
+    assert cache.ack_load_queue == []
+
+
+def test_transfer_timing_sums_stage_service_and_excludes_the_cpu_pause():
+    cache, calls = fixture()
+    cache.start_loading(beliefkv_prefetch_tier="pipeline")
+    cache.resume_beliefkv_loading()
+    assert AckCache._beliefkv_ack_stream_elapsed_ms(cache.ack_load_queue[0]) == 6.
+    assert all(item[2].elapsed_time.call_count == 1 for item in calls)
+
+
+def test_l2_continuation_copies_only_remaining_layers_and_records_their_fences():
+    from sglang.srt.mem_cache import l2_transfer as transfer
+
+    pool = NS(layer_num=8, load_to_device_per_layer=Mock())
+    indices = NS(is_cuda=False)
+    part = transfer.L2Transfer(pool, object(), indices, indices)
+    engine = transfer.L2TransferEngine.__new__(transfer.L2TransferEngine)
+    engine.io_backend, engine.host_to_device_stream = "kernel", object()
+    module = NS(stream=lambda _: contextlib.nullcontext())
+    start, finish = Mock(), Mock()
+    with patch.object(transfer, "device_module", module), patch.object(
+        transfer, "make_timing_event_pair", return_value=(start, finish, True),
+    ):
+        ready = Mock()
+        engine.submit_host_to_device(
+            [part], layer_num=8, layer_start=4, start_event=Mock(), on_layer_done=ready,
+        )
+    assert [item.args[3] for item in pool.load_to_device_per_layer.call_args_list] == [4, 5, 6, 7]
+    assert [item.args[0] for item in ready.call_args_list] == [4, 5, 6, 7]
+
+
+def test_recorded_state_dependency_admits_before_full_ack_without_cpu_synchronize():
+    cache, *_ = shadow_fixture()
+    cache.linker = None
+    controller = cache.cache_controller
+    controller.load_fence_stream = object()
+    controller.load_queue = []
+    full_finish = Mock()
+    full_finish.query.return_value = False
+    state_ready = object()
+    controller.ack_load_queue = [NS(
+        finish_event=full_finish, state_ready_event=state_ready,
+        child_receipts=(NS(command_id="p1", num_tokens_by_pool=(("kv", 10), ("mamba", 1))),),
+    )]
+    controller.resume_beliefkv_loading = Mock()
+    assert cache.beliefkv_prefetch_can_admit(("p1",))
+    controller.resume_beliefkv_loading.assert_called_once()
+    full_finish.query.assert_not_called()
+    full_finish.synchronize.assert_not_called()
+
+
+@pytest.mark.parametrize("quantized", (False, True))
+def test_quantized_state_copy_without_the_new_fence_keeps_the_legacy_restore_path(quantized):
+    cache, *_ = shadow_fixture()
+    cache.linker = None
+    cache.cache_controller.load_fence_stream = object()
+    cache.cache_controller.resume_beliefkv_loading = Mock()
+    cache.req_to_token_pool = NS(mamba_ckpt_pool=object() if quantized else None)
+    assert cache.supports_beliefkv_restore_tiers() is (not quantized)
