+            scan = self._beliefkv_idle_full_scan = deque(
+                self.tree_core.evictable_device_leaves,
+            )
+        excluded = set(exclude_node_ids)
+        candidates = []
+        for _ in range(32):
+            if not scan:
+                break
+            node = scan.popleft()
+            stats["scanned_nodes"] += 1
+            full = node.component_data[BASE_COMPONENT_TYPE]
+            if (
+                node.id not in excluded and full.value is not None
+                and full.host_value is None
+                and node.id not in self.ongoing_write_through
