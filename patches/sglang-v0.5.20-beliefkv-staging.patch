+"""FULL-only session probes use real native tree state without a Mamba checkpoint."""
+
+from array import array
+from types import SimpleNamespace as NS
+
+from sglang.srt.mem_cache.unified_cache.component_type import ComponentType
+from test_beliefkv_terminal_capacity import cache, insert_session
+
+
+def test_full_only_reentry_has_no_fictitious_state_dependency(cache):
+    node, generation = insert_session(cache, [10, 11, 12, 13], "parent")
+    req = NS(
+        session_id="parent", session_generation=generation,
+        origin_input_ids=array("q", [10, 11, 12, 13, 99]), extra_key=None, cache_salt=None,
+    )
+    observed = cache.inspect_beliefkv_reentry(req)
+    assert observed["component_leaves"] == (
+        (int(ComponentType.FULL), ((node.id, node.creation_time),)),
+    )
+    assert observed["checkpoint_tokens"] == observed["device_checkpoint_tokens"] == 4
+    assert observed["missing_full_tokens"] == observed["missing_mamba_slots"] == 0
+    assert cache._component_available_size(ComponentType.MAMBA) == 0
+
+
+def test_full_only_host_prefix_is_recoverable_and_input_is_verified(cache):
+    node, generation = insert_session(cache, [10, 11, 12, 13], "parent")
+    full = node.component_data[ComponentType.FULL]
+    full.host_value, full.value = full.value, None
+    req = NS(
+        session_id="parent", session_generation=generation,
+        origin_input_ids=array("q", [10, 11, 12, 13, 99]), extra_key=None, cache_salt=None,
+    )
+    observed = cache.inspect_beliefkv_reentry(req)
+    assert observed["checkpoint_tokens"] == observed["missing_full_tokens"] == 4
+    assert observed["device_checkpoint_tokens"] == observed["missing_mamba_slots"] == 0
+    req.origin_input_ids = array("q", [10, 11, 88, 13, 99])
+    assert cache.inspect_beliefkv_reentry(req) is None
+    req.origin_input_ids = array("q", [10, 11, 12, 13, 99])
+    req.session_generation += 1
+    assert cache.inspect_beliefkv_reentry(req) is None
+
+
+def test_full_only_pending_load_cannot_be_observed_as_resident(cache):
+    node, generation = insert_session(cache, [10, 11], "parent")
+    req = NS(
+        session_id="parent", session_generation=generation,
+        origin_input_ids=array("q", [10, 11, 99]), extra_key=None, cache_salt=None,
+    )
+    node.load_back_pending_id = node.id
+    assert cache.inspect_beliefkv_reentry(req) is None
+    node.load_back_pending_id = None
+    assert cache.inspect_beliefkv_reentry(req)["device_checkpoint_tokens"] == 2
