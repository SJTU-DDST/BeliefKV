+"""BeliefKV scheduler safe-point contract, without model/GPU dependencies."""
+
+import ast
+import sys
+import types
+import unittest
+from collections import namedtuple
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import patch
+
+
+SCHEDULER = (
+    Path(__file__).resolve().parents[2]
+    / "python/sglang/srt/managers/scheduler.py"
+)
+PLAN = namedtuple("NextBatchPlan", "batch_to_run running_batch")
+
+
+def load_hook():
+    tree = ast.parse(SCHEDULER.read_text(encoding="utf-8"))
+    scheduler = next(
+        node
+        for node in tree.body
+        if isinstance(node, ast.ClassDef) and node.name == "Scheduler"
+    )
+    methods = {
+        "init_beliefkv_runtime",
+        "_beliefkv_tp_agree",
+        "_beliefkv_before_batch_selection",
+        "_beliefkv_prefill_candidates",
+        "get_next_batch_to_run",
+    }
+    extracted = [
+        node
+        for node in scheduler.body
+        if isinstance(node, ast.FunctionDef) and node.name in methods
+    ]
+    for node in extracted:
+        node.decorator_list = []
+    module = ast.Module(
+        body=[
+            ast.ImportFrom(
+                module="__future__",
+                names=[ast.alias(name="annotations")],
+                level=0,
+            ),
+            ast.ClassDef(
+                name="SchedulerHook",
+                bases=[],
+                keywords=[],
+                body=extracted,
+                decorator_list=[],
+            ),
+        ],
+        type_ignores=[],
+    )
+    ast.fix_missing_locations(module)
+    namespace = {
+        "NextBatchPlan": PLAN,
+        "DisaggregationMode": SimpleNamespace(NULL="null"),
+        "HTTPStatus": SimpleNamespace(SERVICE_UNAVAILABLE=503),
+        "_make_abort_req": lambda req, **kwargs: (req, kwargs),
+        "TokenizedGenerateReqInput": SimpleNamespace(
+            __struct_fields__=("beliefkv_metadata",)
+        ),
+    }
+    exec(compile(module, str(SCHEDULER), "exec"), namespace)
+    return namespace["SchedulerHook"]
+
+
+Hook = load_hook()
+
+
+def idle_scheduler(runtime=None, *, overlap=False):
+    scheduler = Hook()
+    calls = []
+    scheduler.beliefkv_runtime = runtime
+    scheduler._beliefkv_retraction_drain_pending = False
+    scheduler.ps = SimpleNamespace(tp_size=1, pp_size=1)
+    scheduler.enable_overlap = overlap
+    scheduler.result_queue = []
+    scheduler.chunked_req = None
+    scheduler.process_pending_chunked_abort = lambda: calls.append("abort")
+    scheduler._process_hicache_events = lambda: calls.append("cache")
+    scheduler.enable_fpm = False
+    scheduler.dllm_config = None
+    scheduler.enable_hisparse = False
+    scheduler.require_mlp_sync = False
+    scheduler._should_defer_prefill = lambda: True
+    scheduler.dp_attn_adapter = SimpleNamespace(
+        maybe_prepare_mlp_sync_batch=lambda batch, **kw: batch,
+        maybe_convert_decode_to_extend=lambda batch: batch,
+    )
+    scheduler._arm_prefill_decode_interval = lambda batch: None
+    scheduler.ngram_embedding_manager = SimpleNamespace(
+        prepare_for_forward=lambda batch, **kw: batch
+    )
+    batch = SimpleNamespace(
+        is_empty=lambda: True, is_prefill_only=False, batch_is_full=False
+    )
+    return scheduler, batch, calls
+
+
+class TestBeliefKVHook(unittest.TestCase):
+    def test_disabled_prefill_keeps_native_queue_and_does_not_import_adapter(self):
+        scheduler = Hook()
+        req = object()
+        scheduler.waiting_queue = [req]
+        scheduler.beliefkv_runtime = None
+        with patch.dict(
+            sys.modules, {"beliefkv.runtime.sglang_v0520_admission": None}
+        ):
+            self.assertIs(
+                scheduler._beliefkv_prefill_candidates(object(), object()),
+                scheduler.waiting_queue,
+            )
+
+    def test_prefill_hook_passes_safe_point_plan_to_bounded_selector(self):
+        scheduler = Hook()
+        req = object()
+        scheduler.waiting_queue = [req]
+        running_batch, adder = object(), object()
+        calls = []
+        runtime = SimpleNamespace(
+            semantic_revision=7,
+            terminal_waiting_request_ids=lambda queue: (),
+            plan_native_prefill=lambda queue, **kwargs: calls.append(
+                ("plan", queue, kwargs)
+            ) or "plan",
+            on_prefill_selection=lambda rejected: calls.append(("rejected", rejected)),
+        )
+        scheduler.beliefkv_runtime = runtime
+        selection = SimpleNamespace(candidates=(req,), rejected=(("blocked", "stale"),))
+        adapter = types.ModuleType("beliefkv.runtime.sglang_v0520_admission")
+        adapter.select_native_prefill_candidates = lambda queue, **kwargs: (
+            calls.append(("select", queue, kwargs)) or selection
+        )
+        with patch.dict(sys.modules, {adapter.__name__: adapter}):
+            self.assertEqual(
+                scheduler._beliefkv_prefill_candidates(running_batch, adder), (req,)
+            )
+        self.assertEqual(calls[0], (
+            "plan",
+            scheduler.waiting_queue,
+            {"running_batch": running_batch, "adder": adder},
+        ))
+        self.assertEqual(calls[1][2], {
+            "plan": "plan", "current_semantic_revision": 7,
+        })
+        self.assertEqual(calls[2], ("rejected", (("blocked", "stale"),)))
+
+    def test_native_prefill_filters_before_prefix_match_and_allocation(self):
+        tree = ast.parse(SCHEDULER.read_text(encoding="utf-8"))
+        scheduler = next(
+            node for node in tree.body
+            if isinstance(node, ast.ClassDef) and node.name == "Scheduler"
+        )
+        method = next(
+            node for node in scheduler.body
+            if isinstance(node, ast.FunctionDef)
+            and node.name == "_get_new_batch_prefill_raw"
+        )
+        loop = next(
+            node for node in ast.walk(method)
+            if isinstance(node, ast.For)
+            and isinstance(node.iter, ast.Call)
+            and isinstance(node.iter.func, ast.Attribute)
+            and node.iter.func.attr == "_beliefkv_prefill_candidates"
+        )
+        matched = next(
+            node.lineno for node in ast.walk(loop)
+            if isinstance(node, ast.Call)
+            and isinstance(node.func, ast.Attribute)
+            and node.func.attr == "init_next_round_input"
+        )
+        allocation = next(
+            node.lineno for node in ast.walk(loop)
+            if isinstance(node, ast.Call)
+            and isinstance(node.func, ast.Attribute)
+            and node.func.attr == "add_one_req"
+        )
+        self.assertLess(loop.lineno, matched)
+        self.assertLess(matched, allocation)
+
+    def test_normal_and_radix_native_request_metadata_is_forwarded(self):
+        tree = ast.parse(SCHEDULER.read_text(encoding="utf-8"))
+        scheduler = next(
+            node
+            for node in tree.body
+            if isinstance(node, ast.ClassDef) and node.name == "Scheduler"
+        )
+        handler = next(
+            node
+            for node in scheduler.body
+            if isinstance(node, ast.FunctionDef)
+            and node.name == "handle_generate_request"
+        )
+        normal_or_radix_branch = next(
+            node
+            for node in ast.walk(handler)
+            if isinstance(node, ast.If)
+            and isinstance(node.test, ast.BoolOp)
+            and any(
+                isinstance(value, ast.Name) and value.id == "radix_native_session"
+                for value in node.test.values
+            )
+        )
+        constructor = next(
+            node
+            for statement in normal_or_radix_branch.body
+            for node in ast.walk(statement)
+            if isinstance(node, ast.Call)
+            and isinstance(node.func, ast.Name)
+            and node.func.id == "Req"
+        )
+        metadata = next(
+            keyword.value
+            for keyword in constructor.keywords
+            if keyword.arg == "beliefkv_metadata"
+        )
+        self.assertIsInstance(metadata, ast.Attribute)
+        self.assertIsInstance(metadata.value, ast.Name)
+        self.assertEqual(
+            (metadata.value.id, metadata.attr), ("recv_req", "beliefkv_metadata")
+        )
+
+    def test_disabled_does_not_touch_runtime_or_change_idle_plan(self):
+        scheduler, batch, calls = idle_scheduler()
+        scheduler.server_args = SimpleNamespace(enable_beliefkv=False)
