+"""A settled urgent FULL copy is visible before the unfinished cold scan."""
+
+from collections import deque
+from types import SimpleNamespace as NS
+from weakref import ref
+from unittest.mock import Mock
+
+import pytest
+
+from sglang.srt.mem_cache.unified_cache.component_type import ComponentType as CT
+from test_beliefkv_cold_full_prepare import install_production_cpu_controller
+from test_beliefkv_terminal_capacity import hybrid_cache, insert_session
+
+
+def fixture(hybrid_cache):
+    cache, allocator, pool = hybrid_cache
+    nodes = []
+    for index in range(3):
+        node, _ = insert_session(cache, [10 + index, 20 + index], "waiting")
+        nodes.append(node)
+
+    class OrderedLeaves(set):
+        def __iter__(self):
+            return (node for node in nodes if set.__contains__(self, node))
+
+    cache.tree_core.evictable_device_leaves = OrderedLeaves(cache.tree_core.evictable_device_leaves)
+    cache.is_write_back = True
+    cache.host_memory_mode = "cache"
+    cache.cache_controller = NS(
+        write_queue=[], load_queue=[], ack_write_queue=[], ack_load_queue=[],
+        mem_pool_host=NS(size_per_token=16 * 1024**2, available_size=lambda: 128),
+    )
+    cache.beliefkv_join_pressure_candidates = ()
+    cache.beliefkv_join_pressure_validator = lambda *_: False
+    cache.beliefkv_cold_full_owner_validator = Mock(return_value=True)
+    _, commits = install_production_cpu_controller(cache)
+    target = allocator.available_size() + 2
+    assert cache.reclaim_beliefkv_handoff_capacity(
+        full_tokens=target, mamba_slots=0, max_nodes=1,
+        collect_cold_full_candidates=True, collect_diagnostics=True,
+    ) == {}
+    assert cache.beliefkv_handoff_last_capacity["native_full_scan_truncated"]
+    assert cache.prepare_beliefkv_cold_full_capacity(full_tokens=target)
+    return cache, allocator, pool, nodes, target, commits
+
+
+def test_settled_one_extent_backup_precedes_unfinished_scan_without_freeing_mamba(hybrid_cache):
+    cache, allocator, pool, nodes, target, commits = fixture(hybrid_cache)
+    available, states = allocator.available_size(), pool.mamba_allocator.available_size()
+    state = nodes[0].component_data[CT.MAMBA].value
+    assert cache.reclaim_beliefkv_handoff_capacity(
+        full_tokens=target, mamba_slots=0, max_nodes=1,
+    ) == {}
+    assert allocator.available_size() == available
+    assert not commits
+    cache.writing_check(finish_count=1)
+    assert commits and not cache.ongoing_write_through
+    assert nodes[0] not in cache._beliefkv_handoff_full_scan
+    assert cache.reclaim_beliefkv_handoff_capacity(
+        full_tokens=target, mamba_slots=0, max_nodes=1, collect_diagnostics=True,
+    ) == {int(CT.FULL): 2}
+    assert allocator.available_size() == target
+    assert pool.mamba_allocator.available_size() == states
+    assert nodes[0].component_data[CT.MAMBA].value is state
+    assert nodes[0].component_data[CT.FULL].session_ref == 1
+    assert nodes[0].component_data[CT.FULL].host_value is not None
+    assert cache.beliefkv_handoff_last_capacity["native_full_prepared_promoted"] == 1
+    assert cache.beliefkv_handoff_last_capacity["native_full_scanned"] == 1
+    assert cache._beliefkv_cold_full_prepare_pending == ()
+    assert cache._beliefkv_cold_full_prepare_scan_ref is None
+
+
+@pytest.mark.parametrize("blocked", (
+    "before_ack", "wrong_identity", "missing_node", "host_lost", "device_lock",
+    "h2d_pending", "not_leaf", "excluded", "runnable_owner",
+))
+def test_ready_copy_priority_never_grants_eviction_without_live_proof(
+    hybrid_cache, blocked, monkeypatch,
+):
+    cache, allocator, _, nodes, target, _ = fixture(hybrid_cache)
+    victim = nodes[0]
+    available = allocator.available_size()
+    if blocked != "before_ack":
+        cache.writing_check(finish_count=1)
+    if blocked == "wrong_identity":
+        cache._beliefkv_cold_full_prepare_pending = ((victim.id, victim.creation_time + 1, 2),)
+    elif blocked == "missing_node":
+        lookup = cache.tree_core.node_by_id
+
+        def missing(node_id):
+            if node_id == victim.id:
+                raise KeyError(node_id)
+            return lookup(node_id)
+
+        monkeypatch.setattr(cache.tree_core, "node_by_id", missing)
+    elif blocked == "host_lost":
+        victim.component_data[CT.FULL].host_value = None
+    elif blocked == "device_lock":
+        victim.component_data[CT.FULL].lock_ref += 1
+    elif blocked == "h2d_pending":
+        victim.load_back_pending_id = victim.id
+    elif blocked == "not_leaf":
+        cache.tree_core.evictable_device_leaves.discard(victim)
+    elif blocked == "runnable_owner":
+        cache.beliefkv_cold_full_owner_validator.return_value = False
+    assert cache.reclaim_beliefkv_handoff_capacity(
+        full_tokens=target, mamba_slots=0, max_nodes=1,
+        exclude_node_ids=(victim.id,) if blocked == "excluded" else (),
+    ) == {}
+    assert allocator.available_size() == available
+    assert victim.component_data[CT.FULL].value is not None
+    assert victim.component_data[CT.MAMBA].value is not None
+    if blocked == "before_ack":
+        assert victim.id in cache.ongoing_write_through
+        assert cache._beliefkv_cold_full_prepare_pending
+
+
+def test_prepared_batch_is_not_read_when_published_victims_already_fit(hybrid_cache):
+    cache, allocator, _, nodes, target, _ = fixture(hybrid_cache)
+    cache.writing_check(finish_count=1)
+    cache.beliefkv_join_pressure_candidates = ((nodes[0].id, nodes[0].creation_time),)
+    cache.beliefkv_join_pressure_validator = lambda *_: True
+    pending = cache._beliefkv_cold_full_prepare_pending
+    assert cache.reclaim_beliefkv_handoff_capacity(full_tokens=target, mamba_slots=0) == {0: 2}
+    assert allocator.available_size() == target
+    assert cache._beliefkv_cold_full_prepare_pending == pending
+
+
+@pytest.mark.parametrize("collect_cold", (False, True))
+def test_fresh_scan_contains_the_settled_extent_only_once(hybrid_cache, collect_cold):
+    cache, allocator, _, nodes, target, _ = fixture(hybrid_cache)
+    cache.writing_check(finish_count=1)
+    cache._beliefkv_handoff_full_scan = None
+    assert cache.reclaim_beliefkv_handoff_capacity(
+        full_tokens=target, mamba_slots=0, max_nodes=1,
+        collect_cold_full_candidates=collect_cold, collect_diagnostics=True,
+    ) == {int(CT.FULL): 2}
+    assert allocator.available_size() == target
+    assert nodes[0] not in cache._beliefkv_handoff_full_scan
+    assert len(cache._beliefkv_handoff_full_scan) == (2 if collect_cold else 0)
+    assert cache.beliefkv_handoff_last_capacity["native_full_prepared_promoted"] == 1
+
+
+@pytest.mark.parametrize("keep_provenance", (False, True))
+def test_unrelated_scan_keeps_its_order_without_injecting_a_duplicate(
+    hybrid_cache, keep_provenance,
+):
+    cache, allocator, _, nodes, target, _ = fixture(hybrid_cache)
+    cache.writing_check(finish_count=1)
+    original = cache._beliefkv_handoff_full_scan
+    cache._beliefkv_handoff_full_scan = deque((nodes[1], nodes[0], nodes[2]))
+    if not keep_provenance:
+        cache._beliefkv_cold_full_prepare_scan_ref = None
+    assert cache.reclaim_beliefkv_handoff_capacity(
+        full_tokens=target, mamba_slots=0, max_nodes=1, collect_diagnostics=True,
+    ) == {}
+    assert list(cache._beliefkv_handoff_full_scan) == [nodes[0], nodes[2]]
+    assert not cache.beliefkv_handoff_last_capacity.get("native_full_prepared_promoted")
+    assert cache._beliefkv_cold_full_prepare_pending == ()
+    assert cache._beliefkv_cold_full_prepare_scan_ref is None
+    assert original is not cache._beliefkv_handoff_full_scan
+    assert cache.reclaim_beliefkv_handoff_capacity(
+        full_tokens=target, mamba_slots=0, max_nodes=1,
+    ) == {int(CT.FULL): 2}
+    assert allocator.available_size() == target
+    assert list(cache._beliefkv_handoff_full_scan) == [nodes[2]]
+
+
+def test_pre_ack_retry_retains_only_a_weak_reference_to_the_origin_scan(hybrid_cache):
+    cache, _, _, _, target, _ = fixture(hybrid_cache)
+    origin = cache._beliefkv_handoff_full_scan
+    origin_ref = cache._beliefkv_cold_full_prepare_scan_ref
+    assert origin_ref() is origin
+    assert cache.reclaim_beliefkv_handoff_capacity(
+        full_tokens=target, mamba_slots=0, max_nodes=1,
+    ) == {}
+    assert cache._beliefkv_cold_full_prepare_scan_ref is origin_ref
+    del cache._beliefkv_handoff_full_scan
+    weak_origin = ref(origin)
+    del origin
+    assert weak_origin() is None
+    assert origin_ref() is None
