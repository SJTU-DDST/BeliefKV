+    def test_rejects_multiple_full_ancestors_or_stale_session_without_load(self):
+        cache, _, parent, leaf, _, _, args = fixture()
+        leaf.component_data[ComponentType.FULL].host_value = torch.arange(2)
+        leaf.component_data[ComponentType.FULL].value = None
+        cache.tree_core.build_load_back_spec = Mock(return_value=(
+            SimpleNamespace(
+                host_indices=torch.arange(4), nodes_to_load=[parent.id, leaf.id]
+            ),
+            {},
+        ))
+        cache.load_back = Mock()
+        self.assertFalse(cache.prefetch_gpu_session_node(
+            **args, beliefkv_before_enqueue=lambda op: True
+        ).issued)
+        cache.load_back.assert_not_called()
+        args["session_generation"] += 1
+        cache.tree_core.build_load_back_spec.reset_mock()
+        self.assertFalse(cache.prefetch_gpu_session_node(
+            **args, beliefkv_before_enqueue=lambda op: True
+        ).issued)
+        cache.tree_core.build_load_back_spec.assert_not_called()
+
+    def test_mamba_only_host_session_node_can_prefetch(self):
+        cache, _, _, leaf, _, _, args = fixture()
+        leaf.component_data[ComponentType.MAMBA].host_value = torch.arange(1)
+        cache.tree_core.build_load_back_spec = Mock(return_value=(
+            SimpleNamespace(host_indices=torch.arange(0), nodes_to_load=[]),
+            {ComponentType.MAMBA: [SimpleNamespace(nodes_to_load=[leaf.id])]},
+        ))
+
+        def load_back(node_id, **kwargs):
+            cache.ongoing_load_back[node_id] = object()
+            return True
+
+        cache.load_back = Mock(side_effect=load_back)
+        result = cache.prefetch_gpu_session_node(
+            **args, beliefkv_before_enqueue=lambda op: True
+        )
+        self.assertTrue(result.issued)
+        self.assertEqual(result.node_id, leaf.id)
+        self.assertTrue(cache.load_back.call_args.kwargs["beliefkv_no_device_reclaim"])
+
+    def test_predictive_queue_flush_preserves_layer_producer_for_early_match(self):
+        cache, _, _, leaf, _, _, args = fixture()
+        leaf.component_data[ComponentType.MAMBA].host_value = torch.arange(1)
+        cache.tree_core.build_load_back_spec = Mock(return_value=(
+            SimpleNamespace(host_indices=torch.arange(0), nodes_to_load=[]),
+            {ComponentType.MAMBA: [SimpleNamespace(nodes_to_load=[leaf.id])]},
+        ))
+        controller = cache.cache_controller
+        controller.load_queue = []
+
+        def load_back(node_id, **kwargs):
+            cache.ongoing_load_back[node_id] = object()
+            controller.load_queue.append(SimpleNamespace(beliefkv_command_id="cmd-2"))
+            return True
+
+        def start_loading():
+            if not controller.load_queue:
+                return -1
+            controller.load_queue.clear()
+            return 2
+
+        cache.load_back = Mock(side_effect=load_back)
+        controller.start_loading = Mock(side_effect=start_loading)
+        cache.linker = None
+        finish = Mock()
+        finish.query.return_value = False
+        controller.layer_done_counter = SimpleNamespace(events={
+            2: SimpleNamespace(finish_event=finish),
+        })
+        result = cache.prefetch_gpu_session_node(**args, beliefkv_before_enqueue=lambda op: True)
+        self.assertTrue(result.load_started)
+        self.assertEqual(cache.ready_to_load_host_cache(), 2)
+        finish.query.return_value = True
+        self.assertEqual(cache.ready_to_load_host_cache(), -1)
+
+    def test_predictive_fast_flush_never_steals_a_native_load_producer(self):
+        cache, _, _, leaf, _, _, args = fixture()
+        leaf.component_data[ComponentType.MAMBA].host_value = torch.arange(1)
+        cache.tree_core.build_load_back_spec = Mock(return_value=(
+            SimpleNamespace(host_indices=torch.arange(0), nodes_to_load=[]),
+            {ComponentType.MAMBA: [SimpleNamespace(nodes_to_load=[leaf.id])]},
+        ))
+        controller = cache.cache_controller
+        controller.load_queue = [SimpleNamespace(beliefkv_command_id=None)]
+        controller.start_loading = Mock()
+
+        def load_back(node_id, **kwargs):
+            cache.ongoing_load_back[node_id] = object()
+            controller.load_queue.append(SimpleNamespace(beliefkv_command_id="cmd-2"))
+            return True
+
+        cache.load_back = Mock(side_effect=load_back)
+        result = cache.prefetch_gpu_session_node(**args, beliefkv_before_enqueue=lambda op: True)
+        self.assertTrue(result.issued)
+        self.assertFalse(result.load_started)
+        controller.start_loading.assert_not_called()
+
+    def test_hbm_shortage_declines_without_native_eviction(self):
+        cache, _, _, leaf, _, _, _ = fixture()
+        cache.tree_core.build_load_back_spec = Mock(return_value=(
+            SimpleNamespace(host_indices=torch.arange(2)),
+            {},
+        ))
+        cache.load_back_threshold = 4
+        cache.token_to_kv_pool_allocator = SimpleNamespace(c128_attn_allocator=None)
+        cache._build_sidecar_transfers = Mock(return_value=[])
+        cache._component_available_size = Mock(return_value=1)
+        cache.dec_lock_ref = Mock()
+        cache.dec_host_lock_ref = Mock()
+        cache.evict_for_alloc = Mock(
+            side_effect=AssertionError("predictive H2D cannot evict")
+        )
+        cache.cache_controller.load = Mock()
+        result = cache._load_back_transfers(
+            node_id=leaf.id,
+            mem_quota=None,
+            req=None,
+            result=SimpleNamespace(delta=0),
+            ancestor_lock_params=object(),
+            host_anchor_params=object(),
+            beliefkv_command_id="cmd",
+            beliefkv_before_enqueue=lambda op: True,
+            beliefkv_no_device_reclaim=True,
+        )
+        self.assertFalse(result)
+        cache.evict_for_alloc.assert_not_called()
+        cache.cache_controller.load.assert_not_called()
+        cache.dec_lock_ref.assert_called_once()
+        cache.dec_host_lock_ref.assert_called_once()
+
+    def test_mamba_only_load_back_can_enqueue_without_full_tokens(self):
+        cache, _, _, leaf, _, _, _ = fixture()
+        cache.tree_core.build_load_back_spec = Mock(return_value=(
+            SimpleNamespace(host_indices=torch.arange(0)),
+            {ComponentType.MAMBA: [SimpleNamespace(
+                name=PoolName.MAMBA, host_indices=torch.arange(1),
+            )]},
+        ))
+        cache.load_back_threshold = 32
+        cache.token_to_kv_pool_allocator = SimpleNamespace(c128_attn_allocator=None)
+        cache._build_sidecar_transfers = Mock(return_value=[])
+        cache._component_available_size = Mock(return_value=0)
+        cache.dec_lock_ref = Mock()
+        cache.inc_lock_ref = Mock(
+            return_value=SimpleNamespace(to_dec_params=lambda: "lock")
+        )
+        cache.tree_core.commit_load_back = Mock(return_value=[])
+        cache._apply_cache_actions = Mock()
+        cache.cache_controller.load = Mock(return_value=torch.arange(0))
+        callback = Mock(return_value=True)
+        assert cache._load_back_transfers(
+            node_id=leaf.id,
+            mem_quota=None, req=None,
+            result=SimpleNamespace(delta=0),
+            ancestor_lock_params="ancestor", host_anchor_params="host",
+            beliefkv_command_id="h2d-mamba",
+            beliefkv_before_enqueue=callback,
+            beliefkv_no_device_reclaim=True,
+        )
+        self.assertIn(leaf.id, cache.ongoing_load_back)
+        self.assertEqual(
+            cache.cache_controller.load.call_args.kwargs[
+                "beliefkv_command_id"
+            ], "h2d-mamba"
+        )
+        self.assertIs(
+            cache.cache_controller.load.call_args.kwargs[
+                "beliefkv_before_enqueue"
+            ], callback
+        )
+        self.assertTrue(
+            cache.cache_controller.load.call_args.kwargs[
+                "beliefkv_no_device_reclaim"
+            ]
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
