+@pytest.mark.parametrize("hybrid_cache", (32,), indirect=True)
+@pytest.mark.parametrize("component", (ComponentType.FULL, ComponentType.MAMBA))
+@pytest.mark.parametrize("excluded_count", (8, 16))
+def test_restore_targets_do_not_hide_cold_victim_behind_scan_budget(
+    hybrid_cache, component, excluded_count,
+):
+    cache, allocator, request_pool = hybrid_cache
+    for index in range(excluded_count + 1):
+        session_id = f"checkpoint-{index}"
+        node, _ = insert_session(cache, [100 + index, 1000 + index], session_id)
+        cache.release_radix_session(session_id)
+        state = node.component_data[ComponentType.MAMBA]
+        state.host_value = state.value.clone()
+        if component == ComponentType.FULL:
+            full = node.component_data[ComponentType.FULL]
+            full.host_value = full.value.clone()
+        cache.tree_core._update_duplicate_tracking(node)
+    if component == ComponentType.FULL:
+        ordered = list(cache.tree_core.evictable_device_leaves)
+    else:
+        lru = cache.tree_core.lru_lists[ComponentType.MAMBA]
+        ordered = []
+        node = lru.get_lru_no_lock()
+        while node is not None:
+            ordered.append(node)
+            node = lru.get_prev_no_lock(node)
+    assert len(ordered) == excluded_count + 1
+    excluded = ordered[:excluded_count]
+    victim = ordered[excluded_count]
+    saved_values = [
+        (node, tuple((data.value, data.host_value) for data in node.component_data))
+        for node in excluded
+    ]
+    full_available = allocator.available_size()
+    mamba_available = request_pool.mamba_allocator.available_size()
+    cache.is_write_back = True
+    cache.beliefkv_join_pressure_candidates = ()
+    cache.beliefkv_join_pressure_validator = lambda *_: False
+
+    result = cache.reclaim_beliefkv_handoff_capacity(
+        full_tokens=full_available + 2 if component == ComponentType.FULL else 0,
+        mamba_slots=mamba_available + 1 if component == ComponentType.MAMBA else 0,
+        exclude_node_ids=tuple(node.id for node in excluded),
+        max_nodes=1,
+    )
+
+    assert result[int(component)] == (2 if component == ComponentType.FULL else 1)
+    assert allocator.available_size() == full_available + (
+        2 if component == ComponentType.FULL else 0
+    )
+    assert request_pool.mamba_allocator.available_size() == mamba_available + 1
+    assert victim.component_data[component].value is None
+    if component == ComponentType.MAMBA:
+        assert victim.component_data[ComponentType.FULL].value is not None
+    for node, values in saved_values:
+        for data, (device_value, host_value) in zip(node.component_data, values):
+            assert data.value is device_value and data.host_value is host_value
+    assert [entry["node_id"] for entry in cache.beliefkv_handoff_last_victims] == [
+        victim.id
+    ]
+    cache._execute_and_commit_kv_backup.assert_not_called()
