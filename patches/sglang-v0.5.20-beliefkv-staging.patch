+++ b/test/srt/test_beliefkv_tool_host_retention.py
@@ -0,0 +1,146 @@
+"""Retained tool source copies and expiry reclamation use real CPU allocators."""
+
+import pytest
+
+from sglang.srt.mem_cache.unified_cache.component_type import ComponentType as CT
+from test_beliefkv_terminal_capacity import hybrid_cache, insert_session
+
+
+def backed_tool(hybrid_cache):
+    cache, allocator, request_pool = hybrid_cache
+    node, generation = insert_session(cache, [1, 2, 3, 4], "tool")
+    cache.is_write_back = cache.tree_core.is_write_back = True
+    cache.host_memory_mode = "cache"
+    cache.ongoing_write_through = {}
+    for ct in (CT.FULL, CT.MAMBA):
+        cd = node.component_data[ct]
+        cd.host_value = cd.value.clone()
+    cache.tree_core._update_duplicate_tracking(node)
+    return cache, allocator, request_pool, node, generation
+
+
+def pin(cache, node, *, full=True, mamba=True):
+    return cache.retain_beliefkv_prefetch_host(
+        node.id, node.creation_time, include_full=full, include_mamba=mamba,
+    )
+
+
+def reclaim(cache, node, generation, *, full=True, mamba=True):
+    return cache.reclaim_beliefkv_expired_tool_prefetch(
+        node.id, node.creation_time, session_id="tool", session_generation=generation,
+        include_full=full, include_mamba=mamba,
+    )
+
+
+@pytest.mark.parametrize("full,mamba", ((True, True), (True, False), (False, True)))
+def test_native_host_receipt_pins_only_the_transferred_pools(hybrid_cache, full, mamba):
+    cache, _, _, node, _ = backed_tool(hybrid_cache)
+    receipt = pin(cache, node, full=full, mamba=mamba)
+    assert receipt.node_id == node.id
+    assert node.component_data[CT.FULL].host_lock_ref == int(full)
+    assert node.component_data[CT.MAMBA].host_lock_ref == int(mamba)
+    assert cache.tree_core._can_reclaim_full_host_duplicate(node) is (not full)
+    cache.dec_host_lock_ref(node.id, receipt)
+    assert all(cd.host_lock_ref == 0 for cd in node.component_data)
+    assert cache.tree_core._can_reclaim_full_host_duplicate(node)
+
+
+@pytest.mark.parametrize("change", ("identity", "pending", "full_missing", "mamba_missing"))
+def test_changed_or_missing_source_is_not_pinned(hybrid_cache, change):
+    cache, _, _, node, _ = backed_tool(hybrid_cache)
+    if change == "identity":
+        node.creation_time += 1
+        assert cache.retain_beliefkv_prefetch_host(
+            node.id, node.creation_time - 1, include_full=True, include_mamba=True,
+        ) is None
+    else:
+        if change == "pending":
+            node.load_back_pending_id = 7
+        else:
+            node.component_data[CT.FULL if change == "full_missing" else CT.MAMBA].host_value = None
+        assert pin(cache, node) is None
+    assert all(cd.host_lock_ref == 0 for cd in node.component_data)
+
+
+@pytest.mark.parametrize("full,mamba", ((True, True), (True, False), (False, True)))
+def test_expiry_releases_only_idle_device_bytes_and_keeps_source(hybrid_cache, full, mamba):
+    cache, allocator, request_pool, node, generation = backed_tool(hybrid_cache)
+    receipt = pin(cache, node, full=full, mamba=mamba)
+    before_full, before_mamba = allocator.available_size(), request_pool.mamba_allocator.available_size()
+    sources = [node.component_data[ct].host_value for ct in (CT.FULL, CT.MAMBA)]
+    assert reclaim(cache, node, generation, full=full, mamba=mamba) == {
+        **({0: 4} if full else {}), **({2: 1} if mamba else {}),
+    }
+    assert allocator.available_size() == before_full + 4 * int(full)
+    assert request_pool.mamba_allocator.available_size() == before_mamba + int(mamba)
+    for ct, source in zip((CT.FULL, CT.MAMBA), sources):
+        assert node.component_data[ct].host_value is source
+    assert reclaim(cache, node, generation, full=full, mamba=mamba) == {}
+    cache.dec_host_lock_ref(node.id, receipt)
+    assert all(cd.host_lock_ref == 0 for cd in node.component_data)
+    cache._execute_and_commit_kv_backup.assert_not_called()
+
+
+@pytest.mark.parametrize("change", (
+    "generation", "closed", "identity", "device_lock", "d2h", "h2d", "no_retention",
+))
+def test_expiry_rechecks_native_identity_ownership_and_dependencies(hybrid_cache, change):
+    cache, allocator, request_pool, node, generation = backed_tool(hybrid_cache)
+    if change != "no_retention":
+        pin(cache, node)
+    if change == "generation":
+        generation += 1
+    elif change == "closed":
+        cache.release_radix_session("tool")
+    elif change == "identity":
+        node.creation_time += 1
+    elif change == "device_lock":
+        cache.inc_lock_ref(node.id)
+    elif change == "d2h":
+        node.write_through_pending_id = node.id
+    elif change == "h2d":
+        node.load_back_pending_id = node.id
+    available = allocator.available_size(), request_pool.mamba_allocator.available_size()
+    created = node.creation_time - int(change == "identity")
+    assert cache.reclaim_beliefkv_expired_tool_prefetch(
+        node.id, created, session_id="tool", session_generation=generation,
+        include_full=True, include_mamba=True,
+    ) == {}
+    assert (allocator.available_size(), request_pool.mamba_allocator.available_size()) == available
+    cache._execute_and_commit_kv_backup.assert_not_called()
+
+
+def test_shared_checkpoint_is_preserved_even_when_one_tool_lease_expires(hybrid_cache):
+    cache, allocator, request_pool, node, generation = backed_tool(hybrid_cache)
+    insert_session(cache, [1, 2, 3, 4], "other")
+    pin(cache, node)
+    available = allocator.available_size(), request_pool.mamba_allocator.available_size()
+    assert reclaim(cache, node, generation) == {}
+    assert (allocator.available_size(), request_pool.mamba_allocator.available_size()) == available
+    cache._execute_and_commit_kv_backup.assert_not_called()
+
+
+def test_retaining_leaf_does_not_claim_to_pin_full_ancestor_duplicates(hybrid_cache):
+    cache, _, _, parent, generation = backed_tool(hybrid_cache)
+    leaf, generation = insert_session(cache, [1, 2, 3, 4, 5, 6], "tool")
+    leaf.component_data[CT.FULL].host_value = leaf.component_data[CT.FULL].value.clone()
+    cache.tree_core._update_duplicate_tracking(leaf)
+    parent_receipt = pin(cache, parent, mamba=False)
+    leaf_receipt = pin(cache, leaf, mamba=False)
+    assert not cache.tree_core._can_reclaim_full_host_duplicate(parent)
+    assert not cache.tree_core._can_reclaim_full_host_duplicate(leaf)
+    cache.dec_host_lock_ref(leaf.id, leaf_receipt)
+    assert not cache.tree_core._can_reclaim_full_host_duplicate(parent)
+    cache.dec_host_lock_ref(parent.id, parent_receipt)
+    assert cache.tree_core._can_reclaim_full_host_duplicate(parent)
+
+
+def test_native_host_pressure_cannot_reclaim_the_retained_full_duplicate(hybrid_cache):
+    cache, _, _, node, _ = backed_tool(hybrid_cache)
+    receipt = pin(cache, node)
+    host = node.component_data[CT.FULL].host_value
+    result = cache.tree_core.drive_host_eviction(CT.FULL, 4)
+    assert not result.host_frees.get(CT.FULL)
+    assert node.component_data[CT.FULL].host_value is host
+    cache.dec_host_lock_ref(node.id, receipt)
+    assert cache.tree_core._can_reclaim_full_host_duplicate(node)
