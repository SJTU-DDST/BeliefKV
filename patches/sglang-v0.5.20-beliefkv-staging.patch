+def test_actual_page_first_fallback_preserves_bytes_and_coalesces_contiguous_pages(tmp_path):
+    root = Path(__file__).resolve().parents[2]
+    header = root / "python/sglang/kernels/jit/csrc/kvcacheio/staged_write_back.cuh"
+    source = header.read_text()
+    body = source.split("inline void copy_page_first_pages_fallback(", 1)[1]
+    body = "inline void copy_page_first_pages_fallback(" + body.split(
+        "inline bool try_copy_page_first_pages_batch(", 1,
+    )[0]
+    prelude = r"""
+#include <cassert>
+#include <cstdint>
+#include <cstring>
+#include <iostream>
+#include <stdexcept>
+#include <vector>
+using cudaStream_t = int;
+constexpr int cudaMemcpyDeviceToHost = 0;
+int calls = 0;
+int cudaMemcpyAsync(void* dst, const void* src, size_t n, int, int) {
+  ++calls;
+  std::memcpy(dst, src, n);
+  return 0;
+}
+namespace tvm::ffi {
+struct TensorView {
+  unsigned char* data;
+  int64_t row_stride;
+  int bytes;
+  int dtype() const { return bytes; }
+  int64_t stride(int) const { return row_stride; }
+  void* data_ptr() const { return data; }
+};
+}
+namespace host {
+inline int64_t dtype_bytes(int bytes) { return bytes; }
+template <typename... Args>
+void RuntimeCheck(bool good, Args...) {
+  if (!good) throw std::runtime_error("invalid tensor");
+}
+inline void RuntimeDeviceCheck(int code) { assert(code == 0); }
+struct Range {
+  int64_t end_value;
+  struct Iterator {
+    int64_t value;
+    int64_t operator*() const { return value; }
+    Iterator& operator++() { ++value; return *this; }
+    bool operator!=(Iterator other) const { return value != other.value; }
+  };
+  Iterator begin() const { return {0}; }
+  Iterator end() const { return {end_value}; }
+};
+inline Range irange(int64_t n) { return {n}; }
+}
+"""
+    main = r"""
+void check(const std::vector<int64_t>& pages, int64_t page_size, int bytes) {
+  constexpr int64_t stride = 3;
+  const size_t width = page_size * stride * bytes;
+  std::vector<unsigned char> k(pages.size() * width), v(k.size());
+  for (size_t i = 0; i < k.size(); ++i) {
+    k[i] = static_cast<unsigned char>(i * 7 + 3);
+    v[i] = static_cast<unsigned char>(i * 13 + 11);
+  }
+  std::vector<unsigned char> dst_k(16 * width, 157), dst_v(dst_k);
+  auto expected_k = dst_k, expected_v = dst_v;
+  std::vector<int64_t> indices;
+  for (size_t i = 0; i < pages.size(); ++i) {
+    for (int64_t token = 0; token < page_size; ++token)
+      indices.push_back(pages[i] * page_size + token);
+    std::memcpy(expected_k.data() + pages[i] * width, k.data() + i * width, width);
+    std::memcpy(expected_v.data() + pages[i] * width, v.data() + i * width, width);
+  }
+  calls = 0;
+  copy_page_first_pages_fallback(
+    {{k.data(), stride, bytes}, {v.data(), stride, bytes}},
+    {{dst_k.data(), stride, bytes}, {dst_v.data(), stride, bytes}},
+    indices.data(), static_cast<int64_t>(pages.size()), page_size, 0);
+  assert(dst_k == expected_k && dst_v == expected_v);
+  assert(calls <= static_cast<int>(pages.size() * 2));
+}
+int main() {
+  for (int64_t page_size : {1, 2, 8}) {
+    for (int bytes : {1, 2, 4}) {
+      for (int length = 0; length <= 5; ++length) {
+        int patterns = 1;
+        for (int j = 0; j < length; ++j) patterns *= 4;
+        for (int pattern = 0; pattern < patterns; ++pattern) {
+          int digits = pattern;
+          std::vector<int64_t> pages;
+          for (int j = 0; j < length; ++j) {
+            pages.push_back(digits % 4);
+            digits /= 4;
+          }
+          check(pages, page_size, bytes);
+        }
+      }
+      check({0, 1, 2, 3, 4, 5, 6, 7}, page_size, bytes);
+      assert(calls == 2);
+      check({0, 1, 4, 5, 9}, page_size, bytes);
+      assert(calls == 6);
+      check({4, 3, 2, 1, 0}, page_size, bytes);
+      assert(calls == 10);
+    }
+  }
+  std::cout << "exhaustive byte equivalence and copy-call boundaries passed\n";
+}
+"""
+    program = tmp_path / "host_copy.cpp"
+    executable = tmp_path / "host_copy"
+    program.write_text(prelude + body + main)
+    subprocess.run(
+        ["g++", "-std=c++17", "-O2", "-Wall", "-Werror", str(program), "-o", str(executable)],
+        check=True, capture_output=True, text=True,
+    )
+    result = subprocess.run([str(executable)], check=True, capture_output=True, text=True)
+    assert "boundaries passed" in result.stdout
