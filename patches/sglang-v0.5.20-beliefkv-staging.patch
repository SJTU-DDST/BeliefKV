+        """Keep the acknowledged source copy for one bounded tool service lease."""
+        if (
+            not self.is_write_back or self.host_memory_mode != "cache"
+            or self.buffer_pipeline is not None
+            or not (include_full or include_mamba)
+            or not set(self.tree_components) <= {
+                BASE_COMPONENT_TYPE, ComponentType.MAMBA,
+            }
+        ):
+            return None
+        try:
+            node = self.tree_core.node_by_id(node_id)
+        except (KeyError, RuntimeError, ValueError):
+            return None
+        if node.creation_time != creation_time or node.load_back_pending_id is not None:
+            return None
+        for ct, requested in (
+            (BASE_COMPONENT_TYPE, include_full), (ComponentType.MAMBA, include_mamba),
+        ):
+            if not requested:
+                continue
+            if ct not in self.tree_components:
+                return None
+            cd = node.component_data[ct]
+            if (
+                cd.value is None or cd.host_value is None
+                or len(cd.value) != len(cd.host_value)
+            ):
+                return None
+        # FULL duplicate reclamation ignores ancestor anchor locks, so each
+        # actual transferred node needs its own paired native Host receipt.
+        requested = {
+            ct for ct, included in (
+                (BASE_COMPONENT_TYPE, include_full), (ComponentType.MAMBA, include_mamba),
+            ) if included
