@@ -0,0 +1,1231 @@
+"""BeliefKV scheduler safe-point contract, without model/GPU dependencies."""
+
+import ast
+import os
+import sys
+import types
+import unittest
+from collections import deque, namedtuple
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import patch
+
+
+SCHEDULER = (
+    Path(__file__).resolve().parents[2]
+    / "python/sglang/srt/managers/scheduler.py"
+)
+PLAN = namedtuple("NextBatchPlan", "batch_to_run running_batch")
+
+
+def load_hook():
+    tree = ast.parse(SCHEDULER.read_text(encoding="utf-8"))
+    scheduler = next(
+        node
+        for node in tree.body
+        if isinstance(node, ast.ClassDef) and node.name == "Scheduler"
+    )
+    methods = {
+        "init_beliefkv_runtime",
+        "_beliefkv_on_native_transfer_commit",
+        "_beliefkv_on_batch_completed",
+        "_beliefkv_tp_agree",
+        "_beliefkv_before_batch_selection",
+        "_beliefkv_after_forward_dispatch",
+        "_beliefkv_prefill_candidates",
+        "event_loop_normal",
+        "event_loop_overlap",
+        "get_next_batch_to_run",
+        "handle_shutdown",
+    }
+    extracted = [
+        node
+        for node in scheduler.body
+        if isinstance(node, ast.FunctionDef) and node.name in methods
+    ]
+    for node in extracted:
+        node.decorator_list = []
+    module = ast.Module(
+        body=[
+            ast.ImportFrom(
+                module="__future__",
+                names=[ast.alias(name="annotations")],
+                level=0,
+            ),
+            ast.ClassDef(
+                name="SchedulerHook",
+                bases=[],
+                keywords=[],
+                body=extracted,
+                decorator_list=[],
+            ),
+        ],
+        type_ignores=[],
+    )
+    ast.fix_missing_locations(module)
+    namespace = {
+        "__file__": str(SCHEDULER),
+        "os": os,
+        "deque": deque,
+        "envs": SimpleNamespace(
+            SGLANG_ENABLE_STRICT_MEM_CHECK_DURING_BUSY=SimpleNamespace(get=lambda: False),
+        ),
+        "NextBatchPlan": PLAN,
+        "DisaggregationMode": SimpleNamespace(NULL="null"),
+        "HTTPStatus": SimpleNamespace(SERVICE_UNAVAILABLE=503),
+        "_make_abort_req": lambda req, **kwargs: (req, kwargs),
+        "set_schedule_time_batch": lambda _: None,
+        "TokenizedGenerateReqInput": SimpleNamespace(
+            __struct_fields__=("beliefkv_metadata",)
+        ),
+    }
+    exec(compile(module, str(SCHEDULER), "exec"), namespace)
+    return namespace["SchedulerHook"]
+
+
+Hook = load_hook()
+
+
+def idle_scheduler(runtime=None, *, overlap=False):
+    scheduler = Hook()
+    calls = []
+    scheduler.beliefkv_runtime = runtime
+    scheduler._beliefkv_retraction_drain_pending = False
+    scheduler.idle_sleeper = None
+    scheduler._beliefkv_predictor_fds = set()
+    scheduler.ps = SimpleNamespace(tp_size=1, pp_size=1)
+    scheduler.enable_overlap = overlap
+    scheduler.result_queue = []
+    scheduler.waiting_queue = []
+    scheduler.chunked_req = None
+    scheduler.process_pending_chunked_abort = lambda: calls.append("abort")
+    scheduler._process_hicache_events = lambda: calls.append("cache")
+    scheduler.enable_fpm = False
+    scheduler.dllm_config = None
+    scheduler.enable_hisparse = False
+    scheduler.require_mlp_sync = False
+    scheduler._should_defer_prefill = lambda: True
+    scheduler.dp_attn_adapter = SimpleNamespace(
+        maybe_prepare_mlp_sync_batch=lambda batch, **kw: batch,
+        maybe_convert_decode_to_extend=lambda batch: batch,
+    )
+    scheduler._arm_prefill_decode_interval = lambda batch: None
+    scheduler.ngram_embedding_manager = SimpleNamespace(
+        prepare_for_forward=lambda batch, **kw: batch
+    )
+    batch = SimpleNamespace(
+        is_empty=lambda: True, is_prefill_only=False, batch_is_full=False
+    )
+    return scheduler, batch, calls
+
+
+class TestBeliefKVHook(unittest.TestCase):
+    def test_prefill_turnover_observes_normal_and_overlap_without_changing_dispatch(self):
+        from beliefkv.runtime.prefill_turnover_probe import PrefillTurnoverProbe
+
+        for overlap in (False, True):
+            with self.subTest(overlap=overlap):
+                scheduler, running, calls = idle_scheduler(overlap=overlap)
+                probe_records = []
+                probe = PrefillTurnoverProbe(
+                    lambda *row: probe_records.append(row), every=1
+                )
+                scheduler._beliefkv_prefill_turnover_probe = probe
+                scheduler.device_module = None
+                scheduler.forward_stream = None
+                batch = SimpleNamespace(
+                    reqs=[SimpleNamespace(rid="r")],
+                    forward_mode=SimpleNamespace(is_extend=lambda: True),
+                    forward_iter=0, launch_ts=0., extend_num_tokens=80, prefix_lens=[256],
+                )
+                batch.copy = lambda: SimpleNamespace(**{
+                    key: value for key, value in vars(batch).items() if key != "copy"
+                })
+                scheduler.running_batch = running
+                scheduler.last_batch = None
+                scheduler.gracefully_exit = False
+                scheduler._engine_paused = False
+                scheduler.ingest_requests = lambda: None
+                scheduler.is_disable_overlap_for_batch = lambda *args, **kwargs: False
+                scheduler.is_generation = False
+                result = SimpleNamespace(can_run_cuda_graph=True)
+                passes = iter((batch, None))
+
+                def select(**kwargs):
+                    selected = next(passes)
+                    scheduler._beliefkv_physical_planning_deferred = True
+                    if selected is None:
+                        scheduler.gracefully_exit = True
+                    return PLAN(selected, running)
+
+                def launch(selected):
+                    selected.forward_iter = 1
+                    probe.on_launch(selected)
+                    calls.append("forward")
+                    if not overlap:
+                        scheduler.gracefully_exit = True
+                    return result
+
+                scheduler.get_next_batch_to_run = select
+                scheduler.run_batch = launch
+                scheduler.process_batch_result = lambda *args: calls.append("result")
+                scheduler._apply_war_barrier = lambda: calls.append("war")
+                scheduler.beliefkv_runtime = SimpleNamespace(
+                    dispatch_after_forward=lambda *args, **kwargs: calls.append("physical"),
+                )
+                scheduler.event_loop_overlap() if overlap else scheduler.event_loop_normal()
+                self.assertEqual(
+                    calls, ["forward", "war", "physical", "result", "physical"]
+                    if overlap else ["forward", "result"],
+                )
+                self.assertEqual(len(probe_records), 1)
+                observed = probe_records[0][1]
+                self.assertEqual(observed["loop"], "overlap" if overlap else "normal")
+                self.assertEqual(observed["request_ids"], ("r",))
+                self.assertEqual(observed["cuda_graph_replayed"], True)
+                self.assertIn("selection", observed["phases"])
+                self.assertIn("run_batch", observed["phases"])
+                self.assertIn("result_processing", observed["phases"])
+                self.assertEqual(
+                    "post_launch_physical" in observed["phases"], overlap
+                )
+
+    def test_overlap_waiting_planning_follows_result_delivery_and_sampling(self):
+        scenarios = (
+            (False, True, False),
+            (True, True, False),
+            (True, True, True),
+            (True, False, False),
+            (False, False, False),
+        )
+        cases = (
+            (*scenario, enabled)
+            for scenario in scenarios
+            for enabled in (False, True)
+        )
+        for previous, current, disable_overlap, enabled in cases:
+            with self.subTest(
+                previous=previous, current=current, disable_overlap=disable_overlap,
+                enabled=enabled,
+            ):
+                scheduler, running, calls = idle_scheduler(overlap=True)
+                batch = SimpleNamespace(copy=lambda: "current-copy") if current else None
+                scheduler.running_batch = running
+                scheduler.last_batch = "previous" if previous else None
+                scheduler.gracefully_exit = False
+                scheduler._engine_paused = False
+                scheduler.ingest_requests = lambda: None
+                scheduler.is_disable_overlap_for_batch = (
+                    lambda *args, **kwargs: disable_overlap
+                )
+                scheduler.enable_unified_memory = False
+                scheduler.is_generation = True
+                released = not previous
+                sampled = not current
+                fenced = not current
+
+                def select(**kwargs):
+                    scheduler._beliefkv_physical_planning_deferred = True
+                    if previous:
+                        scheduler.result_queue.append(("previous-copy", "previous-result"))
+                    scheduler.gracefully_exit = True
+                    return PLAN(batch, running)
+
+                def process(selected, result):
+                    nonlocal released
+                    self.assertEqual((selected, result), ("previous-copy", "previous-result"))
+                    if not disable_overlap:
+                        self.assertTrue(fenced)
+                    released = True
+                    calls.append("result")
+
+                def sample(result, selected):
+                    nonlocal sampled
+                    if selected is None:
+                        self.assertIsNone(result)
+                        return
+                    self.assertTrue(released)
+                    self.assertTrue(fenced)
+                    self.assertEqual(result, "current-result")
+                    sampled = True
+                    calls.append("sample")
+
+                def war():
+                    nonlocal fenced
+                    fenced = True
+                    calls.append("war")
+
+                def physical(queue, **kwargs):
+                    self.assertTrue(released)
+                    self.assertTrue(sampled)
+                    self.assertTrue(fenced)
+                    self.assertIs(kwargs["running_batch"], running)
+                    self.assertEqual(
+                        tuple(scheduler.result_queue),
+                        (("current-copy", "current-result"),) if current else (),
+                    )
+                    calls.append("physical")
+
+                scheduler.get_next_batch_to_run = select
+                scheduler.run_batch = lambda selected: (
+                    calls.append("forward") or "current-result"
+                )
+                scheduler._apply_war_barrier = war
+                scheduler.process_batch_result = process
+                scheduler.launch_batch_sample_if_needed = sample
+                scheduler.beliefkv_runtime = (
+                    SimpleNamespace(dispatch_after_forward=physical) if enabled else None
+                )
+                scheduler.on_idle = lambda: calls.append("idle")
+                scheduler.event_loop_overlap()
+                expected = ["result"] if disable_overlap else []
+                if current:
+                    expected.extend(("forward", "war"))
+                if previous and not disable_overlap:
+                    expected.append("result")
+                if current:
+                    expected.append("sample")
+                if enabled:
+                    expected.append("physical")
+                if not previous and not current:
+                    expected.append("idle")
+                self.assertEqual(calls, expected)
+                self.assertIs(scheduler.last_batch, batch)
