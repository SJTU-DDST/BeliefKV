@@ -0,0 +1,245 @@
+"""Real CPU recovery of backed FULL leaves behind unrelated unbacked leaves."""
+
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import pytest
+
+from sglang.srt.mem_cache.unified_cache.component_type import ComponentType
+from test_beliefkv_terminal_capacity import hybrid_cache, insert_session
+
+
+@pytest.mark.parametrize("hybrid_cache", (32,), indirect=True)
+@pytest.mark.parametrize("handoff", (False, True))
+def test_full_shortfall_keeps_unbacked_live_mamba_in_device(hybrid_cache, handoff):
+    cache, allocator, request_pool = hybrid_cache
+    leaf, _ = insert_session(cache, [1, 2, 3, 4], "waiting-parent")
+    full = leaf.component_data[ComponentType.FULL]
+    state = leaf.component_data[ComponentType.MAMBA]
+    full.host_value = full.value.clone()
+    full_host, state_device = full.host_value, state.value
+    full_available = allocator.available_size()
+    mamba_available = request_pool.mamba_allocator.available_size()
+    cache.is_write_back = True
+    cache.host_memory_mode = "cache"
+    cache.cache_controller = SimpleNamespace()
+    cache.beliefkv_join_pressure_candidates_by_component = {
+        int(ComponentType.FULL): ((leaf.id, leaf.creation_time),),
+    }
+    cache.beliefkv_join_pressure_validator = lambda *_: True
+    cache.beliefkv_join_pressure_parked = Mock()
+
+    if handoff:
+        freed = cache.reclaim_beliefkv_handoff_capacity(
+            full_tokens=full_available + 4, mamba_slots=0,
+        )
+    else:
+        freed = {}
+        cache._evict_backed_join_parent(ComponentType.FULL, freed)
+
+    assert freed == {int(ComponentType.FULL): 4}
+    assert allocator.available_size() == full_available + 4
+    assert request_pool.mamba_allocator.available_size() == mamba_available
+    assert full.value is None and full.host_value is full_host
+    assert state.value is state_device and state.host_value is None
+    cache._execute_and_commit_kv_backup.assert_not_called()
+    cache.beliefkv_join_pressure_parked.assert_called_once_with(
+        leaf.id, {int(ComponentType.FULL): 4},
+    )
+
+
+def backed_victim(cache):
+    ordered = []
+    for index in range(13):
+        session = f"native-{index}"
+        node, _ = insert_session(cache, [100 + index, 1000 + index], session)
+        cache.release_radix_session(session)
+        ordered.append(node)
+    victim = ordered[-1]
+    for component in (ComponentType.FULL, ComponentType.MAMBA):
+        data = victim.component_data[component]
+        data.host_value = data.value.clone()
+    cache.tree_core._update_duplicate_tracking(victim)
+
+    class Leaves(set):
+        iterations = 0
+
+        def __iter__(self):
+            self.iterations += 1
+            return (node for node in ordered if set.__contains__(self, node))
+
+    leaves = Leaves(cache.tree_core.evictable_device_leaves)
+    cache.tree_core.evictable_device_leaves = leaves
+    cache.is_write_back = True
+    cache.beliefkv_join_pressure_candidates = ()
+    cache.beliefkv_join_pressure_validator = lambda *_: False
+    return victim, ordered, leaves
+
+
+@pytest.mark.parametrize("hybrid_cache", (32,), indirect=True)
+def test_backed_index_reaches_real_victim_beyond_the_unbacked_scan_prefix(hybrid_cache):
+    cache, allocator, request_pool = hybrid_cache
+    victim, ordered, leaves = backed_victim(cache)
+    available = allocator.available_size()
+    original = [node.component_data[ComponentType.FULL].value for node in ordered]
+
+    result = cache.reclaim_beliefkv_handoff_capacity(
+        full_tokens=available + 2, mamba_slots=0, max_nodes=8,
+        collect_diagnostics=True,
+    )
+
+    assert result == {int(ComponentType.FULL): 2, int(ComponentType.MAMBA): 1}
+    assert allocator.available_size() == available + 2
+    assert victim.component_data[ComponentType.FULL].value is None
+    assert victim.component_data[ComponentType.FULL].host_value is not None
+    assert all(
+        node.component_data[ComponentType.FULL].value is values
+        for node, values in zip(ordered[:-1], original[:-1])
+    )
+    diagnosis = cache.beliefkv_handoff_last_capacity
+    assert diagnosis["native_full_scan_source"] == "settled_full_host_duplicates"
+    assert diagnosis["native_full_scanned"] == 1
+    assert diagnosis["native_full_selected"] == 1
+    assert diagnosis["native_full_scan_cycle_started"]
+    assert diagnosis["full_target_satisfied"]
+    assert leaves.iterations == 0
+    cache._execute_and_commit_kv_backup.assert_not_called()
+
+
+@pytest.mark.parametrize("hybrid_cache", (32,), indirect=True)
+@pytest.mark.parametrize("blocked", ("host_lost", "lock", "session", "d2h", "h2d", "excluded"))
+def test_index_candidates_still_require_live_native_eviction_proof(hybrid_cache, blocked):
+    cache, allocator, _ = hybrid_cache
+    victim, _, _ = backed_victim(cache)
+    full = victim.component_data[ComponentType.FULL]
+    if blocked == "host_lost":
+        full.host_value = None
+    elif blocked == "lock":
+        cache.inc_lock_ref(victim.id)
+    elif blocked == "session":
+        insert_session(cache, [112, 1012], "live")
+    elif blocked == "d2h":
+        victim.write_through_pending_id = victim.id
+    elif blocked == "h2d":
+        victim.load_back_pending_id = victim.id
+    available = allocator.available_size()
+    values = full.value
+
+    assert cache.reclaim_beliefkv_handoff_capacity(
+        full_tokens=available + 2, mamba_slots=0, max_nodes=8,
+        exclude_node_ids=(victim.id,) if blocked == "excluded" else (),
+    ) == {}
+    assert allocator.available_size() == available
+    assert full.value is values
+    cache._execute_and_commit_kv_backup.assert_not_called()
+
+
+@pytest.mark.parametrize("hybrid_cache", (32,), indirect=True)
+def test_empty_authoritative_duplicate_index_does_not_scan_unbacked_leaves(hybrid_cache):
+    cache, allocator, _ = hybrid_cache
+    victim, _, leaves = backed_victim(cache)
+    for component in (ComponentType.FULL, ComponentType.MAMBA):
+        victim.component_data[component].host_value = None
+    cache.tree_core._update_duplicate_tracking(victim)
+    assert cache.tree_core.full_host_duplicates == {}
+    available = allocator.available_size()
+
+    assert cache.reclaim_beliefkv_handoff_capacity(
+        full_tokens=available + 2, mamba_slots=0, max_nodes=8,
+        collect_diagnostics=True,
+    ) == {}
+    assert leaves.iterations == 0
+    assert cache.beliefkv_handoff_last_capacity["native_full_scanned"] == 0
+    cache._execute_and_commit_kv_backup.assert_not_called()
+
+
+@pytest.mark.parametrize("hybrid_cache", (32,), indirect=True)
+def test_backed_index_follows_a_newly_exposed_parent_within_the_same_transaction(hybrid_cache):
+    cache, allocator, _ = hybrid_cache
+    parent, _ = insert_session(cache, [1, 2], "branch")
+    leaf, _ = insert_session(cache, [1, 2, 3, 4], "branch")
+    cache.release_radix_session("branch")
+    for node in (parent, leaf):
+        for component in (ComponentType.FULL, ComponentType.MAMBA):
+            data = node.component_data[component]
+            data.host_value = data.value.clone()
+        cache.tree_core._update_duplicate_tracking(node)
+    cache.is_write_back = True
+    cache.beliefkv_join_pressure_candidates = ()
+    cache.beliefkv_join_pressure_validator = lambda *_: False
+    available = allocator.available_size()
+
+    result = cache.reclaim_beliefkv_handoff_capacity(
+        full_tokens=available + 4, mamba_slots=0, max_nodes=2,
+        collect_diagnostics=True,
+    )
+
+    assert result[int(ComponentType.FULL)] == 4
+    assert allocator.available_size() == available + 4
+    assert cache.beliefkv_handoff_last_capacity["native_full_scanned"] == 1
+    assert cache.beliefkv_handoff_last_capacity["transaction_attempts"] == 2
+    cache._execute_and_commit_kv_backup.assert_not_called()
+
+
+@pytest.mark.parametrize("hybrid_cache", (32,), indirect=True)
+def test_native_leaf_walk_handles_more_numerous_interior_duplicates(
+    hybrid_cache,
+):
+    cache, allocator, _ = hybrid_cache
+    for end in range(2, 10, 2):
+        leaf, _ = insert_session(cache, list(range(1, end + 1)), "branch")
+    cache.release_radix_session("branch")
+    node = leaf
+    while node is not cache.tree_core.root_node:
+        for component in (ComponentType.FULL, ComponentType.MAMBA):
+            data = node.component_data[component]
+            data.host_value = data.value.clone()
+        cache.tree_core._update_duplicate_tracking(node)
+        node = node.parent
+    assert len(cache.tree_core.full_host_duplicates) == 4
+    assert len(cache.tree_core.evictable_device_leaves) == 1
+    cache.is_write_back = True
+    cache.beliefkv_join_pressure_validator = lambda *_: False
+    available = allocator.available_size()
+
+    result = cache.reclaim_beliefkv_handoff_capacity(
+        full_tokens=available + 2, mamba_slots=0, max_nodes=1,
+        collect_diagnostics=True,
+    )
+
+    assert result[int(ComponentType.FULL)] == 2
+    assert allocator.available_size() == available + 2
+    assert cache.beliefkv_handoff_last_capacity["native_full_scanned"] == 1
+    assert (
+        cache.beliefkv_handoff_last_capacity["native_full_scan_source"]
+        == "device_leaves_dense_index"
+    )
+    cache._execute_and_commit_kv_backup.assert_not_called()
+
+
+@pytest.mark.parametrize("hybrid_cache", (32,), indirect=True)
+def test_native_ack_split_and_reinsert_keep_backed_index_complete(hybrid_cache):
+    cache, allocator, _ = hybrid_cache
+    leaf, _ = insert_session(cache, [1, 2, 3, 4], "checkpoint")
+    cache.release_radix_session("checkpoint")
+    full = leaf.component_data[ComponentType.FULL]
+    full.host_value = full.value.clone()
+    cache.tree_core.mark_write_through_pending([leaf.id], leaf.id)
+    assert leaf.id not in cache.tree_core.full_host_duplicates
+    cache.tree_core.finish_write_through([leaf.id], leaf.id)
+    assert cache.tree_core.full_host_duplicates[leaf.id] is leaf
+
+    insert_session(cache, [1, 2, 9, 9], "other")
+    prefix = leaf.parent
+    assert prefix is not cache.tree_core.root_node
+    assert cache.tree_core.full_host_duplicates[prefix.id] is prefix
+    assert cache.tree_core.full_host_duplicates[leaf.id] is leaf
+
+    cache.is_write_back = True
+    result = cache.tree_core.demote_backed_full_preserving_mamba(leaf.id)
+    cache._free_values(result.device_frees, result.host_frees)
+    cache.tree_core._update_duplicate_tracking(leaf)
+    assert leaf.id not in cache.tree_core.full_host_duplicates
+    cache.tree_core._unevict_node_on_insert(leaf, allocator.alloc(2))
+    assert cache.tree_core.full_host_duplicates[leaf.id] is leaf
+    cache._execute_and_commit_kv_backup.assert_not_called()
