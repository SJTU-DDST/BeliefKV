+@pytest.mark.parametrize("waiting", ("partial", "invalid", "excluded", "bounded"))
+def test_known_waiting_shortfall_still_uses_validated_native_fallback(waiting):
+    cache, checkpoint, victim, _ = fixture()
+    fallback = Node(
+        id=3, parent=cache.tree_core.root_node, creation_time=3,
+        component_data=[data(refs=0), data(False, False, 0), data(refs=0)],
+        write_through_pending_id=None, load_back_pending_id=None, backuped=True,
+    )
+    nodes = {0: cache.tree_core.root_node, 1: checkpoint, 2: victim, 3: fallback}
+    cache.tree_core.node_by_id = nodes.__getitem__
+    cache.tree_core.evictable_device_leaves.add(fallback)
+    cache.is_write_back = True
+    cache.ongoing_write_through = {}
+    cache.beliefkv_join_pressure_candidates = ((victim.id, victim.creation_time),)
+    cache.beliefkv_join_pressure_validator = lambda *_: waiting not in ("invalid", "bounded")
+    free = {0: 0, 2: 0}
+    cache._component_available_size = free.__getitem__
+
+    def demote(node_id, tracker):
+        node = nodes[node_id]
+        assert node is fallback or waiting == "partial"
+        node.component_data[0].value = None
+        free[0] += 2
+        free[2] += 1
+        tracker[0] = tracker.get(0, 0) + 2
+        tracker[2] = tracker.get(2, 0) + 1
+
+    cache._demote = demote
+    target = 4 if waiting == "partial" else 2
+    result = cache.reclaim_beliefkv_handoff_capacity(
+        full_tokens=target, mamba_slots=1,
+        exclude_node_ids=(victim.id,) if waiting == "excluded" else (),
+        max_nodes=1 if waiting == "bounded" else 64,
+        collect_diagnostics=True,
+    )
+    if waiting == "bounded":
+        assert result == {} and free == {0: 0, 2: 0}
+        assert fallback.component_data[0].value is not None
+        diagnosis = cache.beliefkv_handoff_last_capacity
+        assert diagnosis["transaction_truncated"]
+        assert not diagnosis["native_fallback_considered"]
+        return
+    assert result[0] == free[0] == target
+    assert fallback.component_data[0].value is None
+    assert (victim.component_data[0].value is None) == (waiting == "partial")
+    assert cache.beliefkv_handoff_last_capacity["native_full_scanned"] > 0
+    assert cache.beliefkv_handoff_last_victims[-1]["scope"] == "unreferenced_cache"
