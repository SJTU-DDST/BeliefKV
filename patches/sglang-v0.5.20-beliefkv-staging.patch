+"""CPU checks for native-order backup coalescing and ACK-before-release."""
+
+import ast
+import heapq
+from enum import IntEnum
+from pathlib import Path
+from types import SimpleNamespace as NS
+from unittest.mock import Mock
+
+import pytest
+import torch
+
+
+SOURCE = Path(__file__).resolve().parents[2] / "python/sglang/srt/mem_cache"
+
+
+class Component(IntEnum):
+    FULL = 0
+    MAMBA = 1
+    SWA = 2
+
+
+class Node:
+    def __init__(self, identity, priority, tokens=64):
+        self.id = identity
+        self.priority = priority
+        self.parent = None
+        self.children = {}
+        self.backuped = False
+        self.write_through_pending_id = None
+        self.load_back_pending_id = None
+        self.component_data = [
+            NS(value=torch.arange(tokens), lock_ref=0, host_lock_ref=0),
+            NS(value=None, lock_ref=0, host_lock_ref=0),
+        ]
+
+    def __lt__(self, other):
+        return self.id < other.id
+
+
+def methods(path, class_name, names, **namespace):
+    tree = ast.parse(path.read_text())
+    cls = next(
+        node for node in tree.body
+        if isinstance(node, ast.ClassDef) and node.name == class_name
+    )
+    selected = [
+        node for node in cls.body
+        if isinstance(node, ast.FunctionDef) and node.name in names
+    ]
+    assert len(selected) == len(names)
+    for node in selected:
+        node.decorator_list = []
+    module = ast.Module(body=[
+        ast.ImportFrom(module="__future__", names=[ast.alias(name="annotations")], level=0),
+        ast.ClassDef(
+            name="Loaded", bases=[], keywords=[], body=selected, decorator_list=[],
+        ),
+    ], type_ignores=[])
+    ast.fix_missing_locations(module)
+    exec(compile(module, str(path), "exec"), namespace)
+    return namespace["Loaded"]
+
+
+def fixture(*, max_nodes=32, remaining=1000):
+    root, ancestor, parent, leaf = (
+        Node(0, 0), Node(1, 1), Node(2, 2), Node(3, 3),
+    )
+    for upper, lower in ((root, ancestor), (ancestor, parent), (parent, leaf)):
+        upper.children[lower.id] = lower
+        lower.parent = upper
+    nodes = {node.id: node for node in (root, ancestor, parent, leaf)}
+    full_class = methods(
+        SOURCE / "unified_cache/components/full.py", "FullComponent",
+        {
+            "plan_write_back_chain", "finish_write_back_chain",
+            "_evict_device_start", "_evict_device_next_node", "_evict_device_end",
+        },
+        heapq=heapq,
+    )
+    component = full_class()
+    component.component_type = Component.FULL
+    component.tree_core = NS(
+        root_node=root, node_by_id=nodes.__getitem__, evictable_device_leaves={leaf},
+    )
+    component._evict_device_last_node = leaf
+    component._evict_device_heap = []
+    component.session_ref_eviction_strategy = lambda node: node.priority
+    component._ensure_eviction_strategy = lambda: None
+    cache_class = methods(
+        SOURCE / "unified_radix_cache.py", "UnifiedRadixCache",
+        {"_try_write_back_chain", "_evict_components"},
+        ComponentType=Component, BASE_COMPONENT_TYPE=Component.FULL,
+        BackupKV=lambda ids: NS(node_ids=ids),
+        logger=Mock(),
+    )
+    cache = cache_class()
+    cache.tree_core = NS(components_by_type={Component.FULL: component})
+    cache.tree_components = [Component.FULL, Component.MAMBA]
+    cache.buffer_pipeline = None
+    cache.write_back_batch_nodes = max_nodes
+    cache.write_back_batch_counts = dict(
+        batches=0, nodes=0, full_tokens=0, partial_batches=0,
+    )
+    cache.ongoing_write_through = {}
+    trace = []
+    cache.cache_controller = NS(write_queue=[], start_writing=Mock())
+    capacity = [remaining]
+
+    def enqueue(action, **kwargs):
+        if kwargs.get("beliefkv_defer_writing"):
+            assert kwargs == dict(
+                write_back=True, no_host_reclaim=False, beliefkv_defer_writing=True,
+            )
+        else:
+            assert kwargs == {"write_back": True}
+        node = nodes[action.node_ids[0]]
+        trace.append(("enqueue", node.id))
+        if capacity[0] < len(node.component_data[Component.FULL].value):
+            reclaim = getattr(cache, "reclaim_host", None)
+            if callable(reclaim):
+                capacity[0] += reclaim(
+                    len(node.component_data[Component.FULL].value) - capacity[0]
+                )
+        if capacity[0] < len(node.component_data[Component.FULL].value):
+            return 0
+        capacity[0] -= len(node.component_data[Component.FULL].value)
+        cache.ongoing_write_through[node.id] = node
+        cache.cache_controller.write_queue.append(node)
+        if not kwargs.get("beliefkv_defer_writing"):
+            cache.cache_controller.start_writing()
+        return len(node.component_data[Component.FULL].value)
+
+    def submit():
+        trace.append(("submit", tuple(cache.ongoing_write_through)))
+        cache.cache_controller.write_queue.clear()
+
+    def ack(**kwargs):
+        assert kwargs == {"write_back": True}
+        trace.append(("ack", tuple(cache.ongoing_write_through)))
+        for node in cache.ongoing_write_through.values():
+            node.backuped = True
+        cache.ongoing_write_through.clear()
+
+    def demote(identity, tracker):
+        node = nodes[identity]
+        assert node.backuped and not cache.ongoing_write_through
+        assert all(
+            child.component_data[Component.FULL].value is None
+            for child in node.children.values()
+        )
+        trace.append(("demote", identity))
+        tracker[Component.FULL] += len(node.component_data[Component.FULL].value)
+        node.component_data[Component.FULL].value = None
+        component.tree_core.evictable_device_leaves.discard(node)
+        parent = node.parent
+        if parent is not root and not any(
+            child.component_data[Component.FULL].value is not None
+            for child in parent.children.values()
+        ):
+            component.tree_core.evictable_device_leaves.add(parent)
+
+    cache._execute_and_commit_kv_backup = enqueue
+    cache.cache_controller.start_writing.side_effect = submit
+    cache.writing_check = ack
+    cache._demote = demote
+    cache._evict_backed_join_parent = lambda *args: None
+    cache._preserve_mamba_reentry_candidates = lambda *args: None
+    cache._component_available_size = lambda *args: 0
+    cache._evict_device_next_node = lambda ct, tracker: (
+        component._evict_device_next_node(tracker, {}, {}), False
+    )
+    cache._evict_device_leaf = lambda node_id, tracker: NS(node_ids=[node_id])
+    cache.tree_core.evict_device_start = lambda ct, count: component._evict_device_start(count)
+    cache.tree_core.evict_device_end = lambda ct: component._evict_device_end()
+    return cache, component, nodes, trace
+
+
+def test_exact_native_ancestor_order_and_all_acks_precede_releasing_pages():
+    cache, full, _, trace = fixture()
+    tracker = {Component.FULL: 0}
+    assert cache._try_write_back_chain(3, tracker, 192)
+    assert trace == [
+        ("enqueue", 3), ("enqueue", 2), ("enqueue", 1),
+        ("submit", (3, 2, 1)), ("ack", (3, 2, 1)),
+        ("demote", 3), ("demote", 2), ("demote", 1),
+    ]
+    assert tracker[Component.FULL] == 192
