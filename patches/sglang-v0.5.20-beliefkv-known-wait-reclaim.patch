+def test_known_waiting_chain_fills_real_capacity_without_native_leaf_census(hybrid_cache):
+    cache, allocator, request_pool, chain = backed_waiting_chain(hybrid_cache)
+
+    class Leaves(set):
+        iterations = 0
+
+        def __iter__(self):
+            self.iterations += 1
+            return super().__iter__()
+
+    leaves = Leaves(cache.tree_core.evictable_device_leaves)
+    cache.tree_core.evictable_device_leaves = leaves
+    available = allocator.available_size()
+    state = chain[0].component_data[ComponentType.MAMBA].value
+    result = cache.reclaim_beliefkv_handoff_capacity(
+        full_tokens=available + 6, mamba_slots=0, collect_diagnostics=True,
+    )
+    assert result[int(ComponentType.FULL)] == 6
+    assert allocator.available_size() == available + 6
+    assert chain[0].component_data[ComponentType.MAMBA].value is state
+    assert leaves.iterations == 0
+    diagnosis = cache.beliefkv_handoff_last_capacity
+    assert diagnosis["full_target_satisfied"] and diagnosis["mamba_target_satisfied"]
+    assert diagnosis["native_full_scanned"] == 0
+    assert not diagnosis["native_fallback_considered"]
+    cache._execute_and_commit_kv_backup.assert_not_called()
+
+
