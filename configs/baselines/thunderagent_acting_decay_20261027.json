  },
  "isolation": {
    "full_agent_admission": false,
    "join_priority": false,
    "resident_priority": false,
    "tool_prediction": false,
    "controlled_kv_transfers": false,
    "future_tool_durations": false
  },
  "comparison": {
    "running_default_and_full_unchanged": true,
    "same_complete_work_and_tool_timing_map_required": true,
    "all_normal_tails_retained": true,
    "stream_response_metrics": true,
    "common_request_timeout_s": 3600,
    "gpu_registration": null
  },
  "performance_accepted": false
}
