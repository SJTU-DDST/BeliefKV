__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
dist/
build/
*.log
*.tmp

experiments/raw/*
experiments/processed/*
experiments/results/*
experiments/reports/*
!experiments/raw/.gitkeep
!experiments/raw/README.md
!experiments/processed/.gitkeep
!experiments/results/.gitkeep
experiments/archive/*
experiments/calibration/*
experiments/analysis/*
experiments/models/*
experiments/shadow/*
experiments/ab/*
experiments/canary/*
experiments/characterization/*
experiments/micro/*
experiments/smoke/*
experiments/oracle/*
experiments/replay/*
!experiments/archive/README.md

# Hardware-keyed service artifacts are immutable experiment inputs, not source.
artifacts/*

third_party/*
!third_party/README.md

# Local benchmark data and immutable run artifacts are kept outside git.
workloads/raw/*
workloads/frozen/*
workloads/runtime/*
workloads/sources/*
# Generated LoCoBench source packs, references, and provenance.
workloads/locobench_agent_long_*_root_scoped_*/
!workloads/raw/.gitkeep
!workloads/frozen/.gitkeep
