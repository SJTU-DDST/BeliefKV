!/tests/fixtures/qwen_sandbox_workspace/README.md
!/patches/
!/patches/README.md
!/patches/sglang*.patch

# Installation and small, reusable examples.
!/docs/
!/docs/setup.md
!/third_party/
!/third_party/README.md
